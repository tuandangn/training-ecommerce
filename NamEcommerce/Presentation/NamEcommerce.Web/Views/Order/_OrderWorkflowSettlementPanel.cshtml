@model OrderDetailsModel
@{
    var isActive = Model.Workflow.ActiveStage == OrderDetailsModel.WorkflowStage.Settlement;
    var today = DateTime.Today.ToString("yyyy-MM-dd");
    var now = DateTime.Now.ToString("yyyy-MM-ddTHH:mm");

    var customerBalance = Model.Settlement.CustomerAccountBalance;
    var customerBalanceLabel = customerBalance > 0 ? "Còn nợ" : customerBalance < 0 ? "Đã ứng" : (Model.PaymentRequired ? "Chờ thanh toán" : "Đã thanh toán");
    var customerBalanceClass = customerBalance > 0 ? "text-danger" : customerBalance < 0 ? "text-primary" : (Model.PaymentRequired ? "text-warning" : "text-success");
    var paymentDefaultAmount = customerBalance > 0 ? customerBalance : 0m;
    var remainAmount = Math.Max(0, Model.TotalAmount - Model.PaidAmount);
    if (Model.IsRetailWalkInCustomer && Model.DeliveryNotes.Count != 0)
    {
        paymentDefaultAmount = remainAmount;
    }
    var canChangePaymentAmount = !Model.IsRetailWalkInCustomer || Model.DeliveryNotes.Count == 0;
}

<section class="workflow-panel @(isActive ? "active" : "")" data-workflow-panel="settlement" role="tabpanel">
    <div class="content-card">
        <div class="content-card-header">
            <div>
                <h5>Kết sổ</h5>
                <div class="text-muted small">Chi phí phát sinh, công nợ, giá vốn, trả hàng và lãi lỗ</div>
            </div>
            <div class="d-flex flex-wrap gap-2">
                @if (!Model.IsRetailWalkInCustomer || remainAmount > 0)
                {
                    <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#orderSettlementPaymentModal">
                        <i class="bi bi-cash-coin me-1"></i>Thu tiền
                    </button>
                }
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#orderExpenseModal">
                    <i class="bi bi-plus-lg me-1"></i>Thêm chi phí
                </button>
                @if (Model.CanCompleteOrder)
                {
                    <button type="button" class="btn btn-sm btn-primary" id="btnCompleteOrder" data-testid="order-complete" data-order-id="@Model.Id">
                        <i class="bi bi-check-circle me-1"></i>Hoàn thành đơn
                    </button>
                }
                @if (Model.CanCancelOrder || Model.CanDeleteOrder)
                {
                    <div class="btn-group btn-group-sm">
                        @if (Model.CanCancelOrder)
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger" id="btnCancelOrder">
                                <i class="bi bi-x-circle me-1"></i>Hủy đơn
                            </button>
                        }
                        @if (Model.CanDeleteOrder)
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteOrderModal">
                                <i class="bi bi-trash me-1"></i>Xóa đơn
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
        <div class="content-card-body">
            <div class="workflow-metric-grid mb-3">
                <div class="workflow-metric">
                    <span>Doanh thu</span>
                    <strong>@Model.Settlement.Revenue.DisplayCurrencyWithSymbol()</strong>
                </div>
                <div class="workflow-metric">
                    <span>Giá vốn</span>
                    <strong>@Model.Settlement.TotalCost.DisplayCurrencyWithSymbol()</strong>
                </div>
                <div class="workflow-metric">
                    <span>Chi phí</span>
                    <strong>@Model.Settlement.TotalExpenses.DisplayCurrencyWithSymbol()</strong>
                </div>
                <div class="workflow-metric @(Model.Settlement.Profit >= 0 ? "profit-positive" : "profit-negative")">
                    <span>Lãi / lỗ</span>
                    <strong>@(Model.Settlement.Profit >= 0 ? "" : "-")@Model.Settlement.Profit.DisplayCurrencyWithSymbol()</strong>
                </div>
            </div>

            @if (!Model.Settlement.IsProfitFinal && Model.DeliveryNotes.Count > 0)
            {
                <div class="alert alert-warning small mb-3">
                    <i class="bi bi-info-circle me-1"></i>
                    Lợi nhuận có thể chưa chốt vì còn dòng xuất hàng chưa có giá vốn.
                </div>
            }

            <div class="workflow-section-title">Thanh toán</div>
            <div class="workflow-metric-grid mb-3">
                <div class="workflow-metric">
                    <span>Tình trạng</span>
                    <strong class="@customerBalanceClass">@customerBalanceLabel</strong>
                </div>
                <div class="workflow-metric">
                    <span>Công nợ / Ứng</span>
                    <strong class="@customerBalanceClass">@customerBalance.DisplayCurrencyWithSymbol()</strong>
                </div>
                <div class="workflow-metric">
                    <span>Đã thu</span>
                    <strong class="text-success">@Model.Settlement.Payments.Sum(item => item.Amount).DisplayCurrencyWithSymbol()</strong>
                </div>
                <div class="workflow-metric">
                    <span>Hình thức</span>
                    <strong>@(Model.Settlement.BankTransferEnabled ? "Tiền mặt / QR" : "Tiền mặt")</strong>
                </div>
            </div>
            @if (Model.Settlement.Payments.Count == 0)
            {
                <div class="workflow-soft-empty mb-3">
                    <i class="bi bi-cash-stack"></i>
                    <span>Chưa ghi nhận khoản thu nào cho đơn này.</span>
                </div>
            }
            else
            {
                <div class="table-responsive mb-3">
                    <table class="table data-table mb-0">
                        <thead>
                            <tr>
                                <th>Mã thu</th>
                                <th>Hình thức</th>
                                <th>Loại</th>
                                <th>Ghi chú</th>
                                <th class="text-end">Số tiền</th>
                                <th class="text-end">Ngày thu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model.Settlement.Payments)
                            {
                                <tr>
                                    <td class="fw-600">@payment.Code</td>
                                    <td>@payment.PaymentMethodText</td>
                                    <td>@payment.PaymentTypeText</td>
                                    <td>@(payment.Note ?? "-")</td>
                                    <td class="text-end text-success fw-bold">@payment.Amount.DisplayCurrencyWithSymbol()</td>
                                    <td class="text-end">@payment.PaidOn.ToString($"{ViewConstants.DefaultDateFormat} HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="workflow-section-title">Tài chính trả hàng</div>
            @if (Model.Settlement.Returns.Count == 0)
            {
                <div class="workflow-soft-empty mb-3">
                    <i class="bi bi-arrow-return-left"></i>
                    <span>Chưa có phiếu trả hàng đã xác nhận.</span>
                </div>
            }
            else
            {
                <div class="workflow-metric-grid mb-3">
                    <div class="workflow-metric">
                        <span>Giá trị hàng trả</span>
                        <strong>@Model.Settlement.ReturnGrossAmount.DisplayCurrencyWithSymbol()</strong>
                    </div>
                    <div class="workflow-metric">
                        <span>Phụ phí trả hàng</span>
                        <strong>@Model.Settlement.ReturnAdditionalCost.DisplayCurrencyWithSymbol()</strong>
                    </div>
                    <div class="workflow-metric">
                        <span>Hoàn khách ròng</span>
                        <strong>@Model.Settlement.ReturnNetRefundAmount.DisplayCurrencyWithSymbol()</strong>
                    </div>
                    <div class="workflow-metric">
                        <span>SL bù giao sau</span>
                        <strong>@Model.Settlement.ReturnCompensatedQuantity.DisplayQuantity()</strong>
                    </div>
                </div>
                <div class="table-responsive mb-3">
                    <table class="table data-table mb-0">
                        <thead>
                            <tr>
                                <th>Phiếu trả</th>
                                <th>Phiếu giao</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Giá trị trả</th>
                                <th class="text-end">Phụ phí</th>
                                <th class="text-end">Hoàn khách</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customerReturn in Model.Settlement.Returns)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="CustomerReturn" asp-action="Details" asp-route-id="@customerReturn.Id" class="fw-600 text-decoration-none">
                                            @customerReturn.Code
                                        </a>
                                    </td>
                                    <td>@customerReturn.DeliveryNoteCode</td>
                                    <td><span class="status-badge @customerReturn.StatusClass">@customerReturn.StatusText</span></td>
                                    <td class="text-end">@customerReturn.GrossRefundAmount.DisplayCurrencyWithSymbol()</td>
                                    <td class="text-end">@customerReturn.AdditionalCost.DisplayCurrencyWithSymbol()</td>
                                    <td class="text-end fw-bold">@customerReturn.NetRefundAmount.DisplayCurrencyWithSymbol()</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="workflow-section-title">Công nợ</div>
            @if (Model.Settlement.Debts.Count == 0)
            {
                <div class="workflow-soft-empty mb-3">
                    <i class="bi bi-cash-coin"></i>
                    <span>Chưa có công nợ cho đơn này.</span>
                </div>
            }
            else
            {
                <div class="table-responsive mb-3">
                    <table class="table data-table mb-0">
                        <thead>
                            <tr>
                                <th>Mã nợ</th>
                                <th>Phiếu giao</th>
                                <th class="text-end">Tổng nợ</th>
                                <th class="text-end">Đã thu</th>
                                <th class="text-end">Còn lại</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var debt in Model.Settlement.Debts)
                            {
                                <tr>
                                    <td class="fw-600">@debt.Code</td>
                                    <td>@debt.DeliveryNoteCode</td>
                                    <td class="text-end">@debt.TotalAmount.DisplayCurrencyWithSymbol()</td>
                                    <td class="text-end">@debt.PaidAmount.DisplayCurrencyWithSymbol()</td>
                                    <td class="text-end fw-bold @(debt.RemainingAmount > 0 ? "text-danger" : "text-success")">
                                        @debt.RemainingAmount.DisplayCurrencyWithSymbol()
                                    </td>
                                    <td>@debt.StatusText</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="workflow-section-title">Chi phí phát sinh</div>
            @if (Model.Settlement.Expenses.Count == 0)
            {
                <div class="workflow-soft-empty mb-3">
                    <i class="bi bi-wallet2"></i>
                    <span>Chưa có chi phí phát sinh.</span>
                </div>
            }
            else
            {
                <div class="table-responsive mb-3">
                    <table class="table data-table mb-0">
                        <thead>
                            <tr>
                                <th>Khoản chi</th>
                                <th>Loại</th>
                                <th>Lý do</th>
                                <th class="text-end">Số tiền</th>
                                <th class="text-end">Ngày</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var expense in Model.Settlement.Expenses)
                            {
                                <tr>
                                    <td class="fw-600">@expense.Title</td>
                                    <td>@expense.ExpenseTypeText</td>
                                    <td>@(expense.Description ?? "-")</td>
                                    <td class="text-end text-danger fw-bold">@expense.Amount.DisplayCurrencyWithSymbol()</td>
                                    <td class="text-end">@expense.IncurredDate.ToString(ViewConstants.DefaultDateFormat)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="workflow-section-title">Giá vốn từng lần xuất</div>
            @if (Model.Settlement.Costs.Count == 0)
            {
                <div class="workflow-soft-empty">
                    <i class="bi bi-receipt-cutoff"></i>
                    <span>Chưa có dữ liệu xuất hàng để tính giá vốn.</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table data-table mb-0">
                        <thead>
                            <tr>
                                <th>Phiếu giao</th>
                                <th>Hàng hóa</th>
                                <th>Nguồn</th>
                                <th class="text-end">SL</th>
                                <th class="text-end">Giá vốn</th>
                                <th class="text-end">Tổng vốn</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cost in Model.Settlement.Costs)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="DeliveryNote" asp-action="Details" asp-route-id="@cost.DeliveryNoteId" class="text-decoration-none fw-600">
                                            @cost.DeliveryNoteCode
                                        </a>
                                    </td>
                                    <td>@cost.ProductName</td>
                                    <td>@(cost.IsDirectShip ? "Giao thẳng" : "Xuất kho")</td>
                                    <td class="text-end">@cost.Quantity.DisplayQuantity()</td>
                                    <td class="text-end">@(cost.UnitCost?.DisplayCurrencyWithSymbol() ?? "-")</td>
                                    <td class="text-end fw-600">@(cost.TotalCost?.DisplayCurrencyWithSymbol() ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</section>

<div class="modal fade" id="orderSettlementPaymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content ui-modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Thu tiền khách hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="orderSettlementPaymentForm"
                  method="post"
                  data-cash-url="@Url.Action("RecordSettlementPayment", "Order")"
                  data-create-intent-url="@Url.Action("CreatePaymentIntent", "Order")"
                  data-status-url="@Url.Action("GetPaymentIntentStatus", "Order")"
                  data-confirm-url="@Url.Action("ConfirmPaymentIntent", "Order")"
                  data-qr-record-url="@Url.Action("RecordSettlementQrPayment", "Order")">
                <div class="modal-body py-3">
                    <input type="hidden" name="OrderId" value="@Model.Id" />
                    <input type="hidden" name="CustomerId" value="@Model.CustomerId" />
                    <div class="alert alert-light border small mb-3">
                        <div class="d-flex justify-content-between gap-3">
                            <span>@customerBalanceLabel</span>
                            <strong class="@customerBalanceClass">
                                @if (Model.IsRetailWalkInCustomer)
                                {
                                    @remainAmount.DisplayCurrencyWithSymbol()
                                }
                                else
                                {
                                    @Math.Abs(customerBalance).DisplayCurrencyWithSymbol()
                                }
                            </strong>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-7">
                            <label class="form-label" for="orderSettlementPaymentAmount">Số tiền</label>
                            <input id="orderSettlementPaymentAmount" name="Amount"
                                   class="form-control" value="@(paymentDefaultAmount > 0 ? paymentDefaultAmount.ToString("0") : string.Empty)"
                                   autocomplete="off" data-decimal="currency" placeholder="Nhập số tiền" readonly="@(!canChangePaymentAmount)"
                                   data-val="true" data-val-required="Vui lòng nhập số tiền"
                                   data-val-range="Số tiền phải lớn hơn 0" data-val-range-min="0.001"
                                   data-val-number="Số tiền phải là số" />
                            <span class="small text-danger field-validation-valid" data-valmsg-for="Amount" data-valmsg-replace="true"></span>
                        </div>
                        <div class="col-5">
                            <label class="form-label" for="orderSettlementPaymentPaidOn">Ngày thu</label>
                            <input id="orderSettlementPaymentPaidOn" name="PaidOn" type="datetime-local" class="form-control" value="@now" placeholder="Nhập ngày thu tiền" />
                            <span class="small text-danger field-validation-valid" data-valmsg-for="PaidOn" data-valmsg-replace="true"></span>
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="form-label">Hình thức</label>
                        <div class="d-flex flex-wrap gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="PaymentMode" id="orderSettlementCashMode" value="cash" checked />
                                <label class="form-check-label" for="orderSettlementCashMode">Tiền mặt</label>
                            </div>
                            @if (Model.Settlement.BankTransferEnabled)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="PaymentMode" id="orderSettlementQrMode" value="qr" />
                                    <label class="form-check-label" for="orderSettlementQrMode">Mã QR</label>
                                </div>
                            }
                        </div>
                        @if (Model.Settlement.BankTransferEnabled && !string.IsNullOrWhiteSpace(Model.Settlement.BankAccountLabel))
                        {
                            <div class="text-muted small mt-1">@Model.Settlement.BankAccountLabel</div>
                        }
                    </div>
                    <div class="mt-3">
                        <label class="form-label" for="orderSettlementPaymentNote">Ghi chú</label>
                        <textarea id="orderSettlementPaymentNote" name="Note" class="form-control" rows="2" placeholder="Nhập ghi chú"></textarea>
                    </div>
                    @if (Model.Settlement.BankTransferEnabled)
                    {
                        <div id="orderSettlementQrPanel" class="border rounded-3 p-3 mt-3 d-none">
                            <div class="row g-3 align-items-center">
                                <div class="col-5">
                                    <img id="orderSettlementQrImage" class="img-fluid border rounded" alt="QR chuyển khoản" />
                                </div>
                                <div class="col-7">
                                    <div class="small text-muted">Mã tham chiếu</div>
                                    <div id="orderSettlementQrReference" class="fw-bold"></div>
                                    <div id="orderSettlementQrStatus" class="small text-muted mt-2"></div>
                                    <div id="orderSettlementQrExpires" class="small text-muted"></div>
                                    <div class="d-flex flex-wrap gap-2 mt-3">
                                        @if (Model.Settlement.ManualBankTransferConfirmEnabled)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary" id="orderSettlementQrManualConfirm">
                                                <i class="bi bi-check2-circle me-1"></i>Xác nhận đã nhận tiền
                                            </button>
                                        }
                                        <button type="button" class="btn btn-sm btn-success" id="orderSettlementQrRecord" disabled>
                                            <i class="bi bi-floppy me-1"></i>Ghi nhận QR
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer border-0 pt-0 pb-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary" id="orderSettlementPaymentSubmit">
                        <i class="bi bi-floppy me-1"></i>Ghi nhận
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="orderExpenseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content ui-modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Thêm chi phí phát sinh</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="orderExpenseForm" method="post" action="/Order/AddExpense">
                <div class="modal-body py-3">
                    <input type="hidden" name="SourceOrderId" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label" for="orderExpenseTitle">Khoản chi</label>
                        <input id="orderExpenseTitle" name="Title" class="form-control" required maxlength="200" />
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label" for="orderExpenseAmount">Số tiền</label>
                            <input id="orderExpenseAmount" name="Amount" class="form-control decimal-input"
                                   data-decimal="currency" data-decimals="0" autocomplete="off" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label" for="orderExpenseType">Loại phí</label>
                            <select id="orderExpenseType" name="ExpenseType" class="form-select">
                                <option value="5">Khác</option>
                                <option value="1">Lương thưởng</option>
                                <option value="2">Mặt bằng</option>
                                <option value="3">Tiếp thị</option>
                                <option value="4">Điện nước</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3 mt-3">
                        <label class="form-label" for="orderExpenseDate">Ngày phát sinh</label>
                        <input id="orderExpenseDate" name="IncurredDate" type="date" class="form-control"
                               value="@today" required />
                    </div>
                    <div>
                        <label class="form-label" for="orderExpenseDescription">Lý do</label>
                        <textarea id="orderExpenseDescription" name="Description" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 pb-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-floppy me-1"></i>Lưu lại
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
