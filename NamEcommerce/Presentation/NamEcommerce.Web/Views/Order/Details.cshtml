@model OrderDetailsModel
@{
    ViewData[ViewConstants.PageTitle] = $"Đơn bán - {Model.Code}";
    var orderStatus = (OrderStatus)Model.Status;
}

@section TitleSection {
    <h1 class="topbar-page-title">
        Đơn bán
        <span class="text-muted">@Model.Code</span>
        <span class="text-muted small d-none d-md-inline">
            <span class="status-badge @orderStatus.GetDisplayColor()">
                @orderStatus.GetDisplayText()
            </span>
        </span>
    </h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="List" asp-controller="Order" class="text-decoration-none">Đơn bán</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Code</li>
            </ol>
        </nav>
    </div>
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/order.css" asp-append-version="true" />
}

@await Html.PartialAsync("_OrderWorkflowBar", Model)

<div class="order-workflow-layout">
    <div class="order-workflow-main">
        @await Html.PartialAsync("_OrderWorkflowOrderPanel", Model)
        @await Html.PartialAsync("_OrderWorkflowPreparationPanel", Model)
        @await Html.PartialAsync("_OrderWorkflowDeliveryPanel", Model)
        @await Html.PartialAsync("_OrderWorkflowSettlementPanel", Model)
    </div>
    <aside class="order-workflow-timeline">
        @await Html.PartialAsync("_OrderWorkflowTimeline", Model)
    </aside>
</div>

@if (Model.CanUpdateOrderItems)
{
    <div class="modal fade" id="editItemModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content ui-modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Chỉnh sửa hàng hóa</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="editItemForm" method="post" asp-action="UpdateOrderItem">
                    <div class="modal-body py-3">
                        <div id="modalProductDisplay" class="alert alert-light border-0 rounded-3 mb-3 d-flex align-items-center gap-3 selectedProductInfo">
                            <img class="img-fluid img-thumbnail d-none picture-field order-edit-item-picture" id="editProductHasPicture" alt="" />
                            <i class="bi bi-box-seam-fill text-primary fs-5 picture-field-icon" id="editProductNoPicture"></i>
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="fw-bold text-truncate name-field" id="editProductName"></div>
                                <div class="text-muted small" id="editProductStock">
                                    <span class="stock-field"></span>
                                </div>
                            </div>
                        </div>
                        <input type="hidden" id="editItemId" name="ItemId" />
                        <input type="hidden" name="OrderId" value="@Model.Id" />
                        <input type="hidden" id="editDecimalPlaces" name="QuantityDecimalPlaces" value="0" />
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label" for="editQuantity">Số lượng</label>
                                <input id="editQuantity" name="Quantity" class="form-control"
                                       data-decimal="quantity" value="1" autocomplete="off"
                                       data-val="true" data-val-required="Vui lòng nhập số lượng"
                                       data-val-range="Số lượng phải lớn hơn 0" data-val-range-min="0.0001"
                                       data-val-number="Số lượng phải là số" />
                                <span class="small text-danger field-validation-valid" data-valmsg-for="Quantity"
                                      data-valmsg-replace="true"></span>
                            </div>
                            <div class="col-6">
                                <label class="form-label noRefill" for="editUnitPrice">Đơn giá</label>
                                <input id="editUnitPrice" name="UnitPrice" class="form-control"
                                       data-decimal="currency" autocomplete="off"
                                       data-val="true" data-val-required="Vui lòng nhập đơn giá."
                                       data-val-range="Đơn giá phải lớn hơn 0" data-val-range-min="0.1"
                                       data-val-number="Đơn giá phải là số" />
                                <span class="small text-danger field-validation-valid" data-valmsg-for="UnitPrice"
                                      data-valmsg-replace="true"></span>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0 pb-3">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                        <button type="submit" id="submitEditItem" class="btn btn-primary">
                            <i class="bi bi-floppy"></i>
                            Lưu lại
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="addProductModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content ui-modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Thêm hàng hóa</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="#" method="post" id="addProductForm">
                    <input type="hidden" name="OrderId" value="@Model.Id" />
                    <input type="hidden" id="addProductDecimalPlaces" name="QuantityDecimalPlaces" value="0" />
                    <div class="modal-body py-3">
                        <div class="mb-3">
                            <div id="productPicker"></div>
                            <input type="text" class="visually-hidden" id="addProductId" name="ProductId" value=""
                                   data-val="true" data-val-required="Vui lòng chọn hàng hóa." />
                            <span class="small text-danger field-validation-valid" data-valmsg-for="ProductId"
                                  data-valmsg-replace="true"></span>
                        </div>
                        <div id="modalProductInfo" class="d-none">
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small fw-medium text-muted" for="addProductQuantity">Số lượng</label>
                                    <input id="addProductQuantity" name="Quantity" class="form-control"
                                           data-decimal="quantity" value="1" autocomplete="off"
                                           data-val="true" data-val-required="Vui lòng nhập số lượng"
                                           data-val-range="Số lượng phải lớn hơn 0" data-val-range-min="0.0001"
                                           data-val-number="Số lượng phải là số" />
                                    <span class="small text-danger field-validation-valid" data-valmsg-for="Quantity"
                                          data-valmsg-replace="true"></span>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-medium text-muted noRefill" for="addProductUnitPrice">Đơn giá</label>
                                    <input id="addProductUnitPrice" name="UnitPrice" class="form-control"
                                           data-decimal="currency" autocomplete="off"
                                           data-val="true" data-val-required="Vui lòng nhập đơn giá."
                                           data-val-range="Đơn giá phải lớn hơn 0" data-val-range-min="0.1"
                                           data-val-number="Đơn giá phải là số" />
                                    <span class="small text-danger field-validation-valid" data-valmsg-for="UnitPrice"
                                          data-valmsg-replace="true"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0 pb-3">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" id="addItemToTable" class="btn btn-success d-none noDisabled">
                            <i class="bi bi-plus-lg me-1"></i>Thêm vào
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (Model.CanUpdateInfo)
{
    <div class="modal fade" id="changeNoteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content ui-modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-secondary">Ghi chú đơn hàng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="changeNoteForm" method="post" asp-action="UpdateOrderNote">
                    <div class="modal-body py-3">
                        <input type="hidden" name="OrderId" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label" for="orderNote">Ghi chú</label>
                            <textarea id="orderNote" name="Note" class="form-control" rows="3"
                                      placeholder="Viết ghi chú cho đơn hàng" data-val-maxlength="Ghi chú tối đa 1000 ký tự."
                                      data-val-maxlength-max="1000">@Model.Note</textarea>
                            <span class="small text-danger field-validation-valid" data-valmsg-for="Note"
                                  data-valmsg-replace="true"></span>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0 pb-3">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-floppy"></i>
                            Lưu lại
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="editDiscountModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content ui-modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Giảm giá đơn hàng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="editDiscountForm" method="post" asp-action="UpdateOrderDiscount">
                    <div class="modal-body py-3">
                        <input type="hidden" name="OrderId" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label" for="orderDiscount">Giảm giá</label>
                            <input id="orderDiscount" name="OrderDiscount" class="form-control"
                                   value="@Model.OrderDiscount.DisplayCurrency()"
                                   data-decimal="currency" autocomplete="off"
                                   data-val="true" data-val-required="Vui lòng nhập đơn giá."
                                   data-val-range="Giảm giá phải lớn hơn hoặc bằng 0" data-val-range-min="0"
                                   data-val-number="Giảm giá phải là số" />
                            <span class="small text-danger field-validation-valid" data-valmsg-for="OrderDiscount"
                                  data-valmsg-replace="true"></span>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0 pb-3">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-floppy"></i>
                            Lưu lại
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="shippingModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content ui-modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-warning">Cập nhật vận chuyển</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="shippingForm" method="post" asp-action="UpdateShipping">
                    <div class="modal-body py-3">
                        <input type="hidden" name="OrderId" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label" for="shippingExpectedDate">
                                Ngày giao dự kiến
                                @if (Model.ExpectedShippingDate.HasValue)
                                {
                                    <span class="fw-medium">(@Model.ExpectedShippingDate?.ToString(ViewConstants.DefaultDateFormat))</span>
                                }
                            </label>
                            <input type="date" id="shippingExpectedDate" name="ExpectedShippingDate" class="form-control" placeholder="Ngày giao dự kiến"/>
                            <span class="small text-danger field-validation-valid" data-valmsg-for="ExpectedShippingDate"
                                  data-valmsg-replace="true"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="shippingPhoneNumber">Số điện thoại giao hàng</label>
                            <input id="shippingPhoneNumber" name="PhoneNumber" class="form-control" value="@Model.ShippingPhoneNumber"
                                   placeholder="Nhập số điện thoại giao hàng" data-val="true"
                                   data-val-required="Vui lòng nhập số điện thoại giao hàng."
                                   data-val-maxlength="Số điện thoại tối đa 50 ký tự." data-val-maxlength-max="50" />
                            <span class="small text-danger field-validation-valid" data-valmsg-for="PhoneNumber"
                                  data-valmsg-replace="true"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="shippingAddress">Địa chỉ giao hàng</label>
                            <input id="shippingAddress" name="Address" class="form-control" value="@Model.ShippingAddress"
                                   placeholder="Nhập địa chỉ giao hàng" data-val="true"
                                   data-val-required="Vui lòng nhập địa chỉ giao hàng."
                                   data-val-maxlength="Địa chỉ giao hàng tối đa 1000 ký tự." data-val-maxlength-max="1000" />
                            <span class="small text-danger field-validation-valid" data-valmsg-for="Address"
                                  data-valmsg-replace="true"></span>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0 pb-3">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-floppy"></i>
                            Lưu lại
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (Model.CanCancelOrder)
{
    @if (Model.FullyReceivedDirectShipCount > 0)
    {
        <div class="modal fade" id="cancelOrderWarningModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content ui-modal-content">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold text-danger">Cảnh báo - Hủy đơn hàng</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body py-3">
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            Có <strong>@Model.FullyReceivedDirectShipCount</strong> mặt hàng đang ở kho ảo Direct-Ship Transit. Chọn kho thật để nhập hàng về khi hủy đơn.
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Kho nhận hàng trả về <span class="text-danger">*</span></label>
                            <select id="cancelReturnWarehouseId" class="form-select">
                                <option value="">-- Chọn kho nhận hàng --</option>
                                @foreach (var warehouse in Model.ReturnWarehouseOptions)
                                {
                                    <option value="@warehouse.Id">@warehouse.Name</option>
                                }
                            </select>
                            <div id="cancelReturnWarehouseError" class="invalid-feedback">Vui lòng chọn kho nhận hàng trả về.</div>
                        </div>
                        <p>Xác nhận hủy đơn hàng <strong>@Model.Code</strong>?</p>
                    </div>
                    <div class="modal-footer border-0 pt-0 pb-3">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Giữ nguyên</button>
                        <button type="button" class="btn btn-danger" id="btnConfirmCancelWithDs">
                            <i class="bi bi-x-circle me-1"></i>Hủy đơn và chuyển kho
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="modal fade" id="cancelOrderModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content ui-modal-content">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold text-danger">Xác nhận hủy đơn hàng</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body py-3">
                        <p>Xác nhận hủy đơn hàng <strong>@Model.Code</strong>? Thao tác này không thể hoàn tác.</p>
                    </div>
                    <div class="modal-footer border-0 pt-0 pb-3">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Giữ nguyên</button>
                        <button type="button" class="btn btn-danger" id="btnConfirmCancel">
                            <i class="bi bi-x-circle me-1"></i>Xác nhận hủy
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@if (Model.CanDeleteOrder)
{
    <div class="modal fade" id="deleteOrderModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content ui-modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger">Xác nhận xóa đơn hàng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-3">
                    <p>Xác nhận xóa đơn hàng <strong>@Model.Code</strong>? Thao tác này không thể hoàn tác.</p>
                </div>
                <form method="post" asp-action="Delete" asp-route-id="@Model.Id">
                    <div class="modal-footer border-0 pt-0 pb-3">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Giữ nguyên</button>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>Xóa đơn
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (Model.DeliveryWorkflow.Notes.Any(note => note.Status == (int)DeliveryNoteStatus.Confirmed || note.Status == (int)DeliveryNoteStatus.Delivering))
{
    <partial name="_DeliveryNote.ConfirmDelivered" />
}

@if (Model.AvailableWarehouses is not null
    && Model.DeliveryWorkflow.Notes.Any(note => note.IsDirectShip
        && note.Status != (int)DeliveryNoteStatus.Delivered
        && note.Status != (int)DeliveryNoteStatus.Cancelled))
{
    <partial name="_DeliveryNote.ConfirmReject" model="Model.AvailableWarehouses" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/modules/OrderDetails.js" type="module"></script>
    @if (Model.CanCancelOrder)
    {
        <script>
        (function() {
            const cancelBtn = document.getElementById('btnCancelOrder');
            if (!cancelBtn) return;

            @if (Model.FullyReceivedDirectShipCount > 0)
            {
                <text>
            const modal = new bootstrap.Modal(document.getElementById('cancelOrderWarningModal'));
            cancelBtn.addEventListener('click', () => {
                document.getElementById('cancelReturnWarehouseId')?.classList.remove('is-invalid');
                modal.show();
            });
            document.getElementById('btnConfirmCancelWithDs')?.addEventListener('click', submitCancel);
                </text>
            }
            else
            {
                <text>
            const modal = new bootstrap.Modal(document.getElementById('cancelOrderModal'));
            cancelBtn.addEventListener('click', () => modal.show());
            document.getElementById('btnConfirmCancel')?.addEventListener('click', submitCancel);
                </text>
            }

            async function submitCancel() {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
                let returnWarehouseId = null;
                @if (Model.FullyReceivedDirectShipCount > 0)
                {
                    <text>
                const warehouseSelect = document.getElementById('cancelReturnWarehouseId');
                returnWarehouseId = warehouseSelect?.value || null;
                if (!returnWarehouseId) {
                    warehouseSelect?.classList.add('is-invalid');
                    return;
                }
                warehouseSelect?.classList.remove('is-invalid');
                    </text>
                }
                try {
                    const res = await fetch('/Order/CancelOrder', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                        body: JSON.stringify({ orderId: '@Model.Id', returnWarehouseId })
                    });
                    const data = await res.json();
                    if (data.success) {
                        window.location.href = data.redirectUrl || '/Order/List';
                    } else {
                        alert(data.message || 'Không thể hủy đơn.');
                    }
                } catch { alert('Lỗi kết nối, vui lòng thử lại.'); }
            }
        })();
        </script>
    }
}
