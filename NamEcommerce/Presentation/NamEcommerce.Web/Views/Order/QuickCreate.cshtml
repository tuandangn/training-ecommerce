@using System.Globalization
@model OrderQuickCreateModel
@{
    ViewData[ViewConstants.PageTitle] = "Bán nhanh";
}

@section TitleSection {
    <h1 class="topbar-page-title">
        Đơn hàng
        <span class="text-muted">Bán nhanh</span>
    </h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="List" asp-controller="Order" class="text-decoration-none">Đơn bán</a></li>
                <li class="breadcrumb-item active" aria-current="page">Bán nhanh</li>
            </ol>
        </nav>
    </div>
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/order.css" asp-append-version="true" />
    <style>
        .order-summary .order-summary-row .currency-field .field-prefix {
            right: 0;
        }

        #orderDiscount[readonly] {
            background-color: #fff;
        }
    </style>
}

<form asp-action="QuickCreate" method="post" asp-antiforgery="true" id="fastSaleApp"
      data-create-intent-url="@Url.Action("CreatePaymentIntent", "Order")"
      data-status-url="@Url.Action("GetPaymentIntentStatus", "Order")"
      data-confirm-intent-url="@Url.Action("ConfirmPaymentIntent", "Order")"
      data-bank-transfer-enabled="@Model.BankTransferEnabled.ToString().ToLowerInvariant()"
      data-manual-confirm-enabled="@Model.ManualBankTransferConfirmEnabled.ToString().ToLowerInvariant()">
    <div class="fast-sale-alert alert" id="fastSaleAlert" role="alert"></div>
    <div asp-validation-summary="ModelOnly" class="alert alert-warning alert-global alert-dismissible long-time-waiting"></div>
    <div class="row g-3">
        <div class="col-xl-8">
            <div class="row g-3">
                <div class="col-12">
                    <section class="content-card">
                        <div class="content-card-header">
                            <h5>Thông tin đơn bán</h5>
                        </div>
                        <div class="content-card-body border-bottom pb-4">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div>
                                        <label asp-for="CustomerId" class="form-label small fw-bold text-muted text-uppercase d-block"></label>
                                        <div id="fastSaleCustomerPicker" data-id="@Model.CustomerId" data-name="@Model.CustomerDisplayName"
                                             data-phone="@Model.CustomerDisplayPhone" data-address="@Model.CustomerDisplayAddress"
                                             data-kind="@Model.CustomerDisplayKind" data-is-system="@Model.CustomerDisplayIsSystem.ToString().ToLowerInvariant()"></div>
                                        <input type="text" class="visually-hidden" asp-for="CustomerId" />
                                        <span asp-validation-for="CustomerId" class="small text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div>
                                        <label for="fastSaleNote" class="form-label small fw-bold text-muted text-uppercase d-block">@Html.DisplayNameFor(m => m.Note)</label>
                                        <textarea asp-for="Note" class="form-control" rows="2" id="fastSaleNote" placeholder="Nhập ghi chú..."></textarea>
                                        <span asp-validation-for="Note" class="small text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="content-card-header">
                            <h5>Danh sách hàng hóa</h5>
                            <button type="button" class="btn btn-sm btn-outline-secondary d-lg-none"
                                    data-bs-toggle="offcanvas" data-bs-target="#productBrowserOffcanvas">
                                <i class="bi bi-plus-lg me-1"></i>Thêm hàng
                            </button>
                        </div>
                        <div class="content-card-body-flush">
                            <div class="table-responsive">
                                <table class="table data-table mb-0">
                                    <thead>
                                        <tr>
                                            <th class="ps-3">Hàng hóa</th>
                                            <th class="warehouse-col d-none">Kho hàng</th>
                                            <th class="text-end d-none d-xl-table-cell">Số lượng</th>
                                            <th class="text-end d-none d-xl-table-cell">Đơn giá</th>
                                            <th class="text-end d-table-cell d-xl-none d-xxl-table-cell">Thành tiền</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody id="fastSaleCartBody">
                                        @for (var i = 0; i < Model.Items.Count; i++)
                                        {
                                            var item = Model.Items[i];
                                            <tr data-unit-measurement="@item.UnitMeasurement" data-qty-available="@item.QuantityAvailable.ToString(CultureInfo.InvariantCulture)">
                                                <td class="ps-3 fw-medium align-middle">
                                                    <div class="d-flex align-items-center gap-3">
                                                        @if (!string.IsNullOrEmpty(item.ProductDisplayPicture))
                                                        {
                                                            <img src="@item.ProductDisplayPicture" class="rounded product-picture order-item-thumb d-none d-lg-block" alt="@item.ProductDisplayName" />
                                                        }
                                                        <div>
                                                            <div class="fw-medium product-name">@item.ProductDisplayName</div>
                                                            <div class="text-muted small d-xl-none">
                                                                @item.Quantity.DisplayQuantity(item.QuantityDecimalPlaces) x @item.UnitPrice.DisplayCurrencyWithSymbol()
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <input type="text" class="visually-hidden product-id" name="Items[@i].ProductId" value="@item.ProductId"
                                                           data-val="true" data-val-required="Vui lòng chọn hàng hóa." />
                                                    <input type="hidden" name="Items[@i].QuantityDecimalPlaces" value="@(item.QuantityDecimalPlaces)" class="quantityDecimalPlaces" />
                                                    <input type="hidden" class="row-qty" name="Items[@i].Quantity" value="@item.Quantity?.ToString(CultureInfo.InvariantCulture)"
                                                           data-val="true" data-val-required="Vui lòng nhập số lượng."
                                                           data-val-range="Số lượng phải lớn hơn 0."
                                                           data-val-range-min="0.001"
                                                           data-val-number="Số lượng không đúng." />
                                                    <input type="hidden" class="row-price" name="Items[@i].UnitPrice" value="@item.UnitPrice?.ToString(CultureInfo.InvariantCulture)"
                                                           data-val="true" data-val-required="Vui lòng nhập đơn giá"
                                                           data-val-range="Đơn giá phải lớn hơn 0" data-val-range-min="0.1"
                                                           data-val-number="Đơn giá phải là số" />
                                                    <span class="small text-danger field-validation-valid"
                                                          data-valmsg-for="Items[@i].ProductId"
                                                          data-valmsg-replace="true"></span>
                                                    @if (Model.Items.Where(ci => ci.ProductId == item.ProductId).Sum(ci => (ci.Quantity ?? 0)) > item.QuantityAvailable)
                                                    {
                                                        <div class="text-muted small fst-italic">Số lượng không đủ để giao bây giờ</div>
                                                    }
                                                </td>
                                                <td class="align-middle d-none">
                                                    <select class="form-select form-select-sm warehouse-id" data-role="warehouse" name="Items[@i].WarehouseId"
                                                            data-val="true" data-val-required="Vui lòng chọn kho hàng">
                                                        <option value="">Chọn kho</option>
                                                        @foreach (var warehouse in item.AvailableWarehouseStocks)
                                                        {
                                                            <option value="@warehouse.Id" selected="@(warehouse.Id == item.WarehouseId)"
                                                                    data-name="@warehouse.Name" data-qty-available="@warehouse.QuantityAvailable.ToString(CultureInfo.InvariantCulture)"
                                                                    data-qty-onhand="@warehouse.QuantityOnHand.ToString(CultureInfo.InvariantCulture)">
                                                                @warehouse.Name - @warehouse.QuantityOnHand.DisplayQuantity(item.QuantityDecimalPlaces) @item.UnitMeasurement
                                                            </option>
                                                        }
                                                    </select>
                                                    <span class="small text-danger field-validation-valid" data-valmsg-for="Items[@i].WarehouseId" data-valmsg-replace="true"></span>
                                                </td>
                                                <td class="text-end d-none d-xl-table-cell align-middle">
                                                    <span class="fw-medium">@item.Quantity.DisplayQuantity(item.QuantityDecimalPlaces)</span>
                                                </td>
                                                <td class="text-end d-none d-xl-table-cell align-middle">
                                                    <span class="text-muted text-nowrap">
                                                        @item.UnitPrice.DisplayCurrencyWithSymbol()
                                                    </span>
                                                </td>
                                                <td class="text-end align-middle d-table-cell d-xl-none d-xxl-table-cell">
                                                    <span class="text-nowrap fw-semibold">
                                                        @item.ItemSubTotal.DisplayCurrencyWithSymbol()
                                                    </span>
                                                </td>
                                                <td class="text-center align-middle">
                                                    <button type="button" class="btn-table-action danger border-0 bg-transparent shadow-none deleteItem" aria-label="Xóa hàng hóa">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div id="fastSaleEmptyCart" class="py-4 text-center text-muted" style="@(Model.Items.Count > 0 ? "display:none" : "display:block")">
                                Chưa có hàng hóa
                            </div>
                        </div>
                        <div class="content-card-footer bg-white py-2">
                            @{
                                var subTotal = Model.Items.Sum(item => item.ItemSubTotal);
                                var total = subTotal - Model.OrderDiscount;
                            }
                            <div class="order-summary" id="tableFooter">
                                <div class="order-summary-row">
                                    <span class="label">Tạm tính</span>
                                    <span class="value" id="fastSaleSubtotal">@subTotal.DisplayCurrencyWithSymbol()</span>
                                </div>
                                <div class="order-summary-row">
                                    <span class="label">Giảm giá <i class="bi bi-pencil small text-muted fw-normal"></i></span>
                                    <span class="value">
                                        <input asp-for="OrderDiscount" class="form-control border-0 ui-w-120 include-suffix pe-3" placeholder="Nhập giảm giá"
                                               data-decimal="currency" autocomplete="off" id="orderDiscount" inputmode="numeric" disabled="@(Model.Items.Sum(item => item.ItemSubTotal) == 0)" />
                                        <span class="small text-danger" asp-validation-for="OrderDiscount"></span>
                                    </span>
                                </div>
                                <div class="order-summary-row total">
                                    <span class="label">Tổng cộng</span>
                                    <span class="value">
                                        <span id="fastSaleTotal">@total.DisplayCurrencyWithSymbol()</span>
                                    </span>
                                </div>
                                <div class="currency-hint text-end visible" id="fastSaleTotalHint">
                                    @if (total > 0)
                                    {
                                        @total.DisplayVietnameseCurrencyHint()
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="content-card-body">
                            <div class="mb-3">
                                <div class="d-flex align-items-center gap-3 mb-0">
                                    <div class="form-label small fw-bold text-muted text-uppercase">Giao hàng</div>
                                    <nav>
                                        <div class="nav nav-tabs" role="tablist">
                                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#navNotDelivered"
                                                    type="button" role="tab" aria-controls="navNotDelivered" aria-selected="false"
                                                    id="fastSaleNotDelivered">
                                                Chưa giao
                                            </button>
                                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#navDelivered"
                                                    type="button" role="tab" aria-controls="navDelivered" aria-selected="false"
                                                    id="fastSaleDeliverNow">
                                                Đã giao
                                            </button>
                                        </div>
                                    </nav>
                                </div>
                                <div class="tab-content" id="navShippingContent">
                                    <div class="tab-pane fade" id="navNotDelivered" role="tabpanel" aria-labelledby="navNotDelivered-tab" tabindex="0">
                                    </div>
                                    <div class="tab-pane fade" id="navDelivered" role="tabpanel" aria-labelledby="navDelivered-tab" tabindex="0">
                                    </div>
                                </div>
                                <div class="border rounded p-3 ship-info" role="tabpanel" aria-labelledby="navNotDelivered-tab" tabindex="0">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label asp-for="ShippingPhoneNumber" class="form-label small fw-bold text-muted text-uppercase d-block"></label>
                                            <input asp-for="ShippingPhoneNumber" class="form-control text-sm" placeholder="Nhập số điện thoại" inputmode="tel" />
                                            <span asp-validation-for="ShippingPhoneNumber" class="small text-danger"></span>
                                        </div>
                                        <div class="col-md-6">
                                            <label asp-for="ShippingAddress" class="form-label small fw-bold text-muted text-uppercase d-block"></label>
                                            <input asp-for="ShippingAddress" class="form-control text-sm" placeholder="Nhập địa chỉ" />
                                            <span asp-validation-for="ShippingAddress" class="small text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-3">
                                <div class="d-flex align-items-center gap-3 mb-0">
                                    <div class="form-label small fw-bold text-muted text-uppercase">Thanh toán</div>
                                    <nav>
                                        <div class="nav nav-tabs" role="tablist">
                                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#navUnpaid"
                                                    type="button" role="tab" aria-controls="navUnpaid" aria-selected="false"
                                                    id="fastSaleUnpaid">
                                                Chưa thanh toán
                                            </button>
                                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#navPayNow"
                                                    type="button" role="tab" aria-controls="navPayNow" aria-selected="false"
                                                    id="fastSalePayNow">
                                                Thanh toán ngay
                                            </button>
                                        </div>
                                    </nav>
                                </div>
                                <div class="tab-content">
                                    <div class="tab-pane fade" id="navUnpaid" role="tabpanel" aria-labelledby="navUnpaid-tab" tabindex="0">
                                    </div>
                                    <div class="tab-pane fade" id="navPayNow" role="tabpanel" aria-labelledby="navPayNow-tab" tabindex="0">
                                        <div class="alert alert-warning small mt-2 mb-0 py-2 retailWalkinPaymentWarning">
                                            <i class="bi bi-exclamation-triangle me-1"></i> Khách bán lẻ cần thanh toán hoặc đặt cọc
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-4 d-flex justify-content-center">
                                <button type="button" class="btn btn-primary" id="fastSaleComplete">
                                    <i class="bi bi-floppy me-1"></i> Xác nhận
                                </button>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
        <div class="col-xl-4 d-none d-lg-block">
            <section class="content-card">
                <div class="content-card-body">
                    <div id="fastSaleProductBrowser" data-col-class="col-6 col-xl-12"></div>
                </div>
            </section>
        </div>
    </div>
</form>

<div class="offcanvas offcanvas-bottom d-lg-none ui-top-sheet" tabindex="-1" id="productBrowserOffcanvas">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title">Chọn hàng hóa</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-3">
        <div id="fastSaleProductBrowserMobile" data-col-class="col-12"></div>
    </div>
</div>

<partial name="_ItemEditOffcanvas" />
<partial name="_ItemEditModal" />

<div class="modal fade" id="quickCustomerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content ui-modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Thêm khách hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="QuickCreate" asp-controller="Customer" method="post" id="quickCreateCustomerForm" asp-antiforgery="true">
                <div class="modal-body py-3">
                    <div class="row g-3">
                        <div class="col-12 col-md-7">
                            <label class="form-label small fw-bold text-muted text-uppercase" for="quickCustomerFullName">Họ tên</label>
                            <input id="quickCustomerFullName" name="FullName" class="form-control" autocomplete="off" placeholder="Nhập họ và tên"
                                   data-val="true" data-val-maxlength="Họ tên không được vượt quá 200 ký tự."
                                   data-val-maxlength-max="200" data-val-required="Vui lòng nhập Họ tên." />
                            <span class="text-danger small field-validation-valid" data-valmsg-for="FullName" data-valmsg-replace="true"></span>
                        </div>
                        <div class="col-12 col-md-5">
                            <label class="form-label small fw-bold text-muted text-uppercase" for="quickCustomerPhone">Số điện thoại</label>
                            <input id="quickCustomerPhone" name="PhoneNumber" class="form-control" autocomplete="off" placeholder="Nhập số điện thoại"
                                   data-val="true" data-val-regex="Số điện thoại không hợp lệ." data-val-regex-pattern="0\d{9,10}"
                                   data-val-required="Vui lòng nhập Số điện thoại." inputmode="tel" />
                            <span class="text-danger small field-validation-valid" data-valmsg-for="PhoneNumber" data-valmsg-replace="true"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase" for="quickCustomerAddress">Địa chỉ</label>
                            <input id="quickCustomerAddress" name="Address" class="form-control" autocomplete="off" placeholder="Nhập địa chỉ"
                                   data-val="true" data-val-maxlength="Địa chỉ không được vượt quá 500 ký tự."
                                   data-val-maxlength-max="500" data-val-required="Vui lòng nhập Địa chỉ." />
                            <span class="text-danger small field-validation-valid" data-valmsg-for="Address" data-valmsg-replace="true"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase" for="quickCustomerEmail">Email</label>
                            <input id="quickCustomerEmail" name="Email" class="form-control" autocomplete="off" placeholder="Nhập email" inputmode="email" />
                            <span class="text-danger small field-validation-valid" data-valmsg-for="Email" data-valmsg-replace="true"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 pb-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1"></i> Thêm khách hàng
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="fastSaleScheduleModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content ui-modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Lên lịch giao hàng</h5>
            </div>
            <form id="fastSaleScheduleForm" method="post">
                <div class="modal-body py-3">
                    <input type="hidden" name="OrderId" id="fastSaleScheduleOrderId" />
                    <div id="fastSaleScheduleItemsPayload"></div>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="fastSaleScheduleMode">Kiểu lịch</label>
                            <select id="fastSaleScheduleMode" name="Mode" class="form-select">
                                <option value="@((int)OrderFulfillmentScheduleMode.AsSoonAsPossible)">Giao sớm nhất</option>
                                <option value="@((int)OrderFulfillmentScheduleMode.NotBeforeDate)">Không trước ngày</option>
                                <option value="@((int)OrderFulfillmentScheduleMode.WhenStockAvailable)">Khi có hàng</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-6 d-none" id="fastSaleScheduleDateSection">
                            <label class="form-label" for="fastSaleScheduleFrom">Ngày giao</label>
                            <input id="fastSaleScheduleFrom" name="ScheduledFromUtc" type="datetime-local" class="form-control" placeholder="Nhập ngày giao" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="fastSaleScheduleNote">Ghi chú</label>
                            <textarea id="fastSaleScheduleNote" name="Note" class="form-control" rows="2" placeholder="Nhập ghi chú"></textarea>
                        </div>
                    </div>
                    <div id="fastSaleScheduleItemsTable" class="mt-3"></div>
                </div>
                <div class="modal-footer border-0 pt-0 pb-3">
                    <button type="button" class="btn btn-outline-secondary" id="fastSaleScheduleSkip">Bỏ qua</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-calendar-check me-1"></i> Lên lịch và hoàn tất
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content ui-modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Thanh toán đơn hàng</h5>
            </div>
            <form id="paymentForm" method="post">
                <div class="modal-body py-3">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="text-muted fw-medium">Tổng tiền hàng</span>
                                <div>
                                    <span class="fw-medium" id="paymentSubTotal"></span>
                                </div>
                            </div>
                        </li>
                        <li class="list-group-item">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="text-muted fw-medium">Giảm giá</span>
                                <div>
                                    <span class="fw-medium" id="paymentDiscount"></span>
                                </div>
                            </div>
                        </li>
                        <li class="list-group-item">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="fw-bold">Tổng cộng</span>
                                <div class="text-end">
                                    <span class="fw-medium" id="paymentTotal"></span>
                                    <span class="small text-muted d-block" id="paymentTotalHint"></span>
                                </div>
                            </div>
                        </li>
                    </ul>
                    <div id="paymentProcessContainer">
                        <hr />
                        <div class="d-flex align-items-center gap-3 mb-3 justify-content-between">
                            <label name="PaidAmount" class="form-label small fw-bold text-muted text-uppercase d-block"></label>
                            <div>
                                <div>
                                    <input name="PaidAmount" class="form-control text-sm" id="paidAmount" placeholder="Nhập số tiền" disabled
                                           data-decimal="currency" data-val-range="Số tiền phải lớn hơn 0" data-val-range-min="0" autocomplete="off"
                                           data-val="true" inputmode="numeric" />
                                    <span class="small text-danger field-validation-valid" data-valmsg-for="PaidAmount" data-valmsg-replace="true"></span>
                                </div>
                                <span class="form-text text-muted d-block text-end" id="debtAmount"></span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3 mt-2 mb-3 justify-content-between" id="paymentMethodContainer">
                            <label for="PaidAmount" class="form-label small fw-bold text-muted text-uppercase d-block">
                                Phương thức
                            </label>
                            <div class="fast-sale-payment-methods" role="group">
                                <button type="button" class="btn btn-outline-secondary btn-sm active" id="fastSaleCashMethod" data-method="cash">
                                    Tiền mặt
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" id="fastSaleBankMethod" data-method="bank" @(Model.BankTransferEnabled ? "" : "disabled")>
                                    Chuyển khoản
                                </button>
                            </div>
                        </div>
                        <div id="fastSaleQrPanel" class="d-none">
                            @if (!string.IsNullOrWhiteSpace(Model.BankAccountLabel))
                            {
                                <div class="mt-2 text-center">
                                    <span id="fastBankNumber" class="fw-bold text-muted text-uppercase">@Model.BankAccountLabel</span>
                                </div>
                            }
                            <div class="fast-sale-qr mt-2 border rounded">
                                <img id="fastSaleQrImage" src="" alt="VietQR" />
                                <div class="list-group list-group-flush">
                                    <div class="list-group-item">
                                        <div class="d-flex align-items-center justify-content-between gap-3">
                                            <span class="text-muted">Nội dung</span>
                                            <span class="fw-medium" id="fastSaleReference"></span>
                                        </div>
                                    </div>
                                    <div class="list-group-item">
                                        <div class="d-flex align-items-center justify-content-between gap-3">
                                            <span class="text-muted">Số tiền</span>
                                            <span class="fw-medium" id="fastSaleQrAmount"></span>
                                        </div>
                                    </div>
                                    <div class="list-group-item">
                                        <div class="d-flex align-items-center justify-content-between gap-3">
                                            <span class="text-muted">Trạng thái</span>
                                            <span class="fw-medium" id="fastSaleQrStatus"></span>
                                        </div>
                                    </div>
                                    <div class="list-group-item">
                                        <div class="d-flex align-items-center justify-content-between gap-3">
                                            <span class="text-muted">Hết hạn</span>
                                            <span class="fw-medium" id="fastSaleQrExpires"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2 mt-3 justify-content-center">
                                    <button type="button" class="btn btn-outline-primary" id="fastSaleCreateQr">
                                        <i class="bi bi-qr-code-scan me-1"></i> Tạo QR
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 pb-3">
                    <button type="button" class="btn btn-outline-secondary" id="paymentSkip">Bỏ qua</button>
                    <button type="submit" class="btn btn-primary d-none">
                        <i class="bi bi-floppy me-1"></i>Xác nhận
                    </button>
                    <button type="button" class="btn btn-primary" id="moneyReceived">
                        <i class="bi bi-check-circle me-1"></i>Đã nhận tiền
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/modules/FastSale.js" asp-append-version="true"></script>
}
