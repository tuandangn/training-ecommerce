@model FastSaleModel
@{
    ViewData[ViewConstants.PageTitle] = "Bán nhanh";
}

@section TitleSection {
    <h1 class="topbar-page-title">
        Đơn hàng
        <span class="text-muted">Bán nhanh</span>
    </h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="List" asp-controller="Order" class="text-decoration-none">Đơn bán</a></li>
                <li class="breadcrumb-item active" aria-current="page">Bán nhanh</li>
            </ol>
        </nav>
    </div>
}

@section Styles {
    <style>
        .fast-sale-grid {
            display: grid;
            grid-template-columns: minmax(280px, .85fr) minmax(420px, 1.35fr) minmax(300px, .9fr);
            gap: 1rem;
            align-items: start;
        }

        .fast-sale-total {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: .7rem 0;
            border-top: 1px solid var(--gray-200);
        }

        .fast-sale-total strong {
            font-size: 1.35rem;
            color: var(--gray-900);
        }

        .fast-sale-payment-methods {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: .5rem;
        }

        .fast-sale-option-group {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: .5rem;
        }

        .fast-sale-option-group .btn {
            min-height: 2.75rem;
        }

        .fast-sale-option-group .btn.active {
            background: var(--primary);
            color: #fff;
            border-color: var(--primary);
        }

        .fast-sale-payment-methods .btn {
            min-height: 2.75rem;
        }

        .fast-sale-payment-methods .btn.active {
            background: var(--primary);
            color: #fff;
            border-color: var(--primary);
        }

        .fast-sale-qr {
            display: none;
            border: 1px solid var(--gray-200);
            border-radius: .5rem;
            padding: .75rem;
            background: var(--gray-50);
        }

        .fast-sale-qr.visible {
            display: block;
        }

        .fast-sale-qr img {
            width: min(100%, 260px);
            aspect-ratio: 1;
            object-fit: contain;
            display: block;
            margin: 0 auto .75rem;
            background: #fff;
            border: 1px solid var(--gray-200);
            border-radius: .5rem;
        }

        .fast-sale-alert {
            display: none;
        }

        .fast-sale-alert.visible {
            display: block;
        }

        @@media (max-width: 1200px) {
            .fast-sale-grid {
                grid-template-columns: 1fr;
            }

        }
    </style>
}

<div id="fastSaleApp"
     data-create-intent-url="@Url.Action("CreatePaymentIntent", "Order")"
     data-status-url="@Url.Action("GetPaymentIntentStatus", "Order")"
     data-confirm-intent-url="@Url.Action("ConfirmPaymentIntent", "Order")"
     data-create-cash-sale-url="@Url.Action("CreateCashSale", "Order")"
     data-create-bank-sale-url="@Url.Action("CreateBankTransferSale", "Order")"
     data-create-unpaid-sale-url="@Url.Action("CreateUnpaidSale", "Order")"
     data-bank-transfer-enabled="@Model.BankTransferEnabled.ToString().ToLowerInvariant()"
     data-manual-confirm-enabled="@Model.ManualBankTransferConfirmEnabled.ToString().ToLowerInvariant()">
    <div class="fast-sale-alert alert" id="fastSaleAlert" role="alert"></div>

    <div class="fast-sale-grid">
        <section class="content-card">
            <div class="content-card-header">
                <h5>Thanh toán</h5>
            </div>
            <div class="content-card-body">
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted text-uppercase" for="customerSearch">Khách hàng</label>
                    <div id="fastSaleCustomerPicker"
                         data-id="@Model.DefaultCustomerId"
                         data-name="@Model.DefaultCustomerName"
                         data-phone="@Model.DefaultCustomerPhone"
                         data-address="@Model.DefaultCustomerAddress"></div>
                </div>

                <div class="mb-3">
                    <div class="form-label small fw-bold text-muted text-uppercase">Giao hàng</div>
                    <div class="fast-sale-option-group" role="group">
                        <button type="button" class="btn btn-outline-primary active" id="fastSaleDeliverNow">
                            <i class="bi bi-box-seam me-1"></i> Giao ngay
                        </button>
                        <button type="button" class="btn btn-outline-primary" id="fastSaleNotDelivered">
                            <i class="bi bi-clock-history me-1"></i> Chưa giao
                        </button>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="form-label small fw-bold text-muted text-uppercase">Thanh toán</div>
                    <div class="fast-sale-option-group" role="group">
                        <button type="button" class="btn btn-outline-primary active" id="fastSalePayNow">
                            <i class="bi bi-credit-card-2-front me-1"></i> Thanh toán ngay
                        </button>
                        <button type="button" class="btn btn-outline-primary" id="fastSaleUnpaid">
                            <i class="bi bi-receipt me-1"></i> Chưa thanh toán
                        </button>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted text-uppercase" for="fastSaleDiscount">Giảm giá</label>
                    <input id="fastSaleDiscount" class="form-control text-end" inputmode="decimal" value="0" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted text-uppercase" for="fastSaleNote">Ghi chú</label>
                    <textarea id="fastSaleNote" class="form-control" rows="2"></textarea>
                </div>

                <div class="fast-sale-total">
                    <span>Tạm tính</span>
                    <strong id="fastSaleSubtotal">0 đ</strong>
                </div>
                <div class="fast-sale-total">
                    <span>Tổng thu</span>
                    <strong id="fastSaleTotal">0 đ</strong>
                </div>

                <div class="mb-3" id="fastSalePaymentMethodSection">
                    <div class="form-label small fw-bold text-muted text-uppercase">Phương thức</div>
                    <div class="fast-sale-payment-methods" role="group">
                        <button type="button" class="btn btn-outline-primary active" id="fastSaleCashMethod" data-method="cash">
                            <i class="bi bi-cash-coin me-1"></i> Tiền mặt
                        </button>
                        <button type="button" class="btn btn-outline-primary" id="fastSaleBankMethod" data-method="bank" @(Model.BankTransferEnabled ? "" : "disabled")>
                            <i class="bi bi-qr-code me-1"></i> Chuyển khoản
                        </button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.BankAccountLabel))
                    {
                        <div class="small text-muted mt-2">@Model.BankAccountLabel</div>
                    }
                </div>

                <div class="fast-sale-qr mb-3" id="fastSaleQrPanel">
                    <img id="fastSaleQrImage" src="" alt="VietQR" />
                    <div class="small d-flex justify-content-between gap-2">
                        <span class="text-muted">Nội dung</span>
                        <strong id="fastSaleReference"></strong>
                    </div>
                    <div class="small d-flex justify-content-between gap-2 mt-1">
                        <span class="text-muted">Số tiền</span>
                        <strong id="fastSaleQrAmount"></strong>
                    </div>
                    <div id="fastSaleQrStatus" class="small text-muted mt-2"></div>
                    <div id="fastSaleQrExpires" class="small text-muted"></div>
                    <div class="d-grid gap-2 mt-3">
                        <button type="button" class="btn btn-outline-primary" id="fastSaleCreateQr">
                            <i class="bi bi-qr-code-scan me-1"></i> Tạo QR
                        </button>
                        <button type="button" class="btn btn-outline-success" id="fastSaleConfirmQr" disabled>
                            <i class="bi bi-check2-circle me-1"></i> Xác nhận đã nhận tiền
                        </button>
                    </div>
                </div>

                <div class="d-grid">
                    <button type="button" class="btn btn-primary btn-lg" id="fastSaleComplete">
                        <i class="bi bi-check2-square me-1"></i> Hoàn tất bán hàng
                    </button>
                </div>
            </div>
        </section>
        <section class="content-card">
            <div class="content-card-header">
                <h5>Giỏ hàng</h5>
                <button type="button" class="btn btn-sm btn-light" id="fastSaleClearCart" data-bs-toggle="tooltip" title="Xóa giỏ hàng">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
            <div class="content-card-body-flush">
                <div class="table-responsive">
                    <table class="table data-table mb-0">
                        <thead>
                            <tr>
                                <th class="ps-3">Hàng hóa</th>
                                <th>Kho</th>
                                <th class="text-center">SL</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end">Tiền</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="fastSaleCartBody"></tbody>
                    </table>
                </div>
                <div id="fastSaleEmptyCart" class="py-4 text-center text-muted">Chưa có hàng hóa.</div>
            </div>
        </section>
        <section class="content-card">
            <div class="content-card-header">
                <h5>Hàng hóa</h5>
            </div>
            <div class="content-card-body">
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted text-uppercase" for="fastSaleWarehouse">Kho mặc định</label>
                    <select id="fastSaleWarehouse" class="form-select">
                        <option value="">Chọn kho</option>
                        @foreach (var warehouse in Model.Warehouses)
                        {
                            <option value="@warehouse.Id">@warehouse.Name</option>
                        }
                    </select>
                </div>
                <div id="fastSaleProductBrowser" data-col-class="col-12"></div>
            </div>
        </section>
    </div>
</div>

<div class="modal fade" id="quickCustomerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Thêm khách hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="QuickCreate" asp-controller="Customer" method="post" id="quickCreateCustomerForm" asp-antiforgery="true">
                <div class="modal-body py-3">
                    <div class="row g-3">
                        <div class="col-12 col-md-7">
                            <label class="form-label small fw-bold text-muted text-uppercase" for="quickCustomerFullName">Họ tên</label>
                            <input id="quickCustomerFullName" name="FullName" class="form-control" autocomplete="off" placeholder="Nhập họ và tên"
                                   data-val="true" data-val-maxlength="Họ tên không được vượt quá 200 ký tự."
                                   data-val-maxlength-max="200" data-val-required="Vui lòng nhập Họ tên." />
                            <span class="text-danger small field-validation-valid" data-valmsg-for="FullName" data-valmsg-replace="true"></span>
                        </div>
                        <div class="col-12 col-md-5">
                            <label class="form-label small fw-bold text-muted text-uppercase" for="quickCustomerPhone">Số điện thoại</label>
                            <input id="quickCustomerPhone" name="PhoneNumber" class="form-control" autocomplete="off" placeholder="Nhập số điện thoại"
                                   data-val="true" data-val-regex="Số điện thoại không hợp lệ." data-val-regex-pattern="0\d{9,10}"
                                   data-val-required="Vui lòng nhập Số điện thoại." />
                            <span class="text-danger small field-validation-valid" data-valmsg-for="PhoneNumber" data-valmsg-replace="true"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase" for="quickCustomerAddress">Địa chỉ</label>
                            <input id="quickCustomerAddress" name="Address" class="form-control" autocomplete="off" placeholder="Nhập địa chỉ"
                                   data-val="true" data-val-maxlength="Địa chỉ không được vượt quá 500 ký tự."
                                   data-val-maxlength-max="500" data-val-required="Vui lòng nhập Địa chỉ." />
                            <span class="text-danger small field-validation-valid" data-valmsg-for="Address" data-valmsg-replace="true"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase" for="quickCustomerEmail">Email</label>
                            <input id="quickCustomerEmail" name="Email" class="form-control" autocomplete="off" placeholder="Nhập email" />
                            <span class="text-danger small field-validation-valid" data-valmsg-for="Email" data-valmsg-replace="true"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 pb-3">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1"></i> Thêm khách hàng
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/modules/FastSale.js" asp-append-version="true"></script>
}
