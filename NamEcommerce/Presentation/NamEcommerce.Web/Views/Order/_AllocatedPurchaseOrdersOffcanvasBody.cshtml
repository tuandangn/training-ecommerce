@model NamEcommerce.Web.Contracts.Models.PurchaseOrders.OrderAllocatedPurchaseOrderListModel

@if (!Model.HasItems)
{
    <div class="text-center text-muted py-4">
        <i class="bi bi-inbox" style="font-size: 2rem;"></i>
        <p class="mt-2 mb-0">Đơn hàng này chưa có phiếu nhập nào được phân bổ.</p>
    </div>
}
else
{
    <div class="allocated-po-summary text-muted small mb-3">
        @Model.TotalPurchaseOrderCount phiếu nhập đã phân bổ · @Model.TotalAllocatedItemCount dòng mặt hàng
    </div>

    <div class="allocated-po-list d-flex flex-column gap-3">
        @foreach (var po in Model.Items)
        {
            <div class="allocated-po-card border rounded-3 p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <a class="fw-semibold text-decoration-none"
                           asp-controller="PurchaseOrder" asp-action="Details" asp-route-id="@po.PurchaseOrderId">
                            @po.PurchaseOrderCode
                        </a>
                        <span class="badge bg-@po.StatusClass ms-1">@po.StatusName</span>
                        @if (po.IsFullyReceived)
                        {
                            <span class="badge bg-success ms-1"><i class="bi bi-check-circle"></i> Đã về đủ</span>
                        }
                        <div class="small text-muted mt-1">
                            <i class="bi bi-building me-1"></i>@po.VendorName
                        </div>
                    </div>
                    <div class="text-end small text-muted">
                        <div>Tạo @po.CreatedOn.ToString("dd/MM/yyyy")</div>
                        @if (po.ExpectedDeliveryDate.HasValue)
                        {
                            <div>Dự kiến @po.ExpectedDeliveryDate.Value.ToString("dd/MM/yyyy")</div>
                        }
                    </div>
                </div>

                <table class="table table-sm mb-0 allocated-po-items">
                    <thead class="text-muted small">
                        <tr>
                            <th>Mặt hàng</th>
                            <th class="text-end" style="width: 110px;">Phân bổ</th>
                            <th class="text-end" style="width: 130px;">Đã về</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in po.Items)
                        {
                            var receivedRatio = item.AllocatedQuantity > 0
                                ? (double)(item.ReceivedQuantity / item.AllocatedQuantity) * 100
                                : 0;
                            <tr>
                                <td>@item.ProductName</td>
                                <td class="text-end">@item.AllocatedQuantity.DisplayQuantity()</td>
                                <td class="text-end">
                                    @item.ReceivedQuantity.DisplayQuantity() / @item.AllocatedQuantity.DisplayQuantity()
                                    <div class="progress mt-1" style="height: 4px;">
                                        <div class="progress-bar @(item.PendingQuantity == 0 ? "bg-success" : "bg-warning")"
                                             role="progressbar"
                                             style="width: @receivedRatio.ToString("0")%;"
                                             aria-valuenow="@receivedRatio.ToString("0")"
                                             aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
