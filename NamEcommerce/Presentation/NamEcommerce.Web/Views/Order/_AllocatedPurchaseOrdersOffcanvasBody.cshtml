@model NamEcommerce.Web.Contracts.Models.PurchaseOrders.OrderAllocatedPurchaseOrderListModel

@if (!Model.HasItems)
{
    <div class="text-center text-muted py-4">
        <i class="bi bi-inbox fs-2"></i>
        <p class="mt-2 mb-0">Đơn hàng này chưa có phiếu nhập nào được phân bổ.</p>
    </div>
}
else
{
    <div class="allocated-po-list d-flex flex-column gap-3">
        @foreach (var po in Model.Items)
        {
            <div class="allocated-po-card">
                <table class="table table-sm mb-0 allocated-po-items caption-top @(po.Status == (int)PurchaseOrderStatus.Completed ? "" : "table-light")">
                    <caption>
                        <div class="d-flex align-items-end justify-content-between">
                            <a class="fw-medium text-decoration-none" asp-controller="PurchaseOrder" asp-action="Details" asp-route-id="@po.PurchaseOrderId">
                                <span>@po.PurchaseOrderCode</span>
                                <span class="badge bg-@po.StatusClass ms-1">@po.StatusName</span>
                            </a>
                            <span class="text-muted small">
                                Ngày đặt @po.PlacedOn.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        </div>
                    </caption>
                    <thead class="text-muted small">
                        <tr>
                            <th>Mặt hàng</th>
                            <th class="text-end order-allocated-quantity-column">Phân bổ</th>
                            <th class="text-end order-received-quantity-column">Đã về</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in po.Items)
                        {
                            var receivedRatio = item.AllocatedQuantity > 0
                                ? (double)(item.ReceivedQuantity / item.AllocatedQuantity) * 100
                                : 0;
                            <tr>
                                <td>@item.ProductName</td>
                                <td class="text-end">@item.AllocatedQuantity.DisplayQuantity()</td>
                                <td class="text-end">
                                    @item.ReceivedQuantity.DisplayQuantity() / @item.AllocatedQuantity.DisplayQuantity()
                                    <progress class="order-items-progress order-items-progress--fluid mt-1 @(item.PendingQuantity == 0 ? "order-items-progress--success" : "order-items-progress--warning")"
                                              value="@receivedRatio.ToString("0")"
                                              max="100"
                                              aria-label="Tiến độ nhận hàng"></progress>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="border-bottom-0">
                                <div class="d-flex align-items-center justify-content-between">
                                    <span class="fw-medium text-muted small text-uppercase">
                                        @po.VendorName
                                    </span>
                                    @if (po.IsFullyReceived)
                                    {
                                        <span class="text-primary small fw-medium"><i class="bi bi-check-circle"></i> Đã về đủ</span>
                                    }
                                    else if (po.ExpectedDeliveryDate.HasValue)
                                    {
                                        <span class="text-muted small">Dự kiến @po.ExpectedDeliveryDate.Value.ToString("dd/MM/yyyy")</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
}
