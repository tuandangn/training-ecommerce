@model CreateOrderModel
@{
    ViewData[ViewConstants.PageTitle] = "Thêm đơn bán";
}
@section TitleSection {
    <h1 class="topbar-page-title">
        Thêm mới
        <span class="text-muted">Đơn bán</span>
    </h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="List" asp-controller="Order" class="text-decoration-none">Đơn bán</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
            </ol>
        </nav>
    </div>
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/order.css" asp-append-version="true" />
}
<div>
    <div asp-validation-summary="ModelOnly" class="alert alert-warning alert-global alert-dismissible long-time-waiting"></div>
    <form method="post" id="createOrderForm" asp-antiforgery="true">
        <div class="row g-3">
            <div class="col-lg-8">
                <div class="content-card">
                    <div class="content-card-body-flush border-bottom pt-2">
                        <div class="content-card-header">
                            <h5>Thông tin đơn bán</h5>
                        </div>
                        <div class="content-card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                                            <label for="customerSearch" class="form-label small fw-bold text-muted text-uppercase mb-0">Khách hàng</label>
                                        </div>
                                        <div id="customerPicker" data-testid="order-customer-picker" data-id="@Model.CustomerId" data-name="@Model.CustomerDisplayName"
                                             data-phone="@Model.CustomerDisplayPhone" data-address="@Model.CustomerDisplayAddress"></div>
                                        <input type="text" class="visually-hidden" asp-for="CustomerId" />
                                        <span asp-validation-for="CustomerId" class="small text-danger"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="ShippingAddress" class="form-label small fw-bold text-muted text-uppercase d-block"></label>
                                        <div class="input-group">
                                            <input asp-for="ShippingAddress" class="form-control text-sm" placeholder="Nhập địa chỉ giao hàng" readonly="@(Model.CustomerDisplayAddress == Model.ShippingAddress)" />
                                            @if (Model.CustomerDisplayAddress == Model.ShippingAddress)
                                            {
                                                <button type="button" class="btn btn-outline-secondary" id="btnEditShippingAddress"
                                                        data-bs-toggle="tooltip" title="Chỉnh sửa địa chỉ">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                            }
                                        </div>
                                        <span asp-validation-for="ShippingAddress" class="small text-danger"></span>
                                    </div>
                                    <div>
                                        <label asp-for="ExpectedShippingDate" class="form-label small fw-bold text-muted text-uppercase d-block"></label>
                                        <input type="date" asp-for="ExpectedShippingDate" class="form-control" placeholder="Nhập ngày giao dự kiến" />
                                        <span asp-validation-for="ExpectedShippingDate" class="small text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="OrderDiscount" class="form-label small fw-bold text-muted text-uppercase d-block"></label>
                                        <input asp-for="OrderDiscount" class="form-control" placeholder="Nhập giảm giá"
                                               data-decimal="currency" autocomplete="off"
                                               data-val="true" disabled="@(Model.Items.Count == 0)"
                                               data-val-range="Giảm giá phải lớn hơn hoặc bằng 0" data-val-range-min=""
                                               data-val-number="Giảm giá phải là số" />
                                        <span asp-validation-for="OrderDiscount" class="small text-danger"></span>
                                    </div>
                                    <div>
                                        <label asp-for="Note" class="form-label small fw-bold text-muted text-uppercase d-block"></label>
                                        <textarea asp-for="Note" class="form-control" rows="3"
                                                  placeholder="Nhập ghi chú..."></textarea>
                                        <span asp-validation-for="Note" class="small text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="content-card-header">
                        <h5>Danh sách hàng hóa</h5>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="order-add-product-open" data-bs-toggle="modal" data-bs-target="#addProductModal">
                                <i class="bi bi-plus-lg me-1"></i>
                                <span class="d-none d-lg-inline">Thêm hàng hóa</span>
                                <span class="d-lg-none">Thêm</span>
                            </button>
                        </div>
                    </div>
                    <div class="content-card-body-flush">
                        <div class="table-responsive">
                            <table class="table data-table mb-0" id="orderItemsTable">
                                <thead>
                                    <tr>
                                        <th class="ps-3">Sản phẩm</th>
                                        <th class="text-center d-none d-md-table-cell">Số lượng</th>
                                        <th class="text-end">Đơn giá</th>
                                        <th class="text-end d-none d-lg-table-cell">Thành tiền</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="itemsTableBody">
                                    @for (var i = 0; i < Model.Items.Count; i++)
                                    {
                                        var item = Model.Items[i];
                                        <tr id="row-@i" class="order-item-row">
                                            <td class="ps-3 align-middle">
                                                <div class="d-flex align-items-center gap-2">
                                                    @if (!string.IsNullOrEmpty(item.ProductDisplayPicture))
                                                    {
                                                        <img src="@item.ProductDisplayPicture" class="rounded product-picture order-item-thumb d-none d-lg-block" />
                                                    }
                                                    <div>
                                                        <div class="fw-medium product-name">@item.ProductDisplayName</div>
                                                        <div class="text-muted small d-md-none">@item.Quantity.DisplayQuantity() × @item.UnitPrice.DisplayCurrency() đ</div>
                                                    </div>
                                                </div>
                                                <input type="text" class="visually-hidden product-id"
                                                       name="Items[@i].ProductId" value="@item.ProductId" data-val="true"
                                                       data-val-required="Vui lòng chọn hàng hóa." />
                                                <input type="hidden" name="Items[@i].QuantityDecimalPlaces" value="@item.QuantityDecimalPlaces" />
                                                <input type="hidden" class="row-qty" name="Items[@i].Quantity" value="@item.Quantity"
                                                       data-val="true" data-val-required="Vui lòng nhập số lượng."
                                                       data-val-range="Số lượng phải lớn hơn 0." data-val-range-min="@(item.QuantityDecimalPlaces > 0 ? "0.001" : "1")"
                                                       data-val-number="Số lượng không đúng." />
                                                <input type="hidden" class="row-price" name="Items[@i].UnitPrice" value="@item.UnitPrice"
                                                       data-val="true" data-val-required="Vui lòng nhập đơn giá"
                                                       data-val-range="Đơn giá phải lớn hơn 0" data-val-range-min="0.1"
                                                       data-val-number="Đơn giá phải là số" />
                                                <span class="small text-danger field-validation-valid"
                                                      data-valmsg-for="Items[@i].ProductId" data-valmsg-replace="true"></span>
                                            </td>
                                            <td class="text-center d-none d-md-table-cell align-middle">
                                                <span class="fw-medium">@item.Quantity.DisplayQuantity()</span>
                                            </td>
                                            <td class="text-end align-middle">
                                                <span class="text-muted">@item.UnitPrice.DisplayCurrency() đ</span>
                                            </td>
                                            <td class="text-end fw-bold text-primary row-total text-nowrap d-none d-lg-table-cell align-middle">
                                                @item.ItemSubTotal.DisplayCurrencyWithSymbol()
                                            </td>
                                            <td class="text-end pe-3 align-middle">
                                                <button type="button" class="btn-table-action danger border-0 bg-transparent shadow-none">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div id="noItemsMessage" class="py-4 text-center text-muted @(Model.Items.Count == 0 ? "" : "d-none")">
                            Chưa có hàng hóa nào được chọn.
                            <div class="mt-1">
                                <span asp-validation-for="Items" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                    <div class="content-card-footer bg-white py-2">
                        <div class="order-summary" id="tableFooter">
                            <div class="order-summary-row">
                                <span class="label">Tạm tính</span>
                                <span class="value" id="subTotal">@Model.OrderSubTotal.DisplayCurrencyWithSymbol()</span>
                            </div>
                            <div class="order-summary-row">
                                <span class="label">Giảm giá</span>
                                <span class="value" id="discountDisplay">
                                    @if (Model.OrderDiscount > 0)
                                    {
                                        @:-@Model.OrderDiscount.DisplayCurrencyWithSymbol()
                                    }
                                    else
                                    {
                                        @:0 @ViewConstants.DefaultCurrencySymbol
                                    }
                                </span>
                            </div>
                            <div class="order-summary-row total">
                                <span class="label">Tổng cộng</span>
                                <span class="value">
                                    <span id="grandTotal">@Model.OrderTotal.DisplayCurrencyWithSymbol()</span>
                                </span>
                            </div>
                            <div class="currency-hint text-end visible" id="grandTotalHint">
                                @if (Model.OrderTotal > 0)
                                {
                                    @Model.OrderTotal.DisplayVietnameseCurrencyHint()
                                }
                            </div>
                        </div>
                    </div>
                    <div class="content-card-footer d-flex align-items-center justify-content-between">
                        <a asp-action="List" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-arrow-left"></i>
                            Trở về
                        </a>
                        <div class="d-block">
                            <button type="submit" class="btn btn-primary" id="btnSubmitOrder" data-testid="order-submit">
                                <i class="bi bi-floppy"></i>
                                Tạo đơn
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="content-card">
                    <div class="content-card-body">
                        <div id="productBrowser" data-col-class="col-12"></div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<partial name="_ItemEditOffcanvas" />
<partial name="_ItemEditModal" />
<div class="modal fade" id="addProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content ui-modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Thêm sản phẩm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="#" method="post" id="addProductForm">
                <div class="modal-body py-3">
                    <div class="mb-3">
                        <div id="productPicker" data-testid="order-product-picker"></div>
                    </div>
                    <div id="modalProductInfo" class="d-none">
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label small fw-medium text-muted" for="itemQuantity">Số lượng</label>
                                <input id="itemQuantity" name="itemProductQuantity" class="form-control no-additional-element" data-testid="order-item-quantity"
                                       data-decimal="quantity" value="1" autocomplete="off"
                                       data-val="true" data-val-required="Vui lòng nhập số lượng"
                                       data-val-range="Số lượng phải lớn hơn 0" data-val-range-min="0.0001"
                                       data-val-number="Số lượng phải là số" />
                                <span class="small text-danger field-validation-valid"
                                      data-valmsg-for="itemProductQuantity" data-valmsg-replace="true"></span>
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-medium text-muted noRefill" for="itemUnitPrice">Đơn giá</label>
                                <input id="itemUnitPrice" name="itemProductUnitPrice" class="form-control" data-testid="order-item-unit-price"
                                       data-decimal="currency" autocomplete="off"
                                       data-val="true" data-val-required="Vui lòng nhập đơn giá."
                                       data-val-range="Đơn giá phải lớn hơn 0" data-val-range-min="0.1"
                                       data-val-number="Đơn giá phải là số" />
                                <span class="small text-danger field-validation-valid"
                                      data-valmsg-for="itemProductUnitPrice" data-valmsg-replace="true"></span>
                            </div>
                        </div>
                        <button type="button" id="togglePriceHistoryBtn"
                                class="btn btn-outline-secondary btn-sm px-2 py-1 small d-none">
                            <i class="bi bi-clock-history me-1"></i><span id="togglePriceHistoryLabel">Lịch sử giá</span>
                        </button>
                        <div id="priceHistoryContainer" class="d-none">
                            <div class="border rounded-3">
                                <div class="table-responsive overflow-auto pe-3 order-price-history-scroll">
                                    <table class="table table-sm table-hover mb-0 small align-middle">
                                        <thead class="table-light text-muted">
                                            <tr>
                                                <th class="ps-3 fw-normal">Ngày</th>
                                                <th class="fw-normal">Nguồn</th>
                                                <th class="text-end pe-3 fw-normal">Giá bán</th>
                                            </tr>
                                        </thead>
                                        <tbody id="priceHistoryTableBodyContent"></tbody>
                                    </table>
                                </div>
                                <div id="priceHistoryLoading" class="text-center py-3 d-none">
                                    <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
                                </div>
                                <div id="priceHistoryEmpty" class="text-center py-2 text-muted small d-none">
                                    Chưa có lịch sử bán cho khách này, đang dùng giá mặc định.
                                </div>
                                <div class="border-top px-3 py-2 d-flex justify-content-end align-items-center">
                                    <button type="button" id="closePriceHistoryBtn" class="btn btn-outline-secondary btn-sm py-0 small">
                                        Đóng
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 pb-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" id="addItemToTable" class="btn btn-success d-none noDisabled" data-testid="order-add-item-submit">
                        <i class="bi bi-plus-lg me-1"></i> Thêm vào
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" id="quickCustomerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content ui-modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Thêm khách hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="QuickCreate" asp-controller="Customer" method="post" id="quickCreateCustomerForm" asp-antiforgery="true">
                <div class="modal-body py-3">
                    <div class="row g-3">
                        <div class="col-12 col-md-7">
                            <label class="form-label small fw-bold text-muted text-uppercase" for="quickCustomerFullName">Họ tên</label>
                            <input id="quickCustomerFullName" name="FullName" class="form-control" autocomplete="off" placeholder="Nhập họ và tên"
                                   data-val="true" data-val-maxlength="Họ tên không được vượt quá 200 ký tự."
                                   data-val-maxlength-max="200" data-val-required="Vui lòng nhập Họ tên." />
                            <span class="text-danger small field-validation-valid" data-valmsg-for="FullName" data-valmsg-replace="true"></span>
                        </div>
                        <div class="col-12 col-md-5">
                            <label class="form-label small fw-bold text-muted text-uppercase" for="quickCustomerPhone">Số điện thoại</label>
                            <input id="quickCustomerPhone" name="PhoneNumber" class="form-control" autocomplete="off" placeholder="Nhập số điện thoại"
                                   data-val="true" data-val-regex="Số điện thoại không hợp lệ." data-val-regex-pattern="0\d{9,10}"
                                   data-val-required="Vui lòng nhập Số điện thoại." />
                            <span class="text-danger small field-validation-valid" data-valmsg-for="PhoneNumber" data-valmsg-replace="true"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase" for="quickCustomerAddress">Địa chỉ</label>
                            <input id="quickCustomerAddress" name="Address" class="form-control" autocomplete="off" placeholder="Nhập địa chỉ"
                                   data-val="true" data-val-maxlength="Địa chỉ không được vượt quá 500 ký tự."
                                   data-val-maxlength-max="500" data-val-required="Vui lòng nhập Địa chỉ." />
                            <span class="text-danger small field-validation-valid" data-valmsg-for="Address" data-valmsg-replace="true"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase" for="quickCustomerEmail">Email</label>
                            <input id="quickCustomerEmail" name="Email" class="form-control" autocomplete="off" placeholder="Nhập email" />
                            <span class="text-danger small field-validation-valid" data-valmsg-for="Email" data-valmsg-replace="true"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 pb-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1"></i> Thêm khách hàng
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" id="quickProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content ui-modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Thêm hàng hóa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="QuickCreate" asp-controller="Product" method="post" id="quickCreateProductForm" asp-antiforgery="true">
                <input type="hidden" name="DisplayOrder" value="1" />
                <div class="modal-body py-3">
                    <div class="row g-3">
                        <div class="col-lg-8 order-lg-0">
                            <div class="row">
                                <div class="col-12 col-md-7">
                                    <label class="form-label small fw-bold text-muted text-uppercase" for="quickProductName">Tên hàng hóa</label>
                                    <input id="quickProductName" name="Name" class="form-control" autocomplete="off" placeholder="Nhập tên hàng hóa"
                                           data-val="true" data-val-maxlength="Tên hàng hóa không được vượt quá 200 ký tự."
                                           data-val-maxlength-max="200" data-val-required="Vui lòng nhập Tên hàng hóa." />
                                    <span class="text-danger small field-validation-valid" data-valmsg-for="Name" data-valmsg-replace="true"></span>
                                </div>
                                <div class="col-12 col-md-5">
                                    <label class="form-label small fw-bold text-muted text-uppercase" for="quickProductUnitPrice">Giá bán</label>
                                    <input id="quickProductUnitPrice" name="UnitPrice" class="form-control" data-decimal="currency" autocomplete="off" placeholder="Nhập giá bán" 
                                           data-val="true" data-val-required="Vui lòng nhập giá bán."
                                           data-val-range="Giá bán phải lớn hơn 0" data-val-range-min="0.1"
                                           data-val-number="Giá bán phải là số" / />
                                    <span class="text-danger small field-validation-valid" data-valmsg-for="UnitPrice" data-valmsg-replace="true"></span>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label small fw-bold text-muted text-uppercase" for="quickProductUnit">Đơn vị tính</label>
                                    <select id="quickProductUnit" name="UnitMeasurementId" class="form-select">
                                        <option value="">(Không chọn)</option>
                                        @if (Model.AvailableUnitMeasurements is not null)
                                        {
                                            foreach (var unitMeasurement in Model.AvailableUnitMeasurements)
                                            {
                                                <option value="@unitMeasurement.Id">@unitMeasurement.Name</option>
                                            }
                                        }
                                    </select>
                                    <span class="text-danger small field-validation-valid" data-valmsg-for="UnitMeasurementId" data-valmsg-replace="true"></span>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label small fw-bold text-muted text-uppercase" for="quickProductCategory">Danh mục</label>
                                    <select id="quickProductCategory" name="CategoryId" class="form-select">
                                        <option value="">(Không chọn)</option>
                                        @if (Model.AvailableCategories is not null)
                                        {
                                            foreach (var category in Model.AvailableCategories)
                                            {
                                                <option value="@category.Id">@category.Name</option>
                                            }
                                        }
                                    </select>
                                    <span class="text-danger small field-validation-valid" data-valmsg-for="CategoryId" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            @await Html.PartialAsync("_ImageUploader", new NamEcommerce.Web.Models.Common.ImageUploaderModel
                            {
                                FieldName = "PictureId",
                                Label = "Hình ảnh",
                                MaxFiles = 1,
                                Required = false
                            })
                        </div>
                        <div class="col-12">
                            <div class="form-label small fw-bold text-muted text-uppercase">Nhà cung cấp</div>
                            @if (Model.AvailableVendors?.Options.Any() == true)
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var vendor in Model.AvailableVendors)
                                    {
                                        <div class="form-check form-check-inline border rounded px-3 py-2">
                                            <input class="form-check-input" type="checkbox" name="VendorIds" value="@vendor.Id" id="quick_vendor_@vendor.Id" />
                                            <label class="form-check-label" for="quick_vendor_@vendor.Id">@vendor.Name</label>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-muted small">Chưa có nhà cung cấp.</div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 pb-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-plus-lg me-1"></i> Thêm hàng hóa
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module">
        import OrderController from "/modules/OrderController.js";
        new OrderController();
        const addProductContainer = document.getElementById('addProductModal');
        const addProductModal = bootstrap.Modal.getOrCreateInstance(addProductContainer);
        addProductContainer.addEventListener('hidden.bs.modal', () => {
        const searchInput = addProductContainer.querySelector('.productSearch');
        if (searchInput) searchInput.value = '';
        });
        document.addEventListener('order:itemAdded', () => {
        addProductModal.hide();
        });
    </script>
}
