@using NamEcommerce.Application.Contracts.Dtos.Finance
@model IReadOnlyList<BankAccountAppDto>
@{
    ViewData[ViewConstants.PageTitle] = "Tài khoản ngân hàng";
}

@section TitleSection {
    <h1 class="topbar-page-title">Tài khoản ngân hàng</h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="Setup" class="text-decoration-none">Kế toán</a></li>
                <li class="breadcrumb-item active">Tài khoản ngân hàng</li>
            </ol>
        </nav>
    </div>
    <div class="topbar-page-actions">
        <button class="btn btn-primary btn-sm" id="btnAddBankAccount">
            <i class="bi bi-plus-lg me-1"></i> Thêm tài khoản
        </button>
    </div>
}

<div class="content-card">
    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-bank2 fs-1 mb-3 d-block"></i>
            <p>Chưa có tài khoản ngân hàng nào. Thêm tài khoản để sử dụng sổ quỹ.</p>
        </div>
    }
    else
    {
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-muted small text-uppercase">
                <tr>
                    <th class="ps-3">Tên tài khoản</th>
                    <th>Số TK</th>
                    <th>Chủ TK</th>
                    <th class="text-end">Số dư đầu kỳ</th>
                    <th class="text-end">Số dư hiện tại</th>
                    <th class="text-end pe-3"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var acc in Model)
                {
                    <tr class="@(!acc.IsActive ? "table-secondary" : "")">
                        <td class="ps-3">
                            <div class="fw-semibold">@acc.DisplayName</div>
                            <div class="small text-muted">@acc.BankName &nbsp;·&nbsp; VietQR: @acc.BankCode &nbsp;·&nbsp; Mã: @acc.Code</div>
                            @if (acc.IsDefault) { <span class="badge bg-primary-subtle text-primary">Mặc định</span> }
                            @if (!acc.IsActive) { <span class="badge bg-secondary">Ngừng</span> }
                        </td>
                        <td class="font-monospace">@acc.AccountNumber</td>
                        <td>@acc.AccountHolderName</td>
                        <td class="text-end">@acc.OpeningBalance.ToString("N0")</td>
                        <td class="text-end fw-semibold">@acc.CurrentBalance.ToString("N0")</td>
                        <td class="text-end pe-3 text-nowrap">
                            <button class="btn btn-sm btn-outline-secondary me-1 btn-edit-account"
                                    data-id="@acc.Id"
                                    data-display-name="@acc.DisplayName"
                                    data-bank-code="@acc.BankCode"
                                    data-bank-name="@acc.BankName"
                                    data-account-number="@acc.AccountNumber"
                                    data-account-holder="@acc.AccountHolderName">
                                Sửa
                            </button>
                            @if (!acc.IsDefault)
                            {
                                <button class="btn btn-sm btn-outline-primary me-1 btn-set-default"
                                        data-id="@acc.Id">
                                    Đặt mặc định
                                </button>
                            }
                            @if (acc.IsActive && !acc.IsDefault)
                            {
                                <button class="btn btn-sm btn-outline-danger btn-deactivate"
                                        data-id="@acc.Id">
                                    Ngừng
                                </button>
                            }
                            @if (!acc.IsActive)
                            {
                                <button class="btn btn-sm btn-outline-success btn-activate"
                                        data-id="@acc.Id">
                                    Kích hoạt
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<!-- Modal thêm/sửa -->
<div class="modal fade" id="bankAccountModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="bankAccountModalTitle">Thêm tài khoản ngân hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="bankAccountId" value="" />
                <div class="mb-3">
                    <label class="form-label fw-medium">Tên hiển thị <span class="text-danger">*</span></label>
                    <input type="text" id="bankDisplayName" class="form-control" placeholder="VD: Vietcombank - CN Quận 1" />
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label fw-medium">Mã ngân hàng VietQR <span class="text-danger">*</span></label>
                        <input type="text" id="bankCode" class="form-control" placeholder="VD: VCB" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label fw-medium">Tên ngân hàng <span class="text-danger">*</span></label>
                        <input type="text" id="bankName" class="form-control" placeholder="VD: Vietcombank" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label fw-medium">Số tài khoản <span class="text-danger">*</span></label>
                        <input type="text" id="bankAccountNumber" class="form-control" placeholder="1234567890" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-medium">Chủ tài khoản <span class="text-danger">*</span></label>
                    <input type="text" id="bankAccountHolder" class="form-control" />
                </div>
                <div class="mb-3" id="openingBalanceSection">
                    <label class="form-label fw-medium">Số dư đầu kỳ</label>
                    <input type="number" id="bankOpeningBalance" class="form-control" value="0" min="0" />
                </div>
                <div class="form-check mb-2" id="setDefaultSection">
                    <input class="form-check-input" type="checkbox" id="bankSetDefault" />
                    <label class="form-check-label" for="bankSetDefault">Đặt làm tài khoản mặc định</label>
                </div>
                <div class="alert alert-danger d-none py-2 small" id="bankAccountError"></div>
            </div>
            <div class="modal-footer border-0 pt-0 pb-3">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="btnSaveBankAccount">Lưu</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

    async function postJson(url, data) {
        const resp = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify(data)
        });
        return resp.json();
    }

    // Add
    document.getElementById('btnAddBankAccount')?.addEventListener('click', () => {
        document.getElementById('bankAccountId').value = '';
        document.getElementById('bankAccountModalTitle').textContent = 'Thêm tài khoản ngân hàng';
        document.getElementById('bankDisplayName').value = '';
        document.getElementById('bankCode').value = '';
        document.getElementById('bankName').value = '';
        document.getElementById('bankAccountNumber').value = '';
        document.getElementById('bankAccountHolder').value = '';
        document.getElementById('bankOpeningBalance').value = '0';
        document.getElementById('openingBalanceSection').classList.remove('d-none');
        document.getElementById('setDefaultSection').classList.remove('d-none');
        document.getElementById('bankAccountError').classList.add('d-none');
        bootstrap.Modal.getOrCreateInstance(document.getElementById('bankAccountModal')).show();
    });

    // Edit
    document.querySelectorAll('.btn-edit-account').forEach(btn => {
        btn.addEventListener('click', () => {
            document.getElementById('bankAccountId').value = btn.dataset.id;
            document.getElementById('bankAccountModalTitle').textContent = 'Sửa tài khoản ngân hàng';
            document.getElementById('bankDisplayName').value = btn.dataset.displayName;
            document.getElementById('bankCode').value = btn.dataset.bankCode;
            document.getElementById('bankName').value = btn.dataset.bankName;
            document.getElementById('bankAccountNumber').value = btn.dataset.accountNumber;
            document.getElementById('bankAccountHolder').value = btn.dataset.accountHolder;
            document.getElementById('openingBalanceSection').classList.add('d-none');
            document.getElementById('setDefaultSection').classList.add('d-none');
            document.getElementById('bankAccountError').classList.add('d-none');
            bootstrap.Modal.getOrCreateInstance(document.getElementById('bankAccountModal')).show();
        });
    });

    // Save
    document.getElementById('btnSaveBankAccount')?.addEventListener('click', async () => {
        const id = document.getElementById('bankAccountId').value;
        const errorEl = document.getElementById('bankAccountError');
        errorEl.classList.add('d-none');
        let result;
        if (!id) {
            result = await postJson('@Url.Action("CreateBankAccount")', {
                displayName: document.getElementById('bankDisplayName').value,
                bankCode: document.getElementById('bankCode').value,
                bankName: document.getElementById('bankName').value,
                accountNumber: document.getElementById('bankAccountNumber').value,
                accountHolderName: document.getElementById('bankAccountHolder').value,
                openingBalance: parseFloat(document.getElementById('bankOpeningBalance').value) || 0,
                setAsDefault: document.getElementById('bankSetDefault').checked
            });
        } else {
            result = await postJson('@Url.Action("UpdateBankAccount")', {
                id,
                displayName: document.getElementById('bankDisplayName').value,
                bankCode: document.getElementById('bankCode').value,
                bankName: document.getElementById('bankName').value,
                accountNumber: document.getElementById('bankAccountNumber').value,
                accountHolderName: document.getElementById('bankAccountHolder').value
            });
        }
        if (result.success) location.reload();
        else { errorEl.textContent = result.message || 'Có lỗi xảy ra.'; errorEl.classList.remove('d-none'); }
    });

    // Set default / deactivate / activate
    document.querySelectorAll('.btn-set-default').forEach(btn => {
        btn.addEventListener('click', async () => {
            const result = await postJson('@Url.Action("SetDefaultBankAccount")', { id: btn.dataset.id });
            if (result.success) location.reload();
            else alert(result.message || 'Có lỗi.');
        });
    });
    document.querySelectorAll('.btn-deactivate').forEach(btn => {
        btn.addEventListener('click', async () => {
            if (!confirm('Ngừng sử dụng tài khoản này?')) return;
            const result = await postJson('@Url.Action("DeactivateBankAccount")', { id: btn.dataset.id });
            if (result.success) location.reload();
            else alert(result.message || 'Có lỗi.');
        });
    });
    document.querySelectorAll('.btn-activate').forEach(btn => {
        btn.addEventListener('click', async () => {
            const result = await postJson('@Url.Action("ActivateBankAccount")', { id: btn.dataset.id });
            if (result.success) location.reload();
            else alert(result.message || 'Có lỗi.');
        });
    });
    </script>
}
