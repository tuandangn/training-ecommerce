@using System.Globalization
@using NamEcommerce.Application.Contracts.Dtos.Finance
@model AccountingSetupAppDto
@{
    ViewData[ViewConstants.PageTitle] = "Khai báo kế toán";
    var taxRateOptions = new List<(string taxRateName, decimal taxRateValue)>
    {
        ("0% — Không chịu thuế GTGT", 0),
        ("5%", 0.05m),
        ("8%", 0.08m),
        ("10%", 0.10m)
    };
}

@section TitleSection {
    <h1 class="topbar-page-title">Khai báo kế toán</h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item active">Kế toán — Khai báo</li>
            </ol>
        </nav>
    </div>
}

@if (TempData["SuccessMessage"] is string successMsg)
{
    <div class="alert alert-success">@successMsg</div>
}

<div class="row">
    <div class="col-lg-7">

        @if (!Model.IsConfigured)
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                Chưa khai báo kế toán. Vui lòng nhập thông tin dưới đây để bắt đầu sử dụng tính năng kế toán.
            </div>
        }
        @if (Model.IsFinalized)
        {
            <div class="alert alert-success border-0">
                <i class="bi bi-lock-fill me-2"></i>
                Khai báo đã được <strong>xác nhận và khóa</strong> vào @Model.FinalizedOnUtc?.ToString(ViewConstants.DefaultDateTimeFormat).
                Chỉ có thể cập nhật ước tính thuế TNDN.
            </div>
        }
        <div asp-validation-summary="ModelOnly" class="alert alert-warning alert-global alert-dismissible long-time-waiting"></div>
        <div class="content-card p-4">
            <form asp-action="Setup" method="post">
                <fieldset @(Model.IsFinalized ? "disabled" : "")>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tháng bắt đầu năm tài chính</label>
                            <select asp-for="FiscalYearStartMonth" class="form-select">
                                @for (int m = 1; m <= 12; m++)
                                {
                                    <option value="@m" selected="@(Model.FiscalYearStartMonth == m)">Tháng @m</option>
                                }
                            </select>
                            <span asp-validation-for="FiscalYearStartMonth" class="small text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Ngày bắt đầu năm tài chính</label>
                            <select asp-for="FiscalYearStartDay" class="form-select">
                                @for (int d = 1; d <= 28; d++)
                                {
                                    <option value="@d" selected="@(Model.FiscalYearStartDay == d)">Ngày @d</option>
                                }
                            </select>
                            <span asp-validation-for="FiscalYearStartDay" class="small text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ngày bắt đầu sử dụng hệ thống kế toán <span class="text-danger">*</span></label>
                        <input type="date" asp-for="AccountingStartDate" class="form-control" required />
                        <span asp-validation-for="AccountingStartDate" class="small text-danger"></span>
                        <div class="form-text">Số liệu trước ngày này sẽ không được đưa vào báo cáo.</div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tiền mặt quỹ đầu kỳ (TK 111)</label>
                            <input asp-for="OpeningCash" value="@Model.OpeningCash.DisplayCurrency()" class="form-control no-additional-element" data-decimal="currency" />
                            <span asp-validation-for="OpeningCash" class="small text-danger"></span>
                            <div class="form-text">Tiền mặt tại cửa hàng tại thời điểm bắt đầu.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Vốn chủ sở hữu đầu kỳ (TK 411+421)</label>
                            <input asp-for="OpeningEquity" value="@Model.OpeningEquity.DisplayCurrency()" class="form-control no-additional-element" data-decimal="currency" />
                            <span asp-validation-for="OpeningEquity" class="small text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Thuế GTGT mặc định</label>
                        <select asp-for="DefaultTaxRate" class="form-select">
                            @foreach (var opt in taxRateOptions)
                            {
                                <option value="@opt.taxRateValue.ToString(CultureInfo.InvariantCulture)" selected="@(Model.DefaultTaxRate == opt.taxRateValue)">@opt.taxRateName</option>
                            }
                        </select>
                        <span asp-validation-for="DefaultTaxRate" class="small text-danger"></span>
                        <div class="form-text">Giá trị mặc định khi lập phiếu — có thể thay đổi từng dòng.</div>
                    </div>

                    <div class="alert alert-light border small">
                        <strong>Lưu ý:</strong>
                        <ul class="mb-0 mt-1">
                            <li>Nợ phải thu KH đầu kỳ → nhập tại <a asp-controller="CustomerDebt" asp-action="Create">Công nợ KH</a></li>
                            <li>Nợ phải trả NCC đầu kỳ → nhập tại <a asp-controller="VendorDebt" asp-action="Create">Công nợ NCC</a></li>
                            <li>Hàng tồn kho đầu kỳ → nhập tại <a asp-controller="GoodsReceipt" asp-action="Create">Nhập hàng</a></li>
                            <li>Tài khoản ngân hàng → nhập tại <a asp-action="BankAccounts">Tài khoản NH</a></li>
                        </ul>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i> Lưu khai báo
                        </button>
                        @if (Model.IsConfigured && !Model.IsFinalized)
                        {
                            <button type="button" class="btn btn-outline-success" id="btnFinalize">
                                <i class="bi bi-lock me-1"></i> Xác nhận & Khóa
                            </button>
                        }
                    </div>
                </fieldset>
            </form>
        </div>

        @if (Model.IsFinalized)
        {
            <div class="content-card p-4 mt-4">
                <h6 class="fw-bold mb-3">Ước tính thuế TNDN kỳ này (TK 821)</h6>
                <div class="input-group ui-max-w-300">
                    <input type="number" id="provisionInput" class="form-control"
                           value="@Model.CorporateTaxProvision" placeholder="0" min="0" step="1000" />
                    <button class="btn btn-outline-primary" id="btnUpdateProvision">Cập nhật</button>
                </div>
                <div class="form-text">Nhập thủ công. Ảnh hưởng đến B02 dòng thuế TNDN và B01 TK 3334.</div>
            </div>
        }
    </div>
</div>

@if (Model.IsConfigured && !Model.IsFinalized)
{
    <form class="d-none" id="finalizeForm" asp-action="Finalize" method="post">
    </form>
}

@if (Model.IsFinalized)
{
    @section Scripts {
        <script>
            document.getElementById('btnUpdateProvision')?.addEventListener('click', async function() {
                const amount = parseFloat(document.getElementById('provisionInput').value) || null;
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const resp = await fetch('@Url.Action("UpdateProvision")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token ?? '' },
                    body: JSON.stringify({ amount })
                });
                const data = await resp.json();
                if (data.success) alert('Đã cập nhật thuế TNDN.');
                else alert(data.message || 'Có lỗi xảy ra.');
            });
        </script>
    }
}
else
{
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
        @if (Model.IsConfigured)
        {
            <script>
                document.getElementById('btnFinalize')?.addEventListener('click', function() {
                    if (confirm('Sau khi xác nhận, bạn sẽ không thể sửa các số liệu đầu kỳ. Tiếp tục?')) {
                        document.getElementById('finalizeForm').submit();
                    }
                });
            </script>
        }
    }
}
