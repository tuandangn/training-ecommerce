@using NamEcommerce.Application.Contracts.Dtos.CustomerPortal
@using NamEcommerce.Domain.Shared.Enums.CustomerPortal
@model IReadOnlyCollection<CustomerPortalPaymentIntentAdminAppDto>
@{
    ViewData[ViewConstants.PageTitle] = "Thanh toán online từ portal";
    var status = ViewData["Status"] as int?;
}

<div class="page-header">
    <div class="d-flex align-items-center">
        <a asp-action="Index" class="btn btn-icon btn-outline-secondary me-3 shadow-sm border"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h1 class="page-header-title">Thanh toán online từ portal</h1>
            <p class="page-header-subtitle">Mock payment thành công chỉ ghi nhận sau khi admin đối soát</p>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="PaymentIntents" class="btn btn-outline-secondary">Tất cả</a>
        <a asp-action="PaymentIntents" asp-route-status="@((int)CustomerPaymentIntentStatus.SucceededPendingReconciliation)" class="btn btn-primary">Chờ đối soát</a>
    </div>
</div>

<div class="content-card">
    <div class="table-responsive">
        <table class="table data-table align-middle">
            <thead>
                <tr>
                    <th class="ps-4">Khách hàng</th>
                    <th>Phiếu nợ</th>
                    <th>Provider</th>
                    <th class="text-end">Số tiền</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-center">Ngày tạo</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                var paymentStatus = (CustomerPaymentIntentStatus)item.Status;
                <tr>
                    <td class="ps-4">
                        <div class="fw-medium">@item.CustomerName</div>
                        <div class="text-muted small">@item.CustomerPhone</div>
                    </td>
                    <td class="text-muted small">@item.CustomerDebtCode</td>
                    <td class="text-muted small">@item.Provider</td>
                    <td class="text-end fw-bold text-danger">@item.Amount.ToString(ViewConstants.CurrencyDisplayFormat)</td>
                    <td class="text-center"><span class="badge @paymentStatus.GetDisplayColor()">@paymentStatus.GetDisplayText()</span></td>
                    <td class="text-center text-muted small">@item.CreatedOnUtc.ToLocalTime().ToString(ViewConstants.DefaultDateTimeFormat)</td>
                    <td class="text-end pe-3">
                        <a asp-action="PaymentIntentDetails" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Xem</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7"><div class="empty-state py-5 text-muted">Không có thanh toán@(status.HasValue ? " phù hợp" : "")</div></td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
