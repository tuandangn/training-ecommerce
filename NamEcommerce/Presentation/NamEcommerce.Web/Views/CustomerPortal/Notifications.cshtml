@using NamEcommerce.Application.Contracts.Dtos.CustomerPortal
@using NamEcommerce.Domain.Shared.Enums.CustomerPortal
@model IReadOnlyCollection<CustomerPortalNotificationAdminAppDto>
@{
    ViewData[ViewConstants.PageTitle] = "Thông báo Customer Portal";
    var status = ViewData["Status"] as int?;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="page-header">
    <div class="d-flex align-items-center">
        <a asp-action="Index" class="btn btn-icon btn-light me-3 shadow-sm border"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h1 class="page-header-title">Thông báo Customer Portal</h1>
            <p class="page-header-subtitle">Các hoạt động khách vừa gửi cần admin kiểm tra và xử lý</p>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Notifications" class="btn btn-outline-secondary">Tất cả</a>
        <a asp-action="Notifications" asp-route-status="@((int)CustomerPortalNotificationStatus.Unread)" class="btn btn-primary">Chưa đọc</a>
    </div>
</div>

<div class="content-card">
    <div class="table-responsive">
        <table class="table data-table align-middle">
            <thead>
                <tr>
                    <th class="ps-4">Loại</th>
                    <th>Nội dung</th>
                    <th>Khách hàng</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-center">Thời gian</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                var notificationType = (CustomerPortalNotificationType)item.Type;
                var notificationStatus = (CustomerPortalNotificationStatus)item.Status;
                <tr class="@(notificationStatus == CustomerPortalNotificationStatus.Unread ? "table-warning" : "")">
                    <td class="ps-4"><span class="badge @notificationType.GetDisplayColor()">@notificationType.GetDisplayText()</span></td>
                    <td>
                        <div class="fw-semibold">@item.Title</div>
                        <div class="text-muted small text-truncate" style="max-width:540px">@item.Message</div>
                    </td>
                    <td>
                        <div class="fw-medium">@item.CustomerName</div>
                        <div class="text-muted small">@item.CustomerPhone</div>
                    </td>
                    <td class="text-center"><span class="badge @notificationStatus.GetDisplayColor()">@notificationStatus.GetDisplayText()</span></td>
                    <td class="text-center text-muted small">@item.CreatedOnUtc.ToLocalTime().ToString(ViewConstants.DefaultDateTimeFormat)</td>
                    <td class="text-end pe-3">
                        <form asp-action="OpenNotification" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-light text-primary">Xử lý</button>
                        </form>
                        @if (notificationStatus == CustomerPortalNotificationStatus.Unread)
                        {
                            <form asp-action="MarkNotificationRead" method="post" class="d-inline ms-1">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Đã đọc</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6"><div class="empty-state py-5 text-muted">Không có thông báo@(status.HasValue ? " phù hợp" : "")</div></td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

