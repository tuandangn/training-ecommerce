@using NamEcommerce.Application.Contracts.Dtos.CustomerPortal
@using NamEcommerce.Domain.Shared.Enums.CustomerPortal
@model IReadOnlyCollection<CustomerPortalReturnRequestAdminAppDto>
@{
    ViewData[ViewConstants.PageTitle] = "Yêu cầu trả hàng từ portal";
    var status = ViewData["Status"] as int?;
}

<div class="page-header">
    <div class="d-flex align-items-center">
        <a asp-action="Index" class="btn btn-icon btn-outline-secondary me-3 shadow-sm border"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h1 class="page-header-title">Yêu cầu trả hàng từ portal</h1>
            <p class="page-header-subtitle">Khách tạo yêu cầu trả hàng, admin xem xét trước khi xử lý nội bộ</p>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ReturnRequests" class="btn btn-outline-secondary">Tất cả</a>
        <a asp-action="ReturnRequests" asp-route-status="@((int)CustomerReturnRequestStatus.PendingReview)" class="btn btn-primary">Chờ xem xét</a>
    </div>
</div>

<div class="content-card">
    <div class="table-responsive">
        <table class="table data-table align-middle">
            <thead>
                <tr>
                    <th class="ps-4">Khách hàng</th>
                    <th>Phiếu giao</th>
                    <th>Lý do</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-center">Ngày tạo</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                var requestStatus = (CustomerReturnRequestStatus)item.Status;
                <tr>
                    <td class="ps-4">
                        <div class="fw-medium">@item.CustomerName</div>
                        <div class="text-muted small">@item.CustomerPhone</div>
                    </td>
                    <td class="text-muted small">@item.DeliveryNoteCode</td>
                    <td class="text-truncate ui-max-w-320">@item.Reason</td>
                    <td class="text-center"><span class="badge @requestStatus.GetDisplayColor()">@requestStatus.GetDisplayText()</span></td>
                    <td class="text-center text-muted small">@item.CreatedOnUtc.ToLocalTime().ToString(ViewConstants.DefaultDateTimeFormat)</td>
                    <td class="text-end pe-3">
                        <a asp-action="ReturnRequestDetails" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary text-primary">Xem</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6"><div class="empty-state py-5 text-muted">Không có yêu cầu trả hàng@(status.HasValue ? " phù hợp" : "")</div></td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
