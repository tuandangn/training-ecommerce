@using NamEcommerce.Application.Contracts.Dtos.CustomerPortal
@using NamEcommerce.Application.Contracts.Dtos.Inventory
@using NamEcommerce.Domain.Shared.Enums.CustomerPortal
@using System.Globalization
@model CustomerPortalReturnRequestAdminAppDto
@{
    ViewData[ViewConstants.PageTitle] = $"Yêu cầu trả hàng {Model.DeliveryNoteCode}";
    var status = (CustomerReturnRequestStatus)Model.Status;
    var returnUrl = Context.Request.Path.ToString() + Context.Request.QueryString.ToString();
    var warehouses = ViewBag.Warehouses as IReadOnlyCollection<WarehouseAppDto> ?? Array.Empty<WarehouseAppDto>();
    var invariantCulture = CultureInfo.InvariantCulture;
}

<div class="page-header">
    <div class="d-flex align-items-center">
        <a asp-action="ReturnRequests" class="btn btn-icon btn-outline-secondary me-3 shadow-sm border"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h1 class="page-header-title">Yêu cầu trả hàng</h1>
            <p class="page-header-subtitle">@Model.CustomerName · Phiếu giao @Model.DeliveryNoteCode</p>
        </div>
    </div>
    <span class="badge @status.GetDisplayColor() fs-6">@status.GetDisplayText()</span>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="content-card">
            <div class="action-toolbar">
                <h6 class="mb-0 fw-bold">Hàng khách muốn trả</h6>
                <a asp-controller="DeliveryNote" asp-action="Details" asp-route-id="@Model.DeliveryNoteId" class="btn btn-sm btn-outline-secondary">Xem phiếu giao</a>
            </div>
            <div class="table-responsive">
                <table class="table data-table align-middle">
                    <thead>
                        <tr>
                            <th class="ps-4">Sản phẩm</th>
                            <th class="text-end">SL yêu cầu</th>
                            <th>Lý do từng dòng</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="ps-4 fw-medium">@item.ProductName</td>
                            <td class="text-end">@item.RequestedQuantity</td>
                            <td>
                                <div class="text-muted">@(!string.IsNullOrWhiteSpace(item.Reason) ? item.Reason : "—")</div>
                                @if (item.EvidencePictures.Count > 0)
                                {
                                    <div class="d-flex flex-wrap gap-2 mt-2">
                                        @foreach (var picture in item.EvidencePictures)
                                        {
                                            if (!string.IsNullOrWhiteSpace(picture.PictureUrl))
                                            {
                                                <a href="@picture.PictureUrl" target="_blank" rel="noopener" class="d-inline-block border rounded overflow-hidden" title="@picture.FileName">
                                                    <img class="ui-size-88 object-fit-cover" src="@picture.PictureUrl" alt="Ảnh hiện trạng @item.ProductName" />
                                                </a>
                                            }
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="content-card p-4 mb-4">
            <h6 class="fw-bold mb-3">Khách hàng</h6>
            <div class="fw-semibold">@Model.CustomerName</div>
            <div class="text-muted small mb-3">@Model.CustomerPhone</div>
            <form asp-action="BlockAccount" method="post">
                <input type="hidden" name="customerId" value="@Model.CustomerId" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button type="submit" class="btn btn-sm btn-outline-danger">
                    <i class="bi bi-shield-lock me-1"></i>Khóa khách này
                </button>
            </form>
        </div>
        <div class="content-card p-4 mb-4">
            <h6 class="fw-bold mb-3">Lý do khách gửi</h6>
            <div>@(!string.IsNullOrWhiteSpace(Model.Reason) ? Model.Reason : "—")</div>
        </div>
        @if (Model.CompensateInNextDelivery)
        {
            <div class="alert alert-info border-0 rounded-3 mb-4">
                Khách muốn bù số lượng trả lại vào lần giao sau.
            </div>
        }
        @if (status == CustomerReturnRequestStatus.PendingReview)
        {
            <div class="content-card p-4">
                <h6 class="fw-bold mb-3">Xem xét yêu cầu</h6>
                <form asp-action="AcceptReturnRequest" method="post" class="mb-3">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <textarea name="adminNote" class="form-control mb-2" rows="2" placeholder="Ghi chú nội bộ"></textarea>
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check2-circle me-1"></i>Chấp nhận</button>
                </form>
                <form asp-action="RejectReturnRequest" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <textarea name="adminNote" class="form-control mb-2" rows="2" placeholder="Lý do từ chối"></textarea>
                    <button type="submit" class="btn btn-outline-danger w-100">Từ chối</button>
                </form>
            </div>
        }
        else if (status == CustomerReturnRequestStatus.Accepted)
        {
            <div class="content-card p-4">
                <h6 class="fw-bold mb-3">Tạo phiếu trả nội bộ</h6>
                <form asp-action="ConvertReturnRequest" method="post" id="convertReturnRequestForm">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase">Kho nhận</label>
                        <select name="warehouseId" class="form-select" required>
                            <option value="">Chọn kho nhận hàng trả</option>
                            @foreach (var warehouse in warehouses)
                            {
                                <option value="@warehouse.Id">@warehouse.Name</option>
                            }
                        </select>
                    </div>
                    <div class="table-responsive mb-3">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Hàng hóa</th>
                                    <th class="text-end ui-w-92">Khách yêu cầu</th>
                                    <th class="text-end ui-w-120">Thực nhận</th>
                                    <th class="text-end ui-w-120">Đơn giá hoàn</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    var defaultReturnPrice = item.OriginalUnitPrice ?? 0;
                                    <tr>
                                        <td>
                                            <input type="hidden" name="itemIds" value="@item.Id" />
                                            <div class="fw-medium">@item.ProductName</div>
                                            <div class="text-muted small">
                                                Giá giao: @(item.OriginalUnitPrice.HasValue ? item.OriginalUnitPrice.Value.DisplayCurrency() : "—")
                                            </div>
                                        </td>
                                        <td class="text-end text-muted">@item.RequestedQuantity.DisplayQuantity()</td>
                                        <td>
                                            <input name="acceptedQuantities"
                                                   class="form-control form-control-sm text-end js-return-qty"
                                                   type="number"
                                                   min="0"
                                                   max="@item.RequestedQuantity.ToString("0.###", invariantCulture)"
                                                   step="0.001"
                                                   value="@item.RequestedQuantity.ToString("0.###", invariantCulture)"
                                                   required />
                                        </td>
                                        <td>
                                            <input name="returnUnitPrices"
                                                   class="form-control form-control-sm text-end js-return-price"
                                                   type="number"
                                                   min="0"
                                                   step="0.01"
                                                   value="@defaultReturnPrice.ToString("0.##", invariantCulture)"
                                                   required />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase">Chi phí phát sinh</label>
                        <input name="additionalCost"
                               class="form-control text-end js-additional-cost"
                               type="number"
                               min="0"
                               step="0.01"
                               value="0" />
                        <div class="form-text">Khoản này sẽ trừ vào số tiền hoàn/cấn trừ công nợ khách.</div>
                    </div>
                    <div class="alert alert-light border d-flex justify-content-between align-items-center py-2">
                        <span class="text-muted small">Dự kiến hoàn/cấn trừ công nợ</span>
                        <strong id="convertReturnTotal">0</strong>
                    </div>
                    <textarea name="adminNote" class="form-control mb-2" rows="2" placeholder="Ghi chú khi tạo phiếu trả"></textarea>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-arrow-right-circle me-1"></i>Tạo phiếu trả
                    </button>
                </form>
            </div>
        }
        else if (status == CustomerReturnRequestStatus.ConvertedToReturn && Model.ConvertedCustomerReturnId.HasValue)
        {
            <div class="content-card p-4">
                <h6 class="fw-bold mb-3">Phiếu trả đã tạo</h6>
                <a asp-controller="CustomerReturn" asp-action="Details" asp-route-id="@Model.ConvertedCustomerReturnId" class="btn btn-primary w-100">
                    Xem phiếu trả
                </a>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.AdminNote))
        {
            <div class="content-card p-4">
                <h6 class="fw-bold mb-2">Ghi chú admin</h6>
                <div class="text-muted">@Model.AdminNote</div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById('convertReturnRequestForm');
            if (!form) return;

            const totalEl = document.getElementById('convertReturnTotal');
            const formatter = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND', maximumFractionDigits: 0 });
            const parseNumber = value => {
                const parsed = Number(String(value || '').replace(',', '.'));
                return Number.isFinite(parsed) ? parsed : 0;
            };
            const recalculate = () => {
                const quantities = Array.from(form.querySelectorAll('.js-return-qty'));
                const prices = Array.from(form.querySelectorAll('.js-return-price'));
                const gross = quantities.reduce((sum, input, index) =>
                    sum + parseNumber(input.value) * parseNumber(prices[index]?.value), 0);
                const additionalCost = parseNumber(form.querySelector('.js-additional-cost')?.value);
                totalEl.textContent = formatter.format(Math.max(0, gross - additionalCost));
            };

            form.addEventListener('input', recalculate);
            recalculate();
        })();
    </script>
}
