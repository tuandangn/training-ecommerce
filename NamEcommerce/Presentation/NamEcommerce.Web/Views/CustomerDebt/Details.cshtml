@using NamEcommerce.Domain.Shared.Enums.Debts
@using NamEcommerce.Domain.Shared.Enums.Orders
@using NamEcommerce.Web.Contracts.Models.Debts
@using NamEcommerce.Web.Extensions
@model CustomerLedgerDetailsModel
@{
    ViewData[ViewConstants.PageTitle] = $"Sao kê: {Model.CustomerName}";
    var isCredit = Model.Balance < 0;
    var isDebt = Model.Balance > 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/debt.css" asp-append-version="true" />
}

<div class="page-header">
    <div class="d-flex align-items-center">
        <a asp-action="List" class="btn btn-icon btn-outline-secondary me-3 shadow-sm border">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h1 class="page-header-title">@Model.CustomerName</h1>
            <p class="page-header-subtitle mb-0">Sao kê công nợ</p>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center debt-page-actions">
        @if (isCredit)
        {
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-6 fw-bold">
                <i class="bi bi-arrow-down-circle me-1"></i>
                Khách dư @(Math.Abs(Model.Balance).ToString(ViewConstants.CurrencyDisplayFormat))
            </span>
            <a asp-controller="CustomerRefund" asp-action="Create" asp-route-customerId="@Model.CustomerId"
               class="btn btn-outline-success shadow-sm border">
                <i class="bi bi-cash-coin me-1"></i> Tạo phiếu hoàn tiền
            </a>
        }
        <button type="button" class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#recordPaymentModal">
            <i class="bi bi-cash-coin me-1"></i> Thu tiền
        </button>
    </div>
</div>

@* ── Summary cards ── *@
<div class="row g-3 mb-4">
    <div class="col-12 col-lg-4">
        <div class="card debt-summary-card text-center @(isDebt ? "border-danger border" : isCredit ? "border-success border" : "")">
            <div class="debt-summary-label">Số dư công nợ</div>
            @if (isDebt)
            {
                <div class="debt-summary-value debt-summary-value-lg text-danger">@Model.Balance.ToString(ViewConstants.CurrencyDisplayFormat)</div>
                <div class="small text-danger mt-1">Khách còn nợ</div>
            }
            else if (isCredit)
            {
                <div class="debt-summary-value debt-summary-value-lg text-success">@(Math.Abs(Model.Balance).ToString(ViewConstants.CurrencyDisplayFormat))</div>
                <div class="small text-success mt-1">Khách dư — cửa hàng nợ khách</div>
            }
            else
            {
                <div class="debt-summary-value debt-summary-value-lg text-muted">0</div>
                <div class="small text-muted mt-1">Đã thanh toán đủ</div>
            }
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card debt-summary-card text-center">
            <div class="debt-summary-label">Giao dịch cuối</div>
            <div class="debt-summary-value">
                @(Model.LastEntryOnUtc.HasValue ? Model.LastEntryOnUtc.Value.ToLocalTime().ToString(ViewConstants.DefaultDateFormat) : "—")
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card debt-summary-card text-center">
            <div class="debt-summary-label">Tổng giao dịch</div>
            <div class="debt-summary-value">@Model.TotalCount</div>
        </div>
    </div>
</div>

@* ── Sao kê ── *@
<div class="card debt-ledger-card mb-4">
    <div class="card-header bg-white border-bottom py-3 px-4">
        <h6 class="mb-0 fw-bold text-uppercase small text-muted">Sao kê giao dịch</h6>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="bg-light bg-opacity-50">
                <tr>
                    <th class="ps-4 border-0 small text-uppercase text-muted fw-bold">Ngày</th>
                    <th class="border-0 small text-uppercase text-muted fw-bold">Loại</th>
                    <th class="border-0 small text-uppercase text-muted fw-bold">Chứng từ</th>
                    <th class="text-end border-0 small text-uppercase text-muted fw-bold">Phát sinh nợ</th>
                    <th class="text-end border-0 small text-uppercase text-muted fw-bold">Phát sinh có</th>
                    <th class="text-end border-0 small text-uppercase text-muted fw-bold pe-4">Số dư</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.Statement)
                {
                    var entryType = (CustomerLedgerEntryType)entry.EntryType;
                    var refType = (CustomerLedgerReferenceType)entry.ReferenceType;
                    var isCharge = entry.Amount > 0;
                    <tr>
                        <td class="ps-4 text-muted small text-nowrap">
                            @entry.OccurredAtUtc.ToLocalTime().ToString(ViewConstants.DefaultDateFormat)
                        </td>
                        <td>
                            @{
                                var (badgeClass, label) = entryType switch
                                {
                                    CustomerLedgerEntryType.DeliveryNoteCharge => ("bg-danger-subtle text-danger", "Giao hàng"),
                                    CustomerLedgerEntryType.OpeningBalance => ("bg-secondary-subtle text-secondary", "Đầu kỳ"),
                                    CustomerLedgerEntryType.Payment => ("bg-success-subtle text-success", "Thu tiền"),
                                    CustomerLedgerEntryType.ReturnCredit => ("bg-info-subtle text-info", "Trả hàng"),
                                    CustomerLedgerEntryType.RefundPayout => ("bg-warning-subtle text-warning", "Hoàn tiền"),
                                    CustomerLedgerEntryType.Correction => ("bg-secondary-subtle text-secondary", "Điều chỉnh"),
                                    _ => ("bg-light text-muted", entryType.ToString())
                                };
                            }
                            <span class="badge @badgeClass fw-normal">@label</span>
                        </td>
                        <td>
                            @if (entry.ReferenceId.HasValue && !string.IsNullOrEmpty(entry.ReferenceCode))
                            {
                                @if (refType == CustomerLedgerReferenceType.DeliveryNote)
                                {
                                    <a asp-controller="DeliveryNote" asp-action="Details" asp-route-id="@entry.ReferenceId"
                                       class="text-decoration-none fw-medium">@entry.ReferenceCode</a>
                                }
                                else if (refType == CustomerLedgerReferenceType.CustomerReturn)
                                {
                                    <a asp-controller="CustomerReturn" asp-action="Details" asp-route-id="@entry.ReferenceId"
                                       class="text-decoration-none fw-medium">@entry.ReferenceCode</a>
                                }
                                else if (refType == CustomerLedgerReferenceType.CustomerPayment)
                                {
                                    <a asp-action="Receipt" asp-route-paymentId="@entry.ReferenceId" target="_blank"
                                       class="text-decoration-none fw-medium">@entry.ReferenceCode</a>
                                }
                                else
                                {
                                    <span class="fw-medium">@entry.ReferenceCode</span>
                                }
                            }
                            @if (!string.IsNullOrEmpty(entry.Note))
                            {
                                <div class="text-muted small fst-italic">@entry.Note</div>
                            }
                        </td>
                        <td class="text-end">
                            @if (isCharge)
                            {
                                <span class="fw-bold text-danger">@entry.Amount.ToString(ViewConstants.CurrencyDisplayFormat)</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (!isCharge)
                            {
                                <span class="fw-bold text-success">@(Math.Abs(entry.Amount).ToString(ViewConstants.CurrencyDisplayFormat))</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-end pe-4 fw-bold @(entry.RunningBalance > 0 ? "text-danger" : entry.RunningBalance < 0 ? "text-success" : "text-muted")">
                            @entry.RunningBalance.ToString(ViewConstants.CurrencyDisplayFormat)
                        </td>
                    </tr>
                }
                @if (!Model.Statement.Any())
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state py-5">
                                <div class="empty-icon"><i class="bi bi-journal-text"></i></div>
                                <h5>Chưa có giao dịch nào</h5>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalCount > 50)
    {
        <div class="card-footer bg-light border-top py-3 px-4 d-flex justify-content-center gap-2">
            @if (Model.PageIndex > 1)
            {
                <a asp-action="Details" asp-route-id="@Model.CustomerId" asp-route-pageIndex="@(Model.PageIndex - 1)"
                   class="btn btn-sm btn-outline-secondary rounded-3">
                    <i class="bi bi-chevron-left me-1"></i>Trước
                </a>
            }
            <span class="btn btn-sm btn-outline-secondary border rounded-3 disabled">
                Trang @Model.PageIndex
            </span>
            @if (Model.TotalCount > Model.PageIndex * 50)
            {
                <a asp-action="Details" asp-route-id="@Model.CustomerId" asp-route-pageIndex="@(Model.PageIndex + 1)"
                   class="btn btn-sm btn-outline-secondary rounded-3">
                    Sau<i class="bi bi-chevron-right ms-1"></i>
                </a>
            }
        </div>
    }
</div>

@* ── Modal thu tiền (đơn giản hóa) ── *@
<div class="modal fade" id="recordPaymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content debt-modal-content">
            <div class="modal-header bg-white border-bottom-0 pt-4 px-4 pb-0">
                <h5 class="modal-title fw-bold">Thu tiền — @Model.CustomerName</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="recordPaymentForm">
                <input type="hidden" name="customerId" value="@Model.CustomerId" />
                <div class="modal-body p-4">
                    @if (isDebt)
                    {
                        <div class="alert alert-warning border-0 rounded-3 small mb-4">
                            <i class="bi bi-info-circle me-2"></i>
                            Số dư còn nợ: <strong class="text-danger">@Model.Balance.ToString(ViewConstants.CurrencyDisplayFormat)</strong>
                        </div>
                    }
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-2">
                                Số tiền thu <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-lg bg-light rounded-3 border">
                                <input class="form-control bg-transparent border-0 fw-bold text-primary"
                                       type="number" step="1000" name="amount" inputmode="numeric"
                                       value="@(isDebt ? Model.Balance.DisplayCurrency() : "")"
                                       required />
                                <span class="input-group-text bg-transparent border-0 fw-bold text-primary">đ</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-2">Phương thức</label>
                            <div class="debt-payment-methods">
                                <input type="radio" class="btn-check" name="paymentMethod" id="methodCash" value="@((int)PaymentMethod.Cash)" checked>
                                <label class="btn btn-outline-secondary w-100 py-2 rounded-3" for="methodCash">
                                    <i class="bi bi-cash-stack me-1"></i>Tiền mặt
                                </label>
                                <input type="radio" class="btn-check" name="paymentMethod" id="methodBank" value="@((int)PaymentMethod.BankTransfer)">
                                <label class="btn btn-outline-secondary w-100 py-2 rounded-3" for="methodBank">
                                    <i class="bi bi-bank me-1"></i>Chuyển khoản
                                </label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-2">Ngày thu</label>
                            <input type="datetime-local" class="form-control rounded-3" name="paidOnUtc"
                                   value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-2">Ghi chú</label>
                            <textarea class="form-control rounded-3" name="note" rows="2"
                                      placeholder="VD: Khách trả qua tài khoản TCB..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top-0 p-4">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-3 border" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" id="btnSubmitPayment" class="btn btn-primary px-4 rounded-3 shadow-sm fw-bold">
                        <i class="bi bi-check2-circle me-1"></i>Xác nhận thu tiền
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module">
        import { toast } from "/modules/modals.js";

        (function () {
            const form = document.getElementById('recordPaymentForm');
            const submitBtn = document.getElementById('btnSubmitPayment');

            $(form).on('submit', async function (e) {
                e.preventDefault();
                if (!form.checkValidity()) { form.reportValidity(); return; }

                submitBtn.disabled = true;
                const originalText = submitBtn.innerHTML;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý...';

                try {
                    const response = await $.ajax({
                        url: '@Url.Action("RecordPayment")',
                        type: 'POST',
                        data: $(form).serialize()
                    });

                    if (response.success) {
                        toast('Thành công', response.message, 'success');
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        toast('Lỗi', response.message, 'error');
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalText;
                    }
                } catch {
                    toast('Lỗi', 'Có lỗi xảy ra trong quá trình xử lý.', 'error');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                }
            });
        })();
    </script>
}
