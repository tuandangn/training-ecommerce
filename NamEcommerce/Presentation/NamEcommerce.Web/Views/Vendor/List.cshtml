@using System.Text.Encodings.Web
@inject UrlEncoder MyUrlEncoder
@model VendorListModel
@{
    ViewData[ViewConstants.PageTitle] = "Nhà cung cấp";
    string? query = Model.Keywords;
}

@section TitleSection {
    <h1 class="topbar-page-title">Nhà cung cấp</h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Nhà cung cấp</li>
            </ol>
        </nav>
    </div>
}

<div class="content-card" data-responsive-list data-list-key="vendor-list">
    <div class="action-toolbar">
        <partial name="_Search" model="@(new VendorListSearchModel { Keywords = Model.Keywords })" />
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Thêm mới
        </a>
        <partial name="_ResponsiveListToolbar" />
    </div>

    <div class="responsive-list-panel" data-list-view-panel="list">
        <div class="table-responsive">
        <table class="table data-table">
            <thead>
                <tr>
                    <th class="ps-4">Nhà cung cấp</th>
                    <th><i class="bi bi-phone me-1"></i>Điện thoại</th>
                    <th class="d-none d-md-table-cell"><i class="bi bi-map me-1"></i>Địa chỉ</th>
                    <th class="text-center" style="width: 100px;">Thứ tự</th>
                    <th style="width: 100px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Data.Pagination.TotalCount > 0)
                {
                    @foreach (var item in Model.Data)
                    {
                        <tr>
                            <td class="ps-4 fw-medium">@HighlighHelper.Highlight(item.Name, query)</td>
                            <td>
                                <a href="tel:@item.PhoneNumber" class="text-decoration-none text-muted">
                                    <i class="bi bi-telephone me-1"></i>
                                    @HighlighHelper.Highlight(item.PhoneNumber, query)
                                </a>
                            </td>
                            <td class="d-none d-md-table-cell">
                                @if (!string.IsNullOrEmpty(item.Address))
                                {
                                    var encodedAddress = MyUrlEncoder.Encode(item.Address);
                                    <a href="https://www.google.com/maps/search/@encodedAddress" target="_blank"
                                       class="text-decoration-none text-muted small">
                                        <i class="bi bi-geo-alt me-1"></i>
                                        @HighlighHelper.Highlight(item.Address, query)
                                    </a>
                                }
                            </td>
                            <td class="text-center text-muted">@item.DisplayOrder</td>
                            <td class="text-end pe-3">
                                <a class="btn-table-action me-1" asp-action="Edit" asp-route-id="@item.Id" title="Chỉnh sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button" class="btn-table-action danger btnDelete"
                                        data-id="@item.Id" data-name="@item.Name" title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5">
                            <div class="empty-state">
                                <div class="empty-icon"><i class="bi bi-building"></i></div>
                                <h5>Chưa có nhà cung cấp nào</h5>
                                <p>Thêm nhà cung cấp để bắt đầu quản lý đơn nhập hàng.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>

    <div class="responsive-list-panel responsive-list-grid" data-list-view-panel="grid" hidden>
        @if (Model.Data.Pagination.TotalCount > 0)
        {
            @foreach (var item in Model.Data)
            {
                <article class="list-card">
                    <div class="list-card-header">
                        <div class="list-card-title-group">
                            <div class="list-card-title">
                                <a class="text-decoration-none text-dark" asp-action="Edit" asp-route-id="@item.Id" title="Chỉnh sửa">
                                    @HighlighHelper.Highlight(item.Name, query)
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="list-card-fields">
                        @if (!string.IsNullOrEmpty(item.PhoneNumber))
                        {
                            <div class="list-card-field">
                                <a href="tel:@item.PhoneNumber" class="list-card-value text-decoration-none fw-normal text-dark">
                                    <i class="bi bi-telephone me-1"></i>@item.PhoneNumber
                                </a>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(item.Address))
                        {
                            var encodedAddress = MyUrlEncoder.Encode(item.Address);
                            <div class="list-card-field list-card-field-stack">
                                <a href="https://www.google.com/maps/search/@encodedAddress" target="_blank"
                                   class="text-decoration-none text-dark">
                                    <i class="bi bi-geo-alt me-1"></i>@HighlighHelper.Highlight(item.Address, query)
                                </a>
                            </div>
                        }
                    </div>
                    <div class="list-card-actions justify-content-start">
                        <a class="btn-table-action" asp-action="Edit" asp-route-id="@item.Id" title="Chỉnh sửa">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <button type="button" class="btn-table-action danger btnDelete"
                                data-id="@item.Id" data-name="@item.Name" title="Xóa">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </article>
            }
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="bi bi-building"></i></div>
                <h5>Chưa có nhà cung cấp nào</h5>
                <p>Thêm nhà cung cấp để bắt đầu quản lý đơn nhập hàng.</p>
            </div>
        }
    </div>

    @if (Model.Data.Pagination.TotalCount > 0)
    {
        <partial name="_Pager" model="Model.Data.Pagination" />
    }
</div>

@foreach (var item in Model.Data)
{
    <partial name="_DeleteForm" model="@item.Id" />
}

@section Scripts {
    <script type="module" defer>
        import { confirm } from "/modules/modals.js";
        (function () {
            const txtKeywords = document.getElementById('@(nameof(VendorListSearchModel.Keywords))');
            const form = txtKeywords.closest('form');
            const onSearchChanged = debounce(function () {
                form.submit();
            }, 500);
            txtKeywords.addEventListener('input', onSearchChanged);

            if (txtKeywords.value){
                focusEnd(txtKeywords);
            }

            $('.btnDelete').on('click', async function (e) {
                e.preventDefault();
                const name = $(this).data('name');
                $(this).prop('disabled', true);
                const confirmed = await confirm('Xóa nhà cung cấp', `Bạn muốn xóa nhà cung cấp <strong>${name}</strong>?`);
                if (!confirmed) { $(this).prop('disabled', false); return; }
                $(`#deleteForm${$(this).data('id')}`).submit();
            });
        })();
    </script>
}
