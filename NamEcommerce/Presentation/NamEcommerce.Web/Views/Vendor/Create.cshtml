@model CreateVendorModel
@{
    ViewData[ViewConstants.PageTitle] = "Thêm mới Nhà cung cấp";
}
@section TitleSection {
    <h1 class="topbar-page-title">
        Thêm mới
        <span class="text-muted">Nhà cung cấp</span>
    </h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="List" asp-controller="Vendor" class="text-decoration-none">Nhà cung cấp</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
            </ol>
        </nav>
    </div>
}
<div class="content-card">
    <form method="post" asp-antiforgery="true">
        <div class="content-card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-warning alert-global"></div>
                <ul class="nav nav-tabs" id="vendorTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="infoTab" data-bs-toggle="tab" data-bs-target="#info"
                                type="button" role="tab" aria-selected="true">
                            <i class="bi bi-info-circle me-1"></i>Thông tin
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="additionalTab" data-bs-toggle="tab" data-bs-target="#additional"
                                type="button" role="tab" aria-selected="false">
                            <i class="bi bi-sliders me-1"></i>Cài đặt
                        </button>
                    </li>
                </ul>
                <div class="tab-content pt-3" id="vendorContent">
                    <div class="tab-pane fade show active" id="info" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Name" class="form-label"></label>
                                <input asp-for="Name" class="form-control" placeholder="@Html.DisplayNameFor(m => m.Name)" autofocus />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label"></label>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="@Html.DisplayNameFor(m => m.PhoneNumber)" inputmode="tel"/>
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Address" class="form-label"></label>
                                <input asp-for="Address" class="form-control" placeholder="@Html.DisplayNameFor(m => m.Address)" />
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="InitialDebt" class="form-label"></label>
                                <input asp-for="InitialDebt" class="form-control text-start" data-decimal="currency" placeholder="Nhập số công nợ cũ" inputmode="numeric"/>
                                <div class="form-text text-muted">Nhập số công nợ cũ với nhà cung cấp</div>
                                <span asp-validation-for="InitialDebt" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="additional" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-sm-6 col-md-4">
                                <label asp-for="DisplayOrder" class="form-label"></label>
                                <input asp-for="DisplayOrder" class="form-control" placeholder="0" inputmode="numeric" />
                                <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
        </div>
        <div class="content-card-footer d-flex align-items-center justify-content-between">
            <a asp-action="List" class="btn btn-outline-secondary text-decoration-none btn-sm">
                <i class="bi bi-arrow-left"></i>
                Trở về
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Thêm mới
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}