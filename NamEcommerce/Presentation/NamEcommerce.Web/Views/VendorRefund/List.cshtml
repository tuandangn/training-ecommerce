@model NamEcommerce.Web.Models.Debts.VendorRefundListSearchModel
@using NamEcommerce.Domain.Shared.Enums.Debts

@{
    ViewData["Title"] = "Danh sách thu tiền hoàn từ NCC";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Thu tiền hoàn từ nhà cung cấp</h4>
</div>

<!-- Filter -->
<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small">Tìm kiếm</label>
                <input type="text" name="FilterKeywords" value="@Model.FilterKeywords"
                       class="form-control form-control-sm" placeholder="Mã phiếu, tên NCC..."/>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Trạng thái</label>
                <select name="FilterStatus" class="form-select form-select-sm">
                    <option value="">-- Tất cả --</option>
                    <option value="10" selected="@(Model.FilterStatus == 10)">Chờ thu tiền</option>
                    <option value="20" selected="@(Model.FilterStatus == 20)">Đã thu tiền</option>
                    <option value="30" selected="@(Model.FilterStatus == 30)">Đã huỷ</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary">Lọc</button>
                <a asp-action="List" class="btn btn-sm btn-outline-secondary ms-1">Xoá lọc</a>
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="content-card" data-responsive-list data-list-key="vendor-refund-list">
    <div class="action-toolbar justify-content-end">
        <partial name="_ResponsiveListToolbar" />
    </div>
    <div class="responsive-list-panel" data-list-view-panel="list">
        <div class="table-responsive">
        <table class="table data-table table-hover table-sm mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã phiếu</th>
                    <th>Nhà cung cấp</th>
                    <th>Phiếu trả hàng</th>
                    <th class="text-end">Số tiền thu</th>
                    <th class="text-center">Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Data?.Items.Count > 0)
                {
                    foreach (var item in Model.Data.Items)
                    {
                        var (badgeClass, label) = (VendorRefundStatus)item.Status switch
                        {
                            VendorRefundStatus.Pending => ("bg-warning text-dark", "Chờ thu tiền"),
                            VendorRefundStatus.Completed => ("bg-success", "Đã thu tiền"),
                            VendorRefundStatus.Cancelled => ("bg-secondary", "Đã huỷ"),
                            _ => ("bg-light text-dark", "?")
                        };
                        <tr>
                            <td><strong>@item.Code</strong></td>
                            <td>@item.VendorName</td>
                            <td>
                                <a asp-controller="VendorReturn" asp-action="Details"
                                   asp-route-id="@item.VendorReturnId">@item.VendorReturnCode</a>
                            </td>
                            <td class="text-end text-success fw-bold">@item.Amount.ToString("N0") ₫</td>
                            <td class="text-center">
                                <span class="badge @badgeClass">@label</span>
                            </td>
                            <td>@item.CreatedOnUtc.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id"
                                   class="btn btn-xs btn-outline-primary">Chi tiết</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Không có phiếu thu tiền hoàn nào.</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>

    <div class="responsive-list-panel responsive-list-grid" data-list-view-panel="grid" hidden>
        @if (Model.Data?.Items.Count > 0)
        {
            foreach (var item in Model.Data.Items)
            {
                var (badgeClass, label) = (VendorRefundStatus)item.Status switch
                {
                    VendorRefundStatus.Pending => ("bg-warning text-dark", "Chờ thu tiền"),
                    VendorRefundStatus.Completed => ("bg-success", "Đã thu tiền"),
                    VendorRefundStatus.Cancelled => ("bg-secondary", "Đã huỷ"),
                    _ => ("bg-light text-dark", "?")
                };

                <article class="list-card">
                    <div class="list-card-header">
                        <div class="list-card-title-group">
                            <div class="list-card-title">@item.Code</div>
                            <div class="list-card-meta">@item.CreatedOnUtc.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        <span class="badge @badgeClass">@label</span>
                    </div>
                    <div class="list-card-fields">
                        <div class="list-card-field">
                            <span class="list-card-label">Nhà cung cấp</span>
                            <span class="list-card-value">@item.VendorName</span>
                        </div>
                        <div class="list-card-field">
                            <span class="list-card-label">Phiếu trả hàng</span>
                            <a asp-controller="VendorReturn" asp-action="Details"
                               asp-route-id="@item.VendorReturnId"
                               class="list-card-value text-decoration-none">@item.VendorReturnCode</a>
                        </div>
                        <div class="list-card-field">
                            <span class="list-card-label">Số tiền thu</span>
                            <span class="list-card-value text-success">@item.Amount.ToString("N0") ₫</span>
                        </div>
                    </div>
                    <div class="list-card-actions">
                        <a asp-action="Details" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-primary">Chi tiết</a>
                    </div>
                </article>
            }
        }
        else
        {
            <div class="empty-state">
                <span class="text-muted">Không có phiếu thu tiền hoàn nào.</span>
            </div>
        }
    </div>
</div>

@if (Model.Data != null && Model.Data.TotalCount > Model.PageSize)
{
    var totalPages = (int)Math.Ceiling((double)Model.Data.TotalCount / Model.PageSize);
    <div class="d-flex justify-content-between align-items-center mt-3">
        <span class="text-muted small">
            Hiển thị @Model.Data.Items.Count / @Model.Data.TotalCount phiếu
        </span>
        <div>
            @if (Model.PageNumber > 1)
            {
                <a asp-action="List"
                   asp-route-FilterKeywords="@Model.FilterKeywords"
                   asp-route-FilterStatus="@Model.FilterStatus"
                   asp-route-PageNumber="@(Model.PageNumber - 1)"
                   asp-route-PageSize="@Model.PageSize"
                   class="btn btn-sm btn-outline-secondary me-1">← Trước</a>
            }
            @if (Model.PageNumber < totalPages)
            {
                <a asp-action="List"
                   asp-route-FilterKeywords="@Model.FilterKeywords"
                   asp-route-FilterStatus="@Model.FilterStatus"
                   asp-route-PageNumber="@(Model.PageNumber + 1)"
                   asp-route-PageSize="@Model.PageSize"
                   class="btn btn-sm btn-outline-secondary">Sau →</a>
            }
        </div>
    </div>
}
