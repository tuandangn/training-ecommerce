@model NamEcommerce.Web.Contracts.Models.Dashboard.DashboardModel
@using System.Globalization
@using System.Text.Json

@{
    ViewData["Title"] = "Trang chủ";
    ViewData[ViewConstants.PageTitle] = "Dashboard";

    var chartData = new
    {
        revenueTrend = new
        {
            labels = Model.SalesSummary.RevenueTrend.Select(x => x.Date.ToString("dd/MM")).ToArray(),
            revenues = Model.SalesSummary.RevenueTrend.Select(x => x.Revenue).ToArray(),
            profits = Model.SalesSummary.RevenueTrend.Select(x => x.Profit).ToArray()
        },
        profitBreakdown = new
        {
            labels = new[] { "Giá vốn", "Lãi gộp", "Chi phí" },
            values = new[]
            {
                Model.ProfitSummary.MonthCogs,
                Model.ProfitSummary.MonthGrossProfit,
                Model.ProfitSummary.MonthOperatingExpenses
            }
        },
        revenueDetail = new
        {
            today = new { gross = Model.SalesSummary.TodayGrossRevenue, returns = Model.SalesSummary.TodayReturnAmount, net = Model.SalesSummary.TodayRevenue },
            month = new { gross = Model.SalesSummary.MonthGrossRevenue, returns = Model.SalesSummary.MonthReturnAmount, net = Model.SalesSummary.MonthRevenue },
            quarter = new { gross = Model.SalesSummary.QuarterGrossRevenue, returns = Model.SalesSummary.QuarterReturnAmount, net = Model.SalesSummary.QuarterRevenue },
            year = new { gross = Model.SalesSummary.YearGrossRevenue, returns = Model.SalesSummary.YearReturnAmount, net = Model.SalesSummary.YearRevenue }
        },
        profitDetail = new
        {
            today = new { revenue = Model.ProfitSummary.TodayRevenue, cogs = Model.ProfitSummary.TodayCogs, grossProfit = Model.ProfitSummary.TodayGrossProfit, opex = Model.ProfitSummary.TodayOperatingExpenses, net = Model.ProfitSummary.TodayProfit },
            month = new { revenue = Model.ProfitSummary.MonthRevenue, cogs = Model.ProfitSummary.MonthCogs, grossProfit = Model.ProfitSummary.MonthGrossProfit, opex = Model.ProfitSummary.MonthOperatingExpenses, net = Model.ProfitSummary.MonthProfit },
            quarter = new { revenue = Model.ProfitSummary.QuarterRevenue, cogs = Model.ProfitSummary.QuarterCogs, grossProfit = Model.ProfitSummary.QuarterGrossProfit, opex = Model.ProfitSummary.QuarterOperatingExpenses, net = Model.ProfitSummary.QuarterProfit },
            year = new { revenue = Model.ProfitSummary.YearRevenue, cogs = Model.ProfitSummary.YearCogs, grossProfit = Model.ProfitSummary.YearGrossProfit, opex = Model.ProfitSummary.YearOperatingExpenses, net = Model.ProfitSummary.YearProfit }
        }
    };
}

@functions {
    private static string DateText(DateTime? date)
    {
        return date?.ToString(ViewConstants.DefaultDateFormat) ?? "-";
    }

    private static string StockProgressWidth(decimal quantityOnHand, decimal reorderLevel)
    {
        if (reorderLevel <= 0)
            return "0";

        var percent = Math.Clamp(quantityOnHand / reorderLevel * 100, 0, 100);
        return percent.ToString("0.##", CultureInfo.InvariantCulture);
    }
}

@section TitleSection {
    <h1 class="topbar-page-title">Dashboard</h1>
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/home-index.css" asp-append-version="true" />
}

<script type="application/json" id="dashboardChartData">
    @Html.Raw(JsonSerializer.Serialize(chartData))
</script>

<div class="dashboard-grid">
    <div class="row g-3">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="dashboard-kpi" data-kpi-detail="revenue-today" role="button" tabindex="0" aria-label="Xem chi tiết doanh số ngày">
                <div class="d-flex align-items-start gap-3">
                    <span class="dashboard-kpi-icon bg-primary"><i class="bi bi-calendar-day"></i></span>
                    <div class="min-w-0">
                        <div class="dashboard-kpi-label">Doanh số ngày</div>
                        <div class="dashboard-kpi-value @(Model.SalesSummary.TodayRevenue < 0 ? "text-danger" : "")">@Model.SalesSummary.TodayRevenue.DisplayCurrencyWithSymbol()</div>
                        @if (Model.SalesSummary.TodayReturnAmount > 0)
                        {
                            <div class="dashboard-kpi-meta">
                                <span class="dashboard-kpi-meta-item"><i class="bi bi-arrow-up-short text-success"></i>@Model.SalesSummary.TodayGrossRevenue.DisplayCurrencyWithSymbol()</span>
                                <span class="dashboard-kpi-meta-item text-danger"><i class="bi bi-arrow-down-short"></i>@Model.SalesSummary.TodayReturnAmount.DisplayCurrencyWithSymbol()</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="dashboard-kpi" data-kpi-detail="revenue-month" role="button" tabindex="0" aria-label="Xem chi tiết doanh số tháng">
                <div class="d-flex align-items-start gap-3">
                    <span class="dashboard-kpi-icon bg-info"><i class="bi bi-calendar3"></i></span>
                    <div class="min-w-0">
                        <div class="dashboard-kpi-label">Doanh số tháng</div>
                        <div class="dashboard-kpi-value @(Model.SalesSummary.MonthRevenue < 0 ? "text-danger" : "")">@Model.SalesSummary.MonthRevenue.DisplayCurrencyWithSymbol()</div>
                        @if (Model.SalesSummary.MonthReturnAmount > 0)
                        {
                            <div class="dashboard-kpi-meta">
                                <span class="dashboard-kpi-meta-item"><i class="bi bi-arrow-up-short text-success"></i>@Model.SalesSummary.MonthGrossRevenue.DisplayCurrencyWithSymbol()</span>
                                <span class="dashboard-kpi-meta-item text-danger"><i class="bi bi-arrow-down-short"></i>@Model.SalesSummary.MonthReturnAmount.DisplayCurrencyWithSymbol()</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="dashboard-kpi" data-kpi-detail="revenue-quarter" role="button" tabindex="0" aria-label="Xem chi tiết doanh số quý">
                <div class="d-flex align-items-start gap-3">
                    <span class="dashboard-kpi-icon bg-warning"><i class="bi bi-calendar-range"></i></span>
                    <div class="min-w-0">
                        <div class="dashboard-kpi-label">Doanh số quý</div>
                        <div class="dashboard-kpi-value @(Model.SalesSummary.QuarterRevenue < 0 ? "text-danger" : "")">@Model.SalesSummary.QuarterRevenue.DisplayCurrencyWithSymbol()</div>
                        @if (Model.SalesSummary.QuarterReturnAmount > 0)
                        {
                            <div class="dashboard-kpi-meta">
                                <span class="dashboard-kpi-meta-item"><i class="bi bi-arrow-up-short text-success"></i>@Model.SalesSummary.QuarterGrossRevenue.DisplayCurrencyWithSymbol()</span>
                                <span class="dashboard-kpi-meta-item text-danger"><i class="bi bi-arrow-down-short"></i>@Model.SalesSummary.QuarterReturnAmount.DisplayCurrencyWithSymbol()</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="dashboard-kpi" data-kpi-detail="revenue-year" role="button" tabindex="0" aria-label="Xem chi tiết doanh số năm">
                <div class="d-flex align-items-start gap-3">
                    <span class="dashboard-kpi-icon bg-success"><i class="bi bi-calendar4-week"></i></span>
                    <div class="min-w-0">
                        <div class="dashboard-kpi-label">Doanh số năm</div>
                        <div class="dashboard-kpi-value @(Model.SalesSummary.YearRevenue < 0 ? "text-danger" : "")">@Model.SalesSummary.YearRevenue.DisplayCurrencyWithSymbol()</div>
                        @if (Model.SalesSummary.YearReturnAmount > 0)
                        {
                            <div class="dashboard-kpi-meta">
                                <span class="dashboard-kpi-meta-item"><i class="bi bi-arrow-up-short text-success"></i>@Model.SalesSummary.YearGrossRevenue.DisplayCurrencyWithSymbol()</span>
                                <span class="dashboard-kpi-meta-item text-danger"><i class="bi bi-arrow-down-short"></i>@Model.SalesSummary.YearReturnAmount.DisplayCurrencyWithSymbol()</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="dashboard-kpi" data-kpi-detail="profit-today" role="button" tabindex="0" aria-label="Xem chi tiết lợi nhuận ngày">
                <div class="d-flex align-items-start gap-3">
                    <span class="dashboard-kpi-icon bg-success"><i class="bi bi-graph-up-arrow"></i></span>
                    <div class="min-w-0">
                        <div class="dashboard-kpi-label">Lợi nhuận ngày</div>
                        <div class="dashboard-kpi-value @(Model.ProfitSummary.TodayProfit < 0 ? "text-danger" : "")">@Model.ProfitSummary.TodayProfit.DisplayCurrencyWithSymbol()</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="dashboard-kpi" data-kpi-detail="profit-month" role="button" tabindex="0" aria-label="Xem chi tiết lợi nhuận tháng">
                <div class="d-flex align-items-start gap-3">
                    <span class="dashboard-kpi-icon bg-teal ui-teal-bg"><i class="bi bi-bar-chart-line"></i></span>
                    <div class="min-w-0">
                        <div class="dashboard-kpi-label">Lợi nhuận tháng</div>
                        <div class="dashboard-kpi-value @(Model.ProfitSummary.MonthProfit < 0 ? "text-danger" : "")">@Model.ProfitSummary.MonthProfit.DisplayCurrencyWithSymbol()</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="dashboard-kpi" data-kpi-detail="profit-quarter" role="button" tabindex="0" aria-label="Xem chi tiết lợi nhuận quý">
                <div class="d-flex align-items-start gap-3">
                    <span class="dashboard-kpi-icon bg-secondary"><i class="bi bi-pie-chart"></i></span>
                    <div class="min-w-0">
                        <div class="dashboard-kpi-label">Lợi nhuận quý</div>
                        <div class="dashboard-kpi-value @(Model.ProfitSummary.QuarterProfit < 0 ? "text-danger" : "")">@Model.ProfitSummary.QuarterProfit.DisplayCurrencyWithSymbol()</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="dashboard-kpi" data-kpi-detail="profit-year" role="button" tabindex="0" aria-label="Xem chi tiết lợi nhuận năm">
                <div class="d-flex align-items-start gap-3">
                    <span class="dashboard-kpi-icon bg-dark"><i class="bi bi-award"></i></span>
                    <div class="min-w-0">
                        <div class="dashboard-kpi-label">Lợi nhuận năm</div>
                        <div class="dashboard-kpi-value @(Model.ProfitSummary.YearProfit < 0 ? "text-danger" : "")">@Model.ProfitSummary.YearProfit.DisplayCurrencyWithSymbol()</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-xl-8">
            <section class="dashboard-panel h-100">
                <div class="dashboard-panel-header">
                    <div>
                        <h2 class="dashboard-panel-title">Doanh thu 30 ngày</h2>
                        <p class="dashboard-panel-subtitle">Theo ngày, kèm đường lợi nhuận gộp để đối chiếu.</p>
                    </div>
                    <i class="bi bi-activity text-primary"></i>
                </div>
                <div class="dashboard-chart-wrap">
                    <canvas id="dashboardRevenueChart"></canvas>
                </div>
            </section>
        </div>
        <div class="col-12 col-xl-4">
            <section class="dashboard-panel h-100">
                <div class="dashboard-panel-header">
                    <div>
                        <h2 class="dashboard-panel-title">Cơ cấu lợi nhuận tháng</h2>
                        <p class="dashboard-panel-subtitle">Giá vốn, lãi gộp và chi phí vận hành.</p>
                    </div>
                    <i class="bi bi-pie-chart-fill text-success"></i>
                </div>
                <div class="dashboard-chart-wrap-sm">
                    <canvas id="dashboardProfitChart"></canvas>
                </div>
            </section>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-xl-6">
            <section class="dashboard-panel h-100">
                <div class="dashboard-panel-header">
                    <div>
                        <h2 class="dashboard-panel-title">5 đơn bán cần xử lý</h2>
                        <p class="dashboard-panel-subtitle">Đơn còn hàng chưa giao xong.</p>
                    </div>
                    <a asp-controller="Order" asp-action="List" class="btn btn-sm btn-outline-secondary" title="Xem đơn bán" aria-label="Xem đơn bán"><i class="bi bi-box-arrow-up-right"></i></a>
                </div>
                <div class="table-responsive">
                    <table class="table dashboard-table">
                        <thead>
                            <tr>
                                <th class="ps-3">Đơn</th>
                                <th>Khách hàng</th>
                                <th class="text-end">Tổng tiền</th>
                                <th class="text-center">Còn</th>
                                <th class="text-end pe-3">Hẹn giao</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.PendingOrders.Any())
                            {
                                @foreach (var order in Model.PendingOrders)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id" class="dashboard-link">@order.Code</a>
                                            <div class="small text-muted">@order.CreatedOn.ToString(ViewConstants.DefaultDateFormat)</div>
                                        </td>
                                        <td class="text-nowrap">@order.CustomerName</td>
                                        <td class="text-end text-nowrap">@order.TotalAmount.DisplayCurrencyWithSymbol()</td>
                                        <td class="text-center"><span class="badge bg-warning text-dark">@order.PendingItemCount</span></td>
                                        <td class="text-end pe-3 text-nowrap">@DateText(order.ExpectedShippingDate)</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="dashboard-empty">Không có đơn bán cần xử lý.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
        <div class="col-12 col-xl-6">
            <section class="dashboard-panel h-100">
                <div class="dashboard-panel-header">
                    <div>
                        <h2 class="dashboard-panel-title">5 đơn nhập cần xử lý</h2>
                        <p class="dashboard-panel-subtitle">Đơn nhập chưa nhận đủ hàng.</p>
                    </div>
                    <a asp-controller="PurchaseOrder" asp-action="List" class="btn btn-sm btn-outline-secondary" title="Xem đơn nhập" aria-label="Xem đơn nhập"><i class="bi bi-box-arrow-up-right"></i></a>
                </div>
                <div class="table-responsive">
                    <table class="table dashboard-table">
                        <thead>
                            <tr>
                                <th class="ps-3">Đơn</th>
                                <th>NCC</th>
                                <th class="text-end">Tổng tiền</th>
                                <th class="text-end">Còn nhập</th>
                                <th class="text-end pe-3">Hẹn nhận</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.PendingPurchaseOrders.Any())
                            {
                                @foreach (var order in Model.PendingPurchaseOrders)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <a asp-controller="PurchaseOrder" asp-action="Details" asp-route-id="@order.Id" class="dashboard-link">@order.Code</a>
                                            <div class="small text-muted">@order.CreatedOn.ToString(ViewConstants.DefaultDateFormat)</div>
                                        </td>
                                        <td class="text-nowrap">@order.VendorName</td>
                                        <td class="text-end text-nowrap">@order.TotalAmount.DisplayCurrencyWithSymbol()</td>
                                        <td class="text-end text-nowrap">@order.RemainingQuantity.DisplayQuantity()</td>
                                        <td class="text-end pe-3 text-nowrap">@DateText(order.ExpectedDeliveryDate)</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="dashboard-empty">Không có đơn nhập cần xử lý.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-xl-6">
            <section class="dashboard-panel h-100">
                <div class="dashboard-panel-header">
                    <div>
                        <h2 class="dashboard-panel-title">Top 5 khách hàng công nợ</h2>
                        <p class="dashboard-panel-subtitle">Sắp theo số tiền còn phải thu.</p>
                    </div>
                    <i class="bi bi-people text-primary"></i>
                </div>
                <div class="table-responsive">
                    <table class="table dashboard-table">
                        <thead>
                            <tr>
                                <th class="ps-3">Khách hàng</th>
                                <th class="text-end pe-3">Còn nợ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TopCustomerDebts.Any())
                            {
                                @foreach (var debt in Model.TopCustomerDebts)
                                {
                                    <tr>
                                        <td class="ps-3">@debt.CustomerName</td>
                                        <td class="text-end pe-3 fw-semibold text-nowrap">@debt.TotalRemainingAmount.DisplayCurrencyWithSymbol()</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2" class="dashboard-empty">Chưa có công nợ khách hàng.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
        <div class="col-12 col-xl-6">
            <section class="dashboard-panel h-100">
                <div class="dashboard-panel-header">
                    <div>
                        <h2 class="dashboard-panel-title">Top 5 NCC công nợ</h2>
                        <p class="dashboard-panel-subtitle">Sắp theo số tiền còn phải trả.</p>
                    </div>
                    <i class="bi bi-buildings text-success"></i>
                </div>
                <div class="table-responsive">
                    <table class="table dashboard-table">
                        <thead>
                            <tr>
                                <th class="ps-3">Nhà cung cấp</th>
                                <th class="text-end pe-3">Còn nợ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TopVendorDebts.Any())
                            {
                                @foreach (var debt in Model.TopVendorDebts)
                                {
                                    <tr>
                                        <td class="ps-3">@debt.VendorName</td>
                                        <td class="text-end pe-3 fw-semibold text-nowrap">@debt.TotalRemainingAmount.DisplayCurrencyWithSymbol()</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2" class="dashboard-empty">Chưa có công nợ nhà cung cấp.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>

    <section class="dashboard-panel">
        <div class="dashboard-panel-header">
            <div>
                <h2 class="dashboard-panel-title">10 hàng tồn thấp</h2>
                <p class="dashboard-panel-subtitle">Lọc theo tồn hiện tại nhỏ hơn hoặc bằng mức đặt hàng lại.</p>
            </div>
            <a asp-controller="Inventory" asp-action="StockList" class="btn btn-sm btn-outline-secondary" title="Xem tồn kho" aria-label="Xem tồn kho"><i class="bi bi-box-arrow-up-right"></i></a>
        </div>
        <div class="table-responsive">
            <table class="table dashboard-table">
                <thead>
                    <tr>
                        <th class="ps-3">Hàng hóa</th>
                        <th>Kho</th>
                        <th class="text-end">Tồn</th>
                        <th class="text-end">Giữ</th>
                        <th class="text-end">Khả dụng</th>
                        <th class="pe-3">Stock / ReorderLevel</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.LowStockProducts.Any())
                    {
                        @foreach (var product in Model.LowStockProducts)
                        {
                            var width = StockProgressWidth(product.QuantityOnHand, product.ReorderLevel);
                            <tr>
                                <td class="ps-3 fw-semibold">@product.ProductName</td>
                                <td class="text-nowrap">@product.WarehouseName</td>
                                <td class="text-end text-nowrap">@product.QuantityOnHand.DisplayQuantity()</td>
                                <td class="text-end text-nowrap">@product.QuantityReserved.DisplayQuantity()</td>
                                <td class="text-end text-nowrap">@product.QuantityAvailable.DisplayQuantity()</td>
                                <td class="pe-3">
                                    <div class="stock-progress">
                                        <div class="stock-progress-value">
                                            <span>@product.QuantityOnHand.DisplayQuantity()</span>
                                            <span>@product.ReorderLevel.DisplayQuantity()</span>
                                        </div>
                                        <div class="progress" role="progressbar" aria-valuenow="@width" aria-valuemin="0" aria-valuemax="100">
                                            <div class="progress-bar bg-danger" data-progress-width="@width"></div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="dashboard-empty">Chưa có hàng nào dưới mức tồn cảnh báo.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

<div class="modal fade" id="kpiDetailModal" tabindex="-1" aria-labelledby="kpiDetailModalLabel" aria-modal="true" role="dialog">
    <div class="modal-dialog modal-dialog-centered ui-max-w-360">
        <div class="modal-content ui-modal-frame">
            <div class="modal-header ui-modal-header-soft">
                <h5 class="modal-title fw-700 ui-modal-title-compact" id="kpiDetailModalLabel"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body ui-modal-body-soft" id="kpiDetailModalBody">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true" defer></script>
}
