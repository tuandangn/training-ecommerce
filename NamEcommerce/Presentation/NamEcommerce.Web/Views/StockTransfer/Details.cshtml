@using NamEcommerce.Domain.Shared.Enums.StockTransfer
@model NamEcommerce.Web.Contracts.Models.StockTransfer.StockTransferNoteModel
@{
    ViewData[ViewConstants.PageTitle] = $"Phiếu chuyển kho - {Model.Code}";

    var status = (StockTransferStatus)Model.Status;
    var (badgeClass, badgeText) = status switch
    {
        StockTransferStatus.Draft => ("bg-secondary", "Bản nháp"),
        StockTransferStatus.Approved => ("bg-success", "Đã duyệt"),
        StockTransferStatus.Cancelled => ("bg-danger", "Đã huỷ"),
        _ => ("bg-secondary", "—")
    };
}
@Html.AntiForgeryToken()
@section TitleSection {
    <h1 class="topbar-page-title">
        @Model.Code
        <span class="badge @badgeClass ms-2 ui-fs-075-align-middle">@badgeText</span>
    </h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="List" asp-controller="StockTransfer" class="text-decoration-none">Phiếu chuyển kho</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Code</li>
            </ol>
        </nav>
    </div>
}

<div class="row g-3">
    <!-- Cột trái: danh sách hàng hóa -->
    <div class="col-lg-8 order-1 order-lg-0">
        <div class="content-card">
            <div class="content-card-header">
                <h5 class="mb-0">
                    Danh sách hàng hóa chuyển kho
                    <span class="badge bg-light text-muted border ms-1 ui-fs-072-fw-500">
                        @Model.Items.Count mặt hàng
                    </span>
                </h5>
            </div>
            <div class="content-card-body-flush">
                <div class="table-responsive">
                    <table class="table data-table mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Hàng hóa</th>
                                <th class="text-end ui-w-160">Số lượng</th>
                                <th class="text-end pe-4 ui-w-160">Giá vốn</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr class="align-middle">
                                    <td class="ps-4">
                                        <div class="fw-medium">@item.ProductName</div>
                                    </td>
                                    <td class="text-end fw-medium">@item.Quantity.DisplayQuantity()</td>
                                    <td class="text-end pe-4 text-muted small">
                                        @if (item.UnitCost > 0)
                                        {
                                            @item.UnitCost.DisplayCurrency()
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.Items.Count == 0)
                {
                    <div class="empty-state py-4">
                        <span class="text-muted">Phiếu chuyển kho không có hàng hóa nào.</span>
                    </div>
                }
            </div>
            <div class="content-card-footer py-2 d-flex align-items-center justify-content-between">
                <a asp-action="List" class="btn btn-outline-secondary text-decoration-none small">
                    <i class="bi bi-arrow-left me-1"></i>Trở về
                </a>
                <div class="d-flex gap-2">
                    @if (status == StockTransferStatus.Draft)
                    {
                        <button type="button" class="btn btn-sm btn-outline-success btn-approve" data-id="@Model.Id">
                            <i class="bi bi-check-circle me-1"></i>Duyệt phiếu
                        </button>
                        <form method="post" asp-action="Cancel" asp-route-id="@Model.Id"
                              onsubmit="return confirm('Bạn có chắc muốn huỷ phiếu chuyển kho này?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-x-circle me-1"></i>Huỷ phiếu
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Cột phải: thông tin phiếu -->
    <div class="col-lg-4 order-0 order-lg-1">
        <div class="content-card">
            <div class="content-card-header">
                <h5 class="mb-0">Thông tin phiếu</h5>
            </div>
            <div class="content-card-body p-0">
                <dl class="receipt-info-list mb-0">
                    <div class="receipt-info-row">
                        <dt>Trạng thái</dt>
                        <dd><span class="badge @badgeClass">@badgeText</span></dd>
                    </div>
                    <div class="receipt-info-row">
                        <dt>Kho nguồn</dt>
                        <dd class="fw-semibold">
                            <i class="bi bi-building me-1 text-danger"></i>@Model.FromWarehouseName
                        </dd>
                    </div>
                    <div class="receipt-info-row">
                        <dt>Kho đích</dt>
                        <dd class="fw-semibold">
                            <i class="bi bi-building me-1 text-success"></i>@Model.ToWarehouseName
                        </dd>
                    </div>
                    @if (Model.ApprovedOnUtc.HasValue)
                    {
                        <div class="receipt-info-row">
                            <dt>Duyệt lúc</dt>
                            <dd class="text-success fw-semibold">@Model.ApprovedOnUtc.Value.ToString(ViewConstants.DefaultDateTimeFormat)</dd>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Note))
                    {
                        <div class="receipt-info-row">
                            <dt>Ghi chú</dt>
                            <dd class="text-secondary">@Model.Note</dd>
                        </div>
                    }
                    <div class="receipt-info-row">
                        <dt>Tạo lúc</dt>
                        <dd class="text-muted small">@Model.CreatedOnUtc.ToString(ViewConstants.DefaultDateTimeFormat)</dd>
                    </div>
                </dl>
            </div>
        </div>

        @if (status == StockTransferStatus.Approved)
        {
            <div class="content-card mt-3">
                <div class="content-card-body">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        <div>
                            <div class="fw-semibold small">Phiếu đã được duyệt</div>
                            <div class="text-muted ui-fs-075">
                                Tồn kho kho nguồn đã được trừ, kho đích đã được cộng.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/stocktransfer-details.css" asp-append-version="true" />
}

@section Scripts {
    <script type="module">
        import { toast } from "/modules/modals.js";

        const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        const noteId = '@Model.Id';

        document.querySelector('.btn-approve')?.addEventListener('click', async () => {
            if (!confirm('Xác nhận duyệt phiếu chuyển kho? Tồn kho sẽ được điều chuyển ngay.')) return;
            const fd = new FormData();
            fd.append('id', noteId);
            fd.append('__RequestVerificationToken', antiForgeryToken);
            try {
                const res = await fetch('@Url.Action("Approve")', { method: 'POST', body: fd }).then(r => r.json());
                if (res.success) location.reload();
                else toast('Lỗi', res.message || 'Duyệt phiếu thất bại.', 'danger');
            } catch { toast('Lỗi', 'Lỗi kết nối. Vui lòng thử lại.', 'danger'); }
        });
    </script>
}
