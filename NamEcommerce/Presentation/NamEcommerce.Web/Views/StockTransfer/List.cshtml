@using NamEcommerce.Domain.Shared.Enums.StockTransfer
@model NamEcommerce.Web.Contracts.Models.StockTransfer.StockTransferNoteListModel
@{
    ViewData[ViewConstants.PageTitle] = "Phiếu chuyển kho";
}
@section TitleSection {
    <h1 class="topbar-page-title">Phiếu chuyển kho</h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Phiếu chuyển kho</li>
            </ol>
        </nav>
    </div>
}
<div class="content-card" data-responsive-list data-list-key="stock-transfer-list">
    <div class="action-toolbar">
        <div class="d-flex gap-2 align-items-center flex-wrap"></div>
        <div class="d-flex align-items-center justify-content-end gap-2 flex-wrap">
            <partial name="_ResponsiveListToolbar" />
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Tạo phiếu chuyển kho
            </a>
        </div>
    </div>
    <div class="content-card-body-flush">
        <div class="responsive-list-panel" data-list-view-panel="list">
            <div class="table-responsive">
            <table class="table data-table">
                <thead>
                    <tr>
                        <th class="ps-4 ui-w-160">Mã phiếu</th>
                        <th>Kho nguồn</th>
                        <th>Kho đích</th>
                        <th class="text-center ui-w-100">Số mặt hàng</th>
                        <th class="text-center ui-w-130">Trạng thái</th>
                        <th class="text-center ui-w-120">Ngày tạo</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.TotalCount > 0)
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr class="align-middle">
                                <td class="ps-4">
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="fw-semibold text-decoration-none">
                                        @item.Code
                                    </a>
                                </td>
                                <td class="text-muted small">@item.FromWarehouseName</td>
                                <td class="text-muted small">@item.ToWarehouseName</td>
                                <td class="text-center text-muted">@item.ItemCount</td>
                                <td class="text-center">
                                    @{
                                        var (badgeClass, badgeText) = (StockTransferStatus)item.Status switch
                                        {
                                            StockTransferStatus.Draft => ("bg-secondary", "Bản nháp"),
                                            StockTransferStatus.Approved => ("bg-success", "Đã duyệt"),
                                            StockTransferStatus.Cancelled => ("bg-danger", "Đã huỷ"),
                                            _ => ("bg-secondary", "—")
                                        };
                                    }
                                    <span class="badge @badgeClass">@badgeText</span>
                                </td>
                                <td class="text-center text-muted small">@item.CreatedOnUtc.ToString(ViewConstants.DefaultDateFormat)</td>
                                <td class="text-end pe-3">
                                    <a class="btn btn-sm btn-outline-secondary text-primary"
                                       asp-action="Details" asp-route-id="@item.Id">Xem</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <span class="text-muted">Chưa có phiếu chuyển kho nào</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>

        <div class="responsive-list-panel responsive-list-grid" data-list-view-panel="grid" hidden>
            @if (Model.TotalCount > 0)
            {
                @foreach (var item in Model.Items)
                {
                    var (badgeClass, badgeText) = (StockTransferStatus)item.Status switch
                    {
                        StockTransferStatus.Draft => ("bg-secondary", "Bản nháp"),
                        StockTransferStatus.Approved => ("bg-success", "Đã duyệt"),
                        StockTransferStatus.Cancelled => ("bg-danger", "Đã huỷ"),
                        _ => ("bg-secondary", "—")
                    };

                    <article class="list-card">
                        <div class="list-card-header">
                            <div class="list-card-title-group">
                                <a asp-action="Details" asp-route-id="@item.Id" class="list-card-title">@item.Code</a>
                                <div class="list-card-meta">@item.CreatedOnUtc.ToString(ViewConstants.DefaultDateFormat)</div>
                            </div>
                            <span class="badge @badgeClass">@badgeText</span>
                        </div>
                        <div class="list-card-fields">
                            <div class="list-card-field">
                                <span class="list-card-label">Kho nguồn</span>
                                <span class="list-card-value">@item.FromWarehouseName</span>
                            </div>
                            <div class="list-card-field">
                                <span class="list-card-label">Kho đích</span>
                                <span class="list-card-value">@item.ToWarehouseName</span>
                            </div>
                            <div class="list-card-field">
                                <span class="list-card-label">Số mặt hàng</span>
                                <span class="list-card-value">@item.ItemCount</span>
                            </div>
                        </div>
                        <div class="list-card-actions">
                            <a class="btn btn-sm btn-outline-secondary text-primary"
                               asp-action="Details" asp-route-id="@item.Id">Xem</a>
                        </div>
                    </article>
                }
            }
            else
            {
                <div class="empty-state">
                    <span class="text-muted">Chưa có phiếu chuyển kho nào</span>
                </div>
            }
        </div>
        @if (Model.TotalCount > Model.PageSize)
        {
            <div class="d-flex justify-content-center py-3">
                @if (Model.PageNumber > 1)
                {
                    <a asp-action="List" asp-route-pageNumber="@(Model.PageNumber - 1)"
                       class="btn btn-sm btn-outline-secondary me-2">
                        <i class="bi bi-chevron-left"></i> Trước
                    </a>
                }
                <span class="btn btn-sm btn-outline-secondary disabled">Trang @Model.PageNumber</span>
                @if (Model.PageNumber * Model.PageSize < Model.TotalCount)
                {
                    <a asp-action="List" asp-route-pageNumber="@(Model.PageNumber + 1)"
                       class="btn btn-sm btn-outline-secondary ms-2">
                        Sau <i class="bi bi-chevron-right"></i>
                    </a>
                }
            </div>
        }
    </div>
</div>
