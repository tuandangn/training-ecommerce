@model NamEcommerce.Web.Models.StockTransfer.CreateStockTransferNoteModel
@{
    ViewData[ViewConstants.PageTitle] = "Tạo phiếu chuyển kho";
}
@section TitleSection {
    <h1 class="topbar-page-title">
        Thêm mới
        <span class="text-muted">Phiếu chuyển kho</span>
    </h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="List" asp-controller="StockTransfer" class="text-decoration-none">Phiếu chuyển kho</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
            </ol>
        </nav>
    </div>
}
<div>
    <div asp-validation-summary="ModelOnly" class="alert alert-warning alert-global alert-dismissible"></div>
    <form method="post" id="createTransferForm" asp-antiforgery="true">
        <div class="row g-3">
            <!-- Cột trái: danh sách hàng hóa -->
            <div class="col-lg-8 order-1 order-lg-0">
                <div class="content-card mb-3">
                    <div class="content-card-header">
                        <h5>Danh sách hàng hóa chuyển kho</h5>
                        <button type="button" class="btn btn-sm bg-light text-primary" id="btnAddItem">
                            <i class="bi bi-plus-lg me-1"></i> Thêm hàng hóa
                        </button>
                    </div>
                    <div class="content-card-body-flush">
                        <div class="table-responsive">
                            <table class="table data-table mb-0" id="transferItemsTable">
                                <thead>
                                    <tr>
                                        <th class="ps-3">Hàng hóa</th>
                                        <th class="text-end" style="width:160px">Số lượng chuyển</th>
                                        <th style="width:40px"></th>
                                    </tr>
                                </thead>
                                <tbody id="itemsTableBody">
                                    @for (var i = 0; i < Model.Items.Count; i++)
                                    {
                                        var item = Model.Items[i];
                                        <tr id="item-row-@i">
                                            <td class="ps-3">
                                                <div class="fw-medium">@item.ProductName</div>
                                                <input type="hidden" name="Items[@i].ProductId" value="@item.ProductId" />
                                                <input type="hidden" name="Items[@i].ProductName" value="@item.ProductName" />
                                            </td>
                                            <td class="text-end">
                                                <input name="Items[@i].Quantity" value="@item.Quantity"
                                                       class="form-control form-control-sm text-end"
                                                       data-decimal="quantity" min="0.001" step="0.001" placeholder="0" />
                                            </td>
                                            <td class="pe-3">
                                                <button type="button" class="btn-table-action danger border-0 bg-transparent shadow-none btn-remove-item">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div id="noItemsMessage" class="py-4 text-center text-muted"
                             style="@(Model.Items.Count == 0 ? "display:block" : "display:none")">
                            Chưa có hàng hóa nào được thêm vào phiếu chuyển kho.
                        </div>
                    </div>
                    <div class="content-card-footer py-2 d-flex align-items-center justify-content-between">
                        <a asp-action="List" class="btn btn-link text-decoration-none">
                            <span class="text-muted small">Trở về</span>
                        </a>
                        <button type="submit" class="btn btn-primary d-lg-none">Tạo phiếu</button>
                    </div>
                </div>
            </div>

            <!-- Cột phải: thông tin phiếu -->
            <div class="col-lg-4">
                <div class="content-card">
                    <div class="content-card-header">
                        <h5>Thông tin chuyển kho</h5>
                    </div>
                    <div class="content-card-body">
                        <!-- Kho nguồn -->
                        <div class="mb-3">
                            <label asp-for="FromWarehouseId" class="form-label small fw-bold text-muted text-uppercase d-block">
                                Kho nguồn <span class="text-danger">*</span>
                            </label>
                            <select asp-for="FromWarehouseId" class="form-select" id="fromWarehouseSelect">
                                <option value="">(Chọn kho nguồn)</option>
                                @foreach (var warehouse in Model.AvailableWarehouses)
                                {
                                    <option value="@warehouse.Id" selected="@(Model.FromWarehouseId == warehouse.Id)">
                                        @warehouse.Name
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="FromWarehouseId" class="small text-danger"></span>
                        </div>

                        <!-- Kho đích -->
                        <div class="mb-3">
                            <label asp-for="ToWarehouseId" class="form-label small fw-bold text-muted text-uppercase d-block">
                                Kho đích <span class="text-danger">*</span>
                            </label>
                            <select asp-for="ToWarehouseId" class="form-select" id="toWarehouseSelect">
                                <option value="">(Chọn kho đích)</option>
                                @foreach (var warehouse in Model.AvailableWarehouses)
                                {
                                    <option value="@warehouse.Id" selected="@(Model.ToWarehouseId == warehouse.Id)">
                                        @warehouse.Name
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="ToWarehouseId" class="small text-danger"></span>
                        </div>

                        <!-- Ghi chú -->
                        <div class="mb-3">
                            <label asp-for="Note" class="form-label small fw-bold text-muted text-uppercase d-block">
                                Lý do / Ghi chú
                            </label>
                            <textarea asp-for="Note" class="form-control" rows="3"
                                      placeholder="Nhập nhầm kho, điều chuyển hàng..."></textarea>
                        </div>
                    </div>
                    <div class="content-card-footer d-none d-lg-block">
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Tạo phiếu chuyển kho</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Modal: Thêm hàng hóa -->
<div class="modal fade" id="addItemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Thêm hàng hóa chuyển kho</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3">
                <div class="mb-3">
                    <label class="form-label small fw-medium text-muted">Tên hàng hóa</label>
                    <input type="text" id="modalProductName" class="form-control"
                           placeholder="Nhập tên hàng hóa..." />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-medium text-muted">Số lượng chuyển</label>
                    <input type="number" id="modalQty" class="form-control text-end"
                           value="1" min="0.001" step="0.001" />
                </div>
                <div id="addItemError" class="alert alert-danger d-none mt-3 py-2 mb-0"></div>
            </div>
            <div class="modal-footer border-0 pt-0 pb-3">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                <button type="button" id="btnConfirmAddItem" class="btn btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>Thêm hàng
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module">
        let rowIndex = @Model.Items.Count;
        const tbody = document.getElementById('itemsTableBody');
        const noMsg = document.getElementById('noItemsMessage');
        const addItemModal = new bootstrap.Modal(document.getElementById('addItemModal'));

        function updateEmptyState() {
            noMsg.style.display = tbody.rows.length === 0 ? 'block' : 'none';
        }

        function addItemRow(productName, qty) {
            const i = rowIndex++;
            const tr = document.createElement('tr');
            tr.id = `item-row-${i}`;
            tr.innerHTML = `
                <td class="ps-3">
                    <div class="fw-medium">${productName}</div>
                    <input type="hidden" name="Items[${i}].ProductId" value="${crypto.randomUUID()}" />
                    <input type="hidden" name="Items[${i}].ProductName" value="${productName}" />
                </td>
                <td class="text-end">
                    <input name="Items[${i}].Quantity" value="${qty}"
                           class="form-control form-control-sm text-end"
                           data-decimal="quantity" min="0.001" step="0.001" placeholder="0" />
                </td>
                <td class="pe-3">
                    <button type="button" class="btn-table-action danger border-0 bg-transparent shadow-none btn-remove-item">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>`;
            tbody.appendChild(tr);
            updateEmptyState();
        }

        tbody.addEventListener('click', e => {
            const btn = e.target.closest('.btn-remove-item');
            if (btn) {
                btn.closest('tr').remove();
                updateEmptyState();
            }
        });

        document.getElementById('btnAddItem').addEventListener('click', () => {
            document.getElementById('modalProductName').value = '';
            document.getElementById('modalQty').value = '1';
            document.getElementById('addItemError').classList.add('d-none');
            addItemModal.show();
        });

        document.getElementById('btnConfirmAddItem').addEventListener('click', () => {
            const name = document.getElementById('modalProductName').value.trim();
            const qty = parseFloat(document.getElementById('modalQty').value);
            const errEl = document.getElementById('addItemError');

            if (!name) {
                errEl.textContent = 'Vui lòng nhập tên hàng hóa.';
                errEl.classList.remove('d-none');
                return;
            }
            if (!qty || qty <= 0) {
                errEl.textContent = 'Số lượng phải lớn hơn 0.';
                errEl.classList.remove('d-none');
                return;
            }

            addItemRow(name, qty);
            addItemModal.hide();
        });
    </script>
}
