@using System.Globalization
@model PurchaseOrderBulkReceiveItemsModel
<div class="modal fade" id="bulkReceiveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content purchaseorder-modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-box-arrow-in-down me-2 text-success"></i>
                    Nhận hàng
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="BulkReceiveItems" method="post" id="bulkReceiveForm">
                <fieldset>
                    @if (Model.RemainingReceivableItems.Count > 0)
                    {
                        <input type="hidden" asp-for="PurchaseOrderId" id="bulkReceivePurchaseOrderId" />
                        <script type="application/json" id="bulkReceiveData">
                            {
                                "defaultWarehouseId": "@Model.DefaultWarehouseId",
                                "items": [
                                @for (var idx = 0; idx < Model.RemainingReceivableItems.Count; idx++)
                                    {
                                        var item = Model.RemainingReceivableItems[idx];
                                        var itemDsRemaining = Model.DirectShipAllocationsPerItem.TryGetValue(item.Id, out var itemDsAllocs)
                                            ? itemDsAllocs.Where(a => a.Status != 5 && (a.AllocatedQuantity - a.ReceivedQuantity) > 0m).Sum(a => a.AllocatedQuantity - a.ReceivedQuantity) 
                                            : 0m;
                                        <text>{
                                            "id": "@item.Id",
                                            "name": @Json.Serialize(item.ProductName),
                                            "remaining": @item.RemainingQuantity.ToString(CultureInfo.InvariantCulture),
                                            "unitCost": @item.UnitCost.ToString(CultureInfo.InvariantCulture),
                                            "dsRemaining": @itemDsRemaining.ToString(CultureInfo.InvariantCulture),
                                            "decimalPlaces": @item.QuantityDecimalPlaces,
                                            "unitMeasurement": "@item.UnitMeasurement"
                                            }@(idx < Model.RemainingReceivableItems.Count - 1 ? "," : "")
                                        </text>
                                }],
                                "warehouses": [
                                    @for (var w = 0; w < Model.AvailableWarehouses.Count; w++)
                                    {
                                        var option = Model.AvailableWarehouses[w];
                                        <text>{
                                            "id": "@option.Id",
                                            "name": @Json.Serialize(option.Name)
                                            }@(w < Model.AvailableWarehouses.Count - 1 ? "," : "")
                                        </text>
                                    }]
                                }
                        </script>
                        <div class="modal-body py-3">
                            <div class="row g-3 mb-3">
                                <div class="col-lg-4">
                                    <label asp-for="ReceivedOn" for="bulkReceiveReceivedOn" class="form-label small fw-medium text-muted text-uppercase">Ngày nhận</label>
                                    <input type="datetime-local" asp-for="ReceivedOn" id="bulkReceiveReceivedOn" class="form-control text-sm" placeholder="Ngày nhận"
                                           data-val-range-max="@DateTime.Now.ToString("s")" data-val-range-min="@Model.PurchaseOrderPlacedOn.ToString("s")" />
                                    <span asp-validation-for="ReceivedOn" class="small text-danger"></span>
                                </div>
                                <div class="col-lg-4">
                                    <label class="form-label small fw-medium text-muted text-uppercase" for="bulkAdditionalShipping">
                                        Phí vận chuyển
                                    </label>
                                    <input id="bulkAdditionalShipping" name="AdditionalShipping" class="form-control include-suffix" inputmode="numeric"
                                           data-decimal="currency" value="" placeholder="Phí vận chuyển" data-val="true" 
                                           data-val-number="Số tiền phải là số" data-val-range="Số tiền phải lớn hơn 0" data-val-range-min="0.1" />
                                </div>
                                <div class="col-lg-4">
                                    <label class="form-label small fw-medium text-muted" for="bulkAdditionalTax">
                                        <span class="text-uppercase">Thuế</span>
                                        <span class="small text-muted d-none" id="bulkAdditionalTaxHint"></span>
                                    </label>
                                    <select asp-for="TaxRate" id="bulkTaxRate" class="form-select">
                                        <option value="" selected="@(!Model.TaxRate.HasValue)">Không thuế</option>
                                        @foreach (var taxRate in Model.AvailableTaxRates)
                                        {
                                            <option value="@taxRate" selected="@(taxRate == Model.TaxRate)">@(taxRate)%</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="d-flex align-items-center justify-content-between gap-3 mb-2">
                                <label class="form-label small fw-medium text-muted text-uppercase">Danh sách hàng nhận</label>
                                <button type="button" class="btn btn-sm btn-secondary" id="bulkReceiveAddRow">
                                    <i class="bi bi-plus-lg me-1"></i> Thêm dòng
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table data-table mb-0" id="bulkReceiveTable">
                                    <thead>
                                        <tr>
                                            <th class="text-center"></th>
                                            <th class="ps-2">Hàng hóa</th>
                                            <th class="text-end pe-2 d-none d-xl-table-cell">Còn</th>
                                            <th class="text-end pe-2">Số lượng</th>
                                            <th class="text-end pe-3">Giá nhập</th>
                                            <th class="ps-2">Kho nhận</th>
                                            <th class="text-end pe-2"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="bulkReceiveTableBody"></tbody>
                                </table>
                            </div>
                            <div class="text-center mt-2 mb-3 d-none text-danger" id="bulkReceiveItemsError">
                                Vui lòng thêm ít nhất một dòng nhận hàng.
                            </div>
                            <div class="order-summary mb-3">
                                <div class="order-summary-row">
                                    <span class="label">Tạm tính</span>
                                    <span class="value" id="bulkSubtotal">0</span>
                                </div>
                                <div class="order-summary-row d-none">
                                    <span class="label">Thuế</span>
                                    <span class="value text-muted" id="bulkTaxDisplay">0</span>
                                </div>
                                <div class="order-summary-row total">
                                    <span class="label">Tổng cộng</span>
                                    <span class="value" id="bulkGrandTotal">0</span>
                                </div>
                                <div class="order-summary-row d-none">
                                    <span class="label">Phí vận chuyển</span>
                                    <span class="value text-muted" id="bulkShippingDisplay">0</span>
                                </div>
                            </div>
                            <div>
                                @await Html.PartialAsync("_ImageUploader", new ImageUploaderModel
                                {
                                    FieldName = "PictureIds",
                                    Label = "Bằng chứng nhận",
                                    MaxFiles = 3,
                                    Required = true,
                                    ExistingPictureIds = Model.PictureIds
                                })
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="py-4 text-center text-muted">
                            Không có hàng hóa phù hợp để nhận
                        </div>
                    }
                    <div class="modal-footer border-0 pt-0 pb-3">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                        @if (Model.RemainingReceivableItems.Count > 0)
                        {
                            <button type="submit" class="btn btn-success" id="bulkReceiveSubmit">
                                <i class="bi bi-check-all me-1"></i>Xác nhận
                            </button>
                        }
                    </div>
                </fieldset>
            </form>
        </div>
    </div>
</div>