@model PurchaseOrderDetailsModel
@{
    ViewData[ViewConstants.PageTitle] = $"Đơn nhập - {Model.Info.Code}";
    var purchaseOrderStatus = (PurchaseOrderStatus)Model.Info.Status;
    var hasReceipts = Model.RelatedGoodsReceipts.Count > 0;
    var hasReturns = Model.RelatedVendorReturns.Count > 0;
    var allocationCount = 0;
    foreach (var item in Model.Info.Items)
    {
        var itemRegularAllocationCount = Model.AllocationsPerItem.TryGetValue(item.Id, out var allocationsForCount)
            ? allocationsForCount.Count
            : 0;
        var itemDirectShipAllocationCount = Model.DirectShipAllocationsPerItem.TryGetValue(item.Id, out var directShipAllocationsForCount)
            ? directShipAllocationsForCount.Count
            : 0;
        allocationCount += itemRegularAllocationCount > 0 ? itemRegularAllocationCount : itemDirectShipAllocationCount;
    }
    var hasAnyAllocations = allocationCount > 0;
    var receivingDocumentCount = Model.RelatedGoodsReceipts.Count + Model.RelatedVendorReturns.Count;
}

@functions {
    string BuildReceiptItemsHtml(IList<RelatedGoodsReceiptItemModel> items)
    {
        if (items.Count == 0) return string.Empty;
        var sb = new System.Text.StringBuilder("<div class=\"po-items-list\">");
        foreach (var item in items)
        {
            var name = System.Net.WebUtility.HtmlEncode(item.ProductName);
            var qty = item.Quantity.DisplayQuantity();
            var wh = string.IsNullOrEmpty(item.WarehouseName)
                ? string.Empty
                : $" <span class=\"text-muted\">· {System.Net.WebUtility.HtmlEncode(item.WarehouseName)}</span>";
            sb.Append($"<div class=\"po-items-row\"><div class=\"po-items-name\">{name}{wh}</div><div class=\"po-items-qty\">{qty}</div></div>");
        }
        sb.Append("</div>");
        return sb.ToString();
    }

    string BuildReturnItemsHtml(IList<RelatedVendorReturnItemModel> items)
    {
        if (items.Count == 0) return string.Empty;
        var sb = new System.Text.StringBuilder("<div class=\"po-items-list\">");
        foreach (var item in items)
        {
            var name = System.Net.WebUtility.HtmlEncode(item.ProductName);
            var accepted = item.AcceptedQuantity.DisplayQuantity();
            var requested = item.RequestedQuantity.DisplayQuantity();
            var qtyDisplay = item.AcceptedQuantity < item.RequestedQuantity
                ? $"<span class=\"text-warning\">{accepted}</span> / {requested}"
                : accepted;
            sb.Append($"<div class=\"po-items-row\"><div class=\"po-items-name\">{name}</div><div class=\"po-items-qty\">{qtyDisplay}</div></div>");
        }
        sb.Append("</div>");
        return sb.ToString();
    }

    string ReturnStatusColor(VendorReturnStatus status) => status switch
    {
        VendorReturnStatus.Draft => "secondary",
        VendorReturnStatus.Inspecting => "warning",
        VendorReturnStatus.Confirmed => "success",
        VendorReturnStatus.Cancelled => "danger",
        _ => "secondary"
    };

    string ReturnStatusText(VendorReturnStatus status) => status switch
    {
        VendorReturnStatus.Draft => "Nháp",
        VendorReturnStatus.Inspecting => "Đang kiểm",
        VendorReturnStatus.Confirmed => "Đã xác nhận",
        VendorReturnStatus.Cancelled => "Đã hủy",
        _ => status.ToString()
    };

    string AllocationStatusText(int status) => status switch
    {
        0 => "Đã phân bổ",
        1 => "Nhận một phần",
        2 => "Đã nhận đủ",
        3 => "Chờ khách xác nhận",
        4 => "Khách đã nhận",
        5 => "Đã hủy",
        _ => "Không rõ"
    };

    string AllocationStatusColor(int status) => status switch
    {
        0 => "secondary",
        1 => "warning",
        2 => "success",
        3 => "info text-white",
        4 => "success",
        5 => "danger",
        _ => "secondary"
    };
}

@section TitleSection {
    <h1 class="topbar-page-title">
        Đơn nhập
        <span class="text-muted">@Model.Info.Code</span>
        @if (purchaseOrderStatus != PurchaseOrderStatus.Draft)
        {
            <span class="text-muted small d-none d-md-inline">
                <span class="status-badge @purchaseOrderStatus.GetDisplayColor()">
                    @purchaseOrderStatus.GetDisplayText()
                </span>
            </span>
        }
    </h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="List" asp-controller="PurchaseOrder" class="text-decoration-none">Đơn nhập</a></li>
                <li class="breadcrumb-item active" aria-current="page">Đơn nhập @Model.Info.Code</li>
            </ol>
        </nav>
    </div>
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/purchaseorder-details.css" asp-append-version="true" />
}

@await Html.PartialAsync("_PurchaseOrderWorkflowBar", Model)

<div class="order-workflow-layout">
    <div class="order-workflow-main">
        @await Html.PartialAsync("_POWorkflowOrderingPanel", Model)
        @await Html.PartialAsync("_POWorkflowReceivingPanel", Model)
        @await Html.PartialAsync("_POWorkflowAllocationPanel", Model)
        @await Html.PartialAsync("_POWorkflowSettlementPanel", Model)
    </div>
    <aside class="order-workflow-timeline">
        @await Html.PartialAsync("_PurchaseOrderWorkflowTimeline", Model)
    </aside>
</div>

@if (Model.Info.Status == (int)PurchaseOrderStatus.Receiving)
{
    <div class="modal fade" id="closePartialModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content purchaseorder-modal-content">
                <form asp-action="ClosePartial" asp-route-id="@Model.Info.Id" method="post">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold">
                            <i class="bi bi-archive me-2 text-warning"></i>
                            Đóng đơn
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-warning border-0 small">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            Đơn sẽ chuyển sang <strong>Hoàn tất</strong> ngay cả khi chưa nhận đủ số đã đặt.
                            Số chênh lệch xem như NCC không giao tiếp.
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold text-muted text-uppercase" for="closePartialReason">Lý do đóng đơn</label>
                            <textarea name="reason" id="closePartialReason" class="form-control" rows="3" required minlength="3" maxlength="1000"
                                      placeholder="VD: NCC ngừng cung cấp, đặt sai số lượng, ..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0 pb-3">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-archive me-1"></i>Đóng đơn
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (Model.Info.CanAddItems)
{
    <div class="modal fade" id="addProductModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content purchaseorder-modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Thêm sản phẩm</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="AddPurchaseOrderItem" method="post" id="addProductForm">
                    <input type="hidden" name="purchaseOrderId" value="@Model.Info.Id" />
                    <input type="hidden" id="addItemDecimalPlaces" name="QuantityDecimalPlaces" value="0" />
                    <div class="modal-body py-3">
                        <div class="mb-3">
                            <div id="productPicker"></div>
                            <input type="text" class="visually-hidden" id="itemProductId" name="ProductId" value=""
                                   data-val="true" data-val-required="Vui lòng chọn hàng hóa" />
                            <span class="small text-danger field-validation-valid"
                                  data-valmsg-for="ProductId" data-valmsg-replace="true"></span>
                        </div>
                        <div id="modalProductInfo" class="d-none">
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small fw-medium text-muted" for="itemQuantity">Số lượng</label>
                                    <input id="itemQuantity" name="quantity" class="form-control no-additional-element"
                                           data-decimal="quantity" value="1" inputmode="decimal"
                                           data-val="true" data-val-required="Vui lòng nhập số lượng"
                                           data-val-range="Số lượng phải lớn hơn 0" data-val-range-min="0.0001"
                                           data-val-number="Số lượng phải là số" />
                                    <span class="small text-danger field-validation-valid"
                                          data-valmsg-for="quantity" data-valmsg-replace="true"></span>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-medium text-muted" for="itemUnitPrice">Đơn giá</label>
                                    <input id="itemUnitPrice" name="unitCost" class="form-control no-additional-element"
                                           data-decimal="currency" inputmode="numeric"
                                           data-val="true" data-val-required="Vui lòng nhập đơn giá."
                                           data-val-number="Đơn giá phải là số" />
                                    <span class="small text-danger field-validation-valid"
                                          data-valmsg-for="unitCost" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div id="recentPricesHint" class="mt-2 d-none">
                                <div id="recentPricesAutoFillInfo" class="d-none small text-success mb-1">
                                    <i class="bi bi-check-circle-fill me-1"></i>
                                    <span id="recentPricesAutoFillText"></span>
                                </div>
                                <div class="border rounded-3 bg-light p-2 mt-1">
                                    <div class="small fw-semibold text-muted mb-1">
                                        <i class="bi bi-clock-history me-1"></i> Giá nhập gần nhất theo nhà cung cấp
                                    </div>
                                    <div id="recentPricesTableWrapper">
                                        <table class="table table-sm table-borderless mb-0 small" id="recentPricesTable">
                                            <thead class="text-muted">
                                                <tr>
                                                    <th class="ps-0 py-1">Nhà cung cấp</th>
                                                    <th class="text-end py-1">Giá nhập</th>
                                                    <th class="text-end py-1 text-nowrap">Ngày</th>
                                                </tr>
                                            </thead>
                                            <tbody id="recentPricesTbody"></tbody>
                                        </table>
                                    </div>
                                    <div id="recentPricesEmpty" class="text-muted fst-italic small d-none py-1">
                                        Chưa có lịch sử nhập hàng cho sản phẩm này.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0 pb-3">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" id="btnAddItem" class="btn btn-success d-none">
                            <i class="bi bi-check-lg me-1"></i>Xác nhận
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (Model.Info.CanReceiveGoods)
{
    <div class="modal fade" id="receiveItemModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content purchaseorder-modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Nhập hàng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="Receive" method="post">
                    <div class="modal-body py-4">
                        <input type="hidden" name="PurchaseOrderId" value="@Model.Info.Id" />
                        <input type="hidden" name="PurchaseOrderItemId" id="modalItemId" />
                        <input type="hidden" name="QuantityDecimalPlaces" id="modalDecimalPlaces" value="0" />
                        <input type="hidden" name="OversupplyAction" id="modalOversupplyAction" value="" />
                        <input type="hidden" name="DirectShipOrderId" id="modalDsOrderId" value="" />
                        <input type="hidden" name="DirectShipOrderItemId" id="modalDsOrderItemId" value="" />
                        <input type="hidden" name="DirectShipExistingAllocationId" id="modalDsExistingAllocationId" value="" />

                        <div class="alert alert-info border-0 mb-4">
                            <div class="small fw-bold">
                                Sản phẩm:
                                <span id="modalItemName" class="fs-6 fw-bold text-dark">Tên sản phẩm</span>
                            </div>
                            <div class="small mt-1 mt-1 fst-italic">
                                Còn lại cần nhập:
                                <span id="modalItemRemaining" class="fw-bold">0</span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Số lượng nhận</label>
                            <input name="ReceivedQuantity" id="modalReceivedQty" inputmode="decimal" class="form-control" data-testid="po-receive-quantity" data-decimal="quantity" value="0" required />
                            <div id="modalDistributionPreview" class="d-none mt-2 p-2 rounded border-start border-3 border-primary bg-light small">
                                <div class="fw-semibold text-muted mb-1 text-uppercase ui-fs-07">Phân phối hàng nhận</div>
                                <div id="modalDistributionDetails" class="d-flex flex-column gap-1"></div>
                            </div>
                        </div>

                        <div id="oversupplyWarningPanel" class="alert alert-warning border-0 mt-0 mb-3 d-none">
                            <div class="fw-bold mb-2 small">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                Số lượng nhận vượt quá số lượng đặt hàng. Chọn cách xử lý:
                            </div>
                            <div class="d-flex flex-column gap-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="oversupplyChoice" id="oversupplyAccept" value="AcceptToMainWarehouse" />
                                    <label class="form-check-label small" for="oversupplyAccept">
                                        <span class="fw-semibold">Nhập kho chính phần thừa</span>
                                        <div class="text-muted">Phần thừa được nhập vào kho chính, không giao khách.</div>
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="oversupplyChoice" id="oversupplyReject" value="RejectOversupply" />
                                    <label class="form-check-label small" for="oversupplyReject">
                                        <span class="fw-semibold">Từ chối phần thừa</span>
                                        <div class="text-muted">Chỉ ghi nhận đúng số lượng đặt, trả lại phần thừa cho NCC.</div>
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="oversupplyChoice" id="oversupplyCancel" value="Cancel" checked />
                                    <label class="form-check-label small" for="oversupplyCancel">
                                        <span class="fw-semibold">Hủy</span>
                                        <div class="text-muted">Đóng modal, không lưu.</div>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3" id="modalWarehouseSection">
                            <label class="form-label small fw-bold text-muted text-uppercase">Kho nhập hàng</label>
                            <select name="WarehouseId" class="form-select" data-testid="po-receive-warehouse" required>
                                @foreach (var option in Model.AvailableWarehouses.Options)
                                {
                                    <option value="@option.Id" selected="@(Model.Info.WarehouseId == option.Id)">@option.Name</option>
                                }
                            </select>
                            <span id="remainingWarehouseReceivedQuantity"></span>
                        </div>

                        <div class="mb-2" id="modalSellingPriceSection">
                            <label class="form-label small fw-bold text-muted text-uppercase">
                                Giá bán
                                <span class="text-body-tertiary text-lowercase fw-normal">(có thể bỏ trống để giữ nguyên giá hiện tại)</span>
                            </label>
                            <input name="SellingPrice" id="modalSellingPrice" class="form-control no-additional-element no-hint"
                                   data-decimal="currency" value="" inputmode="numeric" />
                            <div class="small text-muted mt-1">
                                Giá vốn của lô này: <span id="modalItemUnitCost" class="fw-bold">0</span>
                            </div>
                            <div id="modalSellingPriceWarning" class="alert alert-warning mt-2 py-2 small d-none" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                <span>Cảnh báo: giá bán nhỏ hơn hoặc bằng giá vốn — bán sẽ bị lỗ.</span>
                            </div>
                        </div>

                        <hr class="my-3" />
                        <div>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="modalDsToggle" data-testid="po-receive-direct-ship" />
                                <label class="form-check-label fw-semibold small" for="modalDsToggle">
                                    <i class="bi bi-send me-1"></i> Giao thẳng cho khách hàng
                                </label>
                            </div>
                            <div id="modalDsSection" class="d-none">
                                <div id="modalDsLoading" class="text-muted small py-2 d-none">
                                    <span class="spinner-border spinner-border-sm me-1"></span> Đang tải đơn hàng...
                                </div>
                                <div id="modalDsEmpty" class="alert alert-warning py-2 small d-none">
                                    <i class="bi bi-exclamation-circle me-1"></i> Không có đơn hàng phù hợp cho sản phẩm này.
                                </div>
                                <div id="modalDsOrderList" class="d-none mb-3">
                                    <label class="form-label small fw-semibold text-muted text-uppercase">Chọn đơn hàng</label>
                                    <div id="modalDsOrderItems" class="list-group list-group-flush border rounded ui-max-h-180-scroll"></div>
                                </div>
                                <div id="modalDsFields" class="d-none">
                                    <div class="alert alert-primary py-2 small mb-2" id="modalDsSelectedOrder"></div>
                                    <div class="mb-2">
                                        <input type="text" name="DirectShipAddress" id="modalDsAddressInput"
                                               class="form-control form-control-sm" placeholder="Địa chỉ giao hàng" />
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <input type="text" name="DirectShipContactName" id="modalDsContactName"
                                                   class="form-control form-control-sm" placeholder="Tên người nhận" />
                                        </div>
                                        <div class="col-6">
                                            <input type="text" name="DirectShipContactPhone" id="modalDsContactPhone"
                                                   class="form-control form-control-sm" placeholder="Số điện thoại" inputmode="tel" />
                                        </div>
                                    </div>
                                </div>
                                <div class="alert alert-danger py-2 small d-none" id="modalDsError"></div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0 pb-4">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-success" data-testid="po-receive-submit">
                            <i class="bi bi-check-lg me-1"></i>Xác nhận
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="editDirectShipAddressModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content purchaseorder-modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Sửa địa chỉ giao</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UpdateAddress" asp-controller="DirectShipDelivery" method="post">
                <div class="modal-body py-4">
                    <input type="hidden" id="editDsAllocationId" name="AllocationId" />
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase" for="editDsAddress">Địa chỉ giao</label>
                        <input name="NewAddress" id="editDsAddress" class="form-control" data-val="true"
                               data-val-required="Vui lòng nhập địa chỉ" data-val-maxlength="Địa chỉ tối đa 500 ký tự" data-val-maxlength-max="500" />
                        <span class="small text-danger field-validation-valid" data-valmsg-for="NewAddress" data-valmsg-replace="true"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase" for="editDsContactPhone">Điện thoại</label>
                        <input id="editDsContactPhone" name="NewContactPhone" type="text" class="form-control" inputmode="tel"
                               data-val-regex="Số điện thoại không hợp lệ." data-val-regex-pattern="0\d{9,10}"
                               data-val="true" data-val-required="Vui lòng nhập số điện thoại" />
                        <span class="small text-danger field-validation-valid" data-valmsg-for="NewContactPhone" data-valmsg-replace="true"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase" for="editDsContactName">Người nhận</label>
                        <input id="editDsContactName" name="NewContactName" type="text" class="form-control"
                               data-val="true" data-val-maxlength="Tên người nhận tối đa 200 ký tự" data-val-maxlength-max="200" />
                        <span class="small text-danger field-validation-valid" data-valmsg-for="NewContactName" data-valmsg-replace="true"></span>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 pb-4">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary" id="btnSaveDirectShipAddress">
                        <i class="bi bi-check-lg me-1"></i>Xác nhận
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="markDirectShipModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content purchaseorder-modal-content">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title fw-bold">@L["PurchaseOrder.MarkDirectShip.Title"]</h5>
                    <p class="text-muted small mb-0" id="markDsOrderSummary"></p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <input type="hidden" id="markDsAllocationId" />
                <div class="alert alert-info border-0 small">
                    <i class="bi bi-info-circle me-1"></i>
                    @L["PurchaseOrder.MarkDirectShip.HelpText"]
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted text-uppercase">@L["PurchaseOrder.MarkDirectShip.Address"] <span class="text-danger">*</span></label>
                    <textarea id="markDsAddress" class="form-control" rows="2"></textarea>
                </div>
                <div class="mb-3">
