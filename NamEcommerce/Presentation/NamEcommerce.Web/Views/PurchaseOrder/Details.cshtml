                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-medium text-muted" for="bulkAdditionalShipping">
                                            Phí vận chuyển <span class="text-body-tertiary fw-normal">(tùy chọn)</span>
                                        </label>
                                        <input id="bulkAdditionalShipping" name="AdditionalShipping"
                                               class="form-control no-additional-element no-hint"
                                               data-decimal="currency" value="" placeholder="0" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-medium text-muted d-flex justify-content-between align-items-end" for="bulkAdditionalTax">
                                            <span>Thuế <span class="text-body-tertiary fw-normal">(tùy chọn)</span></span>
                                            <div class="btn-group btn-group-sm" role="group" aria-label="Chế độ thuế">
                                                <input type="radio" class="btn-check" name="bulkTaxMode" id="bulkTaxModeAmount" value="amount" checked />
                                                <label class="btn btn-outline-secondary py-0 px-2" for="bulkTaxModeAmount">Số tiền</label>
                                                <input type="radio" class="btn-check" name="bulkTaxMode" id="bulkTaxModePercent" value="percent" />
                                                <label class="btn btn-outline-secondary py-0 px-2" for="bulkTaxModePercent">%</label>
                                            </div>
                                        </label>
                                        <div class="input-group">
                                            <input id="bulkAdditionalTaxInput" class="form-control no-additional-element no-hint"
                                                   data-decimal="currency" value="" placeholder="0" />
                                            <span class="input-group-text d-none" id="bulkAdditionalTaxSuffix">%</span>
                                        </div>
                                        <input type="hidden" name="AdditionalTax" id="bulkAdditionalTax" value="0" />
                                        <div class="small text-muted mt-1 d-none" id="bulkAdditionalTaxHint"></div>
                                    </div>
                                </div>

                                <hr class="my-3" />

                                <div class="order-summary">
                                    <div class="order-summary-row">
                                        <span class="label">Tạm tính đợt nhận</span>
                                        <span class="value" id="bulkSubtotal">0</span>
                                    </div>
                                    <div class="order-summary-row">
                                        <span class="label">Phí vận chuyển</span>
                                        <span class="value text-muted" id="bulkShippingDisplay">0</span>
                                    </div>
                                    <div class="order-summary-row">
                                        <span class="label">Thuế</span>
                                        <span class="value text-muted" id="bulkTaxDisplay">0</span>
                                    </div>
                                    <div class="order-summary-row total">
                                        <span class="label">Cộng dồn vào đơn</span>
                                        <span class="value" id="bulkGrandTotal">0</span>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer border-0 pt-0 pb-3">
                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                                <button type="submit" class="btn btn-success" id="bulkReceiveSubmit">
                                    <i class="bi bi-check-lg me-1"></i> Xác nhận nhận hàng
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }

        <div class="modal fade" id="editDirectShipAddressModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow rounded-4">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold">Sửa địa chỉ giao</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body py-4">
                        <input type="hidden" id="editDsAllocationId" />
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Địa chỉ giao <span class="text-danger">*</span></label>
                            <textarea id="editDsAddress" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Người nhận</label>
                            <input id="editDsContactName" type="text" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Điện thoại</label>
                            <input id="editDsContactPhone" type="text" class="form-control" />
                        </div>
                        <div id="editDsSuccessBanner" class="alert alert-warning border-0 d-none">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            Đã cập nhật — vui lòng in lại phiếu giao cho NCC.
                        </div>
                        <div id="editDsErrorBanner" class="alert alert-danger border-0 small d-none"></div>
                    </div>
                    <div class="modal-footer border-0 pt-0 pb-4">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="button" class="btn btn-primary" id="btnSaveDirectShipAddress">
                            <i class="bi bi-save me-1"></i> Lưu
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @section Styles {
            <style>
                .po-items-popover-content .popover-body {
                    padding: 0.5rem 0.75rem;
                }

                .po-items-list {
                    min-width: 240px;
                }

                .po-items-row {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    gap: 0.75rem;
                    padding: 0.25rem 0;
                    font-size: 0.85rem;
                }

                    .po-items-row + .po-items-row {
                        border-top: 1px dashed var(--bs-border-color, #dee2e6);
                    }

                .po-items-name {
                    flex: 1;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                    max-width: 280px;
                }

                .po-items-qty {
                    font-variant-numeric: tabular-nums;
                    font-weight: 500;
                }

                /* Tinh chỉnh cards related documents */
                .content-card.h-100 {
                    display: flex;
                    flex-direction: column;
                }

                    .content-card.h-100 > .table-responsive {
                        flex: 1;
                    }
            </style>
        }
        @section Scripts {
            <partial name="_ValidationScriptsPartial" />

            <script>
                document.querySelectorAll('.btnEditDirectShipAddress').forEach(btn => {
                    btn.addEventListener('click', function() {
                        document.getElementById('editDsAllocationId').value = this.dataset.allocationId;
                        document.getElementById('editDsAddress').value = this.dataset.address || '';
                        document.getElementById('editDsContactName').value = this.dataset.contactName || '';
                        document.getElementById('editDsContactPhone').value = this.dataset.contactPhone || '';
                        document.getElementById('editDsSuccessBanner').classList.add('d-none');
                        document.getElementById('editDsErrorBanner').classList.add('d-none');
                        bootstrap.Modal.getOrCreate(document.getElementById('editDirectShipAddressModal')).show();
                    });
                });

                document.getElementById('btnSaveDirectShipAddress')?.addEventListener('click', async function() {
                    const allocationId = document.getElementById('editDsAllocationId').value;
                    const newAddress = document.getElementById('editDsAddress').value.trim();
                    const successBanner = document.getElementById('editDsSuccessBanner');
                    const errorBanner = document.getElementById('editDsErrorBanner');
                    successBanner.classList.add('d-none');
                    errorBanner.classList.add('d-none');
                    if (!newAddress) {
                        errorBanner.textContent = 'Địa chỉ giao không được để trống.';
                        errorBanner.classList.remove('d-none');
                        return;
                    }
                    try {
                        const resp = await fetch('/DirectShipDelivery/UpdateAddress', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' },
                            body: JSON.stringify({
                                allocationId,
                                newAddress,
                                newContactName: document.getElementById('editDsContactName').value.trim() || null,
                                newContactPhone: document.getElementById('editDsContactPhone').value.trim() || null
                            })
                        });
                        const data = await resp.json();
                        if (data.success) successBanner.classList.remove('d-none');
                        else { errorBanner.textContent = data.message || 'Có lỗi xảy ra.'; errorBanner.classList.remove('d-none'); }
                    } catch { errorBanner.textContent = 'Lỗi kết nối.'; errorBanner.classList.remove('d-none'); }
                });
            </script>

            @if (Model.RelatedGoodsReceipts.Count > 0 || Model.RelatedVendorReturns.Count > 0)
            {
                <script>
                    // Init popover cho mã phiếu nhận/trả hàng. Bootstrap không auto-init popover.
                    document.querySelectorAll('[data-bs-toggle="popover"]').forEach(el => {
                        bootstrap.Popover.getOrCreateInstance(el, { container: 'body', sanitize: false });
                    });
                </script>
            }

            <script type="module">
                import ProductPicker from '/modules/ProductPicker.js';

                let productPickerInstance = null;

                document.addEventListener('DOMContentLoaded', function() {
                // Initialize Product Picker for Add Product Modal
                const addProductModal = document.getElementById('addProductModal');
                if (addProductModal) {
                initializeProductPicker();

                addProductModal.addEventListener('hidden.bs.modal', function() {
                // Reset form when modal closes
                resetAddProductForm();
                });
                }

                // Handle Add Product Form Submission
                const addProductForm = document.getElementById('addProductForm');
                if (addProductForm) {
                addProductForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                if(!$(this).valid())
                return;
                await submitAddProductForm();
                });
                }

                // Initialize Receive Item Modal
                let itemRemainingQty = 0;
                const receiveItemModal = document.getElementById('receiveItemModal');
                if (receiveItemModal) {
                receiveItemModal.addEventListener('show.bs.modal', function(event) {
                const button = event.relatedTarget;
                const itemId = button.getAttribute('data-item-id');
                const itemName = button.getAttribute('data-item-name');
                const remainingRaw = button.getAttribute('data-item-remaining');
                const remaining = DecimalFields.formatQuantity(remainingRaw);
                const unitCostRaw = parseFloat(button.getAttribute('data-item-unit-cost')) || 0;
                const unitPriceRaw = parseFloat(button.getAttribute('data-item-unit-price')) || 0;

                document.getElementById('modalItemId').value = itemId;
                document.getElementById('modalItemName').innerText = itemName;
                document.getElementById('modalItemRemaining').innerText = remaining;
                document.getElementById('modalReceivedQty').value = remaining;
                document.getElementById('modalReceivedQty').max = remainingRaw;
                itemRemainingQty = parseFloat(remainingRaw) || 0;
                document.getElementById('oversupplyWarningPanel').classList.add('d-none');
                document.getElementById('modalOversupplyAction').value = '';
                document.getElementById('oversupplyCancel').checked = true;

                // Pre-fill selling price with current UnitPrice; display unit cost for reference
                const sellingPriceInput = document.getElementById('modalSellingPrice');
                const unitCostDisplay = document.getElementById('modalItemUnitCost');
                sellingPriceInput.value = DecimalFields.formatCurrency(String(Math.trunc(unitPriceRaw)));
                sellingPriceInput.setAttribute('data-unit-cost', unitCostRaw);
                unitCostDisplay.innerText = DecimalFields.formatCurrency(String(Math.trunc(unitCostRaw)));
                updateSellingPriceWarning();
                });

                // Warning when selling price <= unit cost (lỗ)
                const sellingPriceInput = document.getElementById('modalSellingPrice');
                if (sellingPriceInput) {
                sellingPriceInput.addEventListener('input', updateSellingPriceWarning);
                sellingPriceInput.addEventListener('change', updateSellingPriceWarning);
                }
                }

                const modalQtyInput = document.getElementById('modalReceivedQty');
                if (modalQtyInput) {
                modalQtyInput.addEventListener('input', function () {
                const val = (window.DecimalFields && typeof DecimalFields.stripFormatting === 'function')
                    ? parseFloat(DecimalFields.stripFormatting(this.value, true)) || 0
                    : parseFloat((this.value || '').replace(/[^0-9.]/g, '')) || 0;
                const panel = document.getElementById('oversupplyWarningPanel');
                if (val > itemRemainingQty && itemRemainingQty > 0) {
                panel.classList.remove('d-none');
                } else {
                panel.classList.add('d-none');
                document.getElementById('modalOversupplyAction').value = '';
                }
                });
                }

                const receiveItemForm = receiveItemModal?.querySelector('form');
                if (receiveItemForm) {
                receiveItemForm.addEventListener('submit', function (e) {
                const val = (window.DecimalFields && typeof DecimalFields.stripFormatting === 'function')
                    ? parseFloat(DecimalFields.stripFormatting(document.getElementById('modalReceivedQty').value, true)) || 0
                    : parseFloat((document.getElementById('modalReceivedQty').value || '').replace(/[^0-9.]/g, '')) || 0;
                if (val > itemRemainingQty && itemRemainingQty > 0) {
                const choice = document.querySelector('input[name="oversupplyChoice"]:checked')?.value;
                if (!choice || choice === 'Cancel') {
                e.preventDefault();
                bootstrap.Modal.getInstance(receiveItemModal)?.hide();
                return;
                }
                document.getElementById('modalOversupplyAction').value = choice;
                }
                });
                }

                function updateSellingPriceWarning() {
                const sellingPriceInput = document.getElementById('modalSellingPrice');
                const warningBox = document.getElementById('modalSellingPriceWarning');
                if (!sellingPriceInput || !warningBox) return;
                // Currency format trên UI là "3.400.000" (dấu chấm phân cách nghìn) — không có phần thập phân.
                const stripped = (window.DecimalFields && typeof DecimalFields.stripFormatting === 'function')
                    ? DecimalFields.stripFormatting(sellingPriceInput.value, false)
                    : (sellingPriceInput.value || '').toString().replace(/[^0-9]/g, '');
                const unitCost = parseFloat(sellingPriceInput.getAttribute('data-unit-cost')) || 0;
                const sellingPrice = parseFloat(stripped);
                if (!isNaN(sellingPrice) && sellingPrice > 0 && sellingPrice <= unitCost) {
                warningBox.classList.remove('d-none');
                } else {
                warningBox.classList.add('d-none');
                }
                }

                // Handle Remove Item Button
                document.querySelectorAll('.btnRemoveItem').forEach(btn => {
                btn.addEventListener('click', async function(e) {
                e.preventDefault();
                const itemId = this.getAttribute('data-id');
                const purchaseOrderId = this.getAttribute('data-purchaseorder');
                const itemName = this.getAttribute('data-name');

                if (confirm(`Bạn có chắc chắn muốn xóa "${itemName}" khỏi đơn hàng?`)) {
                await removeItem(itemId, purchaseOrderId);
                }
                });
                });
                });

                function initializeProductPicker() {
                const container = document.getElementById('productPicker');
                if (container && !productPickerInstance) {
                productPickerInstance = new ProductPicker(container, { purchase: true });
                productPickerInstance.setVendor('@Model.Info.VendorId', '@Html.Raw(Model.Info.VendorName)');
                container.addEventListener('select', (e) => {
                onProductSelected(e.detail.product);
                });
                container.addEventListener('remove', onProductRemove);

                }
                }

                let detailsRecentPrices = [];

                async function onProductSelected(product) {
                const modalProductInfo = document.getElementById('modalProductInfo');
                const itemUnitPrice = document.getElementById('itemUnitPrice');
                const itemProductId = document.getElementById('itemProductId');
                const btnAddProduct = document.getElementById('btnAddItem');

                modalProductInfo.classList.remove('d-none');
                itemUnitPrice.value = 0;
                itemProductId.value = product.id;
                btnAddProduct.classList.remove('d-none');

                // Fetch giá nhập gần nhất
                detailsRecentPrices = [];
                try {
                const res = await fetch(`@Url.Action("RecentPurchasePrices")?productId=${product.id}`);
                if (res.ok) detailsRecentPrices = await res.json();
                } catch {}

                // VendorId của đơn nhập hiện tại (server-side)
                const currentVendorId = '@Model.Info.VendorId.ToString()';

                // Tự động điền giá theo NCC đang chọn
                if (currentVendorId) {
                const match = detailsRecentPrices.find(p => p.vendorId === currentVendorId);
                if (match) {
                itemUnitPrice.value = match.unitCost;
                DecimalFields.autoWrap(itemUnitPrice.closest('div') ?? document.body);
                }
                }

                renderDetailsPriceTable(currentVendorId);
                renderDetailsAutoFillInfo(currentVendorId);
                }

                function onProductRemove() {
                const modalProductInfo = document.getElementById('modalProductInfo');
                const itemUnitPrice = document.getElementById('itemUnitPrice');
                const itemProductId = document.getElementById('itemProductId');
                const btnAddProduct = document.getElementById('btnAddItem');

                modalProductInfo.classList.add('d-none');
                itemUnitPrice.value = 0;
                itemProductId.value = '';
                btnAddProduct.classList.add('d-none');
                detailsRecentPrices = [];
                document.getElementById('recentPricesHint')?.classList.add('d-none');
                document.getElementById('recentPricesAutoFillInfo')?.classList.add('d-none');
                }

                function renderDetailsPriceTable(currentVendorId) {
                const hintEl = document.getElementById('recentPricesHint');
                const emptyEl = document.getElementById('recentPricesEmpty');
                const tableWrapper = document.getElementById('recentPricesTableWrapper');
                const tbody = document.getElementById('recentPricesTbody');
                if (!hintEl || !tbody) return;

                hintEl.classList.remove('d-none');

                if (detailsRecentPrices.length === 0) {
                tableWrapper?.classList.add('d-none');
                emptyEl?.classList.remove('d-none');
                return;
                }

                tableWrapper?.classList.remove('d-none');
                emptyEl?.classList.add('d-none');
                tbody.innerHTML = '';

                detailsRecentPrices.forEach(p => {
                const isCurrentVendor = currentVendorId && p.vendorId === currentVendorId;
                const tr = document.createElement('tr');
                tr.className = isCurrentVendor ? 'table-success' : '';
                tr.style.cursor = 'pointer';
                tr.title = `Đơn: ${p.purchaseOrderCode}`;
                tr.innerHTML = `
                    <td class="ps-0 py-1 text-nowrap">
                        ${isCurrentVendor ? '<i class="bi bi-arrow-right-short text-success"></i>' : ''}
                        <span class="fw-medium">${escapeHtmlDetails(p.vendorName ?? 'Không rõ')}</span>
                        <div class="text-muted" style="font-size:0.72rem">${escapeHtmlDetails(p.purchaseOrderCode)}</div>
                    </td>
                    <td class="text-end py-1 fw-semibold text-nowrap">
                        ${DecimalFields.formatCurrency(String(p.unitCost))}
                    </td>
                    <td class="text-end py-1 text-muted text-nowrap" style="font-size:0.75rem">${escapeHtmlDetails(p.purchaseDate)}</td>`;

                tr.addEventListener('click', () => {
                const priceInput = document.getElementById('itemUnitPrice');
                if (priceInput) {
                priceInput.value = p.unitCost;
                DecimalFields.autoWrap(priceInput.closest('div') ?? document.body);
                }
                });
                tbody.appendChild(tr);
                });
                }

                function renderDetailsAutoFillInfo(currentVendorId) {
                const infoEl = document.getElementById('recentPricesAutoFillInfo');
                const textEl = document.getElementById('recentPricesAutoFillText');
                if (!infoEl || !textEl) return;

                if (detailsRecentPrices.length === 0) { infoEl.classList.add('d-none'); return; }

                if (currentVendorId) {
                const match = detailsRecentPrices.find(p => p.vendorId === currentVendorId);
                if (match) {
                textEl.textContent = `Đã tự động điền giá nhập gần nhất của nhà cung cấp này (${DecimalFields.formatCurrency(String(match.unitCost))}).`;
                infoEl.className = 'small text-success mb-1';
                infoEl.classList.remove('d-none');
                } else {
                textEl.textContent = 'Nhà cung cấp này chưa có lịch sử nhập hàng cho sản phẩm — vui lòng nhập giá thủ công.';
                infoEl.className = 'small text-warning mb-1';
                infoEl.classList.remove('d-none');
                }
                } else {
                textEl.textContent = 'Nhấn vào hàng trong bảng bên dưới để chọn giá nhập.';
                infoEl.className = 'small text-info mb-1';
                infoEl.classList.remove('d-none');
                }
                }

                function escapeHtmlDetails(str) {
                return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
                }

                async function submitAddProductForm() {
                const form = document.getElementById('addProductForm');

                try {
                const response = await fetch('@Url.Action("AddPurchaseOrderItem")', {
                method: 'POST',
                headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: $(form).serialize()
                });

                const data = await response.json();

                if (data.success) {
                // Close modal and refresh page
                bootstrap.Modal.getInstance(document.getElementById('addProductModal'))?.hide();
                setTimeout(() => location.reload(), 300);
                } else {
                alert('Lỗi: ' + (data.errorMessage || 'Không thể thêm sản phẩm'));
                }
                } catch (error) {
                console.error('Error:', error);
                alert('Có lỗi xảy ra khi thêm sản phẩm');
                }
                }

                function resetAddProductForm() {
                document.getElementById('itemQuantity').value = '1';
                document.getElementById('itemUnitPrice').value = '';
                document.getElementById('modalProductInfo').classList.add('d-none');

                if (productPickerInstance) {
                productPickerInstance.clear();
                }
                }

                async function removeItem(itemId, purchaseOrderId) {
                try {
                const response = await fetch('@Url.Action("RemovePurchaseOrderItem")', {
                method: 'POST',
                headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify({
                purchaseOrderItemId: itemId,
                purchaseOrderId: purchaseOrderId
                })
                });

                const data = await response.json();

                if (data.success) {
                // Remove row from table
                document.querySelector(`tr[data-item-id="${itemId}"]`)?.remove();

                // Refresh page after short delay
                setTimeout(() => location.reload(), 300);
                } else {
                alert('Lỗi: ' + (data.errorMessage || 'Không thể xóa sản phẩm'));
                }
                } catch (error) {
                console.error('Error:', error);
                alert('Có lỗi xảy ra khi xóa sản phẩm');
                }
                }

            </script>
            <script type="module">
                import {Vendor, default as VendorPicker} from '/modules/VendorPicker.js';

                (() => {
                    const elementVendorPicker = document.getElementById('vendorPicker');
                    if (!elementVendorPicker)
                        return;

                    let editPurchaseOrderState = {

                    };
                    function setState(patch){
                        const newState = Object.assign({}, editPurchaseOrderState, patch);
                        editPurchaseOrderState = newState;
                        renderState();
                    }
                    function renderState() {
                        getEl('VendorId').value = editPurchaseOrderState.vendor?.id ?? '';
                    }

                    const {vendorPicker, vendor} = bindVendorPicker();

                    setState({ vendor });

                    function bindVendorPicker() {
                        const vendorPicker = new VendorPicker(elementVendorPicker);

                        elementVendorPicker.addEventListener('select', (e) => {
                            setState({ vendor: e.detail?.vendor ? new Vendor(e.detail.vendor) : null });
                        });
                        elementVendorPicker.addEventListener('remove', () => {
                             setState({ vendor: null });
                        });

                        const initialVendor = elementVendorPicker.dataset;
                        if (initialVendor.id) {
                            var vendor = new Vendor(initialVendor);
                            vendorPicker.displayVendor(vendor);
                            return {vendorPicker, vendor: initialVendor};
                        }
                        return {vendorPicker, vendor: null};
                    }
                })();
            </script>
            @if (Model.Info.CanReceiveGoods && Model.Info.Items.Any(i => i.RemainingQuantity > 0))
            {
                <script type="module">
                    import BulkReceiveController from '/modules/BulkReceiveController.js';

                    document.addEventListener('DOMContentLoaded', () => {
                        const modalEl = document.getElementById('bulkReceiveModal');
                        if (!modalEl) return;
                        new BulkReceiveController().init(modalEl);
                    });
                </script>
            }
        }
