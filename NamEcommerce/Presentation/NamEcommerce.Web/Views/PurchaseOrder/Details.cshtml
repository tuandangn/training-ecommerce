@model PurchaseOrderDetailsModel
@{
    ViewData[ViewConstants.PageTitle] = $"Đơn nhập - {Model.Info.Code}";
    var purchaseOrderStatus = (PurchaseOrderStatus)Model.Info.Status;
    var hasReceipts = Model.RelatedGoodsReceipts.Count > 0;
    var hasReturns = Model.RelatedVendorReturns.Count > 0;
}
@functions {
    string BuildReceiptItemsHtml(IList<RelatedGoodsReceiptItemModel> items)
    {
        if (items.Count == 0) return string.Empty;
        var sb = new System.Text.StringBuilder("<div class=\"po-items-list\">");
        foreach (var item in items)
        {
            var name = System.Net.WebUtility.HtmlEncode(item.ProductName);
            var qty = item.Quantity.DisplayQuantity();
            var wh = string.IsNullOrEmpty(item.WarehouseName)
                ? string.Empty
                : $" <span class=\"text-muted\">· {System.Net.WebUtility.HtmlEncode(item.WarehouseName)}</span>";
            sb.Append($"<div class=\"po-items-row\"><div class=\"po-items-name\">{name}{wh}</div><div class=\"po-items-qty\">{qty}</div></div>");
        }
        sb.Append("</div>");
        return sb.ToString();
    }

    string BuildReturnItemsHtml(IList<RelatedVendorReturnItemModel> items)
    {
        if (items.Count == 0) return string.Empty;
        var sb = new System.Text.StringBuilder("<div class=\"po-items-list\">");
        foreach (var item in items)
        {
            var name = System.Net.WebUtility.HtmlEncode(item.ProductName);
            var accepted = item.AcceptedQuantity.DisplayQuantity();
            var requested = item.RequestedQuantity.DisplayQuantity();
            var qtyDisplay = item.AcceptedQuantity < item.RequestedQuantity
                ? $"<span class=\"text-warning\">{accepted}</span> / {requested}"
                : accepted;
            sb.Append($"<div class=\"po-items-row\"><div class=\"po-items-name\">{name}</div><div class=\"po-items-qty\">{qtyDisplay}</div></div>");
        }
        sb.Append("</div>");
        return sb.ToString();
    }

    string ReturnStatusColor(VendorReturnStatus status) => status switch
    {
        VendorReturnStatus.Draft => "secondary",
        VendorReturnStatus.Inspecting => "warning",
        VendorReturnStatus.Confirmed => "success",
        VendorReturnStatus.Cancelled => "danger",
        _ => "secondary"
    };

    string ReturnStatusText(VendorReturnStatus status) => status switch
    {
        VendorReturnStatus.Draft => "Nháp",
        VendorReturnStatus.Inspecting => "Đang kiểm",
        VendorReturnStatus.Confirmed => "Đã xác nhận",
        VendorReturnStatus.Cancelled => "Đã hủy",
        _ => status.ToString()
    };
}
@section TitleSection {
    <h1 class="topbar-page-title">
        Đơn nhập
        <span class="text-muted">@Model.Info.Code</span>
        @if (purchaseOrderStatus != PurchaseOrderStatus.Draft)
        {
            <span class="text-muted small">
                <span class="status-badge @purchaseOrderStatus.GetDisplayColor()">
                    @purchaseOrderStatus.GetDisplayText()
                </span>
            </span>
        }
    </h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="List" asp-controller="PurchaseOrder" class="text-decoration-none">Đơn nhập</a></li>
                <li class="breadcrumb-item active" aria-current="page">Đơn nhập @Model.Info.Code</li>
            </ol>
        </nav>
    </div>
}
<div class="content-card mb-3 position-relative">
    <div class="content-card-body-flush">
        <div class="row g-3">
            <div class="col-lg-8 order-0">
                <div class="mb-3">
                    <div class="content-card-header">
                        <h5>Danh sách hàng hóa</h5>
                        @if (Model.Info.CanAddItems)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#addProductModal">
                                <i class="bi bi-plus-lg me-1"></i>
                                <span class="d-none d-lg-inline">Thêm hàng hóa</span>
                                <span class="d-lg-none">Thêm</span>
                            </button>
                        }
                    </div>
                    <div class="content-card-body-flush">
                        <div class="table-responsive">
                            <table class="table data-table mb-0">
                                <thead>
                                    <tr>
                                        <th class="ps-3">Hàng hóa</th>
                                        <th class="text-end">Số lượng</th>
                                        <th class="text-end">Đã Nhận</th>
                                        <th class="text-end">Đơn giá</th>
                                        <th class="text-end d-none d-md-table-cell @(Model.Info.CanAddItems ? "" : "pe-3")">Thành tiền</th>
                                        @if (Model.Info.CanAddItems || Model.Info.CanReceiveGoods)
                                        {
                                            <th class="text-center"></th>
                                        }
                                    </tr>
                                </thead>
                                <tbody id="itemsTableBody">
                                    @if (Model.Info.Items.Count > 0)
                                    {
                                        @for (var i = 0; i < Model.Info.Items.Count; i++)
                                        {
                                            var item = Model.Info.Items[i];
                                            <tr id="row-@i" data-item-id="@item.Id">
                                                <td class="ps-3">
                                                    <div class="d-flex align-items-center gap-2">
                                                        @if (!string.IsNullOrEmpty(item.ProductPicture))
                                                        {
                                                            <img src="@item.ProductPicture" class="rounded d-none d-lg-block"
                                                                 style="width: 40px; height: 40px; object-fit: cover;" alt="@item.ProductName" />
                                                        }
                                                        else
                                                        {
                                                            <div class="d-flex align-items-center justify-content-center rounded bg-light"
                                                                 style="width: 40px; height: 40px;">
                                                                <i class="bi bi-image text-muted"></i>
                                                            </div>
                                                        }
                                                        <span class="fw-medium product-name">@item.ProductName</span>
                                                    </div>
                                                    <input type="hidden" class="product-id" value="@item.ProductId" />
                                                </td>
                                                <td class="text-end">
                                                    <span class="quantity-text">@item.QuantityOrdered.DisplayQuantity()</span>
                                                    <input type="hidden" class="row-qty" value="@item.QuantityOrdered" />
                                                </td>
                                                <td class="text-end">
                                                    @if (item.QuantityReceived >= item.QuantityOrdered)
                                                    {
                                                        <span class="status-badge success py-1 px-2">
                                                            <i class="bi bi-check-circle-fill"></i> @item.QuantityReceived.DisplayQuantity()
                                                        </span>
                                                    }
                                                    else if (item.QuantityReceived > 0)
                                                    {
                                                        <span class="status-badge warning py-1 px-2">
                                                            @item.QuantityReceived.DisplayQuantity()
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted fst-italic small">Chưa nhận</span>
                                                    }
                                                </td>
                                                <td class="text-end text-muted">
                                                    <span class="unit-price-text text-nowrap">
                                                        @item.UnitCost.DisplayCurrency()
                                                    </span>
                                                </td>
                                                <td class="text-end fw-600 text-primary d-none d-md-table-cell @(Model.Info.CanAddItems ? "" : "pe-4")">
                                                    <span class="total-price-text">
                                                        @item.TotalCost.DisplayCurrency()
                                                    </span>
                                                </td>
                                                @if (Model.Info.CanAddItems || (Model.Info.CanReceiveGoods && item.RemainingQuantity > 0))
                                                {
                                                    <td class="text-center">
                                                        <div>
                                                            <button class="btn-table-action" type="button" data-bs-toggle="dropdown">
                                                                <i class="bi bi-three-dots-vertical"></i>
                                                            </button>
                                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                                                @if (Model.Info.CanReceiveGoods && item.RemainingQuantity > 0)
                                                                {
                                                                    <li>
                                                                        <button class="dropdown-item" data-bs-toggle="modal" data-bs-target="#receiveItemModal"
                                                                                data-item-id="@item.Id" data-item-name="@item.ProductName" data-item-remaining="@item.RemainingQuantity"
                                                                                data-item-unit-cost="@item.UnitCost" data-item-unit-price="@item.CurrentUnitPrice">
                                                                            <i class="bi bi-truck"></i>
                                                                            Nhận hàng
                                                                        </button>
                                                                    </li>
                                                                }
                                                                @if (Model.Info.CanAddItems)
                                                                {
                                                                    <li>
                                                                        <button class="dropdown-item btnRemoveItem" data-id="@item.Id"
                                                                                disabled="@(Model.Info.Items.Count <= 1)"
                                                                                data-purchaseorder="@Model.Info.Id" data-name="@item.ProductName">
                                                                            <i class="bi bi-trash me-2 text-danger"></i>
                                                                            Xóa bỏ
                                                                        </button>
                                                                    </li>
                                                                }
                                                            </ul>
                                                        </div>
                                                    </td>
                                                }

                                            </tr>
                                            @if (Model.DirectShipAllocationsPerItem.TryGetValue(item.Id, out var dsAllocations))
                                            {
                                                foreach (var alloc in dsAllocations)
                                                {
                                                    var deliveryStatus = alloc.DeliveryStatus.HasValue
                                                        ? (DeliveryNoteStatus)alloc.DeliveryStatus.Value
                                                        : (DeliveryNoteStatus?)null;
                                                    var (dsStatusBadge, dsStatusText) = deliveryStatus switch
                                                    {
                                                        DeliveryNoteStatus.Confirmed => ("info text-white", "Chờ khách xác nhận"),
                                                        DeliveryNoteStatus.Delivered => ("success", "Khách đã nhận"),
                                                        DeliveryNoteStatus.Cancelled => ("danger", "Đã hủy/từ chối"),
                                                        _ => alloc.Status switch
                                                        {
                                                            0 => ("secondary", "Chờ nhận"),
                                                            1 => ("warning", "Nhận một phần"),
                                                            2 => ("info text-white", "Đã nhận"),
                                                            _ => ("secondary", "Không rõ")
                                                        }
                                                    };
                                                    <tr class="table-light">
                                                        <td colspan="3" class="ps-5 py-1 small">
                                                            <i class="bi bi-send me-1 text-primary"></i>
                                                            <strong>Giao thẳng:</strong>
                                                            @alloc.DirectShipAddress
                                                            @if (!string.IsNullOrEmpty(alloc.DirectShipContactName))
                                                            { <span class="text-muted ms-2">— @alloc.DirectShipContactName</span> }
                                                            @if (!string.IsNullOrEmpty(alloc.DirectShipContactPhone))
                                                            { <span class="text-muted ms-1">(@alloc.DirectShipContactPhone)</span> }
                                                            @if (alloc.DeliveryNoteId.HasValue)
                                                            {
                                                                <a asp-controller="DeliveryNote" asp-action="Details"
                                                                   asp-route-id="@alloc.DeliveryNoteId"
                                                                   class="ms-2 text-decoration-none">@alloc.DeliveryNoteCode</a>
                                                            }
                                                        </td>
                                                        <td class="py-1 text-end small text-muted">
                                                            @alloc.ReceivedQuantity.DisplayQuantity() / @alloc.AllocatedQuantity.DisplayQuantity()
                                                        </td>
                                                        <td class="py-1"><span class="status-badge @dsStatusBadge">@dsStatusText</span></td>
                                                        <td class="py-1 text-center d-none d-md-table-cell"></td>
                                                        <td class="py-1 text-center">
                                                            <button class="btn btn-sm btn-outline-secondary py-0 px-2 btnEditDirectShipAddress"
                                                                    data-allocation-id="@alloc.AllocationId"
                                                                    data-address="@alloc.DirectShipAddress"
                                                                    data-contact-name="@(alloc.DirectShipContactName ?? "")"
                                                                    data-contact-phone="@(alloc.DirectShipContactPhone ?? "")">
                                                                <i class="bi bi-pencil-square"></i>
                                                                <span class="d-none d-lg-inline ms-1">Sửa địa chỉ giao</span>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="@(Model.Info.CanAddItems ? 6 : 5)">
                                                <div class="py-4 text-center text-muted">
                                                    <i class="bi bi-box-seam me-1"></i> Chưa có sản phẩm nào.
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @{
                            var totalShipping = Model.Info.ShippingAmount + Model.Info.AccumulatedShippingAmount;
                            var totalTax = Model.Info.TaxAmount + Model.Info.AccumulatedTaxAmount;
                            var subTotal = Model.Info.TotalAmount - totalShipping - totalTax;
                        }
                        <div class="@(Model.Info.Items.Count > 0 ? "" : "d-none") order-summary" id="tableFooter">
                            <div class="order-summary-row">
                                <span class="label">Tạm tính</span>
                                <span class="value" id="subTotal">
                                    @subTotal.DisplayCurrencyWithSymbol()
                                </span>
                            </div>
                            @if (totalShipping > 0)
                            {
                                <div class="order-summary-row">
                                    <span class="label">
                                        Phí vận chuyển
                                        @if (Model.Info.AccumulatedShippingAmount > 0 && Model.Info.ShippingAmount > 0)
                                        {
                                            <span class="small text-muted">(@Model.Info.ShippingAmount.DisplayCurrencyWithSymbol() + nhận hàng @Model.Info.AccumulatedShippingAmount.DisplayCurrencyWithSymbol())</span>
                                        }
                                        else if (Model.Info.AccumulatedShippingAmount > 0)
                                        {
                                            <span class="small text-muted">(từ nhận hàng)</span>
                                        }
                                    </span>
                                    <span class="value text-muted">@totalShipping.DisplayCurrencyWithSymbol()</span>
                                </div>
                            }
                            @if (totalTax > 0)
                            {
                                <div class="order-summary-row">
                                    <span class="label">
                                        Thuế VAT
                                        @if (Model.Info.AccumulatedTaxAmount > 0 && Model.Info.TaxAmount > 0)
                                        {
                                            <span class="small text-muted">(@Model.Info.TaxAmount.DisplayCurrencyWithSymbol() + nhận hàng @Model.Info.AccumulatedTaxAmount.DisplayCurrencyWithSymbol())</span>
                                        }
                                        else if (Model.Info.AccumulatedTaxAmount > 0)
                                        {
                                            <span class="small text-muted">(từ nhận hàng)</span>
                                        }
                                    </span>
                                    <span class="value text-muted">+ @totalTax.DisplayCurrencyWithSymbol()</span>
                                </div>
                            }
                            <div class="order-summary-row total">
                                <span class="label">Tổng cộng</span>
                                <span class="value" id="grandTotal">
                                    @Model.Info.TotalAmount.DisplayCurrencyWithSymbol()
                                </span>
                            </div>
                        </div>
                    </div>
                    @if (hasReceipts || hasReturns)
                    {
                        <div class="content-card-body">
                            <div class="row g-3 mt-1">
                                <div class="col-12">
                                    <div class="content-card mb-3 h-100">
                                        <div class="content-card-header">
                                            <h5 class="mb-0">
                                                Phiếu nhận hàng
                                                @if (hasReceipts)
                                                {
                                                    <span class="badge rounded-pill bg-light text-dark border ms-1">@Model.RelatedGoodsReceipts.Count phiếu</span>
                                                }
                                            </h5>
                                        </div>
                                        @if (!hasReceipts)
                                        {
                                            <div class="content-card-body text-center py-4">
                                                <div class="text-muted small">
                                                    Chưa có phiếu nhận hàng nào.
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="table-responsive">
                                                <table class="table data-table mb-0 align-middle">
                                                    <thead>
                                                        <tr>
                                                            <th class="ps-3">Mã phiếu</th>
                                                            <th>Kho nhập</th>
                                                            <th class="d-none d-lg-table-cell">Hàng hóa</th>
                                                            <th class="text-end">Số lượng</th>
                                                            <th class="text-end pe-3">Giá trị</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var receipt in Model.RelatedGoodsReceipts)
                                                        {
                                                            var receiptItemsHtml = BuildReceiptItemsHtml(receipt.Items);
                                                            foreach (var item in receipt.Items)
                                                            {
                                                                <tr>
                                                                    <td class="ps-3">
                                                                        <a asp-action="Details" asp-controller="GoodsReceipt" asp-route-id="@receipt.Id" class="text-decoration-none fw-medium text-nowrap"
                                                                           data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-html="true" data-bs-placement="right"
                                                                           data-bs-custom-class="po-items-popover-content"
                                                                           data-bs-title="@($"{receipt.ItemCount} mặt hàng")"
                                                                           data-bs-content="@receiptItemsHtml">
                                                                            @receipt.Code
                                                                        </a>
                                                                        <div class="small text-muted text-nowrap">
                                                                            @receipt.ReceivedOn.ToString(ViewConstants.DefaultDateTimeFormat)
                                                                        </div>
                                                                    </td>
                                                                    <td>
                                                                        <span class="small">@item.WarehouseName</span>
                                                                    </td>
                                                                    <td class="d-none d-lg-table-cell">
                                                                        @item.ProductName
                                                                    </td>
                                                                    <td class="text-end">
                                                                        <span class="fw-medium">@item.Quantity.DisplayQuantity()</span>
                                                                    </td>
                                                                    <td class="text-end pe-3 text-nowrap">
                                                                        @if (item.UnitCost.HasValue)
                                                                        {
                                                                            <span class="fw-bold text-primary">@((item.UnitCost.Value * item.Quantity).DisplayCurrencyWithSymbol())</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle small">
                                                                                <i class="bi bi-hourglass-split me-1"></i>Chờ định giá
                                                                            </span>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="content-card mb-3 h-100">
                                        <div class="content-card-header">
                                            <h5 class="mb-0">
                                                Phiếu trả hàng
                                                @if (hasReturns)
                                                {
                                                    <span class="badge rounded-pill bg-light text-dark border ms-1">@Model.RelatedVendorReturns.Count phiếu</span>
                                                }
                                            </h5>
                                        </div>
                                        @if (!hasReturns)
                                        {
                                            <div class="content-card-body text-center py-4">
                                                <div class="text-muted small">
                                                    Chưa có phiếu trả hàng nào.
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="table-responsive">
                                                <table class="table data-table mb-0 align-middle">
                                                    <thead>
                                                        <tr>
                                                            <th class="ps-3">Mã phiếu</th>
                                                            <th>Kho xuất</th>
                                                            <th class="d-none d-lg-table-cell">Hàng hóa</th>
                                                            <th class="text-end">Số lượng</th>
                                                            <th class="text-end pe-3">Giá trị</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var vendorReturn in Model.RelatedVendorReturns)
                                                        {
                                                            var returnStatus = (VendorReturnStatus)vendorReturn.Status;
                                                            var returnItemsHtml = BuildReturnItemsHtml(vendorReturn.Items);
                                                            @foreach (var item in vendorReturn.Items)
                                                            {
                                                                <tr>
                                                                    <td class="ps-3">
                                                                        <a asp-action="Details" asp-controller="VendorReturn" asp-route-id="@vendorReturn.Id" class="text-decoration-none fw-medium text-nowrap"
                                                                           data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-html="true" data-bs-placement="left"
                                                                           data-bs-custom-class="po-items-popover-content"
                                                                           data-bs-title="@($"{vendorReturn.Code} — {vendorReturn.ItemCount} mặt hàng")"
                                                                           data-bs-content="@returnItemsHtml">
                                                                            @vendorReturn.Code
                                                                        </a>
                                                                        <div class="small text-muted text-nowrap">
                                                                            @vendorReturn.ReturnDate.ToString(ViewConstants.DefaultDateTimeFormat)
                                                                        </div>
                                                                        <span class="status-badge @ReturnStatusColor(returnStatus)">
                                                                            @ReturnStatusText(returnStatus)
                                                                        </span>
                                                                    </td>
                                                                    <td>
                                                                        <span class="small">@vendorReturn.WarehouseName</span>
                                                                    </td>
                                                                    <td>
                                                                        @item.ProductName
                                                                    </td>
                                                                    <td class="text-end">
                                                                        <span class="fw-medium">@item.AcceptedQuantity.DisplayQuantity()</span>
                                                                    </td>
                                                                    <td class="text-end pe-3 text-nowrap">
                                                                        <span class="fw-bold text-danger">@((item.AcceptedQuantity * item.ReturnUnitCost).DisplayCurrencyWithSymbol())</span>
                                                                    </td>
                                                                </tr>
                                                            }
                                                            @if (vendorReturn.AdditionalCost > 0)
                                                            {
                                                                <tr>
                                                                    <td colspan="5" class="text-end pe-3 text-danger fw-medium">
                                                                        <div data-bs-toggle="tooltip" title="Chi phí phát sinh đã trừ vào tổng thu hồi">
                                                                            Phát sinh chi phí: @vendorReturn.AdditionalCost.DisplayCurrencyWithSymbol()
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-4 order-0 order-lg-1">
                @if (Model.CanModifyInfo && Model.ModifyInfo != null)
                {
                    <partial name="Details.InfoModify" model="Model.ModifyInfo" />
                }
                else
                {
                    <partial name="Details.Info" model="Model" />
                }
            </div>
        </div>
    </div>
    <div class="content-card-footer d-flex align-items-center justify-content-between">
        <a asp-action="List" class="btn btn-link text-decoration-none text-muted btn-sm">
            <i class="bi bi-arrow-left"></i>
            Trở về
        </a>
        <div>
            @if (Model.Info.Status == (int)PurchaseOrderStatus.Draft)
            {
                <form asp-action="SubmitsPurchaseOrder" asp-route-id="@Model.Info.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-send me-1"></i> Gửi đơn
                    </button>
                </form>
            }
            else if (Model.Info.Status == (int)PurchaseOrderStatus.Submitted)
            {
                <form asp-action="ChangeStatus" asp-route-id="@Model.Info.Id" asp-route-status="@((int)PurchaseOrderStatus.Approved)" method="post" class="d-inline">
                    <button type="submit" class="btn btn-info text-white">
                        <i class="bi bi-check-all me-1"></i> Duyệt đơn
                    </button>
                </form>
            }
            @if (Model.Info.CanReceiveGoods && Model.Info.Items.Any(i => i.RemainingQuantity > 0))
            {
                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#bulkReceiveModal">
                    <i class="bi bi-box-arrow-in-down me-1"></i>
                    <span>Nhận hàng</span>
                </button>
            }
            @if (hasReceipts && Model.Info.Status != (int)PurchaseOrderStatus.Cancelled)
            {
                <a class="btn btn-outline-danger"
                   asp-controller="VendorReturn" asp-action="Create"
                   asp-route-vendorId="@Model.Info.VendorId"
                   asp-route-vendorName="@Model.Info.VendorName"
                   asp-route-purchaseOrderId="@Model.Info.Id"
                   asp-route-purchaseOrderCode="@Model.Info.Code">
                    <i class="bi bi-arrow-return-left me-1"></i>
                    <span>Trả hàng</span>
                </a>
            }
            @if (Model.Info.Status == (int)PurchaseOrderStatus.Receiving)
            {
                <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#closePartialModal">
                    <i class="bi bi-archive me-1"></i> Đóng đơn
                </button>
            }
            @if (Model.Info.Status != (int)PurchaseOrderStatus.Completed && Model.Info.Status != (int)PurchaseOrderStatus.Cancelled)
            {
                <form asp-action="CancelPurchaseOrder" asp-route-id="@Model.Info.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-x-circle me-1"></i> Hủy đơn
                    </button>
                </form>
            }
        </div>
    </div>
</div>
@if (Model.Info.Status == (int)PurchaseOrderStatus.Receiving)
{
    <div class="modal fade" id="closePartialModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4">
                <form asp-action="ClosePartial" asp-route-id="@Model.Info.Id" method="post">
