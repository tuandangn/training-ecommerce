@model PurchaseOrderDetailsModel
@{
    ViewData[ViewConstants.PageTitle] = $"Đơn nhập - {Model.Info.Code}";
    var purchaseOrderStatus = (PurchaseOrderStatus)Model.Info.Status;
    var hasReceipts = Model.RelatedGoodsReceipts.Count > 0;
    var hasReturns = Model.RelatedVendorReturns.Count > 0;
    var allocationCount = 0;
    foreach (var item in Model.Info.Items)
    {
        var itemRegularAllocationCount = Model.AllocationsPerItem.TryGetValue(item.Id, out var allocationsForCount)
            ? allocationsForCount.Count
            : 0;
        var itemDirectShipAllocationCount = Model.DirectShipAllocationsPerItem.TryGetValue(item.Id, out var directShipAllocationsForCount)
            ? directShipAllocationsForCount.Count
            : 0;
        allocationCount += itemRegularAllocationCount > 0 ? itemRegularAllocationCount : itemDirectShipAllocationCount;
    }
    var hasAnyAllocations = allocationCount > 0;
    var receivingDocumentCount = Model.RelatedGoodsReceipts.Count + Model.RelatedVendorReturns.Count;
}
@functions {
    string BuildReceiptItemsHtml(IList<RelatedGoodsReceiptItemModel> items)
    {
        if (items.Count == 0) return string.Empty;
        var sb = new System.Text.StringBuilder("<div class=\"po-items-list\">");
        foreach (var item in items)
        {
            var name = System.Net.WebUtility.HtmlEncode(item.ProductName);
            var qty = item.Quantity.DisplayQuantity();
            var wh = string.IsNullOrEmpty(item.WarehouseName)
                ? string.Empty
                : $" <span class=\"text-muted\">· {System.Net.WebUtility.HtmlEncode(item.WarehouseName)}</span>";
            sb.Append($"<div class=\"po-items-row\"><div class=\"po-items-name\">{name}{wh}</div><div class=\"po-items-qty\">{qty}</div></div>");
        }
        sb.Append("</div>");
        return sb.ToString();
    }

    string BuildReturnItemsHtml(IList<RelatedVendorReturnItemModel> items)
    {
        if (items.Count == 0) return string.Empty;
        var sb = new System.Text.StringBuilder("<div class=\"po-items-list\">");
        foreach (var item in items)
        {
            var name = System.Net.WebUtility.HtmlEncode(item.ProductName);
            var accepted = item.AcceptedQuantity.DisplayQuantity();
            var requested = item.RequestedQuantity.DisplayQuantity();
            var qtyDisplay = item.AcceptedQuantity < item.RequestedQuantity
                ? $"<span class=\"text-warning\">{accepted}</span> / {requested}"
                : accepted;
            sb.Append($"<div class=\"po-items-row\"><div class=\"po-items-name\">{name}</div><div class=\"po-items-qty\">{qtyDisplay}</div></div>");
        }
        sb.Append("</div>");
        return sb.ToString();
    }

    string ReturnStatusColor(VendorReturnStatus status) => status switch
    {
        VendorReturnStatus.Draft => "secondary",
        VendorReturnStatus.Inspecting => "warning",
        VendorReturnStatus.Confirmed => "success",
        VendorReturnStatus.Cancelled => "danger",
        _ => "secondary"
    };

    string ReturnStatusText(VendorReturnStatus status) => status switch
    {
        VendorReturnStatus.Draft => "Nháp",
        VendorReturnStatus.Inspecting => "Đang kiểm",
        VendorReturnStatus.Confirmed => "Đã xác nhận",
        VendorReturnStatus.Cancelled => "Đã hủy",
        _ => status.ToString()
    };

    string AllocationStatusText(int status) => status switch
    {
        0 => "Đã phân bổ",
        1 => "Nhận một phần",
        2 => "Đã nhận đủ",
        3 => "Chờ khách xác nhận",
        4 => "Khách đã nhận",
        5 => "Đã hủy",
        _ => "Không rõ"
    };

    string AllocationStatusColor(int status) => status switch
    {
        0 => "secondary",
        1 => "warning",
        2 => "success",
        3 => "info text-white",
        4 => "success",
        5 => "danger",
        _ => "secondary"
    };
}
@section TitleSection {
    <h1 class="topbar-page-title">
        Đơn nhập
        <span class="text-muted">@Model.Info.Code</span>
        @if (purchaseOrderStatus != PurchaseOrderStatus.Draft)
        {
            <span class="text-muted small d-none d-md-inline">
                <span class="status-badge @purchaseOrderStatus.GetDisplayColor()">
                    @purchaseOrderStatus.GetDisplayText()
                </span>
            </span>
        }
    </h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="List" asp-controller="PurchaseOrder" class="text-decoration-none">Đơn nhập</a></li>
                <li class="breadcrumb-item active" aria-current="page">Đơn nhập @Model.Info.Code</li>
            </ol>
        </nav>
    </div>
}
@await Html.PartialAsync("_PurchaseOrderWorkflowBar", Model)


<div class="order-workflow-layout">
    <div class="order-workflow-main">
        @await Html.PartialAsync("_POWorkflowOrderingPanel", Model)
        @await Html.PartialAsync("_POWorkflowReceivingPanel", Model)
        @await Html.PartialAsync("_POWorkflowAllocationPanel", Model)
        @await Html.PartialAsync("_POWorkflowSettlementPanel", Model)
    </div>
    <aside class="order-workflow-timeline">
        @await Html.PartialAsync("_PurchaseOrderWorkflowTimeline", Model)
    </aside>
</div>
@if (Model.Info.Status == (int)PurchaseOrderStatus.Receiving)
{
    <div class="modal fade" id="closePartialModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow rounded-4">
                <form asp-action="ClosePartial" asp-route-id="@Model.Info.Id" method="post">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold">
                            <i class="bi bi-archive me-2 text-warning"></i>
                            Đóng đơn dù chưa nhận hết
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-warning border-0 small">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            Đơn sẽ chuyển sang <strong>Hoàn tất</strong> ngay cả khi chưa nhận đủ số đã đặt.
                            Số chênh lệch xem như NCC không giao tiếp.
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold text-muted text-uppercase" for="closePartialReason">Lý do đóng đơn</label>
                            <textarea name="reason" id="closePartialReason" class="form-control" rows="3" required minlength="3" maxlength="1000"
                                      placeholder="VD: NCC ngừng cung cấp, đặt sai số lượng, ..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0 pb-3">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-check-lg me-1"></i> Xác nhận đóng đơn
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
@if (Model.Info.CanAddItems)
