                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    var remainingItems = Model.Info.Items.Where(i => i.RemainingQuantity > 0).ToList();
    var warehouseOptions = Model.AvailableWarehouses.Options.ToList();

    <div class="modal fade" id="bulkReceiveModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content border-0 shadow rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-box-arrow-in-down me-2 text-success"></i>
                        Nhận hàng cùng lúc
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="BulkReceive" method="post" id="bulkReceiveForm">
                    <input type="hidden" name="PurchaseOrderId" value="@Model.Info.Id" />

                    <script type="application/json" id="bulkReceiveData">
                                        {
                                            "defaultWarehouseId": @Json.Serialize(Model.Info.WarehouseId),
                                            "items": [
                                                @for (var idx = 0; idx < remainingItems.Count; idx++)
                                                {
                                                            var item = remainingItems[idx];
                                                            <text>{
                                                                        "id": "@item.Id",
                                                                        "name": @Json.Serialize(item.ProductName),
                                                                        "remaining": @item.RemainingQuantity.ToString("#"),
                                                                        "unitCost": @item.UnitCost.ToString("#")
                                                                    }@(idx < remainingItems.Count - 1 ? "," : "")</text>
                                                        }
                                                    ],
                                                    "warehouses": [
                                                        @for (var w = 0; w < warehouseOptions.Count; w++)
                                                        {
                                                                    var option = warehouseOptions[w];
                                                                    <text>{
                                                                                "id": "@option.Id",
                                                                                "name": @Json.Serialize(option.Name)
                                                                            }@(w < warehouseOptions.Count - 1 ? "," : "")</text>
                                                                }
                                                            ]
                                                        }
                            </script>

                            <div class="modal-body py-3">
                                <div class="alert alert-info border-0 small mb-3">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Mỗi dòng = một lần nhận: cùng một hàng hóa có thể chia ra nhiều dòng để nhận vào các kho khác nhau.
                                </div>

                                <div class="table-responsive">
                                    <table class="table table-sm align-middle mb-0" id="bulkReceiveTable">
                                        <thead class="text-muted small text-uppercase">
                                            <tr>
                                                <th class="ps-0">Hàng hóa</th>
                                                <th style="width: 22%">Kho nhận</th>
                                                <th class="text-end" style="width: 14%">Số lượng</th>
                                                <th class="text-end" style="width: 18%">Giá vốn thực tế</th>
                                                <th class="text-end pe-0" style="width: 1%"></th>
                                            </tr>
                                        </thead>
                                        <tbody id="bulkReceiveTableBody"></tbody>
                                    </table>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" id="bulkReceiveAddRow">
                                        <i class="bi bi-plus-lg me-1"></i> Thêm dòng
                                    </button>
                                    <span class="small text-danger d-none" id="bulkReceiveItemsError">
