@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function() {
            function activatePanel(targetId) {
                document.querySelectorAll('.workflow-panel').forEach(p => p.classList.remove('active'));
                const target = document.getElementById(targetId.replace('#', ''));
                if (target) {
                    target.classList.add('active');
                    //target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
                document.querySelectorAll('.workflow-step').forEach(s => {
                    const href = s.getAttribute('href') || '';
                    s.classList.toggle('active', href === targetId);
                    s.setAttribute('aria-selected', href === targetId ? 'true' : 'false');
                });
            }

            document.querySelectorAll('.workflow-step').forEach(step => {
                step.addEventListener('click', function(e) {
                    e.preventDefault();
                    const href = this.getAttribute('href');
                    if (href) activatePanel(href);
                });
            });

            // Activate the initial active panel
            const activeStep = document.querySelector('.workflow-step.active');
            if (activeStep) {
                const href = activeStep.getAttribute('href');
                if (href) {
                    const target = document.getElementById(href.replace('#', ''));
                    if (target && !target.classList.contains('active')) {
                        target.classList.add('active');
                    }
                }
            } else {
                // Default: show ordering panel
                const firstPanel = document.getElementById('po-stage-ordering');
                if (firstPanel) firstPanel.classList.add('active');
            }
        })();
    </script>

    <script type="module" defer>
        import { confirm } from '/modules/modals.js';

        (function() {
            document.querySelectorAll('.change-status-form').forEach(form => {
                form.addEventListener('submit', function(e) {
                    e.preventDefault();
                    const newStatus = this.dataset.newStatus || '';
                    const message = this.dataset.confirmText || 'Bạn có chắc chắn muốn thay đổi trạng thái?';
                    confirm('Xác nhận', message)
                        .then(confirmed => {
                            if (confirmed) {
                                showPageLoading();
                                this.submit();
                            }
                        });
                });
            });

            document.getElementById('copyForm')?.addEventListener('submit', async e => {
                e.preventDefault();
                if (!await confirm('Sao chép đơn nhập', 'Tạo đơn nhập mới có hàng hóa, số lượng, giá nhập tương tự'))
                    return;
                showPageLoading();
                e.target.submit();
            });
        })();
    </script>

    <script type="module">
        import { apiPost } from '/modules/ajax-helper.js';

        //edit direct ship address
        (function() {
            const modalElement = document.getElementById('editDirectShipAddressModal');
            const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
            const form = modalElement.querySelector('form');

            document.querySelectorAll('.btnEditDirectShipAddress').forEach(btn => {
                btn.addEventListener('click', function() {
                    modalElement.querySelector('#editDsAllocationId').value = this.dataset.allocationId;
                    modalElement.querySelector('#editDsAddress').value = this.dataset.address || '';
                    modalElement.querySelector('#editDsContactName').value = this.dataset.contactName || '';
                    modalElement.querySelector('#editDsContactPhone').value = this.dataset.contactPhone || '';
                    modal.show();
                });
            });

            form.addEventListener('submit', async e => {
                e.preventDefault();

                if (!isFormValid(form))
                    return;

                const btnSubmit = form.querySelector('[type=submit]');
                btnSubmit.disabled = true;
                showPageLoading();

                const response = await apiPost('@Url.Action("UpdateAddress", "DirectShipDelivery")', new FormData(form));
                if (response.success) {
                    location.reload();
                    return;
                }
                btnSubmit.disabled = false;
                hidePageLoading();
            });
        })();

        const markDirectShipText = {
            addressRequired: @Json.Serialize(L["Error.DirectShipAddressRequired"].Value),
            phoneRequired: @Json.Serialize(L["Error.DirectShipContactPhoneRequired"].Value),
            unexpected: @Json.Serialize(L["Error.UnexpectedError"].Value),
            network: @Json.Serialize(L["Error.Network"].Value),
            saving: @Json.Serialize(L["Common.Processing"].Value),
            submit: @Json.Serialize(L["PurchaseOrder.MarkDirectShip.Submit"].Value),
            orderPrefix: @Json.Serialize(L["PurchaseOrder.MarkDirectShip.OrderPrefix"].Value),
            customerPrefix: @Json.Serialize(L["PurchaseOrder.MarkDirectShip.CustomerPrefix"].Value)
                                                                                                                                        };

        document.querySelectorAll('.btnMarkAllocationDirectShip').forEach(btn => {
            btn.addEventListener('click', function() {
                document.getElementById('markDsAllocationId').value = this.dataset.allocationId || '';
                document.getElementById('markDsAddress').value = this.dataset.shippingAddress || '';
                document.getElementById('markDsContactName').value = this.dataset.customerName || '';
                document.getElementById('markDsContactPhone').value = this.dataset.customerPhone || '';
                document.getElementById('markDsErrorBanner').classList.add('d-none');
                document.getElementById('markDsErrorBanner').textContent = '';
                const summaryParts = [];
                if (this.dataset.orderCode) summaryParts.push(`${markDirectShipText.orderPrefix}: ${this.dataset.orderCode}`);
                if (this.dataset.customerName) summaryParts.push(`${markDirectShipText.customerPrefix}: ${this.dataset.customerName}`);
                document.getElementById('markDsOrderSummary').textContent = summaryParts.join(' · ');
                bootstrap.Modal.getOrCreateInstance(document.getElementById('markDirectShipModal')).show();
            });
        });

        document.getElementById('btnMarkDirectShip')?.addEventListener('click', async function() {
            const allocationId = document.getElementById('markDsAllocationId')?.value;
            const address = document.getElementById('markDsAddress').value.trim();
            const contactName = document.getElementById('markDsContactName').value.trim();
            const contactPhone = document.getElementById('markDsContactPhone').value.trim();
            const errorBanner = document.getElementById('markDsErrorBanner');
            errorBanner.classList.add('d-none');
            errorBanner.textContent = '';
            if (!address) {
                errorBanner.textContent = markDirectShipText.addressRequired;
                errorBanner.classList.remove('d-none');
                return;
            }
            if (!contactPhone) {
                errorBanner.textContent = markDirectShipText.phoneRequired;
                errorBanner.classList.remove('d-none');
                return;
            }

            showPageLoading();
            const originalHtml = this.innerHTML;
            this.disabled = true;
            this.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span>${markDirectShipText.saving}`;
            try {
                const resp = await fetch('/PurchaseOrder/MarkAllocationAsDirectShip', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' },
                    body: JSON.stringify({
                        allocationId,
                        address,
                        contactName: contactName || null,
                        contactPhone,
                        priority: 0
                    })
                });
                const data = await resp.json();
                if (data.success) {
                    location.reload();
                    return;
                }
                hidePageLoading();
                errorBanner.textContent = data.message || markDirectShipText.unexpected;
                errorBanner.classList.remove('d-none');
            } catch {
                hidePageLoading();
                errorBanner.textContent = markDirectShipText.network;
                errorBanner.classList.remove('d-none');
            } finally {
                this.disabled = false;
                this.innerHTML = originalHtml || `<i class="bi bi-send me-1"></i> ${markDirectShipText.submit}`;
            }
        });
    </script>

    @if (Model.RelatedGoodsReceipts.Count > 0 || Model.RelatedVendorReturns.Count > 0)
    {
        <script>
            // Init popover cho mã phiếu nhận/trả hàng. Bootstrap không auto-init popover.
            document.querySelectorAll('[data-bs-toggle="popover"]').forEach(el => {
                bootstrap.Popover.getOrCreateInstance(el, { container: 'body', sanitize: false });
            });
        </script>
    }

    <script type="module">
        import ProductPicker from '/modules/ProductPicker.js';
        import { apiGet } from '/modules/ajax-helper.js';

        let productPickerInstance = null;

        document.addEventListener('DOMContentLoaded', function() {
            // Initialize Product Picker for Add Product Modal
            const addProductModal = document.getElementById('addProductModal');
            if (addProductModal) {
                initializeProductPicker();

                addProductModal.addEventListener('hidden.bs.modal', function() {
                    // Reset form when modal closes
                    resetAddProductForm();
                });
            }

            // Handle Add Product Form Submission
            const addProductForm = document.getElementById('addProductForm');
            if (addProductForm) {
                addProductForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    if (!$(this).valid())
                        return;
                    await submitAddProductForm();
                });
            }

            // Initialize Receive Item Modal
            let itemRemainingQty = 0;
            let currentDsAvailableQty = 0;
            let currentDsCustomerName = null;
            let currentReceivePoItemId = null;
            const receiveItemModal = document.getElementById('receiveItemModal');
            let receiveDsAbortController = null;
            let receiveOriginalPhone = '';
            let currentUnitMeasurement = '';

            function _escReceive(s) {
                return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
            }
            function _parseReceiveQty() {
                const el = document.getElementById('modalReceivedQty');
                const v = el?.value || '0';
                const decimals = parseInt(el?.dataset?.decimals ?? '2', 10);
                return (window.DecimalFields?.stripFormatting)
                    ? parseFloat(DecimalFields.stripFormatting(v, decimals)) || 0
                    : parseFloat(v.replace(/[^0-9.]/g, '')) || 0;
            }
            function syncWarehouseVisibility() {
                const warehouseSection = document.getElementById('modalWarehouseSection');
                const sellingPriceSection = document.getElementById('modalSellingPriceSection');
                if (!warehouseSection) return;
                const qty = _parseReceiveQty();
                const dsToggle = document.getElementById('modalDsToggle');
                // Only hide warehouse when user explicitly enabled DS toggle and qty fully covered
                const isDsActive = dsToggle?.checked && currentDsAvailableQty > 0;
                const hide = isDsActive && qty > 0 && qty <= currentDsAvailableQty;
                warehouseSection.classList.toggle('d-none', hide);
                sellingPriceSection?.classList.toggle('d-none', hide);
            }
            function toggleDirectShipCheckbox() {
                // DS toggle is always available — user decides whether to direct ship
            }

            function updateDistributionPreview() {
                const preview = document.getElementById('modalDistributionPreview');
                const details = document.getElementById('modalDistributionDetails');
                if (!preview || !details) return;
                const dsToggle = document.getElementById('modalDsToggle');
                const qty = _parseReceiveQty();
                // Only show distribution preview when user explicitly chose DS via toggle
                if (!dsToggle?.checked || currentDsAvailableQty <= 0 || qty <= 0) {
                    preview.classList.add('d-none');
                    return;
                }
                let rem = qty;
                const rows = [];
                const dsQty = Math.min(rem, currentDsAvailableQty);
                if (dsQty > 0) {
                    const fmt = window.DecimalFields?.formatQuantity ? DecimalFields.formatQuantity(String(dsQty)) : dsQty;
                    rows.push(`<div class="d-flex align-items-center gap-2"><span class="badge bg-primary">${DecimalFields.formatQuantity(fmt) + currentUnitMeasurement}</span><span class="text-muted"><i class="bi bi-send me-1"></i>Giao thẳng · ${_escReceive(currentDsCustomerName)}</span></div>`);
                    rem -= dsQty;
                }
                if (rem > 0) {
                    const fmt = window.DecimalFields?.formatQuantity ? DecimalFields.formatQuantity(String(rem)) : rem;
                    rows.push(`<div class="d-flex align-items-center gap-2"><span class="badge bg-secondary">${DecimalFields.formatQuantity(fmt) + currentUnitMeasurement}</span><span class="text-muted"><i class="bi bi-building me-1"></i>Nhập kho</span></div>`);
                }
                details.innerHTML = rows.join('');
                preview.classList.remove('d-none');
            }

            if (receiveItemModal) {
                receiveItemModal.addEventListener('show.bs.modal', function(event) {
                    const button = event.relatedTarget;
                    const itemId = button.getAttribute('data-item-id');
                    const itemName = button.getAttribute('data-item-name');
                    const remainingRaw = button.getAttribute('data-item-remaining');
                    const remaining = DecimalFields.formatQuantity(remainingRaw);
                    const unitCostRaw = parseFloat(button.getAttribute('data-item-unit-cost')) || 0;
                    const unitPriceRaw = parseFloat(button.getAttribute('data-item-unit-price')) || 0;
                    currentUnitMeasurement = button.getAttribute('data-unit') ? ' ' + button.getAttribute('data-unit') : '';

                    currentReceivePoItemId = itemId;
                    document.getElementById('modalItemId').value = itemId;
                    document.getElementById('modalItemName').innerText = itemName;
                    document.getElementById('modalItemRemaining').innerText = remaining + currentUnitMeasurement;
                    const receivedQtyInput = document.getElementById('modalReceivedQty');
                    receivedQtyInput.value = remaining;
                    receivedQtyInput.max = remainingRaw;
                    const receiveDecimalPlaces = parseInt(button.getAttribute('data-decimalplaces') || '0', 10);
                    receivedQtyInput.dataset.decimals = String(receiveDecimalPlaces);
                    receivedQtyInput.dataset.decimalBound = '';
                    window.DecimalFields?.bindInput?.(receivedQtyInput);
                    const modalDpInput = document.getElementById('modalDecimalPlaces');
                    if (modalDpInput) modalDpInput.value = receiveDecimalPlaces;
                    itemRemainingQty = parseFloat(remainingRaw) || 0;
                    document.getElementById('oversupplyWarningPanel').classList.add('d-none');
                    document.getElementById('modalOversupplyAction').value = '';
                    document.getElementById('oversupplyCancel').checked = true;
                    document.getElementById('remainingWarehouseReceivedQuantity').textContent = '';

                    // Reset DS section and distribution preview
                    document.getElementById('modalDistributionPreview')?.classList.add('d-none');
                    currentDsAvailableQty = 0;
                    currentDsCustomerName = null;
                    receiveOriginalPhone = '';
                    document.getElementById('modalDsToggle').checked = false;
                    document.getElementById('modalDsSection').classList.add('d-none');
                    document.getElementById('modalWarehouseSection')?.classList.remove('d-none');
                    document.getElementById('modalSellingPriceSection')?.classList.remove('d-none');
                    document.getElementById('modalDsOrderItemId').value = '';
                    document.getElementById('modalDsOrderId').value = '';
                    document.getElementById('modalDsExistingAllocationId').value = '';
                    document.getElementById('modalDsAddressInput').value = '';
                    document.getElementById('modalDsContactName').value = '';
                    document.getElementById('modalDsContactPhone').value = '';
                    document.getElementById('modalDsOrderList').classList.add('d-none');
                    document.getElementById('modalDsFields').classList.add('d-none');
                    document.getElementById('modalDsEmpty').classList.add('d-none');
                    document.getElementById('modalDsError').classList.add('d-none');

                    // Pre-fill selling price with current UnitPrice; display unit cost for reference
                    const sellingPriceInput = document.getElementById('modalSellingPrice');
                    const unitCostDisplay = document.getElementById('modalItemUnitCost');
                    sellingPriceInput.value = DecimalFields.formatCurrency(String(Math.trunc(unitPriceRaw)));
                    sellingPriceInput.setAttribute('data-unit-cost', unitCostRaw);
                    unitCostDisplay.innerText = DecimalFields.formatCurrencyWithSymbol(String(Math.trunc(unitCostRaw)));
                    updateSellingPriceWarning();
                    toggleDirectShipCheckbox();
                    updateDistributionPreview();
                    syncWarehouseVisibility();
                });

                // DS toggle
                document.getElementById('modalDsToggle')?.addEventListener('change', function() {
                    const section = document.getElementById('modalDsSection');
                    if (this.checked) {
                        section.classList.remove('d-none');
                        loadReceiveDsItems(currentReceivePoItemId);
                    } else {
                        section.classList.add('d-none');
                        currentDsAvailableQty = 0;
                        currentDsCustomerName = null;
                        document.getElementById('modalDsOrderItemId').value = '';
                        document.getElementById('modalDsOrderId').value = '';
                        document.getElementById('modalDsExistingAllocationId').value = '';
                        receiveOriginalPhone = '';
                    }
                    syncWarehouseVisibility();
                    toggleDirectShipCheckbox();
                    updateDistributionPreview();
                });

                // Warning when selling price <= unit cost (lỗ)
                const sellingPriceInput = document.getElementById('modalSellingPrice');
                if (sellingPriceInput) {
                    sellingPriceInput.addEventListener('input', updateSellingPriceWarning);
                    sellingPriceInput.addEventListener('change', updateSellingPriceWarning);
                }
            }

            async function loadReceiveDsItems(poItemId) {
                receiveDsAbortController?.abort();
                receiveDsAbortController = new AbortController();
                const signal = receiveDsAbortController.signal;
                const loading = document.getElementById('modalDsLoading');
                const empty = document.getElementById('modalDsEmpty');
                const list = document.getElementById('modalDsOrderList');
                const items = document.getElementById('modalDsOrderItems');
                const fields = document.getElementById('modalDsFields');
                const errorBox = document.getElementById('modalDsError');
                loading.classList.remove('d-none');
                empty.classList.add('d-none');
                list.classList.add('d-none');
                fields.classList.add('d-none');
                errorBox.classList.add('d-none');
                try {
                    const [eligibleResponse, nonDirectShipResponse] = await Promise.all([
                        apiGet(`/PurchaseOrder/EligibleOrderItems?purchaseOrderId=@(Model.Info.Id)&purchaseOrderItemId=${poItemId}`, { signal }),
                        apiGet(`/PurchaseOrder/NonDirectShipAllocations?purchaseOrderId=@(Model.Info.Id)&purchaseOrderItemId=${poItemId}`, { signal })
                    ]);
                    if (!eligibleResponse.success || !nonDirectShipResponse.success)
                        throw new Error('Lỗi tải dữ liệu');

                    const [eligible, nonDs] = [eligibleResponse.data, nonDirectShipResponse.data];
                    loading.classList.add('d-none');
                    if ((!eligible || !eligible.length) && (!nonDs || !nonDs.length)) {
                        empty.classList.remove('d-none');
                        return;
                    }
                    items.innerHTML = '';

                    function selectDsItem(availableQty, shippingAddress, customerName, customerPhone) {
                        document.querySelectorAll('#modalDsOrderItems .list-group-item-action').forEach(el => el.classList.remove('active'));
                        document.getElementById('modalDsAddressInput').value = shippingAddress;
                        document.getElementById('modalDsContactName').value = customerName;
                        document.getElementById('modalDsContactPhone').value = customerPhone;
                        receiveOriginalPhone = customerPhone;
                        fields.classList.remove('d-none');
                        currentDsAvailableQty = parseFloat(DecimalFields.stripFormatting(String(availableQty), 2)) || 0;
                        currentDsCustomerName = customerName;
                        syncWarehouseVisibility();
                        toggleDirectShipCheckbox();
                        updateDistributionPreview();
                    }

                    if (eligible && eligible.length) {
                        const hdr = document.createElement('div');
                        hdr.className = 'list-group-item list-group-item-light text-muted small fw-semibold py-1 px-3 border-0';
                        hdr.textContent = 'Tạo phân bổ mới + Giao thẳng';
                        items.appendChild(hdr);
                        eligible.forEach(function(order) {
                            const btn = document.createElement('button');
                            btn.type = 'button';
                            btn.className = 'list-group-item list-group-item-action py-2 px-3';
                            btn.innerHTML = `<div class="d-flex justify-content-between align-items-start">
                                                                                                                                                            <div><span class="fw-semibold">${order.orderCode}</span><span class="text-muted ms-2 small">${order.customerName}</span></div>
                                                                                                                                                            <span class="badge bg-success ms-2">Còn ${DecimalFields.formatQuantity(order.availableToAllocate) + currentUnitMeasurement}</span>
                                                                                                                                                        </div>`;
                            btn.addEventListener('click', function() {
                                btn.classList.add('active');
                                document.getElementById('modalDsOrderId').value = order.orderId;
                                document.getElementById('modalDsOrderItemId').value = order.orderItemId;
                                document.getElementById('modalDsExistingAllocationId').value = '';
                                document.getElementById('modalDsSelectedOrder').textContent =
                                    `Đơn hàng: ${order.orderCode} · Khách: ${order.customerName} · Có thể nhận: ${order.availableToAllocate}`;
                                selectDsItem(order.availableToAllocate, order.shippingAddress || '', order.customerName || '', order.customerPhone || '');
                            });
                            items.appendChild(btn);
                        });
                    }

                    if (nonDs && nonDs.length) {
                        const hdr = document.createElement('div');
                        hdr.className = 'list-group-item list-group-item-light text-muted small fw-semibold py-1 px-3 border-0';
                        hdr.textContent = 'Nâng cấp giao thẳng (phân bổ hiện có)';
                        items.appendChild(hdr);
                        nonDs.forEach(function(alloc) {
                            const btn = document.createElement('button');
                            btn.type = 'button';
                            btn.className = 'list-group-item list-group-item-action py-2 px-3';
                            btn.innerHTML = `<div class="d-flex justify-content-between align-items-start">
                                                                                                                                                            <div><span class="fw-semibold">${alloc.orderCode}</span><span class="text-muted ms-2 small">${alloc.customerName}</span></div>
                                                                                                                                                            <span class="badge bg-warning text-dark ms-2">Còn ${DecimalFields.formatQuantity(alloc.remainingQty) + currentUnitMeasurement}</span>
                                                                                                                                                        </div>`;
                            btn.addEventListener('click', function() {
                                btn.classList.add('active');
                                document.getElementById('modalDsExistingAllocationId').value = alloc.allocationId;
                                document.getElementById('modalDsOrderId').value = '';
                                document.getElementById('modalDsOrderItemId').value = '';
                                document.getElementById('modalDsSelectedOrder').textContent =
                                    `Nâng cấp: ${alloc.orderCode} · Khách: ${alloc.customerName} · Còn: ${alloc.remainingQty}`;
                                selectDsItem(alloc.remainingQty, alloc.shippingAddress || '', alloc.customerName || '', alloc.customerPhone || '');
                            });
                            items.appendChild(btn);
                        });
                    }

                    list.classList.remove('d-none');
                } catch (err) {
                    if (err.name === 'AbortError') return;
                    loading.classList.add('d-none');
                    errorBox.textContent = err.message || 'Không thể tải danh sách đơn hàng.';
                    errorBox.classList.remove('d-none');
                }
            }

            const modalQtyInput = document.getElementById('modalReceivedQty');
            if (modalQtyInput) {
                modalQtyInput.addEventListener('change', function() {
                    const val = (window.DecimalFields && typeof DecimalFields.stripFormatting === 'function')
                        ? parseFloat(DecimalFields.stripFormatting(this.value, 2)) || 0
                        : parseFloat((this.value || '').replace(/[^0-9.]/g, '')) || 0;
                    const panel = document.getElementById('oversupplyWarningPanel');
                    if (val > itemRemainingQty && itemRemainingQty > 0) {
                        panel.classList.remove('d-none');
                    } else {
                        panel.classList.add('d-none');
                        document.getElementById('modalOversupplyAction').value = '';
                    }
                    toggleDirectShipCheckbox();
                    updateDistributionPreview();
                    syncWarehouseVisibility();
                });
            }

            const receiveItemForm = receiveItemModal?.querySelector('form');
            if (receiveItemForm) {
                receiveItemForm.addEventListener('submit', function(e) {
                    const _rqEl = document.getElementById('modalReceivedQty');
                    const _rqDecimals = parseInt(_rqEl?.dataset?.decimals ?? '2', 10);
                    const val = (window.DecimalFields && typeof DecimalFields.stripFormatting === 'function')
                        ? parseFloat(DecimalFields.stripFormatting(_rqEl.value, _rqDecimals)) || 0
                        : parseFloat((_rqEl?.value || '').replace(/[^0-9.]/g, '')) || 0;
                    if (val > itemRemainingQty && itemRemainingQty > 0) {
                        const choice = document.querySelector('input[name="oversupplyChoice"]:checked')?.value;
                        if (!choice || choice === 'Cancel') {
                            e.preventDefault();
                            bootstrap.Modal.getInstance(receiveItemModal)?.hide();
                            return;
                        }
                        document.getElementById('modalOversupplyAction').value = choice;
                    }
                    const dsToggle = document.getElementById('modalDsToggle');
                    if (dsToggle && dsToggle.checked) {
                        const dsOrderItemId = document.getElementById('modalDsOrderItemId').value;
                        const dsExistingAllocationId = document.getElementById('modalDsExistingAllocationId').value;
                        const dsAddress = document.getElementById('modalDsAddressInput').value.trim();
                        const errorBox = document.getElementById('modalDsError');
                        if (!dsOrderItemId && !dsExistingAllocationId) {
                            e.preventDefault();
                            errorBox.textContent = 'Vui lòng chọn đơn hàng để giao thẳng.';
                            errorBox.classList.remove('d-none');
                            return;
                        }
                        const currentPhone = document.getElementById('modalDsContactPhone').value.trim();
                        if (!currentPhone) {
                            e.preventDefault();
                            errorBox.textContent = 'Vui lòng nhập số điện thoại nhận hàng giao thẳng.';
                            errorBox.classList.remove('d-none');
                            return;
                        }
                        if (!dsAddress) {
                            e.preventDefault();
                            errorBox.textContent = 'Vui lòng nhập địa chỉ giao hàng.';
                            errorBox.classList.remove('d-none');
                            return;
                        }
                        if (receiveOriginalPhone && currentPhone !== receiveOriginalPhone) {
                            if (!confirm(`Số điện thoại liên lạc đã thay đổi từ "${receiveOriginalPhone}" thành "${currentPhone}". Xác nhận tiếp tục?`)) {
                                e.preventDefault();
                                return;
                            }
                        }
                    }
                });
            }

            function updateSellingPriceWarning() {
                const sellingPriceInput = document.getElementById('modalSellingPrice');
                const warningBox = document.getElementById('modalSellingPriceWarning');
                if (!sellingPriceInput || !warningBox) return;
                // Currency format trên UI là "3.400.000" (dấu chấm phân cách nghìn) — không có phần thập phân.
                const stripped = (window.DecimalFields && typeof DecimalFields.stripFormatting === 'function')
                    ? DecimalFields.stripFormatting(sellingPriceInput.value)
                    : (sellingPriceInput.value || '').toString().replace(/[^0-9]/g, '');
                const unitCost = parseFloat(sellingPriceInput.getAttribute('data-unit-cost')) || 0;
                const sellingPrice = parseFloat(stripped);
                if (!isNaN(sellingPrice) && sellingPrice > 0 && sellingPrice <= unitCost) {
                    warningBox.classList.remove('d-none');
                } else {
                    warningBox.classList.add('d-none');
                }
            }

            // Handle Edit Item Button
            document.querySelectorAll('.btnEditItem').forEach(btn => {
                btn.addEventListener('click', async function(e) {
                    e.preventDefault();
                    const btn = this;
                    const itemId = btn.dataset.id;
                    if (!itemId) return;
                    btn.disabled = true;
                    showPageLoading();

                    const response = await apiGet(`@Url.Action("UpdatePurchaseOrderItem")?id=@Model.Info.Id&itemId=${itemId}`);

                    hidePageLoading();
                    if (!response)
                        return;

                    document.body.insertAdjacentHTML('beforeend', response);

                    const modalElement = document.getElementById('editProductModal');
                    attachEditEventHandler(modalElement);
                    DecimalFields.autoWrap(modalElement);

                    modalElement.addEventListener('hidden.bs.modal', () => {
                        modalElement.remove();
                    }, { once: true });
                    const modal = new bootstrap.Modal(modalElement);
                    modal.show();

                    btn.disabled = false;
                });
            });

            function attachEditEventHandler(modalElement) {
                const form = modalElement.querySelector('form');
                if (!form) return;
                reparseForm(form);
                form.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    const submitBtn = form.querySelector('[type="submit"]');
                    submitBtn.disabled = true;

                    if (!isFormValid(form)) {
                        submitBtn.disabled = false;
                        return;
                    }

                    showPageLoading();
                    form.submit();
                    const fieldset = form.querySelector('fieldset');
                    fieldset.disabled = true;
                });
            }

            // Handle Remove Item Button
            document.querySelectorAll('.btnRemoveItem').forEach(btn => {
                btn.addEventListener('click', async function(e) {
                    e.preventDefault();
                    const itemId = this.getAttribute('data-id');
                    const purchaseOrderId = this.getAttribute('data-purchaseorder');
                    const itemName = this.getAttribute('data-name');

                    if (confirm(`Bạn có chắc chắn muốn xóa "${itemName}" khỏi đơn hàng?`)) {
                        await removeItem(itemId, purchaseOrderId);
                    }
                });
            });
        });

        function initializeProductPicker() {
            const container = document.getElementById('productPicker');
            if (container && !productPickerInstance) {
                productPickerInstance = new ProductPicker(container, { purchase: true });
                productPickerInstance.setVendor('@Model.Info.VendorId', '@Html.Raw(Model.Info.VendorName)');
                container.addEventListener('select', (e) => {
                    onProductSelected(e.detail.product);
                });
                container.addEventListener('remove', onProductRemove);

            }
        }

        let detailsRecentPrices = [];

        async function onProductSelected(product) {
            const modalProductInfo = document.getElementById('modalProductInfo');
            const itemUnitPrice = document.getElementById('itemUnitPrice');
            const itemProductId = document.getElementById('itemProductId');
            const btnAddProduct = document.getElementById('btnAddItem');

            modalProductInfo.classList.remove('d-none');
            itemUnitPrice.value = 0;
            itemProductId.value = product.id;
            btnAddProduct.classList.remove('d-none');
            const itemQtyInput = document.getElementById('itemQuantity');
            if (itemQtyInput) {
                const dp = String(product.quantityDecimalPlaces ?? 0);
                itemQtyInput.dataset.decimals = dp;
                itemQtyInput.dataset.decimalBound = '';
                window.DecimalFields?.bindInput?.(itemQtyInput);
                const addDpInput = document.getElementById('addItemDecimalPlaces');
                if (addDpInput) addDpInput.value = dp;
            }

            // Fetch giá nhập gần nhất
            detailsRecentPrices = [];
            try {
                const res = await fetch(`@Url.Action("RecentPurchasePrices")?productId=${product.id}`);
                if (res.ok) detailsRecentPrices = await res.json();
            } catch { }

            // VendorId của đơn nhập hiện tại (server-side)
            const currentVendorId = '@Model.Info.VendorId.ToString()';

            // Tự động điền giá theo NCC đang chọn
            if (currentVendorId) {
                const match = detailsRecentPrices.find(p => p.vendorId === currentVendorId);
                if (match) {
                    itemUnitPrice.value = match.unitCost;
                    DecimalFields.autoWrap(itemUnitPrice.closest('div') ?? document.body);
                }
            }

            renderDetailsPriceTable(currentVendorId);
            renderDetailsAutoFillInfo(currentVendorId);
        }

        function onProductRemove() {
            const modalProductInfo = document.getElementById('modalProductInfo');
            const itemUnitPrice = document.getElementById('itemUnitPrice');
            const itemProductId = document.getElementById('itemProductId');
            const btnAddProduct = document.getElementById('btnAddItem');

            modalProductInfo.classList.add('d-none');
            itemUnitPrice.value = 0;
            itemProductId.value = '';
            btnAddProduct.classList.add('d-none');
            detailsRecentPrices = [];
            document.getElementById('recentPricesHint')?.classList.add('d-none');
            document.getElementById('recentPricesAutoFillInfo')?.classList.add('d-none');
        }

        function renderDetailsPriceTable(currentVendorId) {
            const hintEl = document.getElementById('recentPricesHint');
            const emptyEl = document.getElementById('recentPricesEmpty');
            const tableWrapper = document.getElementById('recentPricesTableWrapper');
            const tbody = document.getElementById('recentPricesTbody');
            if (!hintEl || !tbody) return;

            hintEl.classList.remove('d-none');

            if (detailsRecentPrices.length === 0) {
                tableWrapper?.classList.add('d-none');
                emptyEl?.classList.remove('d-none');
                return;
            }

            tableWrapper?.classList.remove('d-none');
            emptyEl?.classList.add('d-none');
            tbody.innerHTML = '';

            detailsRecentPrices.forEach(p => {
                const isCurrentVendor = currentVendorId && p.vendorId === currentVendorId;
                const tr = document.createElement('tr');
                tr.className = isCurrentVendor ? 'table-success' : '';
                tr.style.cursor = 'pointer';
                tr.title = `Đơn: ${p.purchaseOrderCode}`;
                tr.innerHTML = `
                                                                                                                                            <td class="ps-0 py-1 text-nowrap">
                                                                                                                                                ${isCurrentVendor ? '<i class="bi bi-arrow-right-short text-success"></i>' : ''}
                                                                                                                                                <span class="fw-medium">${escapeHtmlDetails(p.vendorName ?? 'Không rõ')}</span>
                                                                                                                                                <div class="text-muted ui-fs-072">${escapeHtmlDetails(p.purchaseOrderCode)}</div>
                                                                                                                                            </td>
                                                                                                                                            <td class="text-end py-1 fw-semibold text-nowrap">
                                                                                                                                                ${DecimalFields.formatCurrency(String(p.unitCost))}
                                                                                                                                            </td>
                                                                                                                                            <td class="text-end py-1 text-muted text-nowrap ui-fs-075">${escapeHtmlDetails(p.purchaseDate)}</td>`;

                tr.addEventListener('click', () => {
                    const priceInput = document.getElementById('itemUnitPrice');
                    if (priceInput) {
                        priceInput.value = p.unitCost;
                        DecimalFields.autoWrap(priceInput.closest('div') ?? document.body);
                    }
                });
                tbody.appendChild(tr);
            });
        }

        function renderDetailsAutoFillInfo(currentVendorId) {
            const infoEl = document.getElementById('recentPricesAutoFillInfo');
            const textEl = document.getElementById('recentPricesAutoFillText');
            if (!infoEl || !textEl) return;

            if (detailsRecentPrices.length === 0) { infoEl.classList.add('d-none'); return; }

            if (currentVendorId) {
                const match = detailsRecentPrices.find(p => p.vendorId === currentVendorId);
                if (match) {
                    textEl.textContent = `Đã tự động điền giá nhập gần nhất của nhà cung cấp này (${DecimalFields.formatCurrency(String(match.unitCost))}).`;
                    infoEl.className = 'small text-success mb-1';
                    infoEl.classList.remove('d-none');
                } else {
                    textEl.textContent = 'Nhà cung cấp này chưa có lịch sử nhập hàng cho sản phẩm — vui lòng nhập giá thủ công.';
                    infoEl.className = 'small text-warning mb-1';
                    infoEl.classList.remove('d-none');
                }
            } else {
                textEl.textContent = 'Nhấn vào hàng trong bảng bên dưới để chọn giá nhập.';
                infoEl.className = 'small text-info mb-1';
                infoEl.classList.remove('d-none');
            }
        }

        function escapeHtmlDetails(str) {
            return String(str ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        async function submitAddProductForm() {
            const form = document.getElementById('addProductForm');
            showPageLoading();
            try {
                const response = await fetch('@Url.Action("AddPurchaseOrderItem")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: $(form).serialize()
                });

                const data = await response.json();

                if (data.success) {
                    // Close modal and refresh page
                    bootstrap.Modal.getInstance(document.getElementById('addProductModal'))?.hide();
                    setTimeout(() => location.reload(), 300);
                } else {
                    hidePageLoading();
                    alert('Lỗi: ' + (data.errorMessage || 'Không thể thêm sản phẩm'));
                }
            } catch (error) {
                hidePageLoading();
                console.error('Error:', error);
                alert('Có lỗi xảy ra khi thêm sản phẩm');
            }
        }

        function resetAddProductForm() {
            document.getElementById('itemQuantity').value = '1';
            document.getElementById('itemUnitPrice').value = '';
            document.getElementById('modalProductInfo').classList.add('d-none');

            if (productPickerInstance) {
                productPickerInstance.clear();
            }
        }

        function parsePurchaseOrderDecimal(value, scale) {
            const raw = String(value ?? '').trim();
            if (!raw) return 0;
            const stripped = window.DecimalFields?.stripFormatting
                ? DecimalFields.stripFormatting(raw, scale)
                : normalizePurchaseOrderDecimal(raw);
            const parsed = parseFloat(stripped);
            return isNaN(parsed) ? 0 : parsed;
        }

        function normalizePurchaseOrderDecimal(value) {
            let normalized = String(value ?? '').replace(/[^0-9,.-]/g, '');
            if (normalized.includes(',') && normalized.includes('.')) {
                normalized = normalized.replace(/\./g, '').replace(',', '.');
            } else if (normalized.includes(',')) {
                normalized = normalized.replace(',', '.');
            }
            return normalized;
        }

        function showEditProductError(message) {
            const errorEl = document.getElementById('editProductError');
            if (!errorEl) return;
            errorEl.textContent = message;
            errorEl.classList.remove('d-none');
        }

        async function removeItem(itemId, purchaseOrderId) {
            showPageLoading();
            try {
                const response = await fetch('@Url.Action("RemovePurchaseOrderItem")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify({
                        purchaseOrderItemId: itemId,
                        purchaseOrderId: purchaseOrderId
                    })
                });

                const data = await response.json();

                if (data.success) {
                    // Remove row from table
                    document.querySelector(`tr[data-item-id="${itemId}"]`)?.remove();

                    // Refresh page after short delay
                    setTimeout(() => location.reload(), 300);
                } else {
                    hidePageLoading();
                    alert('Lỗi: ' + (data.errorMessage || 'Không thể xóa sản phẩm'));
                }
            } catch (error) {
                hidePageLoading();
                console.error('Error:', error);
                alert('Có lỗi xảy ra khi xóa sản phẩm');
            }
        }

    </script>

    <script type="module">
        import { Vendor, default as VendorPicker } from '/modules/VendorPicker.js';

        (() => {
            const elementVendorPicker = document.getElementById('vendorPicker');
            if (!elementVendorPicker)
                return;

            let editPurchaseOrderState = {

            };
            function setState(patch) {
                const newState = Object.assign({}, editPurchaseOrderState, patch);
                editPurchaseOrderState = newState;
                renderState();
            }
            function renderState() {
                getEl('VendorId').value = editPurchaseOrderState.vendor?.id ?? '';
            }

            const { vendorPicker, vendor } = bindVendorPicker();

            setState({ vendor });

            function bindVendorPicker() {
                const vendorPicker = new VendorPicker(elementVendorPicker);

                elementVendorPicker.addEventListener('select', (e) => {
                    setState({ vendor: e.detail?.vendor ? new Vendor(e.detail.vendor) : null });
                });
                elementVendorPicker.addEventListener('remove', () => {
                    setState({ vendor: null });
                });

                const initialVendor = elementVendorPicker.dataset;
                if (initialVendor.id) {
                    var vendor = new Vendor(initialVendor);
                    vendorPicker.displayVendor(vendor);
                    return { vendorPicker, vendor: initialVendor };
                }
                return { vendorPicker, vendor: null };
            }
        })();
    </script>

    @if (Model.Info.CanReceiveGoods && Model.Info.Items.Any(i => i.RemainingQuantity > 0))
    {
        <script type="module" defer>
            import BulkReceiveController from '/modules/BulkReceiveController.js';
            import { apiGet } from '/modules/ajax-helper.js';

            const btn = document.getElementById('btnReceiveItems');
            btn.addEventListener('click', async () => {
                btn.disabled = true;
                showPageLoading();

                const response = await apiGet('@Url.Action("BulkReceiveItems", new { id = Model.Info.Id })');

                hidePageLoading();
                if (!response)
                    return;

                document.body.insertAdjacentHTML('beforeend', response);

                const modalElement = document.getElementById('bulkReceiveModal');
                new BulkReceiveController('@Model.Info.Id').init(modalElement);

                modalElement.addEventListener('hidden.bs.modal', () => {
                    modalElement.remove();
                }, { once: true });
                const modal = new bootstrap.Modal(modalElement);
                modal.show();

                btn.disabled = false;
            });
        </script>
    }

    @if (Model.CanAllocateItems)
    {
        <script type="module">
            import { apiGet } from '/modules/ajax-helper.js';

            (function() {
                const modal = document.getElementById('allocateToOrderModal');
                if (!modal) return;

                let currentPoId = null;
                let currentPoItemId = null;
                let selectedRow = null;
                let originalPhone = '';

                function fmtQty(n) {
                    return window.DecimalFields?.formatQuantity ? DecimalFields.formatQuantity(n) : String(n);
                }
                function parseQty(v) {
                    if (!v) return 0;
                    const s = window.DecimalFields?.stripFormatting
                        ? DecimalFields.stripFormatting(String(v), 2)
                        : String(v).replace(/[^0-9.,]/g, '').replace(',', '.');
                    const n = parseFloat(s);
                    return isNaN(n) ? 0 : n;
                }

                document.addEventListener('click', function(e) {
                    const btn = e.target.closest('.btn-allocate-to-order');
                    if (!btn) return;
                    currentPoId = btn.dataset.purchaseId;
                    currentPoItemId = btn.dataset.itemId;
                    selectedRow = null;
                    document.getElementById('allocateModalItemName').textContent = btn.dataset.itemName || '';
                    document.getElementById('allocateOrderItemsError').classList.add('d-none');
                    document.getElementById('allocateSubmitError').classList.add('d-none');
                    document.getElementById('allocateOrderItemsTableWrapper').classList.add('d-none');
                    document.getElementById('allocateOrderItemsEmpty').classList.add('d-none');
                    document.getElementById('allocateOrderItemsLoading').classList.remove('d-none');
                    document.getElementById('btnAllocateToOrder').classList.add('d-none');
                    document.getElementById('allocateIsDirectShip').checked = false;
                    document.getElementById('allocateDirectShipFields').classList.add('d-none');
                    document.getElementById('allocateDsAddress').value = '';
                    document.getElementById('allocateDsContact').value = '';
                    document.getElementById('allocateDsPhone').value = '';
                    originalPhone = '';
                    new bootstrap.Modal(modal).show();
                    loadEligibleItems(currentPoItemId);
                });

                document.getElementById('allocateIsDirectShip')?.addEventListener('change', function() {
                    document.getElementById('allocateDirectShipFields').classList.toggle('d-none', !this.checked);
                    if (this.checked && selectedRow) {
                        prefillDsFromRow(selectedRow);
                    }
                    if (!this.checked) {
                        originalPhone = '';
                    }
                });

                function loadEligibleItems(poItemId) {
                    apiGet(`/PurchaseOrder/EligibleOrderItems?purchaseOrderId=${currentPoId}&purchaseOrderItemId=${poItemId}`)
                        .then(response => {
                            if (!response.success)
                                throw new Error('Lỗi tải danh sách đơn hàng.');

                            const items = response.data;
                            document.getElementById('allocateOrderItemsLoading').classList.add('d-none');
                            if (!items || items.length === 0) {
                                document.getElementById('allocateOrderItemsEmpty').classList.remove('d-none');
                                return;
                            }
                            const tbody = document.getElementById('allocateOrderItemsBody');
                            tbody.innerHTML = '';
                            items.forEach(item => {
                                const tr = document.createElement('tr');
                                tr.style.cursor = 'pointer';
                                tr.dataset.orderItemId = item.orderItemId;
                                tr.dataset.orderId = item.orderId;
                                tr.dataset.available = item.availableToAllocate;
                                tr.dataset.shippingAddress = item.shippingAddress || '';
                                tr.dataset.customerPhone = item.customerPhone || '';
                                tr.dataset.customerName = item.customerName || '';
                                tr.innerHTML = `
                                    <td class="ps-2"><span class="fw-semibold">${escHtml(item.orderCode)}</span></td>
                                    <td class="text-muted small ps-2">${escHtml(item.customerName)}</td>
                                    <td class="text-end pe-2">${fmtQty(item.totalQuantity)}</td>
                                    <td class="text-end text-success fw-semibold pe-2">${fmtQty(item.availableToAllocate)}</td>
                                    <td class="pe-2">
                                        <div class="d-flex align-items-center justify-content-end">
                                            <input type="text" class="form-control form-control-sm text-end allocate-qty-input ui-w-90 d-inline-block" inputmode="decimal"
                                                   data-decimal="quantity" data-decimals="${item.quantityDecimalPlaces ?? 0}" value="${fmtQty(item.availableToAllocate)}" />
                                       </div>
                                    </td>`;
                                tbody.appendChild(tr);
                                window.DecimalFields?.autoWrap?.(tr);
                                tr.addEventListener('click', e => {
                                    if (e.target.closest('input')) return;
                                    selectRow(tr);
                                });
                                tr.querySelector('input')?.addEventListener('focus', () => selectRow(tr));
                            });
                            document.getElementById('allocateOrderItemsTableWrapper').classList.remove('d-none');
                        })
                        .catch(() => {
                            document.getElementById('allocateOrderItemsLoading').classList.add('d-none');
                            const err = document.getElementById('allocateOrderItemsError');
                            err.textContent = 'Lỗi tải danh sách đơn hàng.';
                            err.classList.remove('d-none');
                        });
                }

                function prefillDsFromRow(tr) {
                    document.getElementById('allocateDsAddress').value = tr.dataset.shippingAddress || '';
                    document.getElementById('allocateDsContact').value = tr.dataset.customerName || '';
                    document.getElementById('allocateDsPhone').value = tr.dataset.customerPhone || '';
                    originalPhone = tr.dataset.customerPhone || '';
                }

                function selectRow(tr) {
                    if (selectedRow) selectedRow.classList.remove('table-primary');
                    selectedRow = tr;
                    tr.classList.add('table-primary');
                    document.getElementById('btnAllocateToOrder').classList.remove('d-none');
                    if (document.getElementById('allocateIsDirectShip').checked) {
                        prefillDsFromRow(tr);
                    }
                }

                document.getElementById('btnAllocateToOrder')?.addEventListener('click', function() {
                    if (!selectedRow || !currentPoItemId) return;
                    const orderId = selectedRow.dataset.orderId;
                    const orderItemId = selectedRow.dataset.orderItemId;
                    const available = parseFloat(selectedRow.dataset.available) || 0;
                    const qtyInput = selectedRow.querySelector('.allocate-qty-input');
                    const qty = parseQty(qtyInput?.value);
                    const errEl = document.getElementById('allocateSubmitError');
                    errEl.classList.add('d-none');

                    if (qty <= 0 || qty > available + 1e-9) {
                        errEl.textContent = `Số lượng không hợp lệ (tối đa ${fmtQty(available)}).`;
                        errEl.classList.remove('d-none');
                        return;
                    }

                    const isDs = document.getElementById('allocateIsDirectShip').checked;
                    const address = document.getElementById('allocateDsAddress').value.trim();
                    const currentPhone = document.getElementById('allocateDsPhone').value.trim();
                    if (isDs && !currentPhone) {
                        errEl.textContent = 'Vui lòng nhập số điện thoại nhận hàng giao thẳng.';
                        errEl.classList.remove('d-none');
                        return;
                    }
                    if (isDs && !address) {
                        errEl.textContent = 'Vui lòng nhập địa chỉ giao hàng.';
                        errEl.classList.remove('d-none');
                        return;
                    }

                    if (isDs && originalPhone && currentPhone !== originalPhone) {
                        if (!confirm(`Số điện thoại liên lạc đã thay đổi từ "${originalPhone}" thành "${currentPhone}". Xác nhận tiếp tục?`)) {
                            return;
                        }
                    }

                    const btn = this;
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang xử lý...';
                    showPageLoading();

                    fetch('/PurchaseOrder/AllocateToOrder', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' },
                        body: JSON.stringify({
                            purchaseOrderId: currentPoId,
                            purchaseOrderItemId: currentPoItemId,
                            orderItemId: orderItemId,
                            orderId: orderId,
                            quantity: qty,
                            directShipAddress: isDs ? address : null,
                            directShipContactName: isDs ? document.getElementById('allocateDsContact').value.trim() || null : null,
                            directShipContactPhone: isDs ? document.getElementById('allocateDsPhone').value.trim() || null : null
                        })
                    })
                        .then(r => r.json())
                        .then(result => {
                            if (result.success) {
                                bootstrap.Modal.getInstance(modal)?.hide();
                                location.reload();
                            } else {
                                hidePageLoading();
                                errEl.textContent = result.message || 'Có lỗi xảy ra.';
                                errEl.classList.remove('d-none');
                                btn.disabled = false;
                                btn.innerHTML = '<i class="bi bi-check-lg me-1"></i> Xác nhận phân bổ';
                            }
                        })
                        .catch(() => {
                            hidePageLoading();
                            errEl.textContent = 'Lỗi kết nối. Vui lòng thử lại.';
                            errEl.classList.remove('d-none');
                            btn.disabled = false;
                            btn.innerHTML = '<i class="bi bi-check-lg me-1"></i> Xác nhận phân bổ';
                        });
                });

                function escHtml(s) {
                    return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
                }
            })();
        </script>
    }

    @if (Model.AllocationsPerItem.Values.Any(allocations => allocations.Count > 0))
    {
        <script type="module">
            import { apiPost } from '/modules/ajax-helper.js';
            import { confirm } from '/modules/modals.js';

            document.addEventListener('DOMContentLoaded', () => {
                document.querySelectorAll('.btn-release-allocate').forEach(btn => {
                    btn.addEventListener('click', async () => {
                        const { purchaseId, itemId } = btn.dataset;
                        if (!purchaseId || !itemId) return;
                        if (!await confirm('Hủy phân bổ', 'Bạn có chắc chắn muốn hủy phân bổ này?')) return;
                        btn.disabled = true;
                        const originalHtml = btn.innerHTML;
                        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang hủy...';
                        showPageLoading();
                        const result = await apiPost('/PurchaseOrder/ReleaseAllocationsForPurchaseOrderItem', { purchaseOrderId: purchaseId, purchaseOrderItemId: itemId });
                        if (result.success) {
                            location.reload();
                            return;
                        }
                        btn.disabled = false;
                        btn.innerHTML = originalHtml;
                        hidePageLoading();
                    });
                });
            });
        </script>
    }

    @if (Model.Info.CanReceiveGoods)
    {
        <script>
            (function() {
                const markDsModal = document.getElementById('markDsModal');
                if (!markDsModal) return;
                markDsModal.addEventListener('show.bs.modal', function(e) {
                    const btn = e.relatedTarget;
                    markDsModal.querySelector('#markDsAllocationId').value = btn.dataset.allocationId;
                    markDsModal.querySelector('#markDsOrderCode').textContent = btn.dataset.orderCode;
                    markDsModal.querySelector('#markDsAddress').value = btn.dataset.address;
                    markDsModal.querySelector('#markDsPhone').value = btn.dataset.phone;
                    markDsModal.querySelector('#markDsContactName').value = btn.dataset.customer;
                });

                markDsModal.querySelector('form')?.addEventListener('submit', async function(e) {
                    e.preventDefault();

                    if (!$(this).valid())
                        return;

                    const btn = this;
                    btn.disabled = true;
                    showPageLoading();
                    try {
                        const resp = await fetch('/DirectShipDelivery/MarkAsDirectShip', {
                            method: 'POST',
                            body: new FormData(this)
                        });
                        const data = await resp.json();
                        if (data.success) {
                            location.reload();
                        } else {
                            hidePageLoading();
                            errEl.textContent = data.message || 'Có lỗi xảy ra.';
                            errEl.classList.remove('d-none');
                        }
                    } catch {
                        hidePageLoading();
                        errEl.textContent = 'Có lỗi xảy ra.';
                        errEl.classList.remove('d-none');
                    } finally {
                        btn.disabled = false;
                    }
                });
            })();
        </script>
    }

    @if (Model.Info.CanAddItems && Model.Info.Items.Any(i => i.QuantityOrdered - i.QuantityReceived > 0))
    {
        <script type="module" defer>
            import { apiGet } from '/modules/ajax-helper.js';

            (function() {
                document.getElementById('btnSplitPurchaseOrder').addEventListener('click', async function(e) {
                    e.preventDefault();
                    const btn = this;
                    btn.disabled = true;
                    showPageLoading();

                    const response = await apiGet(`@Url.Action("SplitsPurchaseOrder")?id=@(Model.Info.Id)`);

                    hidePageLoading();
                    if (!response)
                        return;

                    document.body.insertAdjacentHTML('beforeend', response);

                    const modalElement = document.getElementById('splitPurchaseOrderModal');
                    attachEditEventHandler(modalElement);
                    DecimalFields.autoWrap(modalElement);

                    modalElement.addEventListener('hidden.bs.modal', () => {
                        modalElement.remove();
                    }, { once: true });
                    const modal = new bootstrap.Modal(modalElement);
                    modal.show();

                    btn.disabled = false;
                });
                function attachEditEventHandler(modalElement) {
                    const form = modalElement.querySelector('form');
                    if (!form) return;
                    reparseForm(form);
                    form.addEventListener('submit', e => {
                        e.preventDefault();
                        if (!isFormValid(form)) return;

                        let hasPositiveQuantity = false;
                        form.querySelectorAll('.split-qty-input').forEach(inputQty => {
                            const qty = DecimalFields.getValue(inputQty);
                            if (qty > 0) {
                                hasPositiveQuantity = true;
                            }
                        });
                        if (!hasPositiveQuantity) {
                            NotificationCenter.warning('Vui lòng nhập số lượng mặt hàng cần chia');
                            return;
                        }

                        form.querySelector('[type="submit"]').disabled = true;
                        showPageLoading();
                        form.submit();
                        form.querySelector('fieldset').disabled = true;
                    });
                }
            })();
        </script>
    }

    @if (Model.CanModifyInfo && Model.ModifyInfo != null)
    {
        <script type="module" defer>
            import VendorPicker from '/modules/VendorPicker.js';

            const modal = document.getElementById('poEditInfoModal');

            if (modal) {
                const form = modal.querySelector('form');
                form?.addEventListener('submit', e => {
                    e.preventDefault();
                    if (!isFormValid(form))
                        return;
                    showPageLoading();
                    form.submit();
                });

                let picker = null;
                modal.addEventListener('shown.bs.modal', () => {
                    if (picker) return;

                    const el = modal.querySelector('#vendorPicker');
                    if (!el) return;

                    picker = new VendorPicker(el);

                    const hiddenInput = modal.querySelector('input[name="VendorId"]');
                    el.addEventListener('select', e => {
                        if (hiddenInput) hiddenInput.value = e.detail?.vendor?.id ?? '';
                    });
                    el.addEventListener('remove', () => {
                        if (hiddenInput) hiddenInput.value = '';
                    });
                });
            }
        </script>
    }
}
