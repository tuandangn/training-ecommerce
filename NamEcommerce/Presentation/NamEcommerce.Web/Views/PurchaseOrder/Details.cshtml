                        <div class="mb-3" id="modalWarehouseSection">
                            <label class="form-label small fw-bold text-muted text-uppercase">Kho nhập hàng</label>
                            <select name="WarehouseId" class="form-select" data-testid="po-receive-warehouse" required>
