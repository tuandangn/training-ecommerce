@model EditPurchaseOrderModel
<input type="hidden" asp-for="Id" />
<div class="mb-3">
    <div class="row g-3">
        <div class="col-sm-6">
            @if (Model.CanChangeDate)
            {
                <label asp-for="PlacedOn" class="form-label small fw-semibold text-muted text-uppercase mb-1"></label>
                <input asp-for="PlacedOn" class="form-control" type="datetime-local" value="@Model.PlacedOn.ToString("s")" 
                    data-val-range-max="@DateTime.Now.ToString("s")"/>
                <span asp-validation-for="PlacedOn" class="text-danger small"></span>
            }
            else
            {
                <input type="hidden" asp-for="PlacedOn" value="@Model.PlacedOn.ToString("s")" />
                <label class="form-label small fw-semibold text-muted text-uppercase mb-1">Ngày đặt</label>
                <div class="form-control-plaintext text-dark fw-medium">@Model.PlacedOn.ToString(ViewConstants.DefaultDateTimeFormat)</div>
            }
        </div>
        <div class="col-sm-6">
            <label asp-for="ExpectedDeliveryDate" class="form-label small fw-semibold text-muted text-uppercase mb-1"></label>
            <input asp-for="ExpectedDeliveryDate" class="form-control" type="datetime-local" placeholder="Ngày nhập dự kiến"
                   value="@(Model.ExpectedDeliveryDate.HasValue ? Model.ExpectedDeliveryDate.Value.ToString("s") : "")" data-val="true" 
                   data-val-range="Ngày giao hàng dự kiến không thể là ngày trong quá khứ"
                   data-val-range-min="@(Model.ExpectedDeliveryDate.HasValue ? Model.PlacedOn.ToString("s") : DateTime.Now.ToString("s"))" />
            <span asp-validation-for="ExpectedDeliveryDate" class="text-danger small"></span>
        </div>
    </div>
</div>
<div class="mb-3">
    @if (Model.CanChangeVendor)
    {
        <label for="vendorSearch" class="form-label small fw-semibold text-muted text-uppercase mb-1">Nhà cung cấp</label>
        <div id="vendorPicker" data-id="@Model.VendorId" data-name="@Model.VendorName" data-phone="@Model.VendorPhone" data-address="@Model.VendorAddress"></div>
        <input type="text" class="visually-hidden" asp-for="VendorId" />
        <span asp-validation-for="VendorId" class="small text-danger"></span>
    }
    else
    {
        <input type="hidden" asp-for="VendorId" />
        <label class="form-label small fw-semibold text-muted text-uppercase mb-1">Nhà cung cấp</label>
        <div class="form-control-plaintext text-dark fw-medium">@(Model.VendorName ?? "—")</div>
    }
</div>
<div class="mb-3">
    <label asp-for="Note" class="form-label small fw-semibold text-muted text-uppercase mb-1"></label>
    <textarea asp-for="Note" class="form-control" rows="3" placeholder="Nhập ghi chú"></textarea>
    <span asp-validation-for="Note" class="small text-danger"></span>
</div>
@if (Model.CanChangeFees)
{
    <div class="row g-3">
        <div class="col-sm-6">
            <label asp-for="ShippingAmount" class="form-label small fw-semibold text-muted text-uppercase mb-1"></label>
            <input asp-for="ShippingAmount" class="form-control"
                   value="@Model.ShippingAmount?.DisplayCurrency()" data-decimal="currency" autocomplete="off" inputmode="nnumeric"
                   data-val-range="Phí vận chuyển phải ≥ 0." data-val-range-min="0" data-val-number="Số không hợp lệ." />
            <span asp-validation-for="ShippingAmount" class="text-danger small"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="TaxAmount" class="form-label small fw-semibold text-muted text-uppercase mb-1"></label>
            <input asp-for="TaxAmount" class="form-control"
                   value="@Model.TaxAmount?.DisplayCurrency()" data-decimal="currency" autocomplete="off" inputmode="nnumeric"
                   data-val-range="Thuế phải ≥ 0." data-val-range-min="0" data-val-number="Số không hợp lệ." />
            <span asp-validation-for="TaxAmount" class="text-danger small"></span>
        </div>
    </div>
}
else
{
    <input type="hidden" asp-for="ShippingAmount" value="@Model.ShippingAmount" />
    <input type="hidden" asp-for="TaxAmount" value="@Model.TaxAmount" />
}
