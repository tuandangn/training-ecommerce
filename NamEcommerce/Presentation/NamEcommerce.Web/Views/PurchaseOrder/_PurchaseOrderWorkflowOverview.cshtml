@model PurchaseOrderDetailsModel

<div class="order-workflow-layout mb-3">
    <div class="order-workflow-main">
        <div class="content-card">
            <div class="content-card-header">
                <h5>Quy trình đơn nhập</h5>
                <span class="status-badge @Model.Workflow.StatusClass">@Model.Workflow.StatusText</span>
            </div>
            <div class="content-card-body">
                <section id="po-stage-ordering" class="mb-4">
                    <div class="workflow-section-title">Đặt hàng</div>
                    <div class="workflow-metric-grid">
                        <div class="workflow-metric">
                            <span>Dòng hàng</span>
                            <strong>@Model.Ordering.ItemCount</strong>
                        </div>
                        <div class="workflow-metric">
                            <span>Số lượng đặt</span>
                            <strong>@Model.Ordering.TotalQuantity.DisplayQuantity()</strong>
                        </div>
                        <div class="workflow-metric">
                            <span>Tiền hàng</span>
                            <strong>@Model.Ordering.Subtotal.DisplayCurrency()</strong>
                        </div>
                    </div>
                    @if (Model.Ordering.AllocationCount > 0)
                    {
                        <div class="workflow-soft-empty mt-2">
                            <i class="bi bi-diagram-3"></i>
                            <span>Đã phân bổ @Model.Ordering.AllocatedQuantity.DisplayQuantity() cho @Model.Ordering.AllocationCount dòng đơn bán.</span>
                        </div>
                    }
                </section>

                <section id="po-stage-receiving" class="mb-4">
                    <div class="workflow-section-title">Nhận hàng</div>
                    <div class="workflow-metric-grid">
                        <div class="workflow-metric">
                            <span>Đã nhận</span>
                            <strong>@Model.Receiving.ReceivedQuantity.DisplayQuantity()</strong>
                        </div>
                        <div class="workflow-metric">
                            <span>Còn lại</span>
                            <strong>@Model.Receiving.RemainingQuantity.DisplayQuantity()</strong>
                        </div>
                        <div class="workflow-metric">
                            <span>Phiếu nhập</span>
                            <strong>@Model.Receiving.ReceiptCount</strong>
                        </div>
                    </div>
                    @if (Model.Receiving.HasPendingCosting)
                    {
                        <div class="workflow-soft-empty mt-2">
                            <i class="bi bi-exclamation-triangle"></i>
                            <span>Có phiếu nhập đang chờ chốt giá vốn.</span>
                        </div>
                    }
                </section>

                <section id="po-stage-returning" class="mb-4">
                    <div class="workflow-section-title">Trả hàng</div>
                    <div class="workflow-metric-grid">
                        <div class="workflow-metric">
                            <span>Phiếu trả</span>
                            <strong>@Model.Returns.ReturnCount</strong>
                        </div>
                        <div class="workflow-metric">
                            <span>SL yêu cầu</span>
                            <strong>@Model.Returns.RequestedQuantity.DisplayQuantity()</strong>
                        </div>
                        <div class="workflow-metric">
                            <span>SL chấp nhận</span>
                            <strong>@Model.Returns.AcceptedQuantity.DisplayQuantity()</strong>
                        </div>
                    </div>
                </section>

                <section id="po-stage-settlement">
                    <div class="workflow-section-title">Kết sổ</div>
                    <div class="workflow-metric-grid">
                        <div class="workflow-metric">
                            <span>Phải trả</span>
                            <strong>@Model.Settlement.NetPayable.DisplayCurrency()</strong>
                        </div>
                        <div class="workflow-metric">
                            <span>Đã trả</span>
                            <strong>@Model.Settlement.PaidTotal.DisplayCurrency()</strong>
                        </div>
                        <div class="workflow-metric @(Model.Settlement.RemainingDebt > 0 ? "profit-negative" : "profit-positive")">
                            <span>Còn nợ</span>
                            <strong>@Model.Settlement.RemainingDebt.DisplayCurrency()</strong>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
    <aside class="order-workflow-timeline">
        @await Html.PartialAsync("_PurchaseOrderWorkflowTimeline", Model)
    </aside>
</div>
