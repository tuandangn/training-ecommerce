@model ShortageAggregationModel
@using System.Globalization
@{
    ViewData[ViewConstants.PageTitle] = "Hàng cần nhập";

    var allItems = Model.VendorGroups.SelectMany(group => group.Items).ToList();
    var validGroups = Model.VendorGroups.Where(group => !group.IsNoVendorGroup && group.VendorId.HasValue).ToList();
    var noVendorItems = Model.VendorGroups.Where(group => group.IsNoVendorGroup).SelectMany(group => group.Items).ToList();
    var relatedOrders = allItems.Select(item => item.OrderCode)
        .Where(code => !string.IsNullOrWhiteSpace(code))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();
    var estimatedTotal = Model.VendorGroups.Sum(group => group.TotalAmount);
    DateTime? defaultExpectedDate = null;
}

@section TitleSection {
    <h1 class="topbar-page-title">Hàng cần nhập</h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="List" asp-controller="PurchaseOrder" class="text-decoration-none">Đơn nhập</a></li>
                <li class="breadcrumb-item active" aria-current="page">Hàng cần nhập</li>
            </ol>
        </nav>
    </div>
}

<div class="shortage-order-page">
    <div class="alert alert-warning flex-grow-1 fw-medium">
        @(((decimal)allItems.Count).DisplayQuantity()) mặt hàng thiếu · @(((decimal)relatedOrders.Count).DisplayQuantity()) đơn liên quan · Ước tính @estimatedTotal.DisplayCurrencyWithSymbol()
    </div>

    @if (Model.OrderId.HasValue || Model.DeliveryNoteId.HasValue || Model.ProductId.HasValue)
    {
        <div class="shortage-active-filters">
            @if (relatedOrders.Count >= 1)
            {
                var primaryOrderCode = allItems.FirstOrDefault(item => item.IsFromPrimaryOrder)?.OrderCode;
                <a class="shortage-filter-chip" href="/PurchaseOrder/ShortageAggregation">
                    Lọc theo đơn: @(primaryOrderCode ?? relatedOrders[0])
                    <i class="bi bi-x"></i>
                </a>
            }
            else if (Model.ProductId.HasValue)
            {
                <a class="shortage-filter-chip" href="/PurchaseOrder/ShortageAggregation">
                    Đang lọc mặt hàng
                    <i class="bi bi-x"></i>
                </a>
            }
        </div>
    }

    @{
        var secondaryItemCount = allItems.Count(item => !item.IsFromPrimaryOrder);
    }
    @if ((Model.OrderId.HasValue || Model.DeliveryNoteId.HasValue) && secondaryItemCount > 0)
    {
        <div class="alert alert-info shortage-related-banner" role="alert">
            <i class="bi bi-info-circle me-1"></i>
            Có <strong>@(((decimal)secondaryItemCount).DisplayQuantity())</strong> mặt hàng thiếu từ đơn khác cùng nhà cung cấp gợi ý. Tick chọn để gộp chung vào phiếu nhập, tiết kiệm chi phí giao hàng.
        </div>
    }

    @if (Model.DeliveryNoteId.HasValue)
    {
        <form method="get" action="/PurchaseOrder/ShortageAggregation" class="shortage-scope-form">
            <input type="hidden" name="deliveryNoteId" value="@Model.DeliveryNoteId" />
            <input type="hidden" name="productId" value="@Model.ProductId" />
            <select name="includeSalesOrderScope" class="form-select shortage-page-select" onchange="this.form.submit()">
                <option value="false" selected="@(!Model.IncludeSalesOrderScope)">Phạm vi: Phiếu xuất hiện tại</option>
                <option value="true" selected="@(Model.IncludeSalesOrderScope)">Phạm vi: Toàn bộ đơn bán</option>
            </select>
        </form>
    }

    <div class="shortage-page-filters">
        <div class="row g-2">
            <div class="col-sm-6">
                <select id="vendorFilter" class="form-select shortage-page-select">
                    <option value="">NCC: Tất cả</option>
                    @foreach (var group in validGroups)
                    {
                        <option value="@group.VendorId">@group.VendorName</option>
                    }
                </select>
            </div>
            <div class="col-sm-6">
                <select id="productFilter" class="form-select shortage-page-select">
                    <option value="">Mặt hàng: Tất cả</option>
                    @foreach (var product in allItems.GroupBy(item => item.ProductId).Select(group => group.First()).OrderBy(item => item.ProductName))
                    {
                        <option value="@product.ProductId">@product.ProductName</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <div id="createShortageResult" class="alert alert-success d-none"></div>

    @if (!Model.HasShortage)
    {
        <div class="content-card">
            <div class="content-card-body text-center py-5">
                <i class="bi bi-check-circle text-success fs-1 d-block mb-2"></i>
                <div class="fw-semibold">Không có hàng thiếu cần nhập</div>
                <div class="text-muted small">Các đơn đang lọc hiện có đủ tồn khả dụng hoặc đã được phân bổ.</div>
            </div>
        </div>
    }
    else
    {
        <form asp-action="CreateShortage" method="post" asp-antiforgery="true" id="shortageAggregateForm">
            @foreach (var group in validGroups)
            {
                var groupUnitSummary = string.Join(" · ", group.Items
                    .GroupBy(item => string.IsNullOrWhiteSpace(item.UnitMeasurementName) ? "sp" : item.UnitMeasurementName!)
                    .Select(unitGroup => $"{unitGroup.Sum(item => item.QuantityToOrder).DisplayQuantity()} {unitGroup.Key}"));
                var groupLastPurchaseDate = group.Items
                    .SelectMany(item => item.SupplierSuggestions.Where(suggestion => suggestion.VendorId == group.VendorId && suggestion.LastPurchaseDate.HasValue))
                    .Select(suggestion => suggestion.LastPurchaseDate!.Value)
                    .DefaultIfEmpty()
                    .Max();
                var groupHasPrimary = group.Items.Any(groupItem => groupItem.IsFromPrimaryOrder);

                <div class="shortage-order-card shortage-group" data-vendor-id="@group.VendorId" data-vendor-name="@group.VendorName">
                    <div class="shortage-order-card-header">
                        <div class="shortage-vendor-heading">
                            <input type="checkbox" class="form-check-input group-check" @(groupHasPrimary ? "checked" : "") />
                            <span class="shortage-vendor-icon">
                                <i class="bi bi-building"></i>
                            </span>
                            <div>
                                <div class="shortage-vendor-name">@group.VendorName</div>
                                <div class="shortage-vendor-meta">
                                    @(((decimal)group.Items.Count).DisplayQuantity()) mặt hàng · @groupUnitSummary
                                    @if (groupLastPurchaseDate != default)
                                    {
                                        <span> · Nhập gần nhất @groupLastPurchaseDate.ToString("dd/MM/yyyy")</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="shortage-group-money">
                            <strong class="group-total">@group.TotalAmount.DisplayCurrencyWithSymbol()</strong>
                            <span>tạm tính</span>
                        </div>
                    </div>

                    <div class="shortage-order-card-controls">
                        <label class="shortage-inline-field">
                            <span><i class="bi bi-calendar2-week"></i>Hẹn nhận:</span>
                            <input type="date" class="form-control expected-date" value="@defaultExpectedDate" placeholder="Chọn ngày hẹn" />
                        </label>
                        <label class="shortage-inline-field shortage-note-field">
                            <span><i class="bi bi-stickies"></i>Ghi chú:</span>
                            <input type="text" class="form-control group-note" maxlength="1000" placeholder="Nhập ghi chú" />
                        </label>
                    </div>

                    <div class="shortage-order-items">
                        @{
                            var groupPrimaryItems = group.Items.Where(groupItem => groupItem.IsFromPrimaryOrder).ToList();
                            var groupSecondaryItems = group.Items.Where(groupItem => !groupItem.IsFromPrimaryOrder).ToList();
                            var groupPrimaryOrderCodes = groupPrimaryItems.Select(groupItem => groupItem.OrderCode).Distinct().ToList();
                            var groupedItems = new List<(string? Label, IList<ShortageAggregationItemModel> Items)>();
                            if (groupPrimaryItems.Count > 0)
                            {
                                var primaryLabel = groupPrimaryOrderCodes.Count == 1
                                    ? $"Mặt hàng của đơn {groupPrimaryOrderCodes[0]}"
                                    : "Mặt hàng của đơn đang xem";
                                groupedItems.Add((primaryLabel, groupPrimaryItems));
                            }
                            if (groupSecondaryItems.Count > 0)
                            {
                                groupedItems.Add(($"Có thể gộp thêm từ đơn khác ({(((decimal)groupSecondaryItems.Count).DisplayQuantity())})", groupSecondaryItems));
                            }
                        }
                        @foreach (var (sectionLabel, sectionItems) in groupedItems)
                        {
                            if (!string.IsNullOrEmpty(sectionLabel) && groupedItems.Count > 1)
                            {
                                var isSecondarySection = sectionItems.Any() && !sectionItems[0].IsFromPrimaryOrder;
                                <div class="shortage-subgroup-label @(isSecondarySection ? "shortage-subgroup-secondary" : "shortage-subgroup-primary")">
                                    <i class="bi @(isSecondarySection ? "bi-plus-circle" : "bi-check-circle")"></i>
                                    <span>@sectionLabel</span>
                                </div>
                            }

                            foreach (var item in sectionItems)
                            {
                                var unitName = string.IsNullOrWhiteSpace(item.UnitMeasurementName) ? "sp" : item.UnitMeasurementName!;
                                var currentSuggestion = item.SupplierSuggestions.FirstOrDefault(suggestion => suggestion.VendorId == group.VendorId);
                                var lastPrice = currentSuggestion?.LastUnitPrice ?? item.UnitCost;
                                var lastPurchaseText = currentSuggestion?.LastPurchaseDate?.ToString("dd/MM");
                                var itemTotal = item.QuantityToOrder * item.UnitCost;
                                var suggestionsJson = System.Text.Json.JsonSerializer.Serialize(
                                    item.SupplierSuggestions.Select(s => new
                                    {
                                        vendorId = s.VendorId,
                                        vendorName = s.VendorName,
                                        lastUnitPrice = s.LastUnitPrice,
                                        lastPurchaseDate = s.LastPurchaseDate.HasValue
                                            ? s.LastPurchaseDate.Value.ToString("dd/MM")
                                            : null
                                    }));

                                <div class="shortage-order-item @(item.IsFromPrimaryOrder ? "" : "shortage-item-secondary")"
                                     data-order-item-id="@item.OrderItemId"
                                     data-order-id="@item.OrderId"
                                     data-order-code="@item.OrderCode"
                                     data-product-id="@item.ProductId"
                                     data-product-name="@item.ProductName"
                                     data-unit-name="@unitName"
                                     data-shortage-quantity='@item.ShortageQuantity.ToString("0.####", CultureInfo.InvariantCulture)'
                                     data-is-primary="@(item.IsFromPrimaryOrder ? "true" : "false")"
                                     data-customer-name="@(item.CustomerName ?? "")"
                                     data-customer-phone="@(item.ShippingPhoneNumber ?? item.CustomerPhone ?? "")"
                                     data-customer-address="@(item.ShippingAddress ?? item.CustomerAddress ?? "")"
                                     data-suggestions="@suggestionsJson">
                                    <div class="shortage-item-check">
                                        <input type="checkbox" class="form-check-input item-check" @(item.IsFromPrimaryOrder ? "checked" : "") />
                                    </div>
                                    <div class="shortage-item-main">
                                        <div class="shortage-item-topline">
                                            <div>
                                                <div class="shortage-item-name">@item.ProductName</div>
                                                <div class="shortage-item-meta">
                                                    Tồn @item.AvailableQuantity.DisplayQuantity() @unitName · Cần thêm @item.ShortageQuantity.DisplayQuantity() @unitName
                                                    <span class="shortage-item-lastprice">
                                                        @if (lastPrice > 0)
                                                        {
                                                            <text> · Giá lần trước @lastPrice.DisplayCurrencyWithSymbol()</text>
                                                            if (!string.IsNullOrWhiteSpace(lastPurchaseText))
                                                            {
                                                                <text> (@lastPurchaseText)</text>
                                                            }
                                                        }
                                                    </span>
                                                </div>
                                                <div class="shortage-item-orders">
                                                    Cho đơn: <span class="fw-medium">@item.OrderCode</span> (đặt @item.ShortageQuantity.DisplayQuantity() @unitName)
                                                    @if (item.AllocatedFromPurchaseOrders.Any())
                                                    {
                                                        <span> · </span>
                                                        foreach (var allocation in item.AllocatedFromPurchaseOrders.Take(2))
                                                        {
                                                            <a asp-controller="PurchaseOrder" asp-action="Details" asp-route-id="@allocation.PurchaseOrderId">
                                                                @allocation.PurchaseOrderCode
                                                            </a>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                            <div class="shortage-item-total item-total">@itemTotal.DisplayCurrencyWithSymbol()</div>
                                        </div>

                                        <div class="shortage-item-inputs">
                                            <label>
                                                <span>Số lượng:</span>
                                                <span>
                                                    <input class="form-control quantity-to-order" data-decimal="quantity" data-decimals="@item.QuantityDecimalPlaces" name="quantityToOrder@(item.OrderItemId)"
                                                           value="@item.QuantityToOrder.DisplayCurrency()" autocomplete="off" inputmode="decimal"
                                                           data-val="true" data-val-required="Vui lòng nhập số lượng"
                                                           data-val-range="Số lượng phải lớn hơn 0" data-val-range-min="@(item.QuantityDecimalPlaces > 0 ? "0.0001" : "1")"
                                                           data-val-number="Số lượng phải là số" />
                                                    <span class="small text-danger field-validation-valid" data-valmsg-for="quantityToOrder@(item.OrderItemId)" data-valmsg-replace="true"></span>
                                                </span>
                                                <span>@unitName</span>
                                            </label>
                                            <span class="shortage-input-separator">×</span>
                                            <label>
                                                <span>Giá nhập:</span>
                                                <div>
                                                    <input class="form-control unit-cost" value="@item.UnitCost.DisplayCurrency()" inputmode="numeric"
                                                           data-decimal="currency" autocomplete="off" name="unitCost@(item.OrderItemId)"
                                                           data-val="true" data-val-required="Vui lòng nhập đơn giá."
                                                           data-val-range="Đơn giá phải lớn hơn 0" data-val-range-min="0.1"
                                                           data-val-number="Đơn giá phải là số" />
                                                    <span class="small text-danger field-validation-valid" data-valmsg-for="unitCost@(item.OrderItemId)" data-valmsg-replace="true"></span>
                                                </div>
                                                <span>đ</span>
                                            </label>
                                            @if (item.SupplierSuggestions.Count > 1)
                                            {
                                                <label class="shortage-item-vendor-field">
                                                    <span>NCC:</span>
                                                    <select class="form-select form-select-sm item-vendor">
                                                        @foreach (var suggestion in item.SupplierSuggestions)
                                                        {
                                                            <option value="@suggestion.VendorId"
                                                                    selected="@(suggestion.VendorId == group.VendorId)">
                                                                @suggestion.VendorName
                                                            </option>
                                                        }
                                                    </select>
                                                </label>
                                            }
                                        </div>
                                        <div class="shortage-direct-ship-toggle">
                                            <label class="shortage-ds-check-label">
                                                <input type="checkbox" class="form-check-input direct-ship-check" />
                                                <i class="bi bi-truck-flatbed shortage-ds-icon"></i>
                                                <span>Giao thẳng tới khách</span>
                                            </label>
                                            <span class="badge bg-success shortage-ds-badge d-none"><i class="bi bi-truck-fast me-1"></i>Giao thẳng</span>
                                        </div>
                                        <div class="shortage-direct-ship-form d-none">
                                            <label class="shortage-ds-field">
                                                <span>Địa chỉ:</span>
                                                <input type="text" class="form-control ds-address" placeholder="Địa chỉ"
                                                       name="ds@(item.OrderItemId)_address" data-val="true"
                                                       data-val-maxlength="Địa chỉ tối đa 500 ký tự"
                                                       data-val-maxlength-max="500" />
                                                <span class="small text-danger field-validation-valid" data-valmsg-for="ds@(item.OrderItemId)_address" data-valmsg-replace="true"></span>
                                            </label>
                                            <label class="shortage-ds-field">
                                                <span>Điện thoại:</span>
                                                <input type="text" class="form-control ds-contact-phone" placeholder="SĐT người nhận *"
                                                       name="ds@(item.OrderItemId)_contactPhone" inputmode="tel"
                                                       data-val-regex="Số điện thoại không hợp lệ." data-val-regex-pattern="0\d{9,10}"
                                                       data-val="true" data-val-required="Vui lòng nhập số điện thoại" />
                                                <span class="small text-danger field-validation-valid" data-valmsg-for="ds@(item.OrderItemId)_contactPhone" data-valmsg-replace="true"></span>
                                            </label>
                                            <label class="shortage-ds-field">
                                                <span>Người nhận:</span>
                                                <input type="text" class="form-control ds-contact-name" placeholder="Người nhận" name="ds@(item.OrderItemId)_contactName"
                                                       data-val="true" data-val-maxlength="Tên người nhận tối đa 200 ký tự" data-val-maxlength-max="200" />
                                                <span class="small text-danger field-validation-valid" data-valmsg-for="ds@(item.OrderItemId)_contactName" data-valmsg-replace="true"></span>
                                            </label>
                                            <label class="shortage-ds-field shortage-ds-priority-field">
                                                <span>Ưu tiên:</span>
                                                <input type="number" class="form-control ds-priority" min="0" step="1" value="0" inputmode="numeric" />
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }

            @if (noVendorItems.Count > 0)
            {
                <div class="shortage-unmapped-alert">
                    <div class="shortage-unmapped-icon">
                        <i class="bi bi-question-circle"></i>
                    </div>
                    <div>
                        <div class="fw-semibold">Chưa có nhà cung cấp gợi ý cho @noVendorItems.Count mặt hàng</div>
                        <div>Khi có mặt hàng thiếu mà chưa map với NCC nào, hệ thống sẽ liệt kê ở đây để anh chọn NCC thủ công.</div>
                    </div>
                </div>
            }

            <div class="shortage-create-bar">
                <div>
                    <div id="selectedShortageSummary" class="shortage-create-summary">Sẽ xử lý 0 NCC · 0 mặt hàng</div>
                    <div id="directShipSummary" class="shortage-ds-summary d-none"></div>
                    <div class="shortage-create-total">Tổng <span id="stickyGrandTotalAmount">@(0m.DisplayCurrencyWithSymbol())</span></div>
                </div>
                <div class="shortage-create-actions">
                    <a class="btn btn-outline-secondary" asp-controller="PurchaseOrder" asp-action="List">Hủy</a>
                    <button type="button" class="btn btn-secondary btn-create-from-shortage">
                        Tạo phiếu nhập <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
            </div>
        </form>
    }
</div>

<template id="vendorCardTemplate">
    <div class="shortage-order-card shortage-group" data-vendor-id="" data-vendor-name="">
        <div class="shortage-order-card-header">
            <div class="shortage-vendor-heading">
                <input type="checkbox" class="form-check-input group-check" />
                <span class="shortage-vendor-icon"><i class="bi bi-building"></i></span>
                <div>
                    <div class="shortage-vendor-name">__VENDOR_NAME__</div>
                    <div class="shortage-vendor-meta"></div>
                </div>
            </div>
            <div class="shortage-group-money">
                <strong class="group-total">@(0m.DisplayCurrencyWithSymbol())</strong>
                <span>tạm tính</span>
            </div>
        </div>
        <div class="shortage-order-card-controls">
            <label class="shortage-inline-field">
                <span><i class="bi bi-calendar2-week"></i>Hẹn nhận:</span>
                <input type="date" class="form-control expected-date" value="@defaultExpectedDate" placeholder="Chọn ngày hẹn" />
            </label>
            <label class="shortage-inline-field shortage-note-field">
                <span><i class="bi bi-stickies"></i>Ghi chú:</span>
                <input type="text" class="form-control group-note" maxlength="1000" placeholder="Nhập ghi chú" />
            </label>
        </div>
        <div class="shortage-order-items"></div>
    </div>
</template>

<div class="modal fade" id="existingDraftModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content ui-modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Đơn nhập liên quan</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="related-po-help">Chọn phân bổ từ đơn nhập đang có, ghép thêm vào đơn nhập nháp, hoặc tạo đơn nhập mới cho phần còn thiếu.</div>
                <div id="existingDraftList" class="related-po-list"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-dark" id="btnConfirmCreateFromShortage">
                    <i class="bi bi-check-all me-1"></i>Xác nhận
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="createdPurchaseOrdersModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content ui-modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Tạo phiếu nhập thành công</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body bg-light" id="createdPurchaseOrdersList">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module">
        import { toast, confirm } from '/modules/modals.js';
        import { apiPost } from '/modules/ajax-helper.js';

        (() => {
            const formatter = new Intl.NumberFormat('vi-VN');
            const quantityFormatter = new Intl.NumberFormat('vi-VN', { maximumFractionDigits: 2 });
            const tolerance = 0.0001;
            let groups = Array.from(document.querySelectorAll('.shortage-group'));
            const vendorCardTemplate = document.getElementById('vendorCardTemplate');
            const shortagePage = document.querySelector('.shortage-order-page');
            const resultBox = document.getElementById('createShortageResult');
            const createButtons = Array.from(document.querySelectorAll('.btn-create-from-shortage'));
            const vendorFilter = document.getElementById('vendorFilter');
            const productFilter = document.getElementById('productFilter');
            const draftModalEl = document.getElementById('existingDraftModal');
            const draftModal = draftModalEl ? new bootstrap.Modal(draftModalEl) : null;
            const draftList = document.getElementById('existingDraftList');
            const confirmButton = document.getElementById('btnConfirmCreateFromShortage');
            let modalContext = { lines: [] };
            const form = document.getElementById('shortageAggregateForm');

            const directShipSummaryEl = document.getElementById('directShipSummary');

            function handleDirectShipToggle(row, checkbox) {
                const form = row.querySelector('.shortage-direct-ship-form');
                const badge = row.querySelector('.shortage-ds-badge');
                const isChecked = checkbox.checked;
                form?.classList.toggle('d-none', !isChecked);
                badge?.classList.toggle('d-none', !isChecked);

                if (isChecked && form) {
                    const addrInput = form.querySelector('.ds-address');
                    if (addrInput && !addrInput.value) {
                        addrInput.value = row.dataset.customerAddress || '';
                        form.querySelector('.ds-contact-name').value = row.dataset.customerName || '';
                        form.querySelector('.ds-contact-phone').value = row.dataset.customerPhone || '';
                    }
                }

                refreshTotals();
            }

            function wireGroup(group) {
                group.querySelector('.group-check')?.addEventListener('change', event => {
                    group.querySelectorAll('.item-check').forEach(check => {
                        check.checked = event.target.checked;
                    });
                    refreshTotals();
                });
                group.querySelectorAll('.item-check').forEach(check => {
                    check.addEventListener('change', refreshTotals);
                });
                group.querySelectorAll('.direct-ship-check').forEach(check => {
                    check.addEventListener('change', () => {
                        const row = check.closest('.shortage-order-item');
                        if (row) handleDirectShipToggle(row, check);
                    });
                });

                DecimalFields.autoWrap(group);
                if (window.initFlatPickrControls)
                    window.initFlatPickrControls(group);
            }

            function findOrCreateVendorGroup(vendorId, vendorName) {
                const existing = groups.find(group => equalsId(group.dataset.vendorId, vendorId));
                if (existing) return existing;

                const fragment = vendorCardTemplate.content.cloneNode(true);
                const card = fragment.querySelector('.shortage-group');
                card.dataset.vendorId = vendorId;
                card.dataset.vendorName = vendorName;
                const nameEl = card.querySelector('.shortage-vendor-name');
                if (nameEl) nameEl.textContent = vendorName;

                const createBar = form.querySelector('.shortage-create-bar');
                form.insertBefore(card, createBar);

                groups.push(card);
                wireGroup(card);

                if (vendorFilter && !Array.from(vendorFilter.options).some(option => equalsId(option.value, vendorId))) {
                    const option = document.createElement('option');
                    option.value = vendorId;
                    option.textContent = vendorName;
                    vendorFilter.appendChild(option);
                }

                $(form).removeData('validator').removeData('unobtrusiveValidation');
                $.validator.unobtrusive.parse(form);

                return card;
            }

            function handleItemVendorChange(select) {
                const row = select.closest('.shortage-order-item');
                if (!row) return;

                const sourceGroup = row.closest('.shortage-group');
                let suggestions = [];
                try {
                    suggestions = JSON.parse(row.dataset.suggestions || '[]');
                } catch {
                    suggestions = [];
                }

                const vendorId = select.value;
                const suggestion = suggestions.find(s => equalsId(s.vendorId, vendorId));
                if (!suggestion) return;

                const targetGroup = findOrCreateVendorGroup(vendorId, suggestion.vendorName);
                if (targetGroup === sourceGroup) return;

                targetGroup.querySelector('.shortage-order-items').appendChild(row);

                if (suggestion.lastUnitPrice != null) {
                    const unitCostInput = row.querySelector('.unit-cost');
                    if (unitCostInput) unitCostInput.value = DecimalFields.formatCurrency(suggestion.lastUnitPrice);
                }

                const lastPriceEl = row.querySelector('.shortage-item-lastprice');
                if (lastPriceEl) {
                    lastPriceEl.textContent = suggestion.lastUnitPrice != null
                        ? ` · Giá lần trước ${DecimalFields.formatCurrency(suggestion.lastUnitPrice)}` +
                        (suggestion.lastPurchaseDate ? ` (${suggestion.lastPurchaseDate})` : '')
                        : '';
                }

                if (sourceGroup) syncGroupCheck(sourceGroup);
                syncGroupCheck(targetGroup);
                refreshTotals();
                applyFilters();
            }

            function parseDecimal(value) {
                value = String(value || '').replace(',', '.');
                const number = Number(value);
                return Number.isFinite(number) ? number : 0;
            }

            function readDecimal(input) {
                return parseDecimal(input?.value);
            }
            function readCurrency(input) {
                return parseDecimal(DecimalFields.stripFormatting(input?.value));
            }
            function readQuantity(input) {
                return parseDecimal(DecimalFields.stripFormatting(input?.value, 2));
            }

            function formatInputNumber(value) {
                if (!Number.isFinite(value)) return '0';
                return Number.parseFloat(value.toFixed(4)).toString();
            }

            function formatMoney(value) {
                return DecimalFields.formatCurrency(value);
            }

            function formatQuantity(value, unitName) {
                return `${quantityFormatter.format(value)} ${unitName || 'sp'}`;
            }

            function formatDate(value) {
                if (!value) return '';
                const date = new Date(value);
                return Number.isNaN(date.getTime()) ? '' : date.toLocaleDateString('vi-VN');
            }

            function equalsId(left, right) {
                return String(left || '').toLowerCase() === String(right || '').toLowerCase();
            }

            function escapeHtml(value) {
                return String(value ?? '').replace(/[&<>"']/g, char => ({
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#039;'
                }[char]));
            }

            function syncGroupCheck(group) {
                const groupCheck = group.querySelector('.group-check');
                const itemChecks = Array.from(group.querySelectorAll('.item-check'));
                const checkedCount = itemChecks.filter(check => check.checked).length;
                groupCheck.checked = checkedCount === itemChecks.length && itemChecks.length > 0;
                groupCheck.indeterminate = checkedCount > 0 && checkedCount < itemChecks.length;
            }

            function refreshTotals() {
                let grandTotal = 0;
                let selectedGroupCount = 0;
                let selectedItemCount = 0;
                let directShipCount = 0;
                let warehouseCount = 0;

                groups.forEach(group => {
                    let groupTotal = 0;
                    let groupSelectedItems = 0;
                    const groupHidden = group.classList.contains('d-none');

                    group.querySelectorAll('.shortage-order-item').forEach(row => {
                        const rowHidden = row.classList.contains('d-none');
                        const checked = row.querySelector('.item-check')?.checked;
                        const rowTotal = readQuantity(row.querySelector('.quantity-to-order')) * readCurrency(row.querySelector('.unit-cost'));
                        const itemTotalEl = row.querySelector('.item-total');
                        if (itemTotalEl) itemTotalEl.textContent = formatMoney(rowTotal);

                        row.classList.toggle('is-not-selected', !checked);
                        ['input', 'select', 'textarea'].forEach(tag =>
                            row.querySelectorAll(tag).forEach(control => {
                                if (control.classList.contains('item-check'))
                                    return;
                                control.disabled = !checked;
                            })
                        );
                        if (checked && !rowHidden && !groupHidden) {
                            groupTotal += rowTotal;
                            groupSelectedItems++;
                            if (row.querySelector('.direct-ship-check')?.checked) {
                                directShipCount++;
                            } else {
                                warehouseCount++;
                            }
                        }
                    });

                    if (groupSelectedItems > 0) {
                        selectedGroupCount++;
                        selectedItemCount += groupSelectedItems;
                    }

                    grandTotal += groupTotal;
                    const totalEl = group.querySelector('.group-total');
                    if (totalEl) totalEl.textContent = formatMoney(groupTotal);
                    syncGroupCheck(group);
                });

                const stickyGrandTotalEl = document.getElementById('stickyGrandTotalAmount');
                if (stickyGrandTotalEl) stickyGrandTotalEl.textContent = formatMoney(grandTotal);

                const summaryEl = document.getElementById('selectedShortageSummary');
                if (summaryEl) summaryEl.textContent = `Sẽ xử lý ${selectedGroupCount} NCC · ${selectedItemCount} mặt hàng`;

                if (directShipSummaryEl) {
                    if (directShipCount > 0 || warehouseCount > 0) {
                        directShipSummaryEl.classList.remove('d-none');
                        directShipSummaryEl.textContent = `${directShipCount} giao thẳng · ${warehouseCount} về kho`;
                    } else {
                        directShipSummaryEl.classList.add('d-none');
                    }
                }

                createButtons.forEach(button => button.disabled = selectedItemCount === 0);
            }

            function applyFilters() {
                const vendorId = vendorFilter?.value || '';
                const productId = productFilter?.value || '';

                groups.forEach(group => {
                    const matchesVendor = !vendorId || group.dataset.vendorId === vendorId;
                    let visibleRows = 0;

                    group.querySelectorAll('.shortage-order-item').forEach(row => {
                        const matchesProduct = !productId || row.dataset.productId === productId;
                        const visible = matchesVendor && matchesProduct;
                        row.classList.toggle('d-none', !visible);
                        if (visible) visibleRows++;
                    });

                    group.classList.toggle('d-none', !matchesVendor || visibleRows === 0);
                });

                refreshTotals();
            }

            function getSelectedLines() {
                return groups
                    .filter(group => !group.classList.contains('d-none'))
                    .flatMap(group => Array.from(group.querySelectorAll('.shortage-order-item'))
                        .filter(row => !row.classList.contains('d-none') && row.querySelector('.item-check')?.checked)
                        .map(row => {
                            const dsCheck = row.querySelector('.direct-ship-check');
                            const isDirectShip = dsCheck?.checked || false;
                            const dsForm = row.querySelector('.shortage-direct-ship-form');
                            const quantity = readQuantity(row.querySelector('.quantity-to-order'));
                            const shortageQuantity = parseDecimal(row.dataset.shortageQuantity);
                            const allocationQuantity = Math.min(quantity, shortageQuantity > 0 ? shortageQuantity : quantity);
                            const directShip = isDirectShip && allocationQuantity > 0 && dsForm ? {
                                address: dsForm.querySelector('.ds-address')?.value?.trim() || '',
                                contactName: dsForm.querySelector('.ds-contact-name')?.value?.trim() || null,
                                contactPhone: dsForm.querySelector('.ds-contact-phone')?.value?.trim() || null,
                                priority: parseInt(dsForm.querySelector('.ds-priority')?.value || '0', 10) || 0
                            } : null;

                            return {
                                group,
                                row,
                                vendorId: group.dataset.vendorId,
                                vendorName: group.dataset.vendorName || '',
                                orderId: row.dataset.orderId,
                                orderItemId: row.dataset.orderItemId,
                                orderCode: row.dataset.orderCode || '',
                                productId: row.dataset.productId,
                                productName: row.dataset.productName || '',
                                unitName: row.dataset.unitName || 'sp',
                                quantity,
                                allocationQuantity,
                                unitCost: readCurrency(row.querySelector('.unit-cost')),
                                expectedDeliveryDate: group.querySelector('.expected-date')?.value || null,
                                note: group.querySelector('.group-note')?.value || null,
                                directShip
                            };
                        })
                        .filter(line => line.quantity > 0));
            }

            function validateDirectShipLines(lines) {
                for (const line of lines) {
                    if (!line.directShip) continue;

                    const phoneInput = line.row.querySelector('.ds-contact-phone');
                    const phone = phoneInput?.value?.trim() || '';
                    if (!phone) {
                        alert('Vui lòng nhập số điện thoại nhận hàng giao thẳng.');
                        phoneInput?.focus();
                        return false;
                    }

                    const addressInput = line.row.querySelector('.ds-address');
                    const address = addressInput?.value?.trim() || '';
                    if (!address) {
                        alert('Vui lòng nhập địa chỉ giao hàng.');
                        addressInput?.focus();
                        return false;
                    }
                }

                return true;
            }

            function buildPayloadForLines(lines, actionResolver) {
                const groupMap = new Map();
                lines.forEach((line, index) => {
                    if (!groupMap.has(line.vendorId)) {
                        groupMap.set(line.vendorId, {
                            vendorId: line.vendorId,
                            expectedDeliveryDate: line.expectedDeliveryDate,
                            note: line.note,
                            items: []
                        });
                    }

                    const actions = actionResolver
                        ? actionResolver(line, index)
                        : [{
                            actionType: 'CreateNew',
                            quantity: line.quantity,
                            unitCost: line.unitCost
                        }];

                    groupMap.get(line.vendorId).items.push({
                        orderId: line.orderId,
                        orderItemId: line.orderItemId,
                        productId: line.productId,
                        quantity: line.quantity,
                        allocationQuantity: Math.min(line.allocationQuantity ?? line.quantity, line.quantity),
                        unitCost: line.unitCost,
                        directShipInfo: line.directShip,
                        actions
                    });
                });

                return {
                    groups: Array.from(groupMap.values()).filter(group => group.items.length > 0)
                };
            }

            async function postJson(url, body) {
                return await apiPost(url, body);
            }

            async function createPurchaseOrders(payload, lines) {
                if (payload.groups.length === 0) return;

                showPageLoading();
                createButtons.forEach(button => button.disabled = true);

                const result = await postJson('/PurchaseOrder/CreateFromShortage', payload);

                createButtons.forEach(button => button.disabled = false);
                hidePageLoading();

                refreshTotals();

                if (!result.success) {
                    return;
                }

                if (lines) {
                    let html = `<div class="alert alert-success d-flex align-items-center mb-4 border-0 shadow-sm">
                                            <i class="bi bi-check-circle-fill fs-4 me-3"></i>
                                            <div>Đã xử lý thành công <strong>${result.data.length}</strong> đơn nhập hàng từ danh sách hàng thiếu.</div>
                                        </div>`;

                    const vendorIds = [...new Set(result.data.map(po => String(po.vendorId).toLowerCase()))];

                    vendorIds.forEach(vid => {
                        const vendorPos = result.data.filter(po => equalsId(po.vendorId, vid));
                        const poLines = lines.filter(l => equalsId(l.vendorId, vid));
                        const vendorName = poLines.length > 0 ? poLines[0].vendorName : 'Nhà cung cấp';

                        html += `
                                <div class="card mb-3 border-0 shadow-sm">
                                    <div class="card-header bg-white border-bottom-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
                                        <span class="fw-bold fs-6"><i class="bi bi-building me-2 text-muted"></i>${escapeHtml(vendorName)}</span>
                                        <div>
                                            ${vendorPos.map(po => `<a href="/PurchaseOrder/Details/${po.purchaseOrderId}" class="btn btn-sm btn-outline-dark ms-2 fw-medium">Xem chi tiết ${escapeHtml(po.purchaseOrderCode)} <i class="bi bi-arrow-right-short"></i></a>`).join('')}
                                        </div>
                                    </div>
                                    <div class="card-body p-0">
                                        <ul class="list-group list-group-flush border-top">
                                            ${poLines.map(l => `
                                                <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3 border-0 border-bottom">
                                                    <span class="text-body">${escapeHtml(l.productName)}</span>
                                                    <span class="fw-medium text-body-secondary">${formatQuantity(l.quantity, l.unitName)}</span>
                                                </li>
                                            `).join('')}
                                        </ul>
                                    </div>
                                </div>
                                `;
                    });

                    sessionStorage.setItem('shortageCreatedHtml', html);
                    if (typeof showPageLoading === 'function') {
                        showPageLoading();
                    }
                    location.reload();
                } else {
                    location.reload();
                }
            }

            function renderActionRow({ actionType, label, details, quantity, maxQuantity, checked, poId, poItemId, isNew, statusBadge }) {
                const maxAttr = maxQuantity ? `data-val-range-max="${formatInputNumber(maxQuantity)}"` : '';
                const rowClass = isNew ? 'table-primary bg-opacity-10' : '';
                const actionIcon = isNew ? '<i class="bi bi-plus-circle text-primary me-2"></i>' :
                    actionType === 'AllocateFromExisting' ? '<i class="bi bi-box-seam text-success me-2"></i>' :
                        '<i class="bi bi-diagram-3 text-warning me-2"></i>';

                return `
                            <tr class="po-action-row ${rowClass}">
                                <td class="text-center align-middle">
                                    <input class="form-check-input related-action-check fs-5 m-0" type="checkbox" ${checked ? 'checked' : ''}
                                           data-action-type="${escapeHtml(actionType)}"
                                           data-po-id="${escapeHtml(poId || '')}"
                                           data-po-item-id="${escapeHtml(poItemId || '')}">
                                </td>
                                <td class="fw-medium align-middle text-nowrap">
                                    ${actionIcon}
                                    ${label}
                                </td>
                                <td class="align-middle">
                                    ${details}
                                    ${statusBadge ? ` <span class="ms-2">${statusBadge}</span>` : ''}
                                </td>
                                <td class="align-middle">
                                    <div class="input-group input-group-sm ui-float-end-w-140">
                                        <input class="form-control text-end related-action-qty ${isNew ? 'shortage-new-action-qty' : ''}"
                                               ${maxAttr} data-decimal="quantity" value="1" autocomplete="off" inputmode="decimal"
                                               data-val="true" data-val-required="Vui lòng nhập số lượng"
                                               data-val-range="Số lượng phải lớn hơn 0 ${maxAttr ? ` và nhỏ hơn ${DecimalFields.formatQuantity(maxQuantity)}` : ''}"
                                               data-val-range-min="0.0001"
                                               data-val-number="Số lượng phải là số"
                                               value="${DecimalFields.formatQuantity(quantity)}">
                                    </div>
                                </td>
                            </tr>`;
            }

            function renderPurchaseOrderCard(po, line, allocationRows, mergeRow) {
                return allocationRows + mergeRow;
            }

            function renderRelatedLine(line, index, purchaseOrders) {
                let remaining = line.quantity;
                const poCards = purchaseOrders.map(po => {
                    const matchingItems = (po.items || [])
                        .filter(item => equalsId(item.productId, line.productId) && item.availableForAllocation > 0 && po.canAllocate);

                    const allocationRows = matchingItems.map(item => {
                        const quantity = Math.min(Math.max(remaining, 0), item.availableForAllocation);
                        const checked = quantity > 0;
                        if (checked) remaining -= quantity;

                        const statusBadge = `<span class="badge ${escapeHtml(po.statusClass || 'bg-secondary')}">${escapeHtml(po.statusName || '')}</span>`;

                        return renderActionRow({
                            actionType: 'AllocateFromExisting',
                            label: 'Lấy từ PO có sẵn',
                            details: `Đơn <strong>${escapeHtml(po.code)}</strong>. Còn trống ${formatQuantity(item.availableForAllocation, line.unitName)} / ${formatQuantity(item.quantityOrdered, line.unitName)}`,
                            quantity,
                            maxQuantity: Math.min(item.availableForAllocation, line.quantity),
                            checked,
                            poId: po.id,
                            poItemId: item.purchaseOrderItemId,
                            statusBadge
                        });
                    }).join('');

                    const mergeQuantity = Math.max(remaining, 0) || line.quantity;
                    const statusBadge = `<span class="badge ${escapeHtml(po.statusClass || 'bg-secondary')}">${escapeHtml(po.statusName || '')}</span>`;
                    const mergeRow = po.canMerge
                        ? renderActionRow({
                            actionType: 'MergeIntoDraft',
                            label: 'Ghép vào PO nháp',
                            details: `Thêm vào đơn <strong>${escapeHtml(po.code)}</strong>`,
                            quantity: mergeQuantity,
                            maxQuantity: line.quantity,
                            checked: false,
                            poId: po.id,
                            statusBadge
                        })
                        : '';

                    return allocationRows + mergeRow;
                }).filter(Boolean).join('');

                const newQuantity = Math.max(remaining, 0);
                const newRow = renderActionRow({
                    actionType: 'CreateNew',
                    label: 'Tạo PO mới',
                    details: `Tạo một đơn đặt hàng mới cho phần này`,
                    quantity: newQuantity,
                    maxQuantity: line.quantity,
                    checked: newQuantity > 0,
                    isNew: true
                });

                const orderBreakdown = line.underlying && line.underlying.length > 1
                    ? `<div class="text-muted mt-1 small">Gồm ${line.underlying.length} đơn: ${line.underlying.map(u => `${escapeHtml(u.orderCode || '')} (${formatQuantity(u.quantity, line.unitName)})`).join(', ')}</div>`
                    : '';

                return `
                            <div class="card related-line-card mb-4 border shadow-sm" data-line-index="${index}" data-quantity="${formatInputNumber(line.quantity)}" data-unit-cost="${formatInputNumber(line.unitCost)}" data-unit-name="${escapeHtml(line.unitName)}">
                                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                                    <div>
                                        <div class="fw-bold fs-6 text-dark">${escapeHtml(line.productName)}</div>
                                        <div class="text-secondary small mt-1">Cần xử lý: <strong class="text-dark">${formatQuantity(line.quantity, line.unitName)}</strong> · NCC: ${escapeHtml(line.vendorName)}</div>
                                        ${orderBreakdown}
                                    </div>
                                    <div class="related-line-balance badge bg-secondary px-3 py-2 fs-6 rounded-pill" data-line-balance></div>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0 border-top">
                                        <thead class="table-light text-muted small">
                                            <tr>
                                                <th class="text-center border-bottom-0 ui-w-50">Chọn</th>
                                                <th class="border-bottom-0 ui-w-25p">Giải pháp xử lý</th>
                                                <th class="border-bottom-0">Thông tin chi tiết</th>
                                                <th class="text-end border-bottom-0 pe-4 ui-w-150">Số lượng</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            ${poCards || '<tr><td colspan="4" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-2 text-black-50"></i>Không có PO phù hợp để lấy hàng hoặc ghép.</td></tr>'}
                                            ${newRow}
                                        </tbody>
                                    </table>
                                </div>
                            </div>`;
            }

            function groupLinesForDisplay(lines) {
                const map = new Map();
                lines.forEach(line => {
                    const key = `${line.vendorId || ''}|${line.productId || ''}|${formatInputNumber(line.unitCost)}`;
                    if (!map.has(key)) {
                        map.set(key, {
                            key,
                            vendorId: line.vendorId,
                            vendorName: line.vendorName,
                            productId: line.productId,
                            productName: line.productName,
                            unitCost: line.unitCost,
                            unitName: line.unitName,
                            quantity: 0,
                            allocationQuantity: 0,
                            underlying: []
                        });
                    }
                    const groupLine = map.get(key);
                    groupLine.quantity += line.quantity;
                    groupLine.allocationQuantity += line.allocationQuantity;
                    groupLine.underlying.push({
                        orderId: line.orderId,
                        orderItemId: line.orderItemId,
                        orderCode: line.orderCode || '',
                        quantity: line.quantity,
                        allocationQuantity: line.allocationQuantity,
                        original: line
                    });
                });
                return Array.from(map.values());
            }

            function getLineActionState(card) {
                const actions = [];
                let total = 0;
                let overMax = false;

                card.querySelectorAll('.related-action-check:checked').forEach(check => {
                    const row = check.closest('.po-action-row');
                    const input = row?.querySelector('.related-action-qty');
                    const quantity = readQuantity(input);
                    const max = parseDecimal(input?.getAttribute('max'));
                    if (max > 0 && quantity > max + tolerance) overMax = true;
                    if (quantity <= 0) return;

                    total += quantity;
                    actions.push({
                        actionType: check.dataset.actionType,
                        purchaseOrderId: check.dataset.poId || null,
                        purchaseOrderItemId: check.dataset.poItemId || null,
                        quantity,
                        unitCost: parseDecimal(card.dataset.unitCost)
                    });
                });

                return { actions, total, overMax };
            }

            function balanceNewAction(card) {
                const needed = parseDecimal(card.dataset.quantity);
                let nonNewTotal = 0;
                card.querySelectorAll('.related-action-check:checked').forEach(check => {
                    if (check.dataset.actionType === 'CreateNew') return;
                    const input = check.closest('.po-action-row')?.querySelector('.related-action-qty');
                    nonNewTotal += readQuantity(input);
                });

                const newCheck = card.querySelector('.related-action-check[data-action-type="CreateNew"]');
                const newInput = newCheck?.closest('.po-action-row')?.querySelector('.related-action-qty');
                if (newCheck?.checked && newInput) {
                    newInput.value = formatInputNumber(Math.max(0, needed - nonNewTotal));
                }
            }

            function refreshRelatedModal() {
                if (!confirmButton) return;

                let isValid = true;
                draftList.querySelectorAll('.related-line-card').forEach(card => {
                    const needed = parseDecimal(card.dataset.quantity);
                    const unitName = card.dataset.unitName || 'sp';
                    const state = getLineActionState(card);
                    const remaining = needed - state.total;
                    const balanceEl = card.querySelector('[data-line-balance]');
                    const invalid = state.overMax || Math.abs(remaining) > tolerance;
                    card.classList.toggle('is-invalid', invalid);
                    card.classList.toggle('border-danger', invalid);

                    if (state.overMax) {
                        balanceEl.textContent = 'Vượt số lượng có thể dùng';
                        balanceEl.className = 'related-line-balance badge bg-danger px-3 py-2 fs-6 rounded-pill';
                    } else if (Math.abs(remaining) <= tolerance) {
                        balanceEl.textContent = 'Đã phân bổ đủ';
                        balanceEl.className = 'related-line-balance badge bg-success px-3 py-2 fs-6 rounded-pill';
                    } else if (remaining > 0) {
                        balanceEl.textContent = `Còn thiếu ${formatQuantity(remaining, unitName)}`;
                        balanceEl.className = 'related-line-balance badge bg-warning text-dark px-3 py-2 fs-6 rounded-pill';
                    } else {
                        balanceEl.textContent = `Vượt ${formatQuantity(Math.abs(remaining), unitName)}`;
                        balanceEl.className = 'related-line-balance badge bg-danger px-3 py-2 fs-6 rounded-pill';
                    }

                    if (invalid) isValid = false;
                });

                confirmButton.disabled = !isValid;
            }

            function renderRelatedModal(originalLines, relatedPurchaseOrders) {
                const relatedByVendor = new Map();
                relatedPurchaseOrders.forEach(po => {
                    const key = String(po.vendorId || '').toLowerCase();
                    if (!relatedByVendor.has(key)) relatedByVendor.set(key, []);
                    relatedByVendor.get(key).push(po);
                });

                const displayLines = groupLinesForDisplay(originalLines);
                modalContext = { originalLines, displayLines };

                draftList.innerHTML = displayLines.map((displayLine, index) => {
                    const purchaseOrders = relatedByVendor.get(String(displayLine.vendorId || '').toLowerCase()) || [];
                    return renderRelatedLine(displayLine, index, purchaseOrders);
                }).join('');

                draftList.querySelectorAll('.related-line-card').forEach(balanceNewAction);
                refreshRelatedModal();
                draftModal?.show();
            }

            async function beginCreateFromShortage() {
                if (!$(form).valid())
                    return;

                const lines = getSelectedLines();
                if (lines.length === 0) return;
                if (!validateDirectShipLines(lines)) return;

                const vendorIds = [...new Set(lines.map(line => line.vendorId).filter(Boolean))];
                const productIds = [...new Set(lines.map(line => line.productId).filter(Boolean))];

                createButtons.forEach(button => button.disabled = true);
                try {
                    const related = await postJson('/PurchaseOrder/CheckRelatedPurchaseOrders', { vendorIds, productIds });
                    const relatedItems = related.items || [];
                    if (relatedItems.length === 0) {
                        await createPurchaseOrders(buildPayloadForLines(lines), lines);
                        return;
                    }

                    renderRelatedModal(lines, relatedItems);
                } catch {
                    alert('Không thể kiểm tra đơn nhập liên quan.');
                } finally {
                    createButtons.forEach(button => button.disabled = false);
                    refreshTotals();
                }
            }

            function buildPayloadFromModal() {
                const actionsByOrderItem = new Map();

                modalContext.displayLines.forEach((displayLine, index) => {
                    const card = draftList.querySelector(`.related-line-card[data-line-index="${index}"]`);
                    const totalActions = card ? getLineActionState(card).actions : [];
                    const remainingActions = totalActions.map(action => ({ ...action, remaining: action.quantity }));

                    displayLine.underlying.forEach(underlying => {
                        let needed = underlying.quantity;
                        const lineActions = [];

                        remainingActions.forEach(action => {
                            if (action.remaining <= 0 || needed <= 0) return;
                            const take = Math.min(action.remaining, needed);
                            lineActions.push({
                                actionType: action.actionType,
                                purchaseOrderId: action.purchaseOrderId,
                                purchaseOrderItemId: action.purchaseOrderItemId,
                                quantity: take,
                                unitCost: action.unitCost
                            });
                            action.remaining -= take;
                            needed -= take;
                        });

                        actionsByOrderItem.set(underlying.orderItemId, lineActions);
                    });
                });

                return buildPayloadForLines(modalContext.originalLines, (line) => {
                    const actions = actionsByOrderItem.get(line.orderItemId);
                    if (actions && actions.length > 0) return actions;
                    return [{
                        actionType: 'CreateNew',
                        quantity: line.quantity,
                        unitCost: line.unitCost
                    }];
                });
            }

            async function confirmRelatedActions() {
                refreshRelatedModal();
                if (confirmButton?.disabled) return;

                const payload = buildPayloadFromModal();
                if (payload.groups.some(group => group.items.some(item => item.actions.length === 0))) {
                    alert('Mỗi mặt hàng cần có ít nhất một lựa chọn xử lý.');
                    return;
                }

                draftModal?.hide();
                await createPurchaseOrders(payload, modalContext.originalLines);
            }

            groups.forEach(wireGroup);

            document.querySelectorAll('.item-vendor').forEach(select => {
                select.addEventListener('change', () => handleItemVendorChange(select));
            });

            createButtons.forEach(button => button.addEventListener('click', beginCreateFromShortage));
            vendorFilter?.addEventListener('change', applyFilters);
            productFilter?.addEventListener('change', applyFilters);
            draftList?.addEventListener('change', event => {
                const card = event.target.closest?.('.related-line-card');
                if (!card) return;
                if (!event.target.classList?.contains('shortage-new-action-qty')) balanceNewAction(card);
                refreshRelatedModal();
            });
            draftList?.addEventListener('input', event => {
                const card = event.target.closest?.('.related-line-card');
                if (!card) return;
                if (!event.target.classList?.contains('shortage-new-action-qty')) balanceNewAction(card);
                refreshRelatedModal();
            });

            confirmButton?.addEventListener('click', confirmRelatedActions);

            document.querySelectorAll('.quantity-to-order, .unit-cost').forEach(input => {
                input.addEventListener('input', refreshTotals);
            });

            applyFilters();
            refreshTotals();

            // Check for saved modal HTML
            const savedHtml = sessionStorage.getItem('shortageCreatedHtml');
            if (savedHtml) {
                sessionStorage.removeItem('shortageCreatedHtml');
                const createdListEl = document.getElementById('createdPurchaseOrdersList');
                if (createdListEl) {
                    createdListEl.innerHTML = savedHtml;
                    const modalEl = document.getElementById('createdPurchaseOrdersModal');
                    const modal = new bootstrap.Modal(modalEl);
                    modal.show();
                }
            }

            $(form).removeData('validator').removeData('unobtrusiveValidation');
            $.validator.unobtrusive.parse(form);
        })();
    </script>
}
