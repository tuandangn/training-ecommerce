@model EditCategoryModel
@{
    ViewData[ViewConstants.PageTitle] = "Chỉnh sửa Danh mục";
}
@section TitleSection {
    <h1 class="topbar-page-title">
        Danh mục
        <span class="text-muted">@Model.Name</span>
    </h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="List" asp-controller="Category" class="text-decoration-none">Danh mục</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
            </ol>
        </nav>
    </div>
}
<div asp-validation-summary="ModelOnly" class="alert alert-warning alert-global alert-dismissible long-time-waiting"></div>
<div class="content-card">
    <form method="post" asp-antiforgery="true">
        <div class="content-card-body">
            <input type="hidden" asp-for="Id" />
            <ul class="nav nav-tabs" id="categoryTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="infoTab" data-bs-toggle="tab" data-bs-target="#info"
                            type="button" role="tab" aria-selected="true">
                        <i class="bi bi-info-circle me-1"></i>Thông tin
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="additionalTab" data-bs-toggle="tab" data-bs-target="#additional"
                            type="button" role="tab" aria-selected="false">
                        <i class="bi bi-sliders me-1"></i>Cài đặt
                    </button>
                </li>
            </ul>
            <div class="tab-content pt-3" id="categoryContent">
                <div class="tab-pane fade show active" id="info" role="tabpanel">
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" placeholder="@Html.DisplayNameFor(m => m.Name)" autofocus />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="ParentId" class="form-label"></label>
                            <select asp-for="ParentId" class="form-select">
                                <option selected="@(!Model.ParentId.HasValue)" value="@string.Empty">(Không có danh mục cha)</option>
                                @if (Model.AvailableParents is not null)
                                {
                                    foreach (var parent in Model.AvailableParents)
                                    {
                                        <option value="@parent.Id" selected="@(parent.Id == Model.ParentId)">@parent.Name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="ParentId" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="additional" role="tabpanel">
                    <div class="row g-3">
                        <div class="col-sm-6 col-md-4">
                            <label asp-for="DisplayOrder" class="form-label"></label>
                            <input asp-for="DisplayOrder" class="form-control" placeholder="0" inputmode="numeric"/>
                            <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="content-card-footer d-flex align-items-center justify-content-between">
            <a asp-action="List" class="btn btn-outline-secondary text-decoration-none btn-sm">
                <i class="bi bi-arrow-left"></i>
                Trở về
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-floppy me-1"></i>Lưu thay đổi
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}