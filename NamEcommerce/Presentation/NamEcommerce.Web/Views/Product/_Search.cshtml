@model ProductSearchModel
<form method="get" class="d-flex flex-wrap align-items-center gap-2">
    <input type="hidden" asp-for="Cid" />
    <div class="search-input-group flex-grow-1">
        <div class="input-group">
            <span class="input-group-text bg-white border-end-0">
                <i class="bi bi-search text-muted"></i>
            </span>
            <input asp-for="Q" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm sản phẩm..." />
            @if (!string.IsNullOrEmpty(Model.Q))
            {
                <a asp-action="List" asp-route-cid="@Model.Cid" class="btn btn-outline-secondary px-3" title="Bỏ lọc">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </div>
    </div>
</form>
