@model CreateProductModel
@{
    ViewData[ViewConstants.PageTitle] = "Thêm Hàng hóa";
}

@section TitleSection {
    <h1 class="topbar-page-title">
        Thêm mới
        <span class="text-muted">Hàng hóa</span>
    </h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="List" asp-controller="Product" class="text-decoration-none">Hàng hóa</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
            </ol>
        </nav>
    </div>
}

<div>
    <div asp-validation-summary="ModelOnly" class="alert alert-warning alert-global alert-dismissible long-time-waiting"></div>
    <div class="content-card">
        <form method="post" asp-antiforgery="true">
            <div class="content-card-body">
                <ul class="nav nav-tabs" id="productTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="infoTab" data-bs-toggle="tab" data-bs-target="#info"
                                type="button" role="tab" aria-selected="true">
                            <i class="bi bi-info-circle me-1"></i>Thông tin
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="additionalTab" data-bs-toggle="tab" data-bs-target="#additional"
                                type="button" role="tab" aria-selected="false">
                            <i class="bi bi-sliders me-1"></i>Cài đặt
                        </button>
                    </li>
                </ul>
                <div class="tab-content px-3 pt-4" id="productContent">
                    <div class="tab-pane fade show active" id="info" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-12 col-lg-4 order-0 order-lg-2">
                                @await Html.PartialAsync("_ImageUploader", new NamEcommerce.Web.Models.Common.ImageUploaderModel
                                {
                                    FieldName = "PictureId",
                                    Label = "Hình ảnh",
                                    MaxFiles = 1,
                                    Required = false,
                                    ExistingPictureIds = Model.PictureId.HasValue ? [Model.PictureId.Value] : []
                                })
                            </div>
                            <div class="col-12 col-lg-8 order-1">
                                <div class="row g-3">
                                    <div class="col-12 col-md-8">
                                        <label asp-for="Name" class="form-label"></label>
                                        <input asp-for="Name" class="form-control" placeholder="@Html.DisplayNameFor(m => m.Name)" autofocus autocomplete="off" />
                                        <span asp-validation-for="Name" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label asp-for="UnitMeasurementId" class="form-label"></label>
                                        <select asp-for="UnitMeasurementId" class="form-select">
                                            <option selected="@(!Model.UnitMeasurementId.HasValue)" value="@string.Empty">(Không chọn)</option>
                                            @if (Model.AvailableUnitMeasurements is not null)
                                            {
                                                foreach (var unitMeasurement in Model.AvailableUnitMeasurements)
                                                {
                                                    var dp = Model.UnitMeasurementDecimalPlacesMap.TryGetValue(unitMeasurement.Id.ToString(), out var v) ? v : 0;
                                                    <option value="@unitMeasurement.Id" selected="@(unitMeasurement.Id == Model.UnitMeasurementId)" data-decimalplaces="@dp">
                                                        @unitMeasurement.Name
                                                    </option>
                                                }
                                            }
                                        </select>
                                        <span asp-validation-for="UnitMeasurementId" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label asp-for="UnitPrice" class="form-label"></label>
                                        <input name="UnitPrice" data-decimal="currency" class="form-control include-hint"
                                               placeholder="Nhập giá bán" />
                                        <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label asp-for="CategoryId" class="form-label"></label>
                                        <select asp-for="CategoryId" class="form-select">
                                            <option selected="@(!Model.CategoryId.HasValue)" value="@string.Empty">(Không chọn)</option>
                                            @if (Model.AvailableCategories is not null)
                                            {
                                                foreach (var category in Model.AvailableCategories)
                                                {
                                                    <option value="@category.Id" selected="@(category.Id == Model.CategoryId)">
                                                        @category.Name
                                                    </option>
                                                }
                                            }
                                        </select>
                                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-semibold">Nhà cung cấp</label>
                                        @if (Model.AvailableVendors is not null)
                                        {
                                            <div class="product-vendor-options">
                                                @foreach (var vendor in Model.AvailableVendors)
                                                {
                                                    var isChecked = Model.VendorIds.Contains(vendor.Id);
                                                    <label class="product-vendor-option" for="vendor_@vendor.Id">
                                                        <input class="form-check-input" type="checkbox"
                                                               name="VendorIds" value="@vendor.Id"
                                                               id="vendor_@vendor.Id"
                                                               checked="@isChecked" />
                                                        <span>@vendor.Name</span>
                                                    </label>
                                                }
                                            </div>
                                        }
                                        <span asp-validation-for="VendorIds" class="text-danger small"></span>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Tồn kho đầu kỳ</label>
                                        @if (Model.ProductInventory.ProductStocks is { Count: > 0 })
                                        {
                                            <div class="table-responsive">
                                                <table class="table data-table mb-0">
                                                    <thead>
                                                        <tr>
                                                            <th class="ps-3 ui-w-40p">Kho hàng</th>
                                                            <th class="text-end ui-w-25p">Số lượng ban đầu</th>
                                                            <th class="text-end pe-3 ui-w-35">Giá vốn đơn vị (đ) <span class="text-danger">*</span></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @for (var i = 0; i < Model.ProductInventory.ProductStocks.Count; i++)
                                                        {
                                                            var stock = Model.ProductInventory.ProductStocks[i];
                                                            <tr class="align-middle">
                                                                <td class="ps-3">
                                                                    <input type="hidden" name="ProductInventory.ProductStocks[@i].WarehouseId" value="@stock.WarehouseId" />
                                                                    <span class="fw-medium">@stock.WarehouseName</span>
                                                                    <span asp-validation-for="ProductInventory.ProductStocks[@i].WarehouseId" class="text-danger small"></span>
                                                                </td>
                                                                <td class="text-end ui-max-w-150">
                                                                    @{ var initDp = Model.UnitMeasurementId.HasValue && Model.UnitMeasurementDecimalPlacesMap.TryGetValue(Model.UnitMeasurementId.Value.ToString(), out var initDpVal) ? initDpVal : 0; }
                                                                    <input name="ProductInventory.ProductStocks[@i].Quantity"
                                                                           value="@stock.Quantity.DisplayQuantity()" data-decimal="quantity" data-decimals="@initDp"
                                                                           class="form-control form-control-sm text-end stock-qty-input"
                                                                           data-index="@i" placeholder="Nhập số lượng"
                                                                           data-val-range="Số lượng phải lớn hơn 0." data-val-range-min="0"
                                                                           data-val-number="Số lượng không đúng." data-val-required="Vui lòng nhập số lượng." />
                                                                    <span asp-validation-for="ProductInventory.ProductStocks[@i].Quantity" class="text-danger small"></span>
                                                                </td>
                                                                <td class="text-end pe-3 ui-max-w-180">
                                                                    <input name="ProductInventory.ProductStocks[@i].UnitCost"
                                                                           value="@(stock.UnitCost > 0 ? stock.UnitCost.DisplayCurrency() : "0")"
                                                                           data-decimal="currency"
                                                                           class="form-control form-control-sm text-end stock-cost-input"
                                                                           data-index="@i" placeholder="Nhập giá vốn"
                                                                           data-val="true" data-val-required="Vui lòng nhập giá vốn"
                                                                           data-val-range="Giá vốn phải lớn hơn 0" data-val-range-min="0"
                                                                           data-val-number="Giá vốn phải là số" />
                                                                    <span asp-validation-for="ProductInventory.ProductStocks[@i].UnitCost" class="text-danger small"></span>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                            <div class="alert alert-warning d-flex align-items-start gap-2 mb-3">
                                                <i class="bi bi-exclamation-triangle-fill fs-5 mt-1"></i>
                                                <div>
                                                    Nhập số lượng và <strong>giá vốn đơn vị</strong> tồn kho đầu kỳ cho từng kho.
                                                    Hệ thống sẽ tạo <strong>Phiếu nhập đầu kỳ</strong> và ghi nhận giá vốn ngay lập tức.
                                                    <span class="text-danger fw-medium">Không thể hoàn tác sau khi lưu.</span>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="alert alert-warning d-flex align-items-start gap-2 mb-3">
                                                <i class="bi bi-exclamation-triangle-fill fs-5 mt-1"></i>
                                                <div>
                                                    Nhập số lượng và <strong>giá vốn đơn vị</strong> tồn kho đầu kỳ cho từng kho.
                                                    Hệ thống sẽ tạo <strong>Phiếu nhập đầu kỳ</strong> và ghi nhận giá vốn ngay lập tức.
                                                    <span class="text-danger fw-medium">Không thể hoàn tác sau khi lưu.</span>
                                                </div>
                                            </div>
                                            <div class="text-muted small fst-italic">Chưa có kho hàng nào được cấu hình.</div>
                                        }
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="ShortDesc" class="form-label"></label>
                                        <textarea asp-for="ShortDesc" class="form-control" rows="3" placeholder="Mô tả ngắn về hàng hóa..."></textarea>
                                        <span asp-validation-for="ShortDesc" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="additional" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-sm-6 col-md-3">
                                <label asp-for="DisplayOrder" class="form-label"></label>
                                <input asp-for="DisplayOrder" class="form-control" placeholder="0" />
                                <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="content-card-footer d-flex align-items-center justify-content-between">
                <a asp-action="List" class="btn btn-outline-secondary text-decoration-none btn-sm">
                    <i class="bi bi-arrow-left"></i>
                    Trở về
                </a>
                <button type="submit" class="btn btn-primary" id="btnSubmitProduct">
                    <i class="bi bi-floppy me-1"></i>Thêm hàng hóa
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script defer>
        (function () {
            const form = document.querySelector('form');
            const submitBtn = document.querySelector('button[type="submit"]');

            form.addEventListener('submit', function (e) {
                const rows = document.querySelectorAll('tbody tr');
                let hasStock = false;
                let costMissing = false;

                rows.forEach(function (row) {
                    const qtyInput = row.querySelector('.stock-qty-input');
                    const costInput = row.querySelector('.stock-cost-input');
                    if (!qtyInput || !costInput) return;

                    const qty = parseFloat(DecimalFields.stripFormatting(qtyInput.value, 2)) || 0;
                    const cost = parseFloat(DecimalFields.stripFormatting(costInput.value)) || 0;

                    if (qty > 0) {
                        hasStock = true;
                        if (cost <= 0) costMissing = true;
                    }
                });

                if (costMissing) {
                    e.preventDefault();
                    e.stopPropagation();
                    alert('Vui lòng nhập giá vốn đơn vị cho tất cả kho có số lượng tồn kho đầu kỳ.');
                    return;
                }

                if (hasStock && !form.dataset.confirmed) {
                    e.preventDefault();

                    const tbody = document.getElementById('confirmStockBody');
                    tbody.innerHTML = '';
                    let totalValue = 0;

                    const fmtQty = n => DecimalFields.formatQuantity(n);
                    const fmtCurrency = n => DecimalFields.formatCurrency(n);

                    rows.forEach(function (row) {
                        const qtyInput = row.querySelector('.stock-qty-input');
                        const costInput = row.querySelector('.stock-cost-input');
                        const nameEl = row.querySelector('span.fw-medium');
                        if (!qtyInput || !costInput) return;

                        const qty = parseFloat(DecimalFields.stripFormatting(qtyInput.value, 2)) || 0;
                        const cost = parseFloat(DecimalFields.stripFormatting(costInput.value)) || 0;
                        if (qty <= 0) return;

                        const value = qty * cost;
                        totalValue += value;
                        tbody.insertAdjacentHTML('beforeend',
                            `<tr><td>${nameEl?.textContent?.trim() ?? ''}</td><td class="text-end">${fmtQty(qty)}</td><td class="text-end">${fmtCurrency(cost)}</td><td class="text-end fw-medium">${fmtCurrency(value)}</td></tr>`);
                    });

                    document.getElementById('confirmTotalValue').textContent = fmtCurrency(totalValue);
                    new bootstrap.Modal(document.getElementById('confirmOpeningModal')).show();
                }
            });

            document.getElementById('btnConfirmOpening')?.addEventListener('click', function () {
                form.dataset.confirmed = '1';
                bootstrap.Modal.getInstance(document.getElementById('confirmOpeningModal'))?.hide();
                submitBtn.click();
            });

            // Update data-decimals on stock qty inputs when UnitMeasurement changes
            const unitMeasurementSelect = document.getElementById('UnitMeasurementId');
            if (unitMeasurementSelect) {
                unitMeasurementSelect.addEventListener('change', function () {
                    const selectedOption = this.options[this.selectedIndex];
                    const dp = parseInt(selectedOption.dataset.decimalplaces ?? '0', 10);
                    document.querySelectorAll('.stock-qty-input').forEach(input => {
                        input.dataset.decimals = String(dp);
                        input.dataset.decimalBound = '';
                        window.DecimalFields?.bindInput?.(input);
                    });
                });
            }
        })();
    </script>
}

<!-- Modal xác nhận tồn kho đầu kỳ -->
<div class="modal fade" id="confirmOpeningModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content ui-modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Xác nhận tồn kho đầu kỳ</h5>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-3">Sau khi xác nhận, hệ thống sẽ tạo phiếu nhập đầu kỳ và ghi nhận giá vốn. <strong class="text-danger">Thao tác này không thể hoàn tác.</strong></p>
                <div class="table-responsive mb-2">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Kho hàng</th>
                                <th class="text-end">Số lượng</th>
                                <th class="text-end">Giá vốn/đv</th>
                                <th class="text-end">Giá trị</th>
                            </tr>
                        </thead>
                        <tbody id="confirmStockBody"></tbody>
                    </table>
                </div>
                <div class="text-end fw-bold">Tổng giá trị: <span id="confirmTotalValue" class="text-primary"></span></div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Quay lại kiểm tra</button>
                <button type="button" class="btn btn-danger px-4" id="btnConfirmOpening">
                    <i class="bi bi-check-lg me-1"></i>Tôi hiểu, xác nhận
                </button>
            </div>
        </div>
    </div>
</div>
