@model CreateProductModel
@{
    ViewData[ViewConstants.PageTitle] = "Thêm mới Hàng hóa";
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">Thêm mới Hàng hóa</h1>
        <p class="page-header-subtitle">Thêm sản phẩm mới vào danh mục hàng hóa</p>
    </div>
</div>

<div class="form-card" style="max-width: 1100px;">
    <div class="form-card-header">
        <h2 class="form-card-title"><i class="bi bi-tags me-2" style="color: var(--warning);"></i>Thông tin hàng hóa</h2>
        <a asp-action="List" class="form-card-breadcrumb">
            <i class="bi bi-arrow-left"></i> Trở về danh sách
        </a>
    </div>
    <form method="post" asp-antiforgery="true">
        <div class="form-card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-warning alert-global"></div>
            <ul class="nav nav-tabs" id="productTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="infoTab" data-bs-toggle="tab" data-bs-target="#info"
                            type="button" role="tab" aria-selected="true">
                        <i class="bi bi-info-circle me-1"></i>Thông tin
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="inventoryTab" data-bs-toggle="tab" data-bs-target="#inventory"
                            type="button" role="tab" aria-selected="false">
                        <i class="bi bi-truck me-1"></i>Tồn kho
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="additionalTab" data-bs-toggle="tab" data-bs-target="#additional"
                            type="button" role="tab" aria-selected="false">
                        <i class="bi bi-sliders me-1"></i>Cài đặt
                    </button>
                </li>
            </ul>
            <div class="tab-content px-3 pt-4" id="productContent">
                <div class="tab-pane fade show active" id="info" role="tabpanel">
                    <div class="row g-3">
                        <div class="col-12 col-lg-4 order-0 order-lg-2">
                            <partial name="_UploadPicture" for="ImageFile" />
                        </div>
                        <div class="col-12 col-lg-8 order-1">
                            <div class="row g-3">
                                <div class="col-12 col-md-8">
                                    <label asp-for="Name" class="form-label"></label>
                                    <input asp-for="Name" class="form-control" placeholder="@Html.DisplayNameFor(m => m.Name)" autofocus autocomplete="off" />
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                </div>
                                <div class="col-12 col-md-4">
                                    <label asp-for="UnitMeasurementId" class="form-label"></label>
                                    <select asp-for="UnitMeasurementId" class="form-select">
                                        <option selected="@(!Model.UnitMeasurementId.HasValue)" value="@string.Empty">(Không chọn)</option>
                                        @if (Model.AvailableUnitMeasurements is not null)
                                        {
                                            foreach (var unitMeasurement in Model.AvailableUnitMeasurements)
                                            {
                                                <option value="@unitMeasurement.Id" selected="@(unitMeasurement.Id == Model.UnitMeasurementId)">
                                                    @unitMeasurement.Name
                                                </option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="UnitMeasurementId" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="CategoryId" class="form-label"></label>
                                    <select asp-for="CategoryId" class="form-select">
                                        <option selected="@(!Model.CategoryId.HasValue)" value="@string.Empty">(Không chọn)</option>
                                        @if (Model.AvailableCategories is not null)
                                        {
                                            foreach (var category in Model.AvailableCategories)
                                            {
                                                <option value="@category.Id" selected="@(category.Id == Model.CategoryId)">
                                                    @category.Name
                                                </option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Nhà cung cấp</label>
                                    @if (Model.AvailableVendors is not null)
                                    {
                                        <div class="product-vendor-options">
                                            @foreach (var vendor in Model.AvailableVendors)
                                            {
                                                var isChecked = Model.VendorIds.Contains(vendor.Id);
                                                <label class="product-vendor-option" for="vendor_@vendor.Id">
                                                    <input class="form-check-input" type="checkbox"
                                                           name="VendorIds" value="@vendor.Id"
                                                           id="vendor_@vendor.Id"
                                                           checked="@isChecked" />
                                                    <span>@vendor.Name</span>
                                                </label>
                                            }
                                        </div>
                                    }
                                    <span asp-validation-for="VendorIds" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="ShortDesc" class="form-label"></label>
                                    <textarea asp-for="ShortDesc" class="form-control" rows="3" placeholder="Mô tả ngắn về hàng hóa..."></textarea>
                                    <span asp-validation-for="ShortDesc" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="inventory" role="tabpanel">
                    <div class="alert alert-info d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-info-circle-fill fs-5"></i>
                        <span>Nhập số lượng ban đầu cho từng kho (tùy chọn). Hệ thống sẽ tự tạo <strong>Phiếu kiểm kê (PKK)</strong> và duyệt ngay.</span>
                    </div>
                    @if (Model.ProductInventory?.ProductStocks is { Count: > 0 })
                    {
                        <div class="table-responsive">
                            <table class="table data-table mb-0">
                                <thead>
                                    <tr>
                                        <th class="ps-3" style="width:60%">Kho hàng</th>
                                        <th class="text-end" style="width:40%">Số lượng ban đầu</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < Model.ProductInventory.ProductStocks.Count; i++)
                                    {
                                        var stock = Model.ProductInventory.ProductStocks[i];
                                        <tr class="align-middle">
                                            <td class="ps-3">
                                                <input type="hidden" name="ProductInventory.ProductStocks[@i].WarehouseId"
                                                       value="@stock.WarehouseId" />
                                                <input type="hidden" name="ProductInventory.ProductStocks[@i].WarehouseName"
                                                       value="@stock.WarehouseName" />
                                                <span class="fw-medium">@stock.WarehouseName</span>
                                            </td>
                                            <td class="text-end pe-3" style="max-width:180px;">
                                                <input name="ProductInventory.ProductStocks[@i].Quantity"
                                                       value="@stock.Quantity" data-decimal="quantity"
                                                       class="form-control form-control-sm text-end"
                                                       placeholder="Nhập số lượng" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small fst-italic">Chưa có kho hàng nào được cấu hình.</div>
                    }
                </div>
                <div class="tab-pane fade" id="additional" role="tabpanel">
                    <div class="row g-3">
                        <div class="col-sm-6 col-md-3">
                            <label asp-for="DisplayOrder" class="form-label"></label>
                            <input asp-for="DisplayOrder" class="form-control" placeholder="0" />
                            <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="form-card-footer">
            <a asp-action="List" class="btn btn-outline-secondary">Hủy</a>
            <button type="submit" class="btn btn-primary flex-lg-grow-0 flex-grow-1">
                <i class="bi bi-plus-lg me-1"></i>
                Thêm mới
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
