@model NamEcommerce.Web.Models.Customers.CustomerListSearchModel

<form asp-action="List" method="get" class="d-flex flex-wrap align-items-center gap-2">
    <div class="search-input-group flex-grow-1 ui-min-w-200 ui-max-w-320">
        <div class="input-group">
            <span class="input-group-text bg-white border-end-0">
                <i class="bi bi-search text-muted"></i>
            </span>
            <input type="text" asp-for="Keywords" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm khách hàng..." inputmode="search"/>
            @if (!string.IsNullOrEmpty(Model.Keywords))
            {
                <a asp-action="List" class="btn btn-outline-secondary px-3" title="Bỏ lọc">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </div>
    </div>
</form>
<script>
    (function(){
        document.addEventListener('DOMContentLoaded', function(){
            const txtKeywords = document.getElementById('@Html.IdFor(m => m.Keywords)');
            const form = txtKeywords.closest('form');
            const onSearchChanged = debounce(function () {
                form.submit();
            }, 500);
            txtKeywords.addEventListener('input', onSearchChanged);

            if(txtKeywords.value){
                focusEnd(txtKeywords);
            }
        });
    })();
</script>
