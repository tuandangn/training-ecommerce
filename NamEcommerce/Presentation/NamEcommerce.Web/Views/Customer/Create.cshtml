@using NamEcommerce.Web.Models.Customers
@model CreateCustomerModel
@{
    ViewData[ViewConstants.PageTitle] = "Thêm khách hàng";
}
@section TitleSection {
    <h1 class="topbar-page-title">
        Thêm mới
        <span class="text-muted">Khách hàng</span>
    </h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="List" asp-controller="Customer" class="text-decoration-none">Khách hàng</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
            </ol>
        </nav>
    </div>
}
<div class="content-card">
    <form method="post">
        <div class="content-card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-warning alert-global mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person text-muted"></i></span>
                        <input asp-for="FullName" class="form-control" placeholder="Nhập họ tên đầy đủ" autofocus />
                    </div>
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="Nhập số điện thoại" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" placeholder="Địa chỉ thường trú" />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="InitialDebt" class="form-label"></label>
                    <input asp-for="InitialDebt" class="form-control text-start" placeholder="Nhập số công nợ cũ" data-decimal="currency"/>
                    <span asp-validation-for="InitialDebt" class="text-danger small"></span>
                    <div class="form-text text-muted">Nhập số công nợ ban đầu của khách hàng.</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="Địa chỉ email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Note" class="form-label"></label>
                    <textarea asp-for="Note" class="form-control" rows="3" placeholder="Nhập ghi chú"></textarea>
                    <span asp-validation-for="Note" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="content-card-footer d-flex align-items-center justify-content-between">
            <a asp-action="List" class="btn btn-outline-secondary text-decoration-none text-muted btn-sm">
                <i class="bi bi-arrow-left"></i>
                Trở về
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Thêm mới
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
