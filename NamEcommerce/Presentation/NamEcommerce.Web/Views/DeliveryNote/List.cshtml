@model DeliveryNoteListModel
@using System.Text.Json
@using NamEcommerce.Domain.Shared.Enums.DeliveryNotes
@using NamEcommerce.Web.Constants
@{
    ViewData["Title"] = "Phiếu xuất kho";
    var query = Model.Keywords ?? "";
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">Phiếu xuất kho</h1>
        <p class="page-header-subtitle">Quản lý phiếu xuất kho và giao hàng</p>
    </div>
</div>

<div class="content-card" data-responsive-list data-list-key="delivery-note-list">
    <div class="action-toolbar">
        <div class="search-group">
            <partial name="_Search" model="query" />
        </div>
        <partial name="_ResponsiveListToolbar" />
    </div>

    <div class="responsive-list-panel" data-list-view-panel="list">
        <div class="table-responsive">
            <table class="table data-table">
                <thead>
                    <tr>
                        <th class="ps-4">Mã PXK</th>
                        <th class="text-center">Đơn hàng</th>
                        <th>
                            <i class="bi bi-person me-1"></i>
                            Khách hàng
                        </th>
                        <th class="d-none d-lg-table-cell">
                            <i class="bi bi-geo-alt me-1"></i>
                            Địa chỉ giao
                        </th>
                        <th class="text-center" style="width: 140px;">
                            Trạng thái
                        </th>
                        <th class="d-none d-md-table-cell">
                            <i class="bi bi-calendar me-1"></i>
                            Ngày tạo
                        </th>
                        <th style="width: 100px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Data.Items.Any())
                    {
                        foreach (var deliveryNote in Model.Data.Items)
                        {
                            var statusTuple = deliveryNote.Status switch
                            {
                                10 => ("bg-secondary text-light", "Bản nháp", "bi-pencil"),
                                20 => ("bg-info text-light", "Đã xác nhận", "bi-check-all"),
                                30 => ("bg-warning text-dark", "Đang giao", "bi-truck"),
                                40 => ("bg-success text-light", "Đã giao", "bi-check-circle-fill"),
                                50 => ("bg-danger text-light", "Đã hủy", "bi-x-circle"),
                                _ => ("bg-secondary text-light", "Không rõ", "bi-question-circle")
                            };

                            <tr>
                                <td class="ps-4">
                                    <a asp-action="Details" asp-route-id="@deliveryNote.Id" class="text-decoration-none fw-bold">
                                        @HighlighHelper.Highlight(deliveryNote.Code, query)
                                    </a>
                                </td>
                                <td class="text-center fw-medium">
                                    <a asp-action="Details" asp-controller="Order" asp-route-id="@deliveryNote.OrderId" class="text-decoration-none">
                                        @deliveryNote.OrderCode
                                    </a>
                                </td>
                                <td>
                                    <div class="fw-bold">
                                        @HighlighHelper.Highlight(deliveryNote.CustomerName ?? "", query)
                                    </div>
                                    @if (!string.IsNullOrEmpty(deliveryNote.CustomerPhone))
                                    {
                                        <a href="tel:@deliveryNote.CustomerPhone" class="small text-muted text-decoration-none">
                                            @HighlighHelper.Highlight(deliveryNote.CustomerPhone ?? "", query)
                                        </a>
                                    }
                                    <div class="d-md-none mt-1">
                                        <small class="text-muted d-block">
                                            <i class="bi bi-calendar me-1"></i>@deliveryNote.CreatedOnUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    </div>
                                </td>
                                <td class="d-none d-lg-table-cell">
                                    <span class="d-inline-block text-truncate" style="max-width: 250px;" title="@deliveryNote.ShippingAddress">
                                        @deliveryNote.ShippingAddress
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="status-badge @statusTuple.Item1 w-100">
                                        <i class="bi @statusTuple.Item3 me-1"></i>@deliveryNote.StatusName
                                    </span>
                                    @if (deliveryNote.Status == 40 && deliveryNote.DeliveredOnUtc.HasValue)
                                    {
                                        <div class="small text-muted mt-1 fst-italic">@deliveryNote.DeliveredOnUtc.Value.ToLocalTime().ToString("dd/MM HH:mm")</div>
                                    }
                                </td>
                                <td class="d-none d-md-table-cell text-muted">@deliveryNote.CreatedOnUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <div class="dropdown position-static text-end pe-3">
                                        <button class="btn btn-sm btn-outline-secondary" type="button" id="dropdownMenuButton-@deliveryNote.Id" data-bs-toggle="dropdown" aria-expanded="false" data-bs-boundary="window">
                                            <i class="bi bi-three-dots"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="dropdownMenuButton-@deliveryNote.Id">
                                            <li>
                                                <a class="dropdown-item py-2" asp-action="Details" asp-route-id="@deliveryNote.Id">
                                                    <i class="bi bi-info-circle me-1 text-primary"></i>Chi tiết
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item py-2" asp-action="Print" asp-route-id="@deliveryNote.Id" target="_blank">
                                                    <i class="bi bi-printer me-1 text-secondary"></i>In phiếu
                                                </a>
                                            </li>
                                            @if (!deliveryNote.IsDirectShip && deliveryNote.Status == (int)DeliveryNoteStatus.Draft)
                                            {
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <a class="dropdown-item py-2 text-primary btn-confirm fw-medium" href="#" data-id="@deliveryNote.Id">
                                                        <i class="bi bi-check-all me-1"></i>Xuất hàng
                                                    </a>
                                                </li>
                                            }
                                            @if (!deliveryNote.IsDirectShip && deliveryNote.Status == (int)DeliveryNoteStatus.Confirmed)
                                            {
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <a class="dropdown-item py-2 text-secondary btn-delivering fw-medium" href="#" data-id="@deliveryNote.Id">
                                                        <i class="bi bi-truck me-1"></i>Đang giao
                                                    </a>
                                                </li>
                                            }
                                            @if (deliveryNote.Status == (int)DeliveryNoteStatus.Confirmed || deliveryNote.Status == (int)DeliveryNoteStatus.Delivering)
                                            {
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <a class="dropdown-item py-2 text-success btn-delivered fw-medium" href="#" data-id="@deliveryNote.Id">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Đã giao
                                                    </a>
                                                </li>
                                            }
                                            @if (deliveryNote.Status != (int)DeliveryNoteStatus.Delivered && deliveryNote.Status != (int)DeliveryNoteStatus.Cancelled)
                                            {
                                                if (deliveryNote.IsDirectShip)
                                                {
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <a class="dropdown-item py-2 text-danger btn-customer-reject fw-medium" href="#" data-id="@deliveryNote.Id">
                                                            <i class="bi bi-person-fill-x me-1"></i>Hủy phiếu
                                                        </a>
                                                    </li>
                                                }
                                                else
                                                {
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <a class="dropdown-item py-2 text-danger btn-cancel fw-medium" href="#" data-id="@deliveryNote.Id">
                                                            <i class="bi bi-x-circle me-1"></i>Hủy phiếu
                                                        </a>
                                                    </li>
                                                }
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <div class="empty-icon"><i class="bi bi-inbox"></i></div>
                                    <h5>Không tìm thấy phiếu xuất kho nào</h5>
                                    <p>Thử thay đổi từ khóa tìm kiếm hoặc tạo phiếu mới từ đơn hàng.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="responsive-list-panel responsive-list-grid" data-list-view-panel="grid" hidden>
        @if (Model.Data.Items.Any())
        {
            foreach (var deliveryNote in Model.Data.Items)
            {
                var statusTuple = deliveryNote.Status switch
                {
                    10 => ("bg-secondary text-light", "Bản nháp", "bi-pencil"),
                    20 => ("bg-info text-light", "Đã xác nhận", "bi-check-all"),
                    30 => ("bg-warning text-dark", "Đang giao", "bi-truck"),
                    40 => ("bg-success text-light", "Đã giao", "bi-check-circle-fill"),
                    50 => ("bg-danger text-light", "Đã hủy", "bi-x-circle"),
                    _ => ("bg-secondary text-light", "Không rõ", "bi-question-circle")
                };

                <article class="list-card">
                    <div class="list-card-header">
                        <div class="list-card-title-group">
                            <a asp-action="Details" asp-route-id="@deliveryNote.Id" class="list-card-title">
                                @HighlighHelper.Highlight(deliveryNote.Code, query)
                            </a>
                            <a asp-action="Details" asp-controller="Order" asp-route-id="@deliveryNote.OrderId" class="list-card-meta text-decoration-none">
                                Đơn @deliveryNote.OrderCode
                            </a>
                        </div>
                        <span class="status-badge @statusTuple.Item1">
                            <i class="bi @statusTuple.Item3 me-1"></i>@deliveryNote.StatusName
                        </span>
                    </div>
                    <div class="list-card-fields">
                        <div class="list-card-field list-card-field-stack">
                            <span class="list-card-label">Khách hàng</span>
                            <span class="fw-medium text-dark">@HighlighHelper.Highlight(deliveryNote.CustomerName ?? "", query)</span>
                            @if (!string.IsNullOrEmpty(deliveryNote.CustomerPhone))
                            {
                                <a href="tel:@deliveryNote.CustomerPhone" class="small text-muted text-decoration-none">
                                    @HighlighHelper.Highlight(deliveryNote.CustomerPhone ?? "", query)
                                </a>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(deliveryNote.ShippingAddress))
                        {
                            <div class="list-card-field list-card-field-stack">
                                <span class="list-card-label">Địa chỉ giao</span>
                                <span class="text-muted small">@deliveryNote.ShippingAddress</span>
                            </div>
                        }
                        <div class="list-card-field">
                            <span class="list-card-label">Ngày tạo</span>
                            <span class="list-card-value fw-normal text-muted">@deliveryNote.CreatedOnUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        @if (deliveryNote.Status == 40 && deliveryNote.DeliveredOnUtc.HasValue)
                        {
                            <div class="list-card-field">
                                <span class="list-card-label">Đã giao</span>
                                <span class="list-card-value fw-normal text-muted">@deliveryNote.DeliveredOnUtc.Value.ToLocalTime().ToString("dd/MM HH:mm")</span>
                            </div>
                        }
                    </div>
                    <div class="list-card-actions justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <a class="btn btn-sm btn-light" asp-action="Details" asp-route-id="@deliveryNote.Id">
                                <i class="bi bi-info-circle me-1 text-primary"></i>
                                <span class="visually-hidden">Chi tiết</span>
                            </a>
                            <a class="btn btn-sm btn-light" asp-action="Print" asp-route-id="@deliveryNote.Id" target="_blank">
                                <i class="bi bi-printer me-1 text-secondary"></i>
                                <span class="visually-hidden">In phiếu</span>
                            </a>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            @if (!deliveryNote.IsDirectShip && deliveryNote.Status == (int)DeliveryNoteStatus.Draft)
                            {
                                <a class="btn btn-sm btn-primary btn-confirm fw-medium" href="#" data-id="@deliveryNote.Id">
                                    <i class="bi bi-check-all me-1"></i>Xuất hàng
                                </a>
                            }
                            @if (!deliveryNote.IsDirectShip && deliveryNote.Status == (int)DeliveryNoteStatus.Confirmed)
                            {
                                <a class="btn btn-sm btn-secondary btn-delivering fw-medium" href="#" data-id="@deliveryNote.Id">
                                    <i class="bi bi-truck me-1"></i>Đang giao
                                </a>
                            }
                            @if (deliveryNote.Status == (int)DeliveryNoteStatus.Confirmed || deliveryNote.Status == (int)DeliveryNoteStatus.Delivering)
                            {
                                <a class="btn btn-sm btn-success btn-delivered fw-medium" href="#" data-id="@deliveryNote.Id">
                                    <i class="bi bi-check-circle-fill me-1"></i>Đã giao
                                </a>
                            }
                            @if (deliveryNote.Status != (int)DeliveryNoteStatus.Delivered && deliveryNote.Status != (int)DeliveryNoteStatus.Cancelled)
                            {
                                if (deliveryNote.IsDirectShip)
                                {
                                    <a class="btn btn-sm btn-danger btn-customer-reject fw-medium" href="#" data-id="@deliveryNote.Id" data-code="@deliveryNote.Code">
                                        <i class="bi bi-person-fill-x me-1"></i>Từ chối
                                    </a>
                                }
                                else
                                {
                                    <a class="btn btn-sm btn-danger btn-cancel fw-medium" href="#" data-id="@deliveryNote.Id">
                                        <i class="bi bi-x-circle me-1"></i>Hủy phiếu
                                    </a>
                                }
                            }
                        </div>
                    </div>
                </article>
            }
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="bi bi-inbox"></i></div>
                <h5>Không tìm thấy phiếu xuất kho nào</h5>
                <p>Thử thay đổi từ khóa tìm kiếm hoặc tạo phiếu mới từ đơn hàng.</p>
            </div>
        }
    </div>

    @if (Model.Data.Pagination.TotalPages > 1)
    {
        <div class="card-footer bg-white border-top-0 d-flex justify-content-end p-3">
            <nav aria-label="Page navigation">
                <ul class="pagination mb-0">
                    <li class="page-item @(Model.Data.Pagination.PageNumber == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="List" asp-route-pageNumber="@(Model.Data.Pagination.PageNumber - 1)" asp-route-keywords="@Model.Keywords">Trước</a>
                    </li>
                    @for (int i = 1; i <= Model.Data.Pagination.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Data.Pagination.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="List" asp-route-pageNumber="@i" asp-route-keywords="@Model.Keywords">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.Data.Pagination.PageNumber == Model.Data.Pagination.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="List" asp-route-pageNumber="@(Model.Data.Pagination.PageNumber + 1)" asp-route-keywords="@Model.Keywords">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

@if (Model.Data.Any(note => note.Status == (int)DeliveryNoteStatus.Confirmed || note.Status == (int)DeliveryNoteStatus.Delivering))
{
    <partial name="_DeliveryNote.ConfirmDelivered" />
    <partial name="_DeliveryNote.ConfirmReject" model="@Model.AvailableWarehouses" />

}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module">
        import DeliverNoteController from '/modules/DeliveryNoteController.js';

        $(document).ready(function () {
            const deliveryNoteController = new DeliverNoteController({ hidePageLoadOnRequestEnd: false });

            // Confirm
            $('.btn-confirm').click(async function(e) {
                e.preventDefault();
                var id = $(this).data('id');
                var result = await deliveryNoteController.confirm(id);
                if (result?.success)
                    location.reload();
            });

            // Mark Delivering
            $('.btn-delivering').click(async function(e) {
                e.preventDefault();
                var id = $(this).data('id');
                var result = await deliveryNoteController.delivering(id);
                if (result?.success)
                    location.reload();
            });

            // Cancel
            $('.btn-cancel').click(async function(e) {
                e.preventDefault();
                var id = $(this).data('id');
                var result = await deliveryNoteController.cancel(id);
                if (result?.success)
                    location.reload();
            });

            $('.btn-customer-reject').click(function(e) {
                e.preventDefault();
                const {id, code, warehouse } = $(this).data();
                deliveryNoteController.beginRejectWorkflow('rejectDeliveryNoteModal').setData(id, code, warehouse);
            });

            $('.btn-delivered').click(function(e) {
                e.preventDefault();
                var id = String($(this).data('id'));
                deliveryNoteController.beginDeliveredWorkflow('markDeliveredModal').setId(id);
            });
        });
    </script>
}
