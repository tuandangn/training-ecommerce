@model DeliveryNoteListModel
@using NamEcommerce.Domain.Shared.Enums.DeliveryNotes
@{
    ViewData[ViewConstants.PageTitle] = "Phiếu xuất kho";
    var query = Model.Keywords ?? "";
}
@section TitleSection {
    <h1 class="topbar-page-title">Phiếu xuất kho</h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Phiếu xuất kho</li>
            </ol>
        </nav>
    </div>
}

<div class="content-card" data-responsive-list data-list-key="delivery-note-list">
    <div class="action-toolbar">
        <partial name="_Search" model="@(new DeliveryNoteListSearchModel { Keywords = Model.Keywords })" />
        <partial name="_ResponsiveListToolbar" />
    </div>

    <div class="responsive-list-panel" data-list-view-panel="list">
        <div class="table-responsive">
            <table class="table data-table">
                <thead>
                    <tr>
                        <th class="ps-4">Mã phiếu</th>
                        <th class="text-center">Đơn hàng</th>
                        <th>
                            Khách hàng
                        </th>
                        <th class="d-none d-lg-table-cell">
                            Địa chỉ giao
                        </th>
                        <th class="d-none d-xl-table-cell">
                            Kho xuất
                        </th>
                        <th class="text-center ui-w-140">
                            Trạng thái
                        </th>
                        <th class="ui-w-100"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Data.Items.Any())
                    {
                        foreach (var deliveryNote in Model.Data.Items)
                        {
                            var status = (DeliveryNoteStatus)deliveryNote.Status;
                            var canLeaveWarehouse = deliveryNote.IsDirectShip || deliveryNote.IsCounterPickup || deliveryNote.AssignedDeliveryUserId.HasValue;
                            var canOpenDeliveredWorkflow = deliveryNote.Status == (int)DeliveryNoteStatus.PendingConfirmation
                                || deliveryNote.Status == (int)DeliveryNoteStatus.Delivering
                                || canLeaveWarehouse;

                            <tr>
                                <td class="ps-4">
                                    <a asp-action="Details" asp-route-id="@deliveryNote.Id" class="text-decoration-none fw-bold d-block">
                                        @HighlighHelper.Highlight(deliveryNote.Code, query)
                                    </a>
                                    <span class="text-muted small">@deliveryNote.CreatedOn.ToString(ViewConstants.DefaultDateTimeFormat)</span>
                                </td>
                                <td class="text-center fw-medium">
                                    <a asp-action="Details" asp-controller="Order" asp-route-id="@deliveryNote.OrderId" class="text-decoration-none">
                                        @deliveryNote.OrderCode
                                    </a>
                                </td>
                                <td>
                                    <div class="fw-bold">
                                        @HighlighHelper.Highlight(deliveryNote.CustomerName ?? "", query)
                                    </div>
                                    @if (!string.IsNullOrEmpty(deliveryNote.ShippingPhoneNumber))
                                    {
                                        <a href="tel:@deliveryNote.ShippingPhoneNumber" class="small text-muted text-decoration-none">
                                            @HighlighHelper.Highlight(deliveryNote.ShippingPhoneNumber ?? "", query)
                                        </a>
                                    }
                                    <div class="d-md-none mt-1">
                                        <small class="text-muted d-block">
                                            <i class="bi bi-calendar me-1"></i>@deliveryNote.CreatedOn.ToString(ViewConstants.DefaultDateTimeFormat)
                                        </small>
                                    </div>
                                </td>
                                <td class="d-none d-lg-table-cell">
                                    <span class="d-inline-block text-truncate ui-max-w-250" title="@deliveryNote.ShippingAddress">
                                        @deliveryNote.ShippingAddress
                                    </span>
                                </td>
                                <td class="d-none d-xl-table-cell">
                                    <span class="d-inline-block text-truncate small text-muted ui-max-w-180" title="@deliveryNote.WarehouseName">
                                        @deliveryNote.WarehouseName
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(deliveryNote.AssignedDeliveryFullName))
                                    {
                                        <div class="small text-muted mt-1">
                                            <i class="bi bi-person-check me-1"></i>@deliveryNote.AssignedDeliveryFullName
                                        </div>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="status-badge @status.GetDisplayColor() w-100">
                                        <i class="bi @status.GetActionIcon() me-1"></i>
                                        @status.GetDisplayText()
                                    </span>
                                    @if (deliveryNote.Status == 40 && deliveryNote.DeliveredOn.HasValue)
                                    {
                                        <div class="small text-muted text-nowrap">@deliveryNote.DeliveredOn.Value.ToString(ViewConstants.DefaultDateTimeFormat)</div>
                                    }
                                </td>
                                <td>
                                    <div class="dropdown position-static text-end pe-3">
                                        <button class="btn btn-sm btn-outline-secondary" type="button" id="dropdownMenuButton-@deliveryNote.Id" data-bs-toggle="dropdown" aria-expanded="false" data-bs-boundary="window">
                                            <i class="bi bi-three-dots"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="dropdownMenuButton-@deliveryNote.Id">
                                            <li>
                                                <a class="dropdown-item py-2" asp-action="Details" asp-route-id="@deliveryNote.Id">
                                                    <i class="bi bi-info-circle me-1 text-primary"></i>Chi tiết
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item py-2" asp-action="Print" asp-route-id="@deliveryNote.Id" target="_blank">
                                                    <i class="bi bi-printer me-1 text-secondary"></i>In phiếu
                                                </a>
                                            </li>
                                            @if (!deliveryNote.IsDirectShip && deliveryNote.Status == (int)DeliveryNoteStatus.Draft)
                                            {
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <a class="dropdown-item py-2 text-primary btn-confirm fw-medium" href="#" data-id="@deliveryNote.Id">
                                                        <i class="bi bi-check-all me-1"></i>Xác nhận
                                                    </a>
                                                </li>
                                            }
                                            @if (!deliveryNote.IsDirectShip && deliveryNote.Status == (int)DeliveryNoteStatus.Confirmed)
                                            {
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <a class="dropdown-item py-2 @(canLeaveWarehouse ? "text-secondary btn-delivering" : "text-muted disabled") fw-medium" href="#"
                                                       data-id="@deliveryNote.Id" title="@(!canLeaveWarehouse ? "Cần phân công người giao trước" : null)" aria-disabled="@(!canLeaveWarehouse)">
                                                        <i class="bi bi-truck me-1"></i>Đang giao
                                                    </a>
                                                </li>
                                            }
                                            @if (deliveryNote.Status == (int)DeliveryNoteStatus.Confirmed || deliveryNote.Status == (int)DeliveryNoteStatus.Delivering || deliveryNote.Status == (int)DeliveryNoteStatus.PendingConfirmation)
                                            {
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <a class="dropdown-item py-2 @(canOpenDeliveredWorkflow ? "text-success btn-delivered" : "text-muted disabled") fw-medium" href="#"
                                                       data-id="@deliveryNote.Id" title="@(!canOpenDeliveredWorkflow ? "Cần phân công người giao trước" : null)" aria-disabled="@(!canOpenDeliveredWorkflow)">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Đã giao
                                                    </a>
                                                </li>
                                            }
                                            @if (deliveryNote.Status != (int)DeliveryNoteStatus.Delivered && deliveryNote.Status != (int)DeliveryNoteStatus.Cancelled)
                                            {
                                                if (deliveryNote.IsDirectShip)
                                                {
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <a class="dropdown-item py-2 text-danger btn-customer-reject fw-medium" href="#" data-id="@deliveryNote.Id">
                                                            <i class="bi bi-person-fill-x me-1"></i>Hủy phiếu
                                                        </a>
                                                    </li>
                                                }
                                                else
                                                {
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <a class="dropdown-item py-2 text-danger btn-cancel fw-medium" href="#" data-id="@deliveryNote.Id">
                                                            <i class="bi bi-x-circle me-1"></i>Hủy phiếu
                                                        </a>
                                                    </li>
                                                }
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <div class="empty-icon"><i class="bi bi-inbox"></i></div>
                                    <h5>Không tìm thấy phiếu xuất kho nào</h5>
                                    <p>Thử thay đổi từ khóa tìm kiếm hoặc tạo phiếu mới từ đơn hàng.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="responsive-list-panel responsive-list-grid" data-list-view-panel="grid" hidden>
        @if (Model.Data.Items.Any())
        {
            foreach (var deliveryNote in Model.Data.Items)
            {
                var status = (DeliveryNoteStatus)deliveryNote.Status;
                var canLeaveWarehouse = deliveryNote.IsDirectShip || deliveryNote.IsCounterPickup || deliveryNote.AssignedDeliveryUserId.HasValue;
                var canOpenDeliveredWorkflow = deliveryNote.Status == (int)DeliveryNoteStatus.PendingConfirmation
                    || deliveryNote.Status == (int)DeliveryNoteStatus.Delivering
                    || canLeaveWarehouse;

                <article class="list-card">
                    <div class="list-card-header">
                        <div class="list-card-title-group">
                            <a asp-action="Details" asp-route-id="@deliveryNote.Id" class="list-card-title">
                                @HighlighHelper.Highlight(deliveryNote.Code, query)
                            </a>
                            <a asp-action="Details" asp-controller="Order" asp-route-id="@deliveryNote.OrderId" class="list-card-meta text-decoration-none">
                                Đơn @deliveryNote.OrderCode
                            </a>
                        </div>
                        <span class="status-badge @status.GetDisplayColor()">
                            <i class="bi @status.GetActionIcon() me-1"></i>
                            @status.GetDisplayText()
                        </span>
                    </div>
                    <div class="list-card-fields">
                        <div class="list-card-field">
                            <span class="list-card-label">Khách hàng</span>
                            <div class="list-card-value text-end">
                                <span class="fw-medium text-dark d-block">@HighlighHelper.Highlight(deliveryNote.CustomerName ?? "", query)</span>
                                @if (!string.IsNullOrEmpty(deliveryNote.ShippingPhoneNumber))
                                {
                                    <a href="tel:@deliveryNote.ShippingPhoneNumber" class="small text-muted text-decoration-none">
                                        @HighlighHelper.Highlight(deliveryNote.ShippingPhoneNumber ?? "", query)
                                    </a>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(deliveryNote.ShippingAddress))
                        {
                            <div class="list-card-field">
                                <span class="list-card-label">Địa chỉ giao</span>
                                <span class="list-card-value fw-normal text-muted text-end">@deliveryNote.ShippingAddress</span>
                            </div>
                        }
                        <div class="list-card-field">
                            <span class="list-card-label">Kho xuất</span>
                            <span class="list-card-value fw-normal text-muted">@deliveryNote.WarehouseName</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(deliveryNote.AssignedDeliveryFullName))
                        {
                            <div class="list-card-field">
                                <span class="list-card-label">Người giao</span>
                                <span class="list-card-value fw-normal text-muted">@deliveryNote.AssignedDeliveryFullName</span>
                            </div>
                        }
                        <div class="list-card-field">
                            <span class="list-card-label">Ngày tạo</span>
                            <span class="list-card-value fw-normal text-muted">@deliveryNote.CreatedOn.ToString(ViewConstants.DefaultDateTimeFormat)</span>
                        </div>
                        @if (deliveryNote.Status == 40 && deliveryNote.DeliveredOn.HasValue)
                        {
                            <div class="list-card-field">
                                <span class="list-card-label">Đã giao</span>
                                <span class="list-card-value fw-normal text-success fw-medium">@deliveryNote.DeliveredOn.Value.ToString(ViewConstants.DefaultDateTimeFormat)</span>
                            </div>
                        }
                    </div>
                    <div class="list-card-actions justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@deliveryNote.Id">
                                <i class="bi bi-info-circle"></i>
                                <span class="visually-hidden">Chi tiết</span>
                            </a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Print" asp-route-id="@deliveryNote.Id" target="_blank">
                                <i class="bi bi-printer"></i>
                                <span class="visually-hidden">In phiếu</span>
                            </a>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            @if (!deliveryNote.IsDirectShip && deliveryNote.Status == (int)DeliveryNoteStatus.Draft)
                            {
                                <a class="btn btn-sm btn-primary btn-confirm fw-medium" href="#" data-id="@deliveryNote.Id">
                                    <i class="bi bi-check me-1"></i>Xác nhận
                                </a>
                            }
                            @if (!deliveryNote.IsDirectShip && deliveryNote.Status == (int)DeliveryNoteStatus.Confirmed)
                            {
                                <a class="btn btn-sm @(canLeaveWarehouse ? "btn-outline-secondary btn-delivering" : "btn-outline-secondary disabled") fw-medium" href="#" data-id="@deliveryNote.Id" title="@(!canLeaveWarehouse ? "Cần phân công người giao trước" : null)" aria-disabled="@(!canLeaveWarehouse)">
                                    <i class="bi bi-truck"></i>
                                    <span class="d-none d-xl-inline">Đang giao</span>
                                </a>
                            }
                            @if (deliveryNote.Status == (int)DeliveryNoteStatus.Confirmed || deliveryNote.Status == (int)DeliveryNoteStatus.Delivering || deliveryNote.Status == (int)DeliveryNoteStatus.PendingConfirmation)
                            {
                                <a class="btn btn-sm @(canOpenDeliveredWorkflow ? "btn-outline-success btn-delivered" : "btn-outline-secondary disabled") fw-medium" href="#" data-id="@deliveryNote.Id" title="@(!canOpenDeliveredWorkflow ? "Cần phân công người giao trước" : null)" aria-disabled="@(!canOpenDeliveredWorkflow)">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span class="d-none d-xl-inline">Đã giao</span>
                                </a>
                            }
                            @if (deliveryNote.Status != (int)DeliveryNoteStatus.Delivered && deliveryNote.Status != (int)DeliveryNoteStatus.Cancelled)
                            {
                                if (deliveryNote.IsDirectShip)
                                {
                                    <a class="btn btn-sm btn-outline-danger btn-customer-reject fw-medium" href="#" data-id="@deliveryNote.Id" data-code="@deliveryNote.Code">
                                        <i class="bi bi-person-fill-x"></i>
                                        <span class="d-none d-xxl-inline">Từ chối</span>
                                    </a>
                                }
                                else
                                {
                                    <a class="btn btn-sm btn-outline-danger btn-cancel fw-medium" href="#" data-id="@deliveryNote.Id">
                                        <i class="bi bi-x-circle"></i>
                                        <span class="d-none d-xxl-inline">Hủy phiếu</span>
                                    </a>
                                }
                            }
                        </div>
                    </div>
                </article>
            }
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="bi bi-inbox"></i></div>
                <h5>Không tìm thấy phiếu xuất kho nào</h5>
                <p>Thử thay đổi từ khóa tìm kiếm hoặc tạo phiếu mới từ đơn hàng.</p>
            </div>
        }
    </div>

    @if (Model.Data.Pagination.TotalCount > 0)
    {
        <partial name="_Pager" model="Model.Data.Pagination" />
    }
</div>

@if (Model.Data.Any(note => note.Status == (int)DeliveryNoteStatus.Confirmed || note.Status == (int)DeliveryNoteStatus.Delivering || note.Status == (int)DeliveryNoteStatus.PendingConfirmation))
{
    <partial name="_DeliveryNote.ConfirmDelivered" />
    <partial name="_DeliveryNote.ConfirmReject" model="@Model.AvailableWarehouses" />

}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module">
        import DeliverNoteController from '/modules/DeliveryNoteController.js';

        $(document).ready(function () {
            const deliveryNoteController = new DeliverNoteController({ hidePageLoadOnRequestEnd: false });

            // Confirm
            $('.btn-confirm').click(async function(e) {
                e.preventDefault();
                var id = $(this).data('id');
                var result = await deliveryNoteController.confirm(id);
                if (result?.success)
                    location.reload();
            });

            // Mark Delivering
            $('.btn-delivering').click(async function(e) {
                e.preventDefault();
                var id = $(this).data('id');
                var result = await deliveryNoteController.delivering(id);
                if (result?.success)
                    location.reload();
            });

            // Cancel
            $('.btn-cancel').click(async function(e) {
                e.preventDefault();
                var id = $(this).data('id');
                var result = await deliveryNoteController.cancel(id);
                if (result?.success)
                    location.reload();
            });

            $('.btn-customer-reject').click(function(e) {
                e.preventDefault();
                const {id, code, warehouse } = $(this).data();
                deliveryNoteController.beginRejectWorkflow('rejectDeliveryNoteModal').setData(id, code, warehouse);
            });

            $('.btn-delivered').click(function(e) {
                e.preventDefault();
                var id = String($(this).data('id'));
                deliveryNoteController.beginDeliveredWorkflow('markDeliveredModal').setId(id);
            });
        });
    </script>
}
