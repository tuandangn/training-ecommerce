@model CreateDeliveryNoteModel
@inject IWebHelper WebHelper
@inject ICachedValuesService CachedValuesService
@{
    ViewData[ViewConstants.PageTitle] = "Tạo phiếu xuất kho";
}

@section TitleSection {
    <h1 class="topbar-page-title">
        Tạo phiếu xuất
        <span class="text-muted">Đơn hàng @Model.OrderCode</span>
    </h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="List" asp-controller="DeliveryNote" class="text-decoration-none">Phiếu xuất kho</a></li>
                <li class="breadcrumb-item active" aria-current="page">Tạo mới</li>
            </ol>
        </nav>
    </div>
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/deliverynote-create.css" asp-append-version="true" />
}

<form asp-action="Create" method="post" id="createDeliveryForm">
    <input type="hidden" asp-for="OrderId" />

    <div class="row g-4">
        <div class="col-md-8">
            <div class="content-card">
                <div class="content-card-header">
                    <div>
                        <h5>Chi tiết phiếu xuất hàng</h5>
                        <div class="text-muted small">Thông tin khách hàng và hàng hóa xuất</div>
                    </div>
                </div>
                <div class="content-card-body">
                    <div class="order-workflow-info-grid three-columns">
                        <div>
                            <div class="workflow-info-label">Đơn hàng</div>
                            <div class="fw-bold text-dark">
                                @Model.OrderCode
                            </div>
                            <div class="small text-primary mt-1">
                                Ngày đặt @(Model.PlacedOn.ToString(ViewConstants.DefaultDateFormat))
                            </div>
                            <div class="small text-muted mt-1">
                                @(Model.ExpectedShippingDate.HasValue ? $"Ngày hẹn {Model.ExpectedShippingDate.Value.ToString(ViewConstants.DefaultDateFormat)}" : "Chưa hẹn ngày")
                            </div>
                        </div>
                        <div>
                            <div class="workflow-info-label">Khách hàng</div>
                            <div class="fw-bold text-dark">@Model.CustomerName</div>
                            @if (!string.IsNullOrWhiteSpace(Model.CustomerPhoneNumber))
                            {
                                <a href="tel:@Model.CustomerPhoneNumber" class="text-decoration-none small">@Model.CustomerPhoneNumber</a>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.CustomerAddress))
                            {
                                var encodedCustomerAddress = WebHelper.EncodeUrlComponent(Model.CustomerAddress);
                                <div class="small text-muted mt-1">
                                    @Model.CustomerAddress
                                    <a href="https://www.google.com/maps/search/@encodedCustomerAddress" target="_blank" class="text-decoration-none text-nowrap ms-1">
                                        <i class="bi bi-geo-alt"></i>
                                    </a>
                                </div>
                            }
                        </div>
                        <div>
                            <div class="workflow-info-label">Ghi chú</div>
                            @if (!string.IsNullOrWhiteSpace(Model.OrderNote))
                            {
                                <div class="text-dark">@Model.OrderNote</div>
                            }
                            else
                            {
                                <div class="text-muted small">Không có ghi chú</div>
                            }
                        </div>
                    </div>
                </div>
                <div asp-validation-summary="ModelOnly" class="alert alert-warning alert-global alert-dismissible long-time-waiting"></div>
                <div class="content-card-body-flush">
                    <div class="text-end px-3 d-none" id="selectedTotalContainer">
                        <span class="text-muted small">Tổng tiền chọn:</span>
                        <span class="fw-bold text-success ms-2" id="selectedTotalText">0đ</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table data-table delivery-stock-table mb-0">
                            <thead>
                                <tr>
                                    <th class="text-center ps-3 ui-w-50">
                                        <input type="checkbox" id="selectAll" class="form-check-input" checked />
                                    </th>
                                    <th>Mặt hàng</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end">Đã giao</th>
                                    <th>Phân bổ kho</th>
                                    <th class="text-end pe-3 ui-w-130">Tổng xuất</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Items.Any())
                                {
                                    for (int i = 0; i < Model.Items.Count; i++)
                                    {
                                        var item = Model.Items[i];
                                        var requiredQuantityValue = item.RemainingQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture);
                                        var availableQuantityValue = item.AvailableQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture);
                                        <tr class="item-row"
                                            data-item-index="@i"
                                            data-product-id="@item.ProductId"
                                            data-required-quantity="@requiredQuantityValue"
                                            data-available-quantity="@availableQuantityValue"
                                            data-decimalplaces="@item.QuantityDecimalPlaces"
                                            data-stock-loaded="false">
                                            <td class="align-middle text-center ps-3">
                                                <input type="checkbox" asp-for="Items[i].Selected" class="form-check-input item-checkbox" />
                                                <input type="hidden" asp-for="Items[i].OrderItemId" />
                                                <input type="hidden" asp-for="Items[i].ProductId" class="item-product-id" />
                                                <input type="hidden" asp-for="Items[i].WarehouseId" class="item-warehouse-id" />
                                                <input type="hidden" asp-for="Items[i].ProductName" />
                                                <input type="hidden" asp-for="Items[i].OrderedQuantity" />
                                                <input type="hidden" asp-for="Items[i].PreviouslyDeliveredQuantity" />
                                                <input type="hidden" asp-for="Items[i].RemainingQuantity" class="item-required-quantity" />
                                                <input type="hidden" asp-for="Items[i].AvailableQuantity" class="item-available-quantity" />
                                                <input type="hidden" asp-for="Items[i].UnitPrice" class="item-price" />
                                                <input type="hidden" asp-for="Items[i].QuantityDecimalPlaces" />
                                            </td>
                                            <td class="align-middle">
                                                <span class="fw-medium d-block">@item.ProductName</span>
                                            </td>
                                            <td class="text-end align-middle text-dark">@item.UnitPrice.DisplayCurrency()</td>
                                            <td class="text-end align-middle text-success">@item.PreviouslyDeliveredQuantity.DisplayQuantity(item.QuantityDecimalPlaces)</td>
                                            <td class="align-middle">
                                                <div class="delivery-stock-state stock-availability-state">
                                                    <span class="delivery-stock-status is-neutral">
                                                        <i class="bi bi-box-seam stock-status-icon"></i>
                                                        <span class="stock-availability-label">Đang lấy dữ liệu</span>
                                                    </span>
                                                </div>
                                                <div class="warehouse-allocation-list mt-2"></div>
                                            </td>
                                            <td class="text-end pe-3">
                                                <input type="hidden" asp-for="Items[i].Quantity" class="quantity-input" value="@item.Quantity.DisplayQuantity()" />
                                                <span class="allocation-total-text text-end fw-bold">0</span>
                                                <span class="allocation-total-note text-end small text-muted">
                                                    / @item.RemainingQuantity.DisplayQuantity(item.QuantityDecimalPlaces)
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-5">
                                            <div class="empty-state">
                                                <div class="empty-icon"><i class="bi bi-check-circle text-success"></i></div>
                                                <h5>Hàng hóa đã giao đủ</h5>
                                                <p>Tất cả hàng hóa trong đơn này đã được xuất và giao đầy đủ.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="content-card-footer align-items-center justify-content-between d-none d-md-flex">
                    <a asp-action="Details" asp-controller="Order" asp-route-id="@Model.OrderId" class="btn btn-outline-secondary text-decoration-none btn-sm">
                        <i class="bi bi-arrow-left"></i> Quay lại Đơn hàng
                    </a>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm" data-testid="delivery-create-submit" @(Model.Items.Any() ? "" : "disabled")>
                        <i class="bi bi-floppy"></i> Tạo phiếu xuất
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Info Card -->
            <div class="content-card mb-4">
                <div class="content-card-header">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-info-circle me-2 text-primary"></i>
                        Thông tin phiếu
                    </h5>
                </div>
                <div class="content-card-body">
                    <div class="mb-3">
                        <label asp-for="ShippingPhoneNumber" class="form-label small fw-bold text-muted text-uppercase mb-2"></label>
                        <input asp-for="ShippingPhoneNumber" class="form-control" />
                        <span asp-validation-for="ShippingPhoneNumber" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ShippingAddress" class="form-label small fw-bold text-muted text-uppercase mb-2"></label>
                        <textarea asp-for="ShippingAddress" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="ShippingAddress" class="text-danger small"></span>
                    </div>
                    <div class="mb-0">
                        <label asp-for="Note" class="form-label small fw-bold text-muted text-uppercase mb-2"></label>
                        <textarea asp-for="Note" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>

            <!-- Payment Summary Card -->
            <div class="content-card mb-4">
                <div class="content-card-header">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-wallet2 me-2 text-primary"></i>
                        Tổng kết thanh toán
                    </h5>
                </div>
                <div class="content-card-body">
                    <div class="form-check form-switch mb-3 p-3 bg-light rounded border">
                        <input class="form-check-input ms-0" type="checkbox" asp-for="ShowPrice" role="switch" id="showPriceSwitch" 
                            checked="@(Model.CustomerId == CachedValuesService.DefaultCustomerId && Model.AmountAlreadyPaidForOrder == 0)" />
                        <label class="form-check-label ms-2 fw-medium" asp-for="ShowPrice" for="showPriceSwitch">
                            Hiển thị giá trên phiếu
                        </label>
                    </div>
                    <div class="row mb-3">
                        <div class="col-xl-6 mb-3">
                            <label asp-for="Surcharge" class="form-label small fw-bold text-muted text-uppercase mb-2" for="surchargeInput"></label>
                            <div class="input-group">
                                <input asp-for="Surcharge" class="form-control text-end" id="surchargeInput" placeholder="0" data-decimal="currency" />
                                <span class="input-group-text bg-white">đ</span>
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <label asp-for="SurchargeReason" class="form-label small fw-bold text-muted text-uppercase mb-2" for="SurchargeReason"></label>
                            <input asp-for="SurchargeReason" class="form-control" placeholder="Lý do thu phụ phí (ví dụ: phí vận chuyển xa, phí bốc xếp...)" />
                        </div>
                    </div>

                    <div class="payment-breakdown mb-3 p-3 bg-light rounded border" id="moneySummary">
                        <div class="d-flex justify-content-between mb-2 @(Model.ShowPrice ? "" : "d-none")" id="productsPrice">
                            <span class="text-muted small">Tiền hàng:</span>
                            <span class="fw-bold" id="breakdown-items">0đ</span>
                        </div>
                        @if (Model.AmountAlreadyPaidForOrder > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 @(Model.ShowPrice ? "" : "d-none")" id="paidAmount">
                                <span class="text-muted small">Đã thanh toán<span id="breakdown-paid-total"> (tổng @Model.AmountAlreadyPaidForOrder.DisplayCurrencyWithSymbol())</span>:</span>
                                <span class="fw-bold text-success" id="breakdown-paid">0 đ</span>
                            </div>
                        }
                        <div class="d-flex justify-content-between mb-2 @(Model.AmountAlreadyPaidForOrder > 0 ? "" : "pt-2 border-top")">
                            <span class="text-muted small">Phụ phí:</span>
                            <span class="fw-bold" id="breakdown-surcharge">0đ</span>
                        </div>
                        <div class="d-flex justify-content-between mt-2 pt-2 border-top">
                            <span class="fw-bold text-dark">Tổng cộng:</span>
                            <span class="fw-bold text-primary fs-5" id="breakdown-total">0đ</span>
                        </div>
                    </div>
                    <div>
                        <label asp-for="AmountToCollect" class="form-label small fw-bold text-primary text-uppercase mb-2" for="amountToCollectInput">Số tiền phải thu</label>
                        <div class="input-group">
                            <input asp-for="AmountToCollect" class="form-control text-end fw-bold text-primary fs-5" readonly="@(Model.CustomerId == CachedValuesService.DefaultCustomerId)" id="amountToCollectInput" data-decimal="currency" />
                            <span class="input-group-text bg-primary text-white border-primary">đ</span>
                        </div>
                        <span asp-validation-for="AmountToCollect" class="text-danger small"></span>
                        <span class="text-muted small" id="calculationInfo"></span>
                        @if (Model.IsRetailWalkInCustomer)
                        {
                            <div class="alert alert-warning small mt-2 mb-0 py-2">
                                <i class="bi bi-exclamation-triangle me-1"></i> Đơn khách lẻ phải thu đủ khi giao, không được để công nợ.
                            </div>
                        }
                    </div>
                </div>
                <div class="content-card-footer d-grid d-md-none">
                    <button type="submit" class="btn btn-primary px-4 shadow-sm" data-testid="delivery-create-submit" @(Model.Items.Any() ? "" : "disabled")>
                        <i class="bi bi-floppy"></i> Tạo phiếu xuất
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            const $showPriceSwitch = $('#showPriceSwitch');
            const $surchargeInput = $('#surchargeInput');
            const $amountToCollectInput = $('#amountToCollectInput');
            const $calculationInfo = $('#calculationInfo');
            const $selectedTotalContainer = $('#selectedTotalContainer');
            const $selectedTotalText = $('#selectedTotalText');

            const $breakdownItems = $('#breakdown-items');
            const $breakdownSurcharge = $('#breakdown-surcharge');
            const $breakdownPaid = $('#breakdown-paid');
            const $breakdownTotal = $('#breakdown-total');

            const $moneySummary = $('#moneySummary');
            const $paidAmount = $('#paidAmount');
            const $productsPrice = $('#productsPrice');
            const $warehouseSelect = $('#WarehouseId');
            const stockAvailabilityUrl = '@Url.Action("GetCreateStockAvailability", "DeliveryNote")';
            let stockAvailabilityRequestId = 0;
            const amountAlreadyPaidForOrder = parseFloat('@Model.AmountAlreadyPaidForOrder.ToString(System.Globalization.CultureInfo.InvariantCulture)') || 0;

            function formatCurrency(amount, withSymbol) {
                if (withSymbol)
                    return DecimalFields.formatCurrencyWithSymbol(amount);
                return DecimalFields.formatCurrency(amount);
            }

            function calculateAmount() {
                let totalSelected = 0;
                $('.item-row').each(function() {
                    const isSelected = $(this).find('.item-checkbox').is(':checked');
                    if (isSelected) {
                        const qty = parseFloat(DecimalFields.stripFormatting($(this).find('.quantity-input').val(), 2)) || 0;
                        const price = parseFloat($(this).find('.item-price').val()) || 0;
                        totalSelected += qty * price;
                    }
                });

                const surcharge = parseFloat(DecimalFields.stripFormatting($surchargeInput.val())) || 0;
                const showPrice = $showPriceSwitch.is(':checked');

                var includeProductTotal = showPrice || @(Model.CustomerId == CachedValuesService.DefaultCustomerId && Model.AmountAlreadyPaidForOrder == 0 ? "true" : "false");

                let amountToCollect = surcharge;
                let infoText = 'Tự động tính theo phụ phí';

                if (includeProductTotal) {
                    amountToCollect += Math.max(0, totalSelected - amountAlreadyPaidForOrder);
                    infoText = `Tổng tiền hàng (${formatCurrency(totalSelected, true)}) + Phụ phí (${formatCurrency(surcharge, true)})`;
                    $selectedTotalContainer.show();
                    $selectedTotalText.text(formatCurrency(totalSelected, true));
                    $paidAmount.removeClass('d-none');
                    $productsPrice.removeClass('d-none');
                } else {
                    $paidAmount.addClass('d-none');
                    $selectedTotalContainer.hide();
                    $productsPrice.addClass('d-none');
                }

                if (amountAlreadyPaidForOrder > 0) {
                    infoText += ` − Đã thanh toán (${formatCurrency(amountAlreadyPaidForOrder, true)})`;
                }
                $moneySummary.toggleClass('d-none', amountToCollect <= 0);

                $amountToCollectInput.val(formatCurrency(amountToCollect));
                $calculationInfo.html(`<i class="bi bi-info-circle me-1"></i> ${infoText}`);

                // Update breakdown
                $breakdownItems.text(formatCurrency(totalSelected, true));
                $breakdownSurcharge.text(formatCurrency(surcharge, true));
                $breakdownTotal.text(formatCurrency(amountToCollect, true));
                $breakdownPaid.text(formatCurrency(Math.min(amountAlreadyPaidForOrder, totalSelected), true));
                $('#breakdown-paid-total').toggleClass('d-none', Math.min(amountAlreadyPaidForOrder, totalSelected) == amountAlreadyPaidForOrder);
            }

            function parseQuantity(value) {
                const parsed = parseFloat(DecimalFields.stripFormatting(value, 2));
                return Number.isFinite(parsed) ? parsed : 0;
            }

            function formatQuantity(quantity) {
                return DecimalFields.formatQuantity(Math.max(0, quantity));
            }

            function getRequiredQuantity($row) {
                const dataValue = parseFloat($row.attr('data-required-quantity'));
                if (Number.isFinite(dataValue))
                    return dataValue;
                return parseQuantity($row.find('.item-required-quantity').val());
            }

            function getAvailableQuantity($row) {
                const dataValue = parseFloat($row.attr('data-available-quantity'));
                if (Number.isFinite(dataValue))
                    return dataValue;
                return parseQuantity($row.find('.item-available-quantity').val());
            }

            function setQuantity($row, quantity) {
                $row.find('.quantity-input').val(formatQuantity(quantity));
            }

            function setStockState($row, label, note, state, icon) {
                const $state = $row.find('.stock-availability-state');
                $state.find('.stock-status-icon')
                    .removeClass()
                    .addClass(`bi ${icon} stock-status-icon`);
                $state.find('.stock-availability-label').text(label);
                $state.find('.delivery-stock-status')
                    .removeClass('is-neutral is-loading is-ok is-short is-empty is-error')
                    .addClass(`is-${state}`);
                $state.find('.stock-availability-note').toggleClass('d-none', !note);
                $state.find('.stock-availability-note')
                    .removeClass('is-short is-empty is-error')
                    .addClass(state === 'short' || state === 'empty' || state === 'error' ? `is-${state}` : '')
                    .text(note);
            }

            function updateSelectAllState() {
                const itemCount = $('.item-checkbox').length;
                const checkedCount = $('.item-checkbox:checked').length;
                $('#selectAll').prop('checked', itemCount > 0 && itemCount === checkedCount);
            }

            function applyStockAvailability($row, availableQuantity, stockLoaded) {
                const requiredQuantity = getRequiredQuantity($row);
                const $quantityInput = $row.find('.quantity-input');
                const $checkbox = $row.find('.item-checkbox');

                $row
                    .removeClass('stock-row-empty stock-row-short')
                    .attr('data-stock-loaded', stockLoaded ? 'true' : 'false')
                    .attr('data-available-quantity', availableQuantity.toString());
                $row.find('.item-available-quantity').val(formatQuantity(availableQuantity));

                if (!stockLoaded) {
                    $quantityInput.attr('max', requiredQuantity);
                    setStockState($row, 'Chọn kho', 'Tồn kho sẽ cập nhật theo kho xuất', 'neutral', 'bi-box-seam');
                    if (parseQuantity($quantityInput.val()) > requiredQuantity)
                        setQuantity($row, requiredQuantity);
                    return;
                }

                const maxQuantity = Math.min(requiredQuantity, availableQuantity);
                $quantityInput.attr('max', maxQuantity);
                setQuantity($row, maxQuantity);

                if (availableQuantity <= 0) {
                    if ($checkbox.is(':checked'))
                        $row.attr('data-stock-auto-unchecked', 'true');
                    $row.addClass('stock-row-empty');
                    $checkbox.prop('checked', false);
                    setStockState($row, 'Không có tồn kho', '', 'empty', 'bi-exclamation-triangle');
                    return;
                }

                if ($row.attr('data-stock-auto-unchecked') === 'true') {
                    $checkbox.prop('checked', true);
                    $row.removeAttr('data-stock-auto-unchecked');
                }

                if (availableQuantity < requiredQuantity) {
                    const shortageQuantity = requiredQuantity - availableQuantity;
                    $row.addClass('stock-row-short');
                    setStockState($row, formatQuantity(availableQuantity), `Thiếu ${formatQuantity(shortageQuantity)} so với số cần xuất`, 'short', 'bi-exclamation-circle');
                    return;
                }

                setStockState($row, formatQuantity(availableQuantity), 'Đủ cho số còn cần xuất', 'ok', 'bi-check-circle');
            }

            function clampQuantityInput($input) {
                const $row = $input.closest('.item-row');
                if ($row.attr('data-stock-loaded') !== 'true')
                    return;

                const maxQuantity = Math.min(getRequiredQuantity($row), getAvailableQuantity($row));
                const quantity = parseQuantity($input.val());
                if (quantity > maxQuantity)
                    $input.val(formatQuantity(maxQuantity));
            }

            function loadStockAvailability() {
                const requestId = ++stockAvailabilityRequestId;
                const warehouseId = $warehouseSelect.val();
                if (!warehouseId) {
                    $('.item-row').each(function() {
                        applyStockAvailability($(this), 0, false);
                    });
                    updateSelectAllState();
                    calculateAmount();
                    return;
                }

                const productIds = [];
                $('.item-row').each(function() {
                    const productId = $(this).attr('data-product-id');
                    if (productId && !productIds.includes(productId))
                        productIds.push(productId);
                    setStockState($(this), 'Đang kiểm tra', 'Đang lấy tồn kho kho đã chọn', 'loading', 'bi-arrow-repeat');
                });

                if (!productIds.length)
                    return;

                $.ajax({
                    url: stockAvailabilityUrl,
                    type: 'GET',
                    traditional: true,
                    data: { warehouseId, productIds },
                    success: function(response) {
                        if (requestId !== stockAvailabilityRequestId)
                            return;

                        const availabilityByProductId = {};
                        (response.items || []).forEach(function(item) {
                            availabilityByProductId[String(item.productId).toLowerCase()] = parseFloat(item.quantityAvailable) || 0;
                        });

                        $('.item-row').each(function() {
                            const $row = $(this);
                            const productId = String($row.attr('data-product-id')).toLowerCase();
                            applyStockAvailability($row, availabilityByProductId[productId] || 0, true);
                        });

                        updateSelectAllState();
                        calculateAmount();
                    },
                    error: function() {
                        if (requestId !== stockAvailabilityRequestId)
                            return;

                        $('.item-row').each(function() {
                            const $row = $(this);
                            $row
                                .removeClass('stock-row-empty stock-row-short')
                                .attr('data-stock-loaded', 'false');
                            setStockState($row, 'Không tải được', 'Kiểm tra lại kho hoặc tải lại trang', 'error', 'bi-exclamation-triangle');
                        });
                    }
                });
            }

            function escapeHtml(value) {
                return String(value ?? '').replace(/[&<>"']/g, char => ({
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#039;'
                }[char]));
            }

            function getAllocatedQuantity($row) {
                let total = 0;
                $row.find('.allocation-quantity-input').each(function() {
                    total += parseQuantity($(this).val());
                });
                return total;
            }

            function getAvailableQuantity($row) {
                const dataValue = parseFloat($row.attr('data-total-available-quantity'));
                return Number.isFinite(dataValue) ? dataValue : 0;
            }

            function setQuantity($row, quantity) {
                $row.find('.quantity-input').val(formatQuantity(quantity));
                $row.find('.allocation-total-text').text(formatQuantity(quantity));
            }

            function getAllocationWarehouses(warehouses, requiredQuantity) {
                const normalized = (warehouses || []).map(warehouse => ({
                    warehouseId: warehouse.warehouseId,
                    warehouseName: warehouse.warehouseName || '',
                    quantityAvailable: parseFloat(warehouse.quantityAvailable) || 0,
                    isDefault: warehouse.isDefault === true
                }));
                const ordered = normalized.slice().sort((left, right) => {
                    if (left.isDefault !== right.isDefault)
                        return left.isDefault ? -1 : 1;
                    return right.quantityAvailable - left.quantityAvailable;
                });

                let remainingQuantity = requiredQuantity;
                const suggestedByWarehouseId = {};
                ordered.forEach(function(warehouse) {
                    const quantity = Math.min(remainingQuantity, warehouse.quantityAvailable);
                    suggestedByWarehouseId[String(warehouse.warehouseId).toLowerCase()] = Math.max(0, quantity);
                    remainingQuantity -= quantity;
                });

                const visible = ordered.filter(warehouse => warehouse.isDefault || warehouse.quantityAvailable > 0);
                return (visible.length ? visible : ordered).map(warehouse => ({
                    ...warehouse,
                    suggestedQuantity: suggestedByWarehouseId[String(warehouse.warehouseId).toLowerCase()] || 0
                }));
            }

            function renderWarehouseAllocations($row, warehouses, stockLoaded) {
                const requiredQuantity = getRequiredQuantity($row);
                const $checkbox = $row.find('.item-checkbox');
                const itemIndex = $row.attr('data-item-index');
                const totalAvailable = (warehouses || []).reduce((sum, warehouse) => sum + (parseFloat(warehouse.quantityAvailable) || 0), 0);
                const allocationWarehouses = stockLoaded ? getAllocationWarehouses(warehouses, requiredQuantity) : [];

                $row
                    .removeClass('stock-row-empty stock-row-short')
                    .attr('data-stock-loaded', stockLoaded ? 'true' : 'false')
                    .attr('data-total-available-quantity', totalAvailable.toString());
                $row.find('.item-available-quantity').val(formatQuantity(totalAvailable));
                $row.find('.warehouse-allocation-list').empty();

                if (!stockLoaded) {
                    setQuantity($row, 0);
                    setStockState($row, 'Đang chờ tồn kho', 'Tự phân bổ theo kho ưu tiên, sau đó tới các kho còn hàng', 'neutral', 'bi-box-seam');
                    return;
                }

                const allocationHtml = allocationWarehouses.map(function(warehouse, index) {
                    const warehouseName = escapeHtml(warehouse.warehouseName);
                    const warehouseId = escapeHtml(warehouse.warehouseId);
                    const availableQuantity = formatQuantity(warehouse.quantityAvailable);
                    const suggestedQuantity = formatQuantity(warehouse.suggestedQuantity);
                    const stateClass = warehouse.quantityAvailable <= 0 ? 'is-empty' : '';
                    return `<div class="warehouse-allocation-line ${stateClass} justify-content-between">
                        <div class="warehouse-allocation-name text-truncate" title="${warehouseName}">${warehouseName}</div>
                        <div class="warehouse-allocation-meta">Tồn ${availableQuantity}</div>
                        <input type="hidden" name="Items[${itemIndex}].WarehouseAllocations[${index}].WarehouseId" value="${warehouseId}" />
                        <input class="form-control form-control-sm text-end warehouse-allocation-input allocation-quantity-input"
                               name="Items[${itemIndex}].WarehouseAllocations[${index}].Quantity"
                               value="${suggestedQuantity}"
                               data-available-quantity="${warehouse.quantityAvailable}"
                               data-decimal="quantity" data-decimals="${parseInt($row.attr('data-decimalplaces') || '0', 10)}" />
                    </div>`;
                }).join('');
                $row.find('.warehouse-allocation-list').html(allocationHtml);

                if (totalAvailable <= 0) {
                    if ($checkbox.is(':checked'))
                        $row.attr('data-stock-auto-unchecked', 'true');
                    $row.addClass('stock-row-empty');
                    $checkbox.prop('checked', false);
                    setQuantity($row, 0);
                    setStockState($row, 'Không có tồn kho', '', 'empty', 'bi-exclamation-triangle');
                    return;
                }

                if ($row.attr('data-stock-auto-unchecked') === 'true') {
                    $checkbox.prop('checked', true);
                    $row.removeAttr('data-stock-auto-unchecked');
                }

                refreshRowAllocation($row);
            }

            function refreshRowAllocation($row) {
                const requiredQuantity = getRequiredQuantity($row);
                const allocatedQuantity = getAllocatedQuantity($row);
                const totalAvailable = getAvailableQuantity($row);
                const firstWarehouseId = $row.find('.allocation-quantity-input')
                    .filter(function() { return parseQuantity($(this).val()) > 0; })
                    .first()
                    .siblings('input[name$=".WarehouseId"]')
                    .val();
                const hasOverWarehouse = $row.find('.allocation-quantity-input').toArray().some(input => {
                    const $input = $(input);
                    return parseQuantity($input.val()) > (parseFloat($input.attr('data-available-quantity')) || 0);
                });

                $row.removeClass('stock-row-empty stock-row-short');
                $row.find('.warehouse-allocation-line').each(function() {
                    const $line = $(this);
                    const $input = $line.find('.allocation-quantity-input');
                    const quantity = parseQuantity($input.val());
                    const availableQuantity = parseFloat($input.attr('data-available-quantity')) || 0;
                    $line.toggleClass('is-over', quantity > availableQuantity);
                    $line.toggleClass('is-empty', availableQuantity <= 0);
                });

                $row.find('.item-warehouse-id').val(firstWarehouseId || $warehouseSelect.val() || '');
                setQuantity($row, allocatedQuantity);

                if ($row.attr('data-stock-loaded') !== 'true') {
                    setStockState($row, 'Đang chờ tồn kho', 'Tự phân bổ theo kho ưu tiên, sau đó tới các kho còn hàng', 'neutral', 'bi-box-seam');
                    return;
                }

                if (totalAvailable <= 0) {
                    $row.addClass('stock-row-empty');
                    setStockState($row, 'Không có tồn kho', 'Không kho nào còn hàng để phân bổ', 'empty', 'bi-exclamation-triangle');
                    return;
                }

                if (hasOverWarehouse) {
                    $row.addClass('stock-row-short');
                    setStockState($row, 'Vượt tồn kho', 'Có kho đang nhập số lượng lớn hơn tồn khả dụng', 'error', 'bi-exclamation-triangle');
                    return;
                }

                if (allocatedQuantity <= 0) {
                    $row.addClass('stock-row-short');
                    setStockState($row, 'Chưa phân bổ', 'Nhập số lượng xuất ở ít nhất một kho', 'short', 'bi-exclamation-circle');
                    return;
                }

                if (allocatedQuantity > requiredQuantity) {
                    $row.addClass('stock-row-short');
                    setStockState($row, 'Vượt số cần xuất', `Đang vượt ${formatQuantity(allocatedQuantity - requiredQuantity)} so với số còn cần giao`, 'error', 'bi-exclamation-triangle');
                    return;
                }

                if (allocatedQuantity < requiredQuantity) {
                    const shortageQuantity = requiredQuantity - allocatedQuantity;
                    $row.addClass('stock-row-short');
                    setStockState($row, 'Chưa phân bổ đủ', `Còn thiếu ${formatQuantity(shortageQuantity)} so với số cần xuất`, 'short', 'bi-exclamation-circle');
                    return;
                }

                setStockState($row, 'Đã phân bổ đủ', `Tổng tồn khả dụng ${formatQuantity(totalAvailable)}`, 'ok', 'bi-check-circle');
            }

            function clampQuantityInput($input) {
                refreshRowAllocation($input.closest('.item-row'));
            }

            function loadStockAvailability() {
                const requestId = ++stockAvailabilityRequestId;
                const warehouseId = $warehouseSelect.val();
                const productIds = [];
                $('.item-row').each(function() {
                    const productId = $(this).attr('data-product-id');
                    if (productId && !productIds.includes(productId))
                        productIds.push(productId);
                    setStockState($(this), 'Đang kiểm tra', 'Đang lấy tồn kho theo tất cả kho', 'loading', 'bi-arrow-repeat');
                });

                if (!productIds.length)
                    return;

                $.ajax({
                    url: stockAvailabilityUrl,
                    type: 'GET',
                    traditional: true,
                    data: { warehouseId, productIds },
                    success: function(response) {
                        if (requestId !== stockAvailabilityRequestId)
                            return;

                        const availabilityByProductId = {};
                        (response.items || []).forEach(function(item) {
                            availabilityByProductId[String(item.productId).toLowerCase()] = item.warehouses || [];
                        });

                        $('.item-row').each(function() {
                            const $row = $(this);
                            const productId = String($row.attr('data-product-id')).toLowerCase();
                            renderWarehouseAllocations($row, availabilityByProductId[productId] || [], true);
                        });

                        updateSelectAllState();
                        calculateAmount();
                    },
                    error: function() {
                        if (requestId !== stockAvailabilityRequestId)
                            return;

                        $('.item-row').each(function() {
                            const $row = $(this);
                            $row
                                .removeClass('stock-row-empty stock-row-short')
                                .attr('data-stock-loaded', 'false');
                            $row.find('.warehouse-allocation-list').empty();
                            setQuantity($row, 0);
                            setStockState($row, 'Không tải được', 'Kiểm tra lại kho hoặc tải lại trang', 'error', 'bi-exclamation-triangle');
                        });
                    }
                });
            }

            function hasInvalidAllocation($row) {
                const requiredQuantity = getRequiredQuantity($row);
                const allocatedQuantity = getAllocatedQuantity($row);
                if ($row.attr('data-stock-loaded') !== 'true')
                    return 'Tồn kho chưa tải xong, vui lòng thử lại.';
                if (allocatedQuantity <= 0)
                    return 'Vui lòng phân bổ số lượng xuất cho các mặt hàng được chọn.';
                if (allocatedQuantity > requiredQuantity)
                    return 'Số lượng phân bổ đang vượt số còn cần giao.';

                const invalidWarehouse = $row.find('.allocation-quantity-input').toArray().some(input => {
                    const $input = $(input);
                    return parseQuantity($input.val()) > (parseFloat($input.attr('data-available-quantity')) || 0);
                });
                if (invalidWarehouse)
                    return 'Có kho đang phân bổ vượt tồn khả dụng.';

                return null;
            }

            // Events
            $('.item-checkbox').on('change', function() {
                updateSelectAllState();
                calculateAmount();
            });

            $('.quantity-input').on('change input', function() {
                clampQuantityInput($(this));
                calculateAmount();
            });

            $(document).on('change input', '.allocation-quantity-input', function() {
                refreshRowAllocation($(this).closest('.item-row'));
                updateSelectAllState();
                calculateAmount();
            });

            const onPricesChanged = debounce(() => calculateAmount(), 400);
            $('#surchargeInput, #showPriceSwitch').on('input', onPricesChanged);
            $('#surchargeInput, #showPriceSwitch').on('change', onPricesChanged.flush);

            $warehouseSelect.on('change', loadStockAvailability);

            // Initial calculation
            calculateAmount();
            loadStockAvailability();

            // Select all
            $('#selectAll').change(function() {
                var checked = $(this).is(':checked');
                $('.item-checkbox').each(function() {
                    const $row = $(this).closest('.item-row');
                    const canSelect = $row.attr('data-stock-loaded') !== 'true' || getAvailableQuantity($row) > 0;
                    $(this).prop('checked', checked && canSelect);
                });
                updateSelectAllState();
                calculateAmount();
            });

            // Handle individual checkbox change to uncheck selectAll
            $('.item-checkbox').change(function() {
                updateSelectAllState();
            });

            // Validation on submit
            $('#createDeliveryForm').submit(function(e) {
                var hasSelected = false;
                $('.item-checkbox:checked').each(function() {
                    hasSelected = true;
                    var row = $(this).closest('tr');
                    var qty = parseFloat(DecimalFields.stripFormatting(row.find('.quantity-input').val(), 2));
                    if (isNaN(qty) || qty <= 0) {
                        alert('Vui lòng nhập số lượng hợp lệ cho các mặt hàng được chọn.');
                        e.preventDefault();
                        return false; // break loop
                    }

                    var allocationError = hasInvalidAllocation(row);
                    if (allocationError) {
                        alert(allocationError);
                        e.preventDefault();
                        return false;
                    }

                    if (row.attr('data-stock-loaded') === 'true') {
                        var availableQuantity = getAvailableQuantity(row);
                        var maxQuantity = Math.min(getRequiredQuantity(row), availableQuantity);
                        if (availableQuantity <= 0 || qty > maxQuantity) {
                            alert('Số lượng xuất vượt số lượng có thể xuất trong kho đã chọn.');
                            e.preventDefault();
                            return false;
                        }
                    }
                });

                if (!hasSelected) {
                    alert('Vui lòng chọn ít nhất một mặt hàng để xuất kho.');
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}
