@model CreateDeliveryNoteModel
@inject IWebHelper WebHelper
@{
    ViewData[ViewConstants.PageTitle] = "Tạo phiếu xuất kho";
}

@section TitleSection {
    <h1 class="topbar-page-title">
        Tạo phiếu xuất
        <span class="text-muted">Đơn hàng @Model.OrderCode</span>
    </h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="List" asp-controller="DeliveryNote" class="text-decoration-none">Phiếu xuất kho</a></li>
                <li class="breadcrumb-item active" aria-current="page">Tạo mới</li>
            </ol>
        </nav>
    </div>
}

<form asp-action="Create" method="post" id="createDeliveryForm">
    <input type="hidden" asp-for="OrderId" />

    <div class="row g-4">
        <div class="col-md-8">
            <div class="content-card">
                <div class="content-card-header">
                    <div>
                        <h5>Chi tiết phiếu xuất hàng</h5>
                        <div class="text-muted small">Thông tin khách hàng và hàng hóa xuất</div>
                    </div>
                </div>
                <div class="content-card-body">
                    <div class="order-workflow-info-grid">
                        <div>
                            <div class="workflow-info-label">Đơn hàng</div>
                            <div class="fw-bold text-dark">
                                @Model.OrderCode
                            </div>
                            <div class="small text-primary mt-1">
                                Ngày đặt @(Model.PlacedOn.ToString(ViewConstants.DefaultDateFormat))
                            </div>
                            <div class="small text-muted mt-1">
                                @(Model.ExpectedShippingDate.HasValue ? $"Ngày hẹn {Model.ExpectedShippingDate.Value.ToString(ViewConstants.DefaultDateFormat)}" : "Chưa hẹn ngày")
                            </div>
                        </div>
                        <div>
                            <div class="workflow-info-label">Khách hàng</div>
                            <div class="fw-bold text-dark">@Model.CustomerName</div>
                            @if (!string.IsNullOrWhiteSpace(Model.CustomerPhoneNumber))
                            {
                                <a href="tel:@Model.CustomerPhoneNumber" class="text-decoration-none small">@Model.CustomerPhoneNumber</a>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.CustomerAddress))
                            {
                                var encodedCustomerAddress = WebHelper.EncodeUrlComponent(Model.CustomerAddress);
                                <div class="small text-muted mt-1">
                                    @Model.CustomerAddress
                                    <a href="https://www.google.com/maps/search/@encodedCustomerAddress" target="_blank" class="text-decoration-none text-nowrap ms-1">
                                        <i class="bi bi-geo-alt"></i>
                                    </a>
                                </div>
                            }
                        </div>
                        <div>
                            <div class="workflow-info-label">Ghi chú</div>
                            @if (!string.IsNullOrWhiteSpace(Model.OrderNote))
                            {
                                <div class="text-dark">@Model.OrderNote</div>
                            }
                            else
                            {
                                <div class="text-muted small">Không có ghi chú</div>
                            }
                        </div>
                    </div>
                </div>
                <div asp-validation-summary="ModelOnly" class="alert alert-warning alert-global alert-dismissible long-time-waiting"></div>
                <div class="content-card-body-flush">
                    <div class="text-end px-3" id="selectedTotalContainer" style="display:none;">
                        <span class="text-muted small">Tổng tiền chọn:</span>
                        <span class="fw-bold text-success ms-2" id="selectedTotalText">0đ</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table data-table mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 50px;" class="text-center ps-4">
                                        <input type="checkbox" id="selectAll" class="form-check-input" checked />
                                    </th>
                                    <th>Mặt hàng</th>
                                    <th class="text-end">Đã đặt</th>
                                    <th class="text-end">Đã giao</th>
                                    <th class="text-end pe-4" style="width: 150px;">SL xuất đợt này</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Items.Any())
                                {
                                    for (int i = 0; i < Model.Items.Count; i++)
                                    {
                                        <tr class="item-row">
                                            <td class="align-middle text-center ps-4">
                                                <input type="checkbox" asp-for="Items[i].Selected" class="form-check-input item-checkbox" />
                                                <input type="hidden" asp-for="Items[i].OrderItemId" />
                                                <input type="hidden" asp-for="Items[i].ProductName" />
                                                <input type="hidden" asp-for="Items[i].OrderedQuantity" />
                                                <input type="hidden" asp-for="Items[i].PreviouslyDeliveredQuantity" />
                                                <input type="hidden" asp-for="Items[i].UnitPrice" class="item-price" />
                                            </td>
                                            <td class="align-middle fw-medium">@Model.Items[i].ProductName</td>
                                            <td class="text-end align-middle">@Model.Items[i].OrderedQuantity.DisplayQuantity()</td>
                                            <td class="text-end align-middle text-success">@Model.Items[i].PreviouslyDeliveredQuantity.DisplayQuantity()</td>
                                            <td class="pe-4">
                                                <input asp-for="Items[i].Quantity" class="form-control text-end quantity-input fw-bold"
                                                       max="@Model.Items[i].OrderedQuantity" data-decimal="quantity" value="@Model.Items[i].Quantity.DisplayQuantity()" />
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-5">
                                            <div class="empty-state">
                                                <div class="empty-icon"><i class="bi bi-check-circle text-success"></i></div>
                                                <h5>Hàng hóa đã giao đủ</h5>
                                                <p>Tất cả hàng hóa trong đơn này đã được xuất và giao đầy đủ.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="content-card-footer d-flex align-items-center justify-content-between">
                    <a asp-action="Details" asp-controller="Order" asp-route-id="@Model.OrderId" class="btn btn-link text-decoration-none text-muted btn-sm ps-0">
                        <i class="bi bi-arrow-left"></i> Quay lại Đơn hàng
                    </a>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm" @(Model.Items.Any() ? "" : "disabled")>
                        <i class="bi bi-floppy"></i> Tạo phiếu xuất
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Info Card -->
            <div class="content-card mb-4">
                <div class="content-card-header">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-info-circle me-2 text-primary"></i>
                        Thông tin phiếu
                    </h5>
                </div>
                <div class="content-card-body">
                    <div class="mb-3">
                        <label asp-for="ShippingAddress" class="form-label small fw-bold text-muted text-uppercase mb-2"></label>
                        <textarea asp-for="ShippingAddress" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="ShippingAddress" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="WarehouseId" class="form-label small fw-bold text-muted text-uppercase mb-2"></label>
                        <select asp-for="WarehouseId" asp-items="Model.AvailableWarehouses!.ToSelectList(Model.WarehouseId)" class="form-select">
                            <option value="">-- Chọn kho xuất --</option>
                        </select>
                        <span asp-validation-for="WarehouseId" class="text-danger small"></span>
                    </div>
                    <div class="mb-0">
                        <label asp-for="Note" class="form-label small fw-bold text-muted text-uppercase mb-2"></label>
                        <textarea asp-for="Note" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>

            <!-- Payment Summary Card -->
            <div class="content-card mb-4">
                <div class="content-card-header">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-wallet2 me-2 text-primary"></i>
                        Tổng kết thanh toán
                    </h5>
                </div>
                <div class="content-card-body">
                    <div class="row mb-3">
                        <div class="col-xl-6 mb-3">
                            <label asp-for="Surcharge" class="form-label small fw-bold text-muted text-uppercase mb-2" for="surchargeInput"></label>
                            <div class="input-group">
                                <input asp-for="Surcharge" class="form-control text-end" id="surchargeInput" placeholder="0" data-decimal="currency" />
                                <span class="input-group-text bg-white">đ</span>
                            </div>
                        </div>
                        <div class="col-xl-6">
                            <label asp-for="SurchargeReason" class="form-label small fw-bold text-muted text-uppercase mb-2" for="SurchargeReason"></label>
                            <input asp-for="SurchargeReason" class="form-control" placeholder="Lý do thu phụ phí (ví dụ: phí vận chuyển xa, phí bốc xếp...)"/>
                        </div>
                    </div>

                    <div class="payment-breakdown mb-3 p-3 bg-light rounded border" id="moneySummary">
                        <div class="d-flex justify-content-between mb-2 @(Model.ShowPrice ? "" : "d-none")" id="productsPrice">
                            <span class="text-muted small">Tiền hàng:</span>
                            <span class="fw-bold" id="breakdown-items">0đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Phụ phí:</span>
                            <span class="fw-bold" id="breakdown-surcharge">0đ</span>
                        </div>
                        <div class="d-flex justify-content-between mt-2 pt-2 border-top">
                            <span class="fw-bold text-dark">Tổng cộng phải thu:</span>
                            <span class="fw-bold text-primary fs-5" id="breakdown-total">0đ</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AmountToCollect" class="form-label small fw-bold text-primary text-uppercase mb-2" for="amountToCollectInput">Số tiền phải thu</label>
                        <div class="input-group">
                            <input asp-for="AmountToCollect" class="form-control text-end fw-bold text-primary fs-5" id="amountToCollectInput" data-decimal="currency" />
                            <span class="input-group-text bg-primary text-white border-primary">đ</span>
                        </div>
                        <span asp-validation-for="AmountToCollect" class="text-danger small"></span>
                    </div>

                    <div class="form-check form-switch mb-0 p-3 bg-light rounded border">
                        <input class="form-check-input ms-0" type="checkbox" asp-for="ShowPrice" role="switch" id="showPriceSwitch">
                        <label class="form-check-label ms-2 fw-medium" asp-for="ShowPrice" for="showPriceSwitch">
                            Hiển thị giá trên phiếu
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            const $showPriceSwitch = $('#showPriceSwitch');
            const $surchargeInput = $('#surchargeInput');
            const $amountToCollectInput = $('#amountToCollectInput');
            const $calculationInfo = $('#calculationInfo');
            const $selectedTotalContainer = $('#selectedTotalContainer');
            const $selectedTotalText = $('#selectedTotalText');

            const $breakdownItems = $('#breakdown-items');
            const $breakdownSurcharge = $('#breakdown-surcharge');
            const $breakdownTotal = $('#breakdown-total');

            const $moneySummary = $('#moneySummary');
            const $productsPrice = $('#productsPrice');

            function formatCurrency(amount, withSymbol) {
                if (withSymbol)
                    return DecimalFields.formatCurrencyWithSymbol(amount);
                return DecimalFields.formatCurrency(amount);
            }

            function calculateAmount() {
                let totalSelected = 0;
                $('.item-row').each(function() {
                    const isSelected = $(this).find('.item-checkbox').is(':checked');
                    if (isSelected) {
                        const qty = parseFloat(DecimalFields.stripFormatting($(this).find('.quantity-input').val(), 2)) || 0;
                        const price = parseFloat($(this).find('.item-price').val()) || 0;
                        totalSelected += qty * price;
                    }
                });

                const surcharge = parseFloat(DecimalFields.stripFormatting($surchargeInput.val())) || 0;
                const showPrice = $showPriceSwitch.is(':checked');

                let amountToCollect = surcharge;
                let infoText = 'Tự động tính theo phụ phí';

                if (showPrice) {
                    amountToCollect = totalSelected + surcharge;
                    infoText = `Tổng tiền hàng (${formatCurrency(totalSelected, true)}) + Phụ phí (${formatCurrency(surcharge, true)})`;
                    $selectedTotalContainer.show();
                    $selectedTotalText.text(formatCurrency(totalSelected, true));
                    $productsPrice.removeClass('d-none');
                } else {
                    $selectedTotalContainer.hide();
                    $productsPrice.addClass('d-none');
                }
                $moneySummary.toggleClass('d-none', amountToCollect <= 0);

                $amountToCollectInput.val(formatCurrency(amountToCollect));
                $calculationInfo.html(`<i class="bi bi-info-circle me-1"></i> ${infoText}`);

                // Update breakdown
                $breakdownItems.text(formatCurrency(totalSelected, true));
                $breakdownSurcharge.text(formatCurrency(surcharge, true));
                $breakdownTotal.text(formatCurrency(amountToCollect, true));
            }

            // Events
            $('#selectAll, .item-checkbox, .quantity-input, #surchargeInput, #showPriceSwitch').on('change input', function() {
                calculateAmount();
            });

            // Initial calculation
            calculateAmount();

            // Select all
            $('#selectAll').change(function() {
                var checked = $(this).is(':checked');
                $('.item-checkbox').prop('checked', checked);
                calculateAmount();
            });

            // Handle individual checkbox change to uncheck selectAll
            $('.item-checkbox').change(function() {
                var allChecked = $('.item-checkbox').length === $('.item-checkbox:checked').length;
                $('#selectAll').prop('checked', allChecked);
            });

            // Validation on submit
            $('#createDeliveryForm').submit(function(e) {
                var hasSelected = false;
                $('.item-checkbox:checked').each(function() {
                    hasSelected = true;
                    var row = $(this).closest('tr');
                    var qty = parseFloat(DecimalFields.stripFormatting(row.find('.quantity-input').val(), 2));
                    if (isNaN(qty) || qty <= 0) {
                        alert('Vui lòng nhập số lượng hợp lệ cho các mặt hàng được chọn.');
                        e.preventDefault();
                        return false; // break loop
                    }
                });

                if (!hasSelected) {
                    alert('Vui lòng chọn ít nhất một mặt hàng để xuất kho.');
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}
