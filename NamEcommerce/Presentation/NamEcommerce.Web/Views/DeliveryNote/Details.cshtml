@model DeliveryNoteDetailsModel
@{
    ViewData["Title"] = "Chi tiết phiếu xuất kho " + Model.Code;

    var statusTuple = Model.Status switch
    {
        (int)DeliveryNoteStatus.Draft => ("secondary", "Bản nháp", "bi-pencil"),
        (int)DeliveryNoteStatus.Confirmed => ("info text-white", "Đã xác nhận", "bi-check-all"),
        (int)DeliveryNoteStatus.Delivering => ("warning", "Đang giao", "bi-truck"),
        (int)DeliveryNoteStatus.Delivered => ("success", "Đã giao", "bi-check-circle-fill"),
        (int)DeliveryNoteStatus.Cancelled => ("danger", "Đã hủy", "bi-x-circle"),
        _ => ("secondary", "Không rõ", "bi-question-circle")
    };
    var isDirectShip = Model.SourceType == (int)DeliveryNoteSourceType.DirectShipToCustomer;
    var deliveryProofPictureSrc = string.IsNullOrWhiteSpace(Model.DeliveryProofPictureUrl)
        ? null
        : Model.DeliveryProofPictureUrl.StartsWith("data:", StringComparison.OrdinalIgnoreCase)
            ? Model.DeliveryProofPictureUrl
            : $"data:image/jpeg;base64,{Model.DeliveryProofPictureUrl}";
}

@if (isDirectShip)
{
    <div class="alert alert-info d-flex align-items-center gap-2 mb-3" role="alert">
        <i class="bi bi-truck fs-5"></i>
        <div>
            <strong>Phiếu giao thẳng tới khách</strong>
            @{
                var dsStatusText = ((DeliveryNoteStatus)Model.Status) switch
                {
                    DeliveryNoteStatus.Confirmed => " · Chờ khách xác nhận",
                    DeliveryNoteStatus.Delivered => " · Khách đã nhận",
                    DeliveryNoteStatus.Cancelled => " · Khách từ chối/hủy",
                    _ => ""
                };
            }
            @dsStatusText
        </div>
    </div>
}

<div class="page-header">
    <div>
        <h1 class="page-header-title d-flex align-items-center gap-2">
            @Model.Code
            <span class="status-badge @statusTuple.Item1"><i class="bi @statusTuple.Item3"></i>@Model.StatusName</span>
        </h1>
        <p class="page-header-subtitle">
            <a asp-action="List" class="text-decoration-none text-muted"><i class="bi bi-arrow-left me-1"></i>Trở về danh sách</a>
        </p>
    </div>
    <div class="d-flex gap-2">
        @if (!isDirectShip && Model.Status == (int)DeliveryNoteStatus.Draft)
        {
            <button type="button" class="btn btn-outline-primary btn-confirm" data-testid="delivery-confirm" data-id="@Model.Id">
                <i class="bi bi-check-all me-1"></i>Xuất hàng
            </button>
        }
        @if (!isDirectShip && Model.Status == (int)DeliveryNoteStatus.Confirmed)
        {
            <button type="button" class="btn btn-outline-secondary btn-delivering" data-testid="delivery-mark-delivering" data-id="@Model.Id">
                <i class="bi bi-truck me-1"></i>Đang giao
            </button>
        }
        @if (Model.Status == (int)DeliveryNoteStatus.Delivering || Model.Status == (int)DeliveryNoteStatus.Confirmed)
        {
            <button type="button" class="btn btn-outline-success btn-delivered" data-testid="delivery-mark-delivered-open" data-id="@Model.Id">
                <i class="bi bi-check-circle-fill me-1"></i>Đã giao
            </button>
        }
        @if (Model.Status != (int)DeliveryNoteStatus.Delivered && Model.Status != (int)DeliveryNoteStatus.Cancelled)
        {
            if (isDirectShip)
            {
                <button type="button" class="btn btn-outline-danger btn-customer-reject" data-id="@Model.Id" data-code="@Model.Code">
                    <i class="bi bi-person-fill-x me-1"></i>Từ chối
                </button>
            }
            else
            {
                <button type="button" class="btn btn-outline-danger btn-cancel" data-id="@Model.Id">
                    <i class="bi bi-x-circle me-1"></i>Hủy phiếu
                </button>
            }
        }
        <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="btn btn-primary d-flex align-items-center">
            <i class="bi bi-printer me-2"></i> In phiếu
        </a>
        <a asp-controller="CustomerReturn" asp-action="Create"
           asp-route-deliveryNoteId="@Model.Id"
           asp-route-customerId="@Model.CustomerId"
           class="btn btn-outline-secondary d-flex align-items-center">
            <i class="bi bi-arrow-return-left me-2"></i> Tạo phiếu trả
        </a>
    </div>
</div>

@if (Model.ShortageInfo.HasShortage)
{
    var shortageNoticeViewData = new ViewDataDictionary(ViewData)
    {
        ["ShortageModalId"] = "deliveryNoteShortageModal",
        ["ShortageMessage"] = $"Phiếu xuất có {Model.ShortageInfo.Items.Count} mặt hàng chưa đủ tồn kho. Cần nhập thêm hàng từ nhà cung cấp trước khi xác nhận xuất.",
        ["ShortageActionUrl"] = $"/PurchaseOrder/ShortageAggregation?deliveryNoteId={Model.Id}",
        ["ShortageActionText"] = "Nhập hàng thiếu",
        ["ShortagePrimaryQuantityLabel"] = "Cần xuất",
        ["ShortageSecondaryQuantityLabel"] = "Tồn khả dụng",
        ["ShortageUseShippedQuantity"] = false
    };
    @await Html.PartialAsync("_ShortageNotice", Model.ShortageInfo, shortageNoticeViewData)
}

<div class="row g-3">
    <div class="col-lg-4 order-lg-2">
        <div class="content-card mb-4 h-100">
            <div class="card-header bg-white border-bottom-0 pt-4 px-4 pb-0">
                <h5 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2 text-primary"></i>Thông tin phiếu</h5>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Khách hàng</label>
                    <div class="fw-bold text-dark fs-6">@Model.CustomerName</div>
                    <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@Model.CustomerPhone</div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Đơn hàng tham chiếu</label>
                    <div><a asp-controller="Order" asp-action="Details" asp-route-id="@Model.OrderId" class="fw-bold text-decoration-none">@Model.OrderCode</a></div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Ngày lập</label>
                    <div class="text-dark">@Model.CreatedOnUtc.ToLocalTime().ToString(ViewConstants.DefaultDateTimeFormat)</div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Kho xuất hàng</label>
                    <div class="text-dark">@Model.WarehouseName</div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Địa chỉ giao hàng</label>
                    <div class="text-dark">@Model.ShippingAddress</div>
                </div>

                <hr class="border-light my-4">

                @if (Model.ShowPrice || Model.AmountToCollect > 0 || Model.Surcharge > 0)
                {
                    <div class="financial-summary-sidebar mb-4 p-3 rounded-3" style="background: linear-gradient(145deg, #f8f9fa 0%, #ffffff 100%); border: 1px solid #edf2f9;">
                        <h6 class="fw-bold mb-3 small text-muted text-uppercase">Tóm tắt thanh toán</h6>

                        @if (Model.ShowPrice)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted small">Tiền hàng:</span>
                                <span class="fw-bold small">@Model.TotalAmount.DisplayCurrencyWithSymbol()</span>
                            </div>
                        }
                        @if (Model.Surcharge > 0)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted small">Phụ phí:</span>
                                <div class="text-end">
                                    <span class="fw-bold small">@Model.Surcharge.DisplayCurrencyWithSymbol()</span>
                                    @if (!string.IsNullOrEmpty(Model.SurchargeReason))
                                    {
                                        <div class="text-muted x-small">(@Model.SurchargeReason)</div>
                                    }
                                </div>
                            </div>
                        }
                        @if (Model.AmountToCollect > 0)
                        {
                            <div class="d-flex justify-content-between mt-3 pt-3 border-top">
                                <span class="text-primary fw-bold small">TỔNG THU:</span>
                                <span class="text-primary fw-bold fs-5">@Model.AmountToCollect.DisplayCurrencyWithSymbol()</span>
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-muted text-uppercase mb-1">Ghi chú</label>
                        <div class="text-dark bg-light p-2 rounded border">@Model.Note</div>
                    </div>
                }
                @if (Model.Status == 40 && Model.DeliveredOnUtc.HasValue)
                {
                    <hr class="border-light my-4">

                    <h6 class="fw-bold mb-3"><i class="bi bi-check-circle-fill text-success me-2"></i>Thông tin nhận hàng</h6>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase mb-1">Đã giao lúc</label>
                        <div class="text-dark">@Model.DeliveredOnUtc.Value.ToLocalTime().ToString(ViewConstants.DefaultDateTimeFormat)</div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.DeliveryReceiverName))
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-1">Người nhận</label>
                            <div class="text-dark fw-bold">@Model.DeliveryReceiverName</div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(deliveryProofPictureSrc))
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-2">Bằng chứng giao hàng</label>
                            <div>
                                <a href="#" data-bs-toggle="modal" data-bs-target="#imageModal">
                                    <img src="@deliveryProofPictureSrc" class="img-fluid rounded border shadow-sm" style="max-height: 120px; object-fit: cover; " alt="Bằng chứng" />
                                </a>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8 order-lg-1">
        <div class="content-card mb-3 d-flex flex-column">
            <div class="card-header bg-white border-bottom-0 pt-4 px-4 pb-0">
                <h5 class="mb-0 fw-bold"><i class="bi bi-box-seam me-2 text-primary"></i>Danh sách hàng hóa</h5>
            </div>
            @{
                var hasReturned = Model.Items.Any(i => i.ReturnedQuantity > 0 || i.PendingReturnQuantity > 0);
            }
            <div class="card-body p-0 mt-3 flex-grow-1">
                <div class="table-responsive">
                    <table class="table data-table mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4" style="width: 50px;">#</th>
                                <th>Tên hàng hóa</th>
                                <th class="text-end">Số lượng</th>
                                @if (hasReturned)
                                {
                                    <th class="text-end" style="width: 110px;" data-bs-toggle="tooltip" title="Số lượng đã được khách trả (Confirmed)">Đã trả</th>
                                }
                                @if (Model.ShowPrice)
                                {
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end pe-4">Thành tiền</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items.Any())
                            {
                                int idx = 1;
                                foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="ps-4">@(idx++)</td>
                                        <td class="fw-medium text-dark">@item.ProductName</td>
                                        <td class="text-end fw-bold">@item.Quantity.DisplayQuantity()</td>
                                        @if (hasReturned)
                                        {
                                            <td class="text-end">
                                                @if (item.ReturnedQuantity <= 0 && item.PendingReturnQuantity <= 0)
                                                {
                                                    <span class="text-muted small">—</span>
                                                }
                                                else
                                                {
                                                    if (item.ReturnedQuantity >= item.Quantity)
                                                    {
                                                        <span class="status-badge danger small" data-bs-toggle="tooltip" title="Toàn bộ đã trả">
                                                            <i class="bi bi-arrow-return-left"></i> @item.ReturnedQuantity.DisplayQuantity()
                                                        </span>
                                                    }
                                                    else if (item.ReturnedQuantity > 0)
                                                    {
                                                        <span class="status-badge warning small" data-bs-toggle="tooltip" title="Đã trả một phần">
                                                            @item.ReturnedQuantity.DisplayQuantity()
                                                        </span>
                                                    }
                                                    if (item.PendingReturnQuantity > 0)
                                                    {
                                                        <div class="small text-info mt-1" data-bs-toggle="tooltip" title="Đang chờ xác nhận (Draft/Inspecting)">
                                                            <i class="bi bi-hourglass-split"></i> @item.PendingReturnQuantity.DisplayQuantity()
                                                        </div>
                                                    }
                                                }
                                            </td>
                                        }
                                        @if (Model.ShowPrice)
                                        {
                                            <td class="text-end text-muted">@item.UnitPrice.DisplayCurrencyWithSymbol()</td>
                                            <td class="text-end pe-4 fw-bold text-primary">@item.SubTotal.DisplayCurrencyWithSymbol()</td>
                                        }
                                    </tr>
                                }
                                // Cột: # | Name | Qty | (hasReturned: Returned) | (ShowPrice: Price | SubTotal)
                                // Label colspan = total - 1 (chừa cột cuối cho value)
                                var summaryLabelColspan = 2 + (hasReturned ? 1 : 0) + (Model.ShowPrice ? 2 : 0);
                                @if (Model.ShowPrice)
                                {
                                    <tr class="bg-light border-top">
                                        <td colspan="@summaryLabelColspan" class="text-end py-2 text-dark small">TỔNG TIỀN HÀNG:</td>
                                        <td class="text-end pe-4 py-2 fw-bold">@Model.TotalAmount.DisplayCurrencyWithSymbol()</td>
                                    </tr>
                                }
                                @if (Model.Surcharge > 0)
                                {
                                    <tr class="bg-light border-top">
                                        <td colspan="@summaryLabelColspan" class="text-end py-2 text-dark small">
                                            PHỤ PHÍ:
                                            @if (!string.IsNullOrEmpty(Model.SurchargeReason))
                                            {
                                                <div class="text-muted fw-normal x-small mt-1">(@Model.SurchargeReason)</div>
                                            }
                                        </td>
                                        <td class="text-end pe-4 py-2 fw-bold">@Model.Surcharge.DisplayCurrencyWithSymbol()</td>
                                    </tr>
                                }
                                @if (Model.AmountToCollect > 0)
                                {
                                    <tr class="fw-bold bg-light border-top border-2">
                                        <td colspan="@summaryLabelColspan" class="text-end py-3 text-dark">SỐ TIỀN PHẢI THU:</td>
                                        <td class="text-end pe-4 py-3 fs-5 text-primary">@Model.AmountToCollect.DisplayCurrencyWithSymbol()</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@(3 + (hasReturned ? 1 : 0) + (Model.ShowPrice ? 2 : 0))" class="text-center py-4">
                                        Không có hàng hóa
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="content-card" id="customerReturnsCard" data-delivery-note-id="@Model.Id">
            <div class="card-header bg-white border-bottom-0 pt-4 px-4 pb-0 d-flex align-items-center justify-content-between">
                <h5 class="mb-0 fw-bold"><i class="bi bi-arrow-return-left me-2 text-warning"></i>Khách trả hàng</h5>
                <a asp-controller="CustomerReturn" asp-action="Create"
                   asp-route-deliveryNoteId="@Model.Id"
                   asp-route-customerId="@Model.CustomerId"
                   class="btn btn-sm btn-outline-warning">
                    <i class="bi bi-plus-lg me-1"></i>Tạo phiếu trả
                </a>
            </div>
            <div class="card-body p-0">
                <div id="customerReturnsLoading" class="px-4 py-3 text-center text-muted small">
                    <span class="spinner-border spinner-border-sm me-1"></span>Đang tải...
                </div>
                <div id="customerReturnsEmpty" class="d-none px-4 py-3 text-center text-muted small fst-italic">
                    — Chưa có phiếu trả hàng nào liên kết
                </div>
                <div id="customerReturnsList" class="d-none">
                    <table class="table data-table mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Mã phiếu</th>
                                <th>Ngày trả</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-end">Số mặt hàng</th>
                                <th class="text-end pe-4">Tổng giá trị</th>
                            </tr>
                        </thead>
                        <tbody id="customerReturnsTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Image Modal -->
@if (!string.IsNullOrEmpty(deliveryProofPictureSrc))
{
    <div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Bằng chứng giao hàng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <img src="@deliveryProofPictureSrc" class="img-fluid rounded shadow-sm" alt="Bằng chứng giao hàng" />
                </div>
            </div>
        </div>
    </div>
}

@if (Model.Status == (int)DeliveryNoteStatus.Confirmed || Model.Status == (int)DeliveryNoteStatus.Delivering)
{
    <partial name="_DeliveryNote.ConfirmDelivered" />
    <partial name="_DeliveryNote.ConfirmReject" model="Model.AvailableWarehouses" />

}

<div class="modal fade" id="shortageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title">Thiếu hàng để xuất kho</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="shortage-alert-panel mb-3">
                    <div class="shortage-alert-content">
                        <span class="shortage-alert-icon">
                            <i class="bi bi-exclamation-triangle"></i>
                        </span>
                        <div class="shortage-alert-message">Phiếu xuất chưa thể xác nhận vì tồn khả dụng không đủ.</div>
                    </div>
                </div>
                <div id="shortageModalItems" class="shortage-modal-list small">
                    @foreach (var item in Model.ShortageInfo.Items)
                    {
                        <div class="shortage-modal-item">
                            <span class="fw-semibold text-dark">@item.ProductName</span>
                            <strong class="shortage-danger">@item.ShortageQuantity.DisplayQuantity()</strong>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                <a class="btn shortage-action-btn" id="shortageAggregationLink" href="/PurchaseOrder/ShortageAggregation?deliveryNoteId=@Model.Id">
                    <i class="bi bi-truck"></i>Nhập hàng thiếu
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" defer>
        import DeliveryNoteController from '/modules/DeliveryNoteController.js';

        const deliveryNoteController = new DeliveryNoteController({ hidePageLoadOnRequestEnd: false });

        $(document).ready(function () {
            // Confirm
            $('.btn-confirm').click(async function(e) {
                e.preventDefault();
                var id = $(this).data('id');
                var result = await deliveryNoteController.confirm(id);
                if (result?.success)
                    location.reload();
                else if (result && result.shortageItems && result.shortageItems.length)
                    showShortageModal(result);
            });

            // Mark Delivering
            $('.btn-delivering').click(async function(e) {
                e.preventDefault();
                var id = $(this).data('id');
                var result = await deliveryNoteController.delivering(id);
                if (result?.success)
                    location.reload();
            });

            // Cancel
            $('.btn-cancel').click(async function(e) {
                e.preventDefault();
                var id = $(this).data('id');
                var result = await deliveryNoteController.cancel(id);
                if (result?.success)
                    location.reload();
            });

            $('.btn-customer-reject').click(async function(e) {
                e.preventDefault();
                var {id, code} = this.dataset;
                deliveryNoteController.beginRejectWorkflow('rejectDeliveryNoteModal').setData(id, code);
            });


            // Mark Delivered Flow
            $('.btn-delivered').click(function(e) {
                e.preventDefault();
                deliveryNoteController.beginDeliveredWorkflow('markDeliveredModal').setId('@Model.Id');
            });


            // ── Tải danh sách phiếu trả hàng ────────────────────────────────
            function showShortageModal(res) {
                const itemsEl = document.getElementById('shortageModalItems');
                const linkEl = document.getElementById('shortageAggregationLink');
                const escapeHtml = value => String(value ?? '').replace(/[&<>"']/g, char => ({
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#039;'
                }[char]));
                if (linkEl && res.aggregationUrl) linkEl.href = res.aggregationUrl;
                itemsEl.innerHTML = res.shortageItems.map(item =>
                    '<div class="shortage-modal-item">' +
                    '<span class="fw-semibold text-dark">' + escapeHtml(item.productName) + '</span>' +
                    '<strong class="shortage-danger">' + Number(item.shortageQuantity || 0).toLocaleString('vi-VN') + '</strong>' +
                    '</div>').join('');
                new bootstrap.Modal(document.getElementById('shortageModal')).show();
            }

            (function loadCustomerReturns() {
                const card = document.getElementById('customerReturnsCard');
                if (!card) return;
                const noteId = card.dataset.deliveryNoteId;
                const loadingEl = document.getElementById('customerReturnsLoading');
                const emptyEl = document.getElementById('customerReturnsEmpty');
                const listEl = document.getElementById('customerReturnsList');
                const tbody = document.getElementById('customerReturnsTableBody');

                fetch('/CustomerReturn/GetByDeliveryNote?deliveryNoteId=' + noteId)
                    .then(r => r.json())
                    .then(function(returns) {
                        loadingEl.classList.add('d-none');
                        if (!returns || returns.length === 0) {
                            emptyEl.classList.remove('d-none');
                            return;
                        }
                        returns.forEach(function(ret) {
                            console.log(ret);
                            var tr = document.createElement('tr');
                            tr.innerHTML =
                                '<td class="ps-4"><a href="/CustomerReturn/Details/' + ret.id + '" class="fw-medium text-decoration-none">' + ret.code + '</a></td>' +
                                '<td class="text-muted small">' + ret.returnDate + '</td>' +
                                '<td class="text-center"><span class="badge bg-' + ret.statusColor + '">' + ret.statusLabel + '</span></td>' +
                                '<td class="text-end text-muted small">' + ret.itemCount + '</td>' +
                                '<td class="text-end pe-4 fw-semibold">' + ret.totalAmount.toLocaleString('vi-VN') + 'đ</td>';
                            tbody.appendChild(tr);
                        });
                        listEl.classList.remove('d-none');
                    })
                    .catch(function() {
                        loadingEl.classList.add('d-none');
                        emptyEl.textContent = 'Không thể tải dữ liệu phiếu trả.';
                        emptyEl.classList.remove('d-none');
                    });
            })();

            async function updateDecimalFields(form, formData) {
                const decimalFields = form.querySelectorAll('.decimal-input');
                for (const decimalField of decimalFields) {
                    const decimals = Number(decimalField.dataset.decimals) ?? 0;
                    formData.set(decimalField.name, DecimalFields.stripFormatting(decimalField.value, decimals))
                }
            }
        });
    </script>
}
