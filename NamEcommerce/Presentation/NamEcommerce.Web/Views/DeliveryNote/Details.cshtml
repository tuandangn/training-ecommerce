@model DeliveryNoteDetailsModel
@{
    ViewData["Title"] = "Chi tiết phiếu xuất kho " + Model.Code;

    var statusTuple = Model.Status switch
    {
        (int)DeliveryNoteStatus.Draft => ("bg-secondary text-white", "Bản nháp", "bi-pencil"),
        (int)DeliveryNoteStatus.Confirmed => ("bg-info text-white", "Đã xác nhận", "bi-check-all"),
        (int)DeliveryNoteStatus.Delivering => ("bg-warning text-white", "Đang giao", "bi-truck"),
        (int)DeliveryNoteStatus.Delivered => ("bg-success text-white", "Đã giao", "bi-check-circle-fill"),
        (int)DeliveryNoteStatus.Cancelled => ("bg-danger text-white", "Đã hủy", "bi-x-circle"),
        _ => ("bg-secondary text-white", "Không rõ", "bi-question-circle")
    };
    var isDirectShip = Model.SourceType == (int)DeliveryNoteSourceType.DirectShipToCustomer;
    var isCounterPickup = string.Equals(TextHelper.Normalize("Tại cửa hàng"), TextHelper.Normalize(Model.ShippingAddress));
    var deliveryUserOptions = (Model.AvailableDeliveryUsers?.Options ?? Enumerable.Empty<EntityOptionListModel.EntityOptionModel>()).ToList();
    var hasDeliveryUsers = deliveryUserOptions.Any();
    var canAssignDeliveryUser = !isDirectShip
        && Model.Status != (int)DeliveryNoteStatus.Delivered
        && Model.Status != (int)DeliveryNoteStatus.Cancelled;
    var canLeaveWarehouse = isDirectShip || isCounterPickup;
    var canOpenDeliveredWorkflow = Model.Status == (int)DeliveryNoteStatus.Delivering && canLeaveWarehouse;
    var canUpdateShippingInfo = Model.Status != (int)DeliveryNoteStatus.Delivered
        && Model.Status != (int)DeliveryNoteStatus.Cancelled;
    var isDeliveryUserAssigned = !string.IsNullOrWhiteSpace(Model.AssignedDeliveryFullName);
    var deliveryProofPictureSrc = string.IsNullOrWhiteSpace(Model.DeliveryProofPictureUrl)
        ? null
        : Model.DeliveryProofPictureUrl.StartsWith("data:", StringComparison.OrdinalIgnoreCase)
            ? Model.DeliveryProofPictureUrl
            : $"data:image/jpeg;base64,{Model.DeliveryProofPictureUrl}";
    var hasDeliveryCompletionInfo = Model.DeliveredOnUtc.HasValue
        || !string.IsNullOrWhiteSpace(Model.DeliveryReceiverName)
        || Model.DeliveryLatitude.HasValue
        || Model.DeliveryLongitude.HasValue
        || !string.IsNullOrWhiteSpace(Model.DeliveryCompletionNote)
        || !string.IsNullOrWhiteSpace(Model.DeliveryCompletionSource)
        || Model.DeliveryCashCollectedAmount.HasValue
        || !string.IsNullOrWhiteSpace(deliveryProofPictureSrc);
}
@section TitleSection {
    <h1 class="topbar-page-title">
        Phiếu xuất kho
        <span class="text-muted">@Model.Code</span>
        <span class="text-muted small d-none d-md-inline">
            <span class="status-badge @statusTuple.Item1">
                @Model.StatusName
            </span>
        </span>
    </h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="List" asp-controller="DeliveryNote" class="text-decoration-none">Phiếu xuất kho</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Code</li>
            </ol>
        </nav>
    </div>
}
@if (isDirectShip || Model.ShortageInfo.HasShortage)
{
    <div class="content-card mb-3">
        @if (isDirectShip)
        {
            <div class="alert alert-info d-flex align-items-center gap-2 mb-0" role="alert">
                <i class="bi bi-truck fs-5"></i>
                <div>
                    <strong>Phiếu giao thẳng tới khách</strong>
                    @{
                        var dsStatusText = ((DeliveryNoteStatus)Model.Status) switch
                        {
                            DeliveryNoteStatus.Confirmed => " · Chờ khách xác nhận",
                            DeliveryNoteStatus.Delivered => " · Khách đã nhận",
                            DeliveryNoteStatus.Cancelled => " · Khách từ chối/hủy",
                            _ => ""
                        };
                    }
                    @dsStatusText
                </div>
            </div>
        }
        @if (Model.ShortageInfo.HasShortage)
        {
            var shortageNoticeViewData = new ViewDataDictionary(ViewData)
            {
                ["ShortageModalId"] = "deliveryNoteShortageModal",
                ["ShortageMessage"] = $"Phiếu xuất có {Model.ShortageInfo.Items.Count} mặt hàng chưa đủ tồn kho. Cần nhập thêm hàng từ nhà cung cấp trước khi xác nhận xuất.",
                ["ShortageActionUrl"] = $"/PurchaseOrder/ShortageAggregation?deliveryNoteId={Model.Id}",
                ["ShortageActionText"] = "Nhập hàng thiếu",
                ["ShortagePrimaryQuantityLabel"] = "Cần xuất",
                ["ShortageSecondaryQuantityLabel"] = "Tồn khả dụng",
                ["ShortageUseShippedQuantity"] = false
            };
            <div class="content-card-body">
                @await Html.PartialAsync("_ShortageNotice", Model.ShortageInfo, shortageNoticeViewData)
            </div>
        }
    </div>
}
@if (Model.SettlementApproval == 1)
{
    var canApproveSettlement = User.IsInRole(SystemUserRoleNames.Admin);
    var proposed = Model.ProposedAmountToCollect ?? Model.AmountToCollect;
    var rejectedValue = Model.SettlementItems.Where(i => i.RejectedQuantity > 0).Sum(i => i.RejectedQuantity * i.UnitPrice);
    <div class="content-card mb-3 border border-warning">
        <div class="content-card-header bg-warning-subtle">
            <h5 class="mb-0 text-warning-emphasis"><i class="bi bi-hourglass-split me-2"></i>Chờ duyệt thu hụt</h5>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Phải thu gốc (COD)</label>
                    <div class="fw-bold">@Model.AmountToCollect.DisplayCurrencyWithSymbol()</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Giá trị hàng trả về</label>
                    <div class="fw-bold text-danger">@rejectedValue.DisplayCurrencyWithSymbol()</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Số tự tính</label>
                    <div class="fw-bold text-primary">@proposed.DisplayCurrencyWithSymbol()</div>
                </div>
            </div>
            @if (Model.SettlementItems.Any(i => i.RejectedQuantity > 0))
            {
                <div class="table-responsive mb-3">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Hàng hóa</th>
                                <th class="text-end">SL giao</th>
                                <th class="text-end">Khách nhận</th>
                                <th class="text-end">Trả về</th>
                                <th>Lý do</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in Model.SettlementItems)
                            {
                                <tr>
                                    <td>@line.ProductName</td>
                                    <td class="text-end">@line.Quantity.DisplayQuantity()</td>
                                    <td class="text-end">@line.AcceptedQuantity.DisplayQuantity()</td>
                                    <td class="text-end @(line.RejectedQuantity > 0 ? "text-danger fw-bold" : "text-muted")">@line.RejectedQuantity.DisplayQuantity()</td>
                                    <td class="small text-muted">@line.RejectReason</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.SettlementReason))
            {
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Lý do người giao báo</label>
                    <div class="bg-light p-2 rounded border">@Model.SettlementReason</div>
                </div>
            }
            @if (canApproveSettlement)
            {
                <form asp-action="ApproveSettlement" method="post" class="border-top pt-3">
                    <input type="hidden" name="deliveryNoteId" value="@Model.Id" />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-1">Số tiền thu duyệt</label>
                            <input type="number" name="approvedAmountToCollect" class="form-control" min="0" step="1000" value="@proposed.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-1">Chi phí phát sinh</label>
                            <input type="number" name="agreedCustomerCharge" class="form-control" min="0" step="1000" value="0" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-1">Lý do chi phí</label>
                            <input type="text" name="agreedCustomerChargeReason" class="form-control" placeholder="Nếu có chi phí phát sinh" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-1">Ghi chú duyệt</label>
                            <input type="text" name="adminNote" class="form-control" placeholder="Ghi chú (tùy chọn)" />
                        </div>
                    </div>
                    <div class="small text-muted mt-2">Phần chênh lệch giữa số phải thu và số thu duyệt sẽ ghi thành công nợ khách.</div>
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-lg me-1"></i>Duyệt & cho thu
                        </button>
                    </div>
                </form>
                <form asp-action="RejectSettlement" method="post" class="border-top pt-3 mt-3"
                      onsubmit="return confirm('Từ chối sẽ hủy phiếu và yêu cầu mang hàng về kho. Tiếp tục?');">
                    <input type="hidden" name="deliveryNoteId" value="@Model.Id" />
                    <div class="input-group">
                        <input type="text" name="reason" class="form-control" placeholder="Lý do từ chối (mang hàng về)" required />
                        <button type="submit" class="btn btn-outline-danger">
                            <i class="bi bi-x-circle me-1"></i>Từ chối
                        </button>
                    </div>
                </form>
            }
            else
            {
                <div class="alert alert-info mb-0">Chỉ Admin mới được duyệt thu hụt.</div>
            }
        </div>
    </div>
}
else if (Model.SettlementApproval == 2 && Model.Status != (int)DeliveryNoteStatus.Delivered)
{
    <div class="content-card mb-3 border border-success">
        <div class="card-body d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div>
                <strong>Đã duyệt thu hụt</strong> — chờ người giao thu @((Model.ApprovedAmountToCollect ?? 0m).DisplayCurrencyWithSymbol()) và xác nhận đã giao.
            </div>
        </div>
    </div>
}
<div class="row g-3">
    <div class="col-lg-4 order-lg-2">
        <div class="content-card">
            <div class="content-card-header">
                <h5>Thông tin phiếu</h5>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Khách hàng</label>
                    <div class="fw-bold text-dark fs-6">@Model.CustomerName</div>
                    @if (!string.IsNullOrEmpty(Model.CustomerPhone))
                    {
                        <div class="text-muted small">
                            <i class="bi bi-telephone me-1"></i>@Model.CustomerPhone
                        </div>
                    }
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Đơn hàng tham chiếu</label>
                    <div><a asp-controller="Order" asp-action="Details" asp-route-id="@Model.OrderId" class="fw-bold text-decoration-none">@Model.OrderCode</a></div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Ngày lập</label>
                    <div class="text-dark">@Model.CreatedOnUtc.ToLocalTime().ToString(ViewConstants.DefaultDateTimeFormat)</div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Kho xuất hàng</label>
                    <div class="text-dark">@Model.WarehouseName</div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Người giao hàng</label>
                    @if (!string.IsNullOrWhiteSpace(Model.AssignedDeliveryFullName))
                    {
                        <div class="text-dark fw-bold">
                            <i class="bi bi-person-check me-1 text-muted"></i>@Model.AssignedDeliveryFullName
                        </div>
                        @if (Model.AssignedDeliveryOnUtc.HasValue)
                        {
                            <div class="text-muted small">@Model.AssignedDeliveryOnUtc.Value.ToLocalTime().ToString(ViewConstants.DefaultDateTimeFormat)</div>
                        }
                    }
                    else
                    {
                        <div class="text-dark">Chưa phân công</div>
                    }
                </div>
                @if (Model.DeliveryRunInfo != null)
                {
                    var runBadgeClass = Model.DeliveryRunInfo.Status switch
                    {
                        10 => "bg-secondary text-white",
                        20 => "bg-info text-white",
                        30 => "bg-warning text-white",
                        40 => "bg-success text-white",
                        _ => "bg-secondary text-white"
                    };
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-muted text-uppercase mb-1">Chuyến giao</label>
                        <div class="fw-bold">
                            <a asp-controller="DeliveryRun" asp-action="Details" asp-route-id="@Model.DeliveryRunInfo.Id" class="text-decoration-none">@Model.DeliveryRunInfo.Code</a>
                        </div>
                        <div class="small mt-1">
                            <span class="status-badge @runBadgeClass">@Model.DeliveryRunInfo.StatusName</span>
                        </div>
                        @if (Model.DeliveryRunInfo.HandedOverOnUtc.HasValue)
                        {
                            <div class="text-muted small mt-1">Bàn giao: @Model.DeliveryRunInfo.HandedOverOnUtc.Value.ToLocalTime().ToString(ViewConstants.DefaultDateTimeFormat)</div>
                        }
                    </div>
                }
                <div class="mb-4">
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                        <label class="form-label small fw-bold text-muted text-uppercase mb-0">Thông tin giao hàng</label>
                        @if (canUpdateShippingInfo)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#deliveryShippingModal">
                                <i class="bi bi-pencil-square me-1"></i>Sửa
                            </button>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.ShippingPhoneNumber))
                    {
                        <a href="tel:@Model.ShippingPhoneNumber" class="text-decoration-none small d-inline-block mb-1">
                            <i class="bi bi-telephone me-1"></i>@Model.ShippingPhoneNumber
                        </a>
                    }
                    <div class="text-dark">@Model.ShippingAddress</div>
                </div>

                <hr class="border-light my-4">

                @if (Model.ShowPrice || Model.Surcharge > 0 || Model.AmountToCollect > 0)
                {
                    <div class="financial-summary-sidebar deliverynote-financial-summary mb-4 p-3">
                        <h6 class="fw-bold mb-3 small text-muted text-uppercase">Tóm tắt thanh toán</h6>

                        @if (Model.ShowPrice)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted small">Tiền hàng:</span>
                                <span class="fw-bold small">@Model.TotalAmount.DisplayCurrencyWithSymbol()</span>
                            </div>
                        }
                        @if (Model.Surcharge > 0)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted small">
                                    Phụ phí:
                                    @if (!string.IsNullOrWhiteSpace(Model.SurchargeReason))
                                    {
                                        <span class="fw-normal fst-italic">(@Model.SurchargeReason)</span>
                                    }
                                </span>
                                <span class="fw-bold small">@Model.Surcharge.DisplayCurrencyWithSymbol()</span>
                            </div>
                        }
                        @if (Model.AmountToCollect > 0)
                        {
                            <div class="d-flex justify-content-between mt-3 pt-3 border-top">
                                <span class="text-primary fw-bold small">TỔNG THU:</span>
                                <span class="text-primary fw-bold fs-5">@Model.AmountToCollect.DisplayCurrencyWithSymbol()</span>
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-muted text-uppercase mb-1">Ghi chú</label>
                        <div class="text-dark bg-light p-2 rounded border">@Model.Note</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
                {
                    <hr class="border-light my-4">

                    <h6 class="fw-bold mb-3 text-danger"><i class="bi bi-x-circle-fill me-2"></i>Thông tin từ chối</h6>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted text-uppercase mb-1">Lý do từ chối</label>
                        <div class="text-dark bg-light p-2 rounded border">@Model.RejectionReason</div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.ReturnedToWarehouseName))
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-1">Hàng trả về kho</label>
                            <div class="text-dark fw-bold"><i class="bi bi-house-check me-1 text-muted"></i>@Model.ReturnedToWarehouseName</div>
                        </div>
                    }
                }

                @if (hasDeliveryCompletionInfo)
                {
                    <hr class="border-light my-4">

                    <h6 class="fw-bold mb-3"><i class="bi bi-check-circle-fill text-success me-2"></i>Thông tin nhận hàng</h6>

                    @if (Model.DeliveredOnUtc.HasValue)
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-1">Đã giao lúc</label>
                            <div class="text-dark">@Model.DeliveredOnUtc.Value.ToLocalTime().ToString(ViewConstants.DefaultDateTimeFormat)</div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.DeliveryReceiverName))
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-1">Người nhận</label>
                            <div class="text-dark fw-bold">@Model.DeliveryReceiverName</div>
                        </div>
                    }

                    @if (Model.DeliveryCashCollectedAmount.HasValue)
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-1">Tiền đã thu</label>
                            <div class="text-dark fw-bold">@Model.DeliveryCashCollectedAmount.Value.DisplayCurrencyWithSymbol()</div>
                        </div>
                    }

                    @if (Model.DeliveryLatitude.HasValue || Model.DeliveryLongitude.HasValue || !string.IsNullOrWhiteSpace(Model.DeliveryLocationAddress))
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-1">Vị trí giao</label>
                            @if (!string.IsNullOrWhiteSpace(Model.DeliveryLocationAddress))
                            {
                                <div class="text-dark">@Model.DeliveryLocationAddress</div>
                            }
                            @if (Model.DeliveryLatitude.HasValue && Model.DeliveryLongitude.HasValue)
                            {
                                <div class="small text-muted">@Model.DeliveryLatitude, @Model.DeliveryLongitude</div>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.DeliveryCompletionNote) || !string.IsNullOrWhiteSpace(Model.DeliveryCompletionSource))
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-1">Ghi nhận giao</label>
                            @if (!string.IsNullOrWhiteSpace(Model.DeliveryCompletionNote))
                            {
                                <div class="text-dark">@Model.DeliveryCompletionNote</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.DeliveryCompletionSource))
                            {
                                <div class="small text-muted">Nguồn: @Model.DeliveryCompletionSource</div>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(deliveryProofPictureSrc))
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-2">Bằng chứng giao hàng</label>
                            <div>
                                <a href="#" data-bs-toggle="modal" data-bs-target="#imageModal">
                                    <img src="@deliveryProofPictureSrc" class="img-fluid rounded border shadow-sm ui-max-h-120-cover" alt="Bằng chứng" />
                                </a>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
    <div class="col-lg-8 order-lg-1">
        <div class="content-card">
            @{
                var hasReturned = Model.Items.Any(i => i.ReturnedQuantity > 0 || i.PendingReturnQuantity > 0 || i.CompensatedReturnQuantity > 0);
                var compensatedReturnQuantity = Model.Items.Sum(i => i.CompensatedReturnQuantity);
            }
            @if (compensatedReturnQuantity > 0)
            {
                <div class="alert alert-warning small">
                    Có @compensatedReturnQuantity.DisplayQuantity() hàng khách trả đang được bù vào lần giao sau. Hàng chỉ nhập kho khi xác nhận phiếu trả.
                </div>
            }
                @if (Model.Status != (int)DeliveryNoteStatus.Delivered && Model.Status != (int)DeliveryNoteStatus.Cancelled)
                {
            <div class="action-toolbar justify-content-end">
                @if (!isDirectShip && Model.Status == (int)DeliveryNoteStatus.Draft)
                {
                    <button type="button" class="btn btn-primary btn-confirm btn-sm" data-testid="delivery-confirm" data-id="@Model.Id">
                        <i class="bi bi-check me-1"></i>Xác nhận
                    </button>
                }
                @if (!isDirectShip && Model.Status == (int)DeliveryNoteStatus.Confirmed)
                {
                    <button type="button" class="btn btn-outline-success btn-delivering btn-sm" data-testid="delivery-mark-delivering" data-id="@Model.Id" disabled="@canLeaveWarehouse">
                        <i class="bi bi-truck me-1"></i>Đang giao
                    </button>
                }
                @if (Model.Status == (int)DeliveryNoteStatus.Delivering || Model.Status == (int)DeliveryNoteStatus.Confirmed)
                {
                    <button type="button" class="btn btn-primary btn-delivered btn-sm" data-testid="delivery-mark-delivered-open" data-id="@Model.Id" disabled="@canOpenDeliveredWorkflow">
                        <i class="bi bi-check-circle-fill me-1"></i>Đã giao
                    </button>
                }
                    @if (isDirectShip)
                    {
                        <button type="button" class="btn btn-outline-danger btn-sm btn-customer-reject" data-id="@Model.Id" data-code="@Model.Code">
                            <i class="bi bi-person-fill-x me-1"></i>Từ chối
                        </button>
                    }
                </div>
            }
            <div class="content-card-header">
                <h5>Danh sách hàng hóa</h5>
            </div>
            <div class="content-card-body-flush">
                <div class="table-responsive">
                    <table class="table data-table mb-0">
                        <thead>
                            <tr>
                                <th class="ps-3">Tên hàng hóa</th>
                                <th>Kho</th>
                                <th class="text-end">Số lượng</th>
                                @if (hasReturned)
                                {
                                    <th class="text-end ui-w-110" data-bs-toggle="tooltip" title="Số lượng đã được khách trả (Confirmed)">Đã trả</th>
                                }
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end pe-4">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items.Any())
                            {
                                foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="fw-medium text-dark ps-3">@item.ProductName</td>
                                        <td class="text-muted small">@item.WarehouseName</td>
                                        <td class="text-end fw-bold">@item.Quantity.DisplayQuantity()</td>
                                        @if (hasReturned)
                                        {
                                            <td class="text-end">
                                                @if (item.ReturnedQuantity <= 0 && item.PendingReturnQuantity <= 0 && item.CompensatedReturnQuantity <= 0)
                                                {
                                                    <span class="text-muted small">—</span>
                                                }
                                                else
                                                {
                                                    if (item.ReturnedQuantity >= item.Quantity)
                                                    {
                                                        <span class="status-badge danger small" data-bs-toggle="tooltip" title="Toàn bộ đã trả">
                                                            <i class="bi bi-arrow-return-left"></i> @item.ReturnedQuantity.DisplayQuantity()
                                                        </span>
                                                    }
                                                    else if (item.ReturnedQuantity > 0)
                                                    {
                                                        <span class="status-badge warning small" data-bs-toggle="tooltip" title="Đã trả một phần">
                                                            @item.ReturnedQuantity.DisplayQuantity()
                                                        </span>
                                                    }
                                                    if (item.PendingReturnQuantity > 0)
                                                    {
                                                        <div class="small text-info mt-1" data-bs-toggle="tooltip" title="Đang chờ xác nhận (Draft/Inspecting)">
                                                            <i class="bi bi-hourglass-split"></i> @item.PendingReturnQuantity.DisplayQuantity()
                                                        </div>
                                                    }
                                                    if (item.CompensatedReturnQuantity > 0)
                                                    {
                                                        <div class="small text-warning mt-1" data-bs-toggle="tooltip" title="Duoc cong vao lan giao sau">
                                                            <i class="bi bi-arrow-repeat"></i> @item.CompensatedReturnQuantity.DisplayQuantity()
                                                        </div>
                                                    }
                                                }
                                            </td>
                                        }
                                        <td class="text-end align-middle">@item.UnitPrice.DisplayCurrency()</td>
                                        <td class="text-end fw-bold text-primary row-total text-nowrap d-none d-lg-table-cell align-middle">@item.SubTotal.DisplayCurrencyWithSymbol()</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@(3 + (hasReturned ? 1 : 0))" class="text-center py-4">
                                        Không có hàng hóa
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="content-card-footer bg-white py-2 mb-3">
                <div class="order-summary" id="tableFooter">
                    <div class="order-summary-row">
                        <span class="label">Tổng tiền hàng</span>
                        <span class="value" id="subTotal">@Model.TotalAmount.DisplayCurrencyWithSymbol()</span>
                    </div>
                    <div class="order-summary-row total">
                        <span class="label">Tổng cộng</span>
                        <span class="value">
                            <span id="grandTotal">@Model.TotalAmount.DisplayCurrencyWithSymbol()</span>
                        </span>
                    </div>
                    <div class="currency-hint text-end visible" id="grandTotalHint">
                        @if (Model.TotalAmount > 0)
                        {
                            @Model.TotalAmount.DisplayVietnameseCurrencyHint()
                        }
                    </div>
                </div>
            </div>
            <div class="content-card-footer d-flex align-items-center justify-content-between">
                <a asp-action="List" class="btn btn-outline-secondary text-decoration-none btn-sm">
                    <i class="bi bi-arrow-left"></i>
                    Trở về
                </a>
                <div class="d-flex gap-2">
                    @if (Model.Status == (int)DeliveryNoteStatus.Delivered)
                    {
                        <a asp-controller="CustomerReturn" asp-action="Create" asp-route-deliveryNoteId="@Model.Id" asp-route-customerId="@Model.CustomerId" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-plus-lg me-1"></i>Tạo phiếu trả
                        </a>
                    }
                    @if (Model.Status != (int)DeliveryNoteStatus.Delivered && Model.Status != (int)DeliveryNoteStatus.Cancelled)
                    {
                        if (!isDirectShip)
                        {
                            <button type="button" class="btn btn-outline-danger btn-cancel btn-sm" data-id="@Model.Id">
                                <i class="bi bi-x-circle me-1"></i>Hủy phiếu
                            </button>
                        }
                    }
                    @if (Model.Status != (int)DeliveryNoteStatus.Cancelled && Model.Status != (int)DeliveryNoteStatus.Draft)
                    {
                        <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-printer me-2"></i> In phiếu
                        </a>
                    }
                    <div>
                    </div>
                </div>
            </div>
        </div>
        @if (Model.Status == (int)DeliveryNoteStatus.Delivered)
        {
            <div class="content-card mt-3" id="customerReturnsCard" data-delivery-note-id="@Model.Id">
                <div class="content-card-header">
                    <h5>Khách trả hàng</h5>
                </div>
                <div class="content-card-body-flush">
                    <div id="customerReturnsLoading" class="px-4 py-3 text-center text-muted small">
                        <span class="spinner-border spinner-border-sm me-1"></span>Đang tải...
                    </div>
                    <div id="customerReturnsEmpty" class="d-none px-4 py-3 text-center text-muted small fst-italic">
                        Chưa có phiếu trả hàng nào liên kết
                    </div>
                    <div id="customerReturnsList" class="d-none">
                        <table class="table data-table mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4">Mã phiếu</th>
                                    <th>Ngày trả</th>
                                    <th class="text-center">Trạng thái</th>
                                    <th class="text-end">Số mặt hàng</th>
                                    <th class="text-end pe-4">Tổng giá trị</th>
                                </tr>
                            </thead>
                            <tbody id="customerReturnsTableBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
@if (canUpdateShippingInfo)
{
    <div class="modal fade" id="deliveryShippingModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content deliverynote-modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Cập nhật giao hàng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-action="UpdateShipping">
                    <div class="modal-body py-3">
                        <input type="hidden" name="deliveryNoteId" value="@Model.Id" />
                        <div class="mb-3">
                            <label for="deliveryShippingPhoneNumber" class="form-label">Số điện thoại giao hàng</label>
                            <input id="deliveryShippingPhoneNumber" name="shippingPhoneNumber" class="form-control" value="@Model.ShippingPhoneNumber" required maxlength="50" />
                        </div>
                        <div class="mb-0">
                            <label for="deliveryShippingAddress" class="form-label">Địa chỉ giao hàng</label>
                            <textarea id="deliveryShippingAddress" name="shippingAddress" class="form-control" rows="3" required maxlength="1000">@Model.ShippingAddress</textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-floppy me-1"></i>Lưu lại
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
<!-- Image Modal -->
@if (!string.IsNullOrEmpty(deliveryProofPictureSrc))
{
    <div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content deliverynote-modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Bằng chứng giao hàng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <img src="@deliveryProofPictureSrc" class="img-fluid rounded shadow-sm" alt="Bằng chứng giao hàng" />
                </div>
            </div>
        </div>
    </div>
}

@if (Model.Status == (int)DeliveryNoteStatus.Confirmed || Model.Status == (int)DeliveryNoteStatus.Delivering)
{
    <partial name="_DeliveryNote.ConfirmDelivered" />
    <partial name="_DeliveryNote.ConfirmReject" model="Model.AvailableWarehouses" />
}

<div class="modal fade" id="shortageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content deliverynote-modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thiếu hàng để xuất kho</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="shortage-alert-panel mb-3">
                    <div class="shortage-alert-content">
                        <span class="shortage-alert-icon">
                            <i class="bi bi-exclamation-triangle"></i>
                        </span>
                        <div class="shortage-alert-message">Phiếu xuất chưa thể xác nhận vì tồn khả dụng không đủ.</div>
                    </div>
                </div>
                <div id="shortageModalItems" class="shortage-modal-list small">
                    @foreach (var item in Model.ShortageInfo.Items)
                    {
                        <div class="shortage-modal-item">
                            <span class="fw-semibold text-dark">@item.ProductName</span>
                            <strong class="shortage-danger">@item.ShortageQuantity.DisplayQuantity()</strong>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                <a class="btn shortage-action-btn" id="shortageAggregationLink" href="/PurchaseOrder/ShortageAggregation?deliveryNoteId=@Model.Id">
                    <i class="bi bi-truck"></i>Nhập hàng thiếu
                </a>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/deliverynote-details.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" defer>
        import DeliveryNoteController from '/modules/DeliveryNoteController.js';

        const deliveryNoteController = new DeliveryNoteController({ hidePageLoadOnRequestEnd: false });

        $(document).ready(function () {
            // Confirm
            $('.btn-confirm').click(async function(e) {
                e.preventDefault();
                var id = $(this).data('id');
                var result = await deliveryNoteController.confirm(id);
                if (result?.success)
                    location.reload();
                else if (result && result.shortageItems && result.shortageItems.length)
                    showShortageModal(result);
            });

            // Mark Delivering
            $('.btn-delivering').click(async function(e) {
                e.preventDefault();
                var id = $(this).data('id');
                var result = await deliveryNoteController.delivering(id);
                if (result?.success)
                    location.reload();
            });

            // Cancel
            $('.btn-cancel').click(async function(e) {
                e.preventDefault();
                var id = $(this).data('id');
                var result = await deliveryNoteController.cancel(id);
                if (result?.success)
                    location.reload();
            });

            $('.btn-customer-reject').click(async function(e) {
                e.preventDefault();
                var {id, code} = this.dataset;
                deliveryNoteController.beginRejectWorkflow('rejectDeliveryNoteModal').setData(id, code);
            });


            // Mark Delivered Flow
            $('.btn-delivered').click(function(e) {
                e.preventDefault();
                var hasDeliveryUser = $(this).data('has-delivery-user') === 'true';
                if (hasDeliveryUser) {
                    if (!confirm('Phiếu đã được phân công người giao hàng. Bạn có chắc chắn muốn xác nhận đã giao không?')) {
                        return;
                    }
                }
                deliveryNoteController.beginDeliveredWorkflow('markDeliveredModal').setId('@Model.Id');
            });


            // ── Tải danh sách phiếu trả hàng ────────────────────────────────
            function showShortageModal(res) {
                const itemsEl = document.getElementById('shortageModalItems');
                const linkEl = document.getElementById('shortageAggregationLink');
                const escapeHtml = value => String(value ?? '').replace(/[&<>"']/g, char => ({
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#039;'
                }[char]));
                if (linkEl && res.aggregationUrl) linkEl.href = res.aggregationUrl;
                itemsEl.innerHTML = res.shortageItems.map(item =>
                    '<div class="shortage-modal-item">' +
                    '<span class="fw-semibold text-dark">' + escapeHtml(item.productName) + '</span>' +
                    '<strong class="shortage-danger">' + Number(item.shortageQuantity || 0).toLocaleString('vi-VN') + '</strong>' +
                    '</div>').join('');
                new bootstrap.Modal(document.getElementById('shortageModal')).show();
            }

            (function loadCustomerReturns() {
                const card = document.getElementById('customerReturnsCard');
                if (!card) return;
                const noteId = card.dataset.deliveryNoteId;
                const loadingEl = document.getElementById('customerReturnsLoading');
                const emptyEl = document.getElementById('customerReturnsEmpty');
                const listEl = document.getElementById('customerReturnsList');
                const tbody = document.getElementById('customerReturnsTableBody');

                fetch('/CustomerReturn/GetByDeliveryNote?deliveryNoteId=' + noteId)
                    .then(r => r.json())
                    .then(function(returns) {
                        loadingEl.classList.add('d-none');
                        if (!returns || returns.length === 0) {
                            emptyEl.classList.remove('d-none');
                            return;
                        }
                        returns.forEach(function(ret) {
                            var tr = document.createElement('tr');
                            tr.innerHTML =
                                '<td class="ps-4"><a href="/CustomerReturn/Details/' + ret.id + '" class="fw-medium text-decoration-none">' + ret.code + '</a></td>' +
                                '<td class="text-muted small">' + ret.returnDate + '</td>' +
                                '<td class="text-center"><span class="badge bg-' + ret.statusColor + '">' + ret.statusLabel + '</span></td>' +
                                '<td class="text-end text-muted small">' + ret.itemCount + '</td>' +
                                '<td class="text-end pe-4 fw-semibold">' + ret.totalAmount.toLocaleString('vi-VN') + 'đ</td>';
                            tbody.appendChild(tr);
                        });
                        listEl.classList.remove('d-none');
                    })
                    .catch(function() {
                        loadingEl.classList.add('d-none');
                        emptyEl.textContent = 'Không thể tải dữ liệu phiếu trả.';
                        emptyEl.classList.remove('d-none');
                    });
            })();

            async function updateDecimalFields(form, formData) {
                const decimalFields = form.querySelectorAll('.decimal-input');
                for (const decimalField of decimalFields) {
                    const decimals = Number(decimalField.dataset.decimals) ?? 0;
                    formData.set(decimalField.name, DecimalFields.stripFormatting(decimalField.value, decimals))
                }
            }
        });
    </script>
}
