@using NamEcommerce.Domain.Shared.Enums.StockAdjustment
@model NamEcommerce.Web.Contracts.Models.StockAdjustment.StockAdjustmentNoteModel
@{
    ViewData[ViewConstants.PageTitle] = $"Phiếu kiểm kê - {Model.Code}";

    var status = (StockAdjustmentStatus)Model.Status;
    var (badgeClass, badgeText) = status switch
    {
        StockAdjustmentStatus.Draft => ("bg-secondary", "Bản nháp"),
        StockAdjustmentStatus.Approved => ("bg-success", "Đã duyệt"),
        StockAdjustmentStatus.Cancelled => ("bg-danger", "Đã huỷ"),
        _ => ("bg-secondary", "—")
    };
}
@Html.AntiForgeryToken()
@section TitleSection {
    <h1 class="topbar-page-title">
        @Model.Code
        <span class="badge @badgeClass ms-2" style="font-size:.75rem;vertical-align:middle;">@badgeText</span>
    </h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="List" asp-controller="StockAdjustment" class="text-decoration-none">Kiểm kê tồn kho</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Code</li>
            </ol>
        </nav>
    </div>
}

<div class="row g-3">
    <!-- Cột trái: danh sách hàng hóa -->
    <div class="col-lg-8 order-1 order-lg-0">
        <div class="content-card">
            <div class="content-card-header">
                <h5 class="mb-0">
                    Danh sách hàng hóa kiểm kê
                    <span class="badge bg-light text-muted border ms-1" style="font-size:.72rem;font-weight:500;">
                        @Model.Items.Count mặt hàng
                    </span>
                </h5>
                @{
                    var totalDelta = Model.Items.Sum(i => i.Delta);
                }
                <span class="fw-semibold @(totalDelta > 0 ? "text-success" : totalDelta < 0 ? "text-danger" : "text-muted")">
                    @(totalDelta >= 0 ? "+" : "")@totalDelta.DisplayQuantity()
                </span>
            </div>
            <div class="content-card-body-flush">
                <div class="table-responsive">
                    <table class="table data-table mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Hàng hóa</th>
                                <th class="text-end" style="width:140px">SL hệ thống</th>
                                <th class="text-end" style="width:140px">SL thực tế</th>
                                <th class="text-end pe-4" style="width:120px">Chênh lệch</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr class="align-middle">
                                    <td class="ps-4">
                                        <div class="fw-medium">@item.ProductName</div>
                                    </td>
                                    <td class="text-end text-muted">@item.SystemQuantity.DisplayQuantity()</td>
                                    <td class="text-end fw-medium">@item.PhysicalQuantity.DisplayQuantity()</td>
                                    <td class="text-end pe-4 fw-semibold">
                                        @{
                                            var deltaClass = item.Delta > 0 ? "text-success" : item.Delta < 0 ? "text-danger" : "text-muted";
                                            var deltaSign = item.Delta >= 0 ? "+" : "";
                                        }
                                        <span class="@deltaClass">@deltaSign@item.Delta.DisplayQuantity()</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.Items.Count == 0)
                {
                    <div class="empty-state py-4">
                        <span class="text-muted">Phiếu kiểm kê không có hàng hóa nào.</span>
                    </div>
                }
            </div>
            <div class="content-card-footer py-2 d-flex align-items-center justify-content-between">
                <a asp-action="List" class="btn btn-link text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i>Trở về
                </a>
                <div class="d-flex gap-2">
                    @if (status == StockAdjustmentStatus.Draft)
                    {
                        <button type="button" class="btn btn-sm btn-outline-success btn-approve" data-id="@Model.Id">
                            <i class="bi bi-check-circle me-1"></i>Duyệt phiếu
                        </button>
                        <form method="post" asp-action="Cancel" asp-route-id="@Model.Id"
                              onsubmit="return confirm('Bạn có chắc muốn huỷ phiếu kiểm kê này?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-x-circle me-1"></i>Huỷ phiếu
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Cột phải: thông tin phiếu -->
    <div class="col-lg-4 order-0 order-lg-1">
        <div class="content-card">
            <div class="content-card-header">
                <h5 class="mb-0">Thông tin phiếu</h5>
            </div>
            <div class="content-card-body p-0">
                <dl class="receipt-info-list mb-0">
                    <div class="receipt-info-row">
                        <dt>Trạng thái</dt>
                        <dd><span class="badge @badgeClass">@badgeText</span></dd>
                    </div>
                    <div class="receipt-info-row">
                        <dt>Kho hàng</dt>
                        <dd class="fw-semibold"><i class="bi bi-building me-1 text-muted"></i>@Model.WarehouseName</dd>
                    </div>
                    @if (Model.ApprovedOnUtc.HasValue)
                    {
                        <div class="receipt-info-row">
                            <dt>Duyệt lúc</dt>
                            <dd class="text-success fw-semibold">@Model.ApprovedOnUtc.Value.ToString(ViewConstants.DefaultDateTimeFormat)</dd>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Note))
                    {
                        <div class="receipt-info-row">
                            <dt>Ghi chú</dt>
                            <dd class="text-secondary">@Model.Note</dd>
                        </div>
                    }
                    <div class="receipt-info-row">
                        <dt>Tạo lúc</dt>
                        <dd class="text-muted small">@Model.CreatedOnUtc.ToString(ViewConstants.DefaultDateTimeFormat)</dd>
                    </div>
                </dl>
            </div>
        </div>

        @if (status == StockAdjustmentStatus.Approved)
        {
            <div class="content-card mt-3">
                <div class="content-card-body">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        <div>
                            <div class="fw-semibold small">Phiếu đã được duyệt</div>
                            <div class="text-muted" style="font-size:.75rem;">
                                Tồn kho đã được điều chỉnh theo số liệu thực tế.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Styles {
<style>
    .receipt-info-list { margin: 0; }
    .receipt-info-row {
        display: flex;
        align-items: baseline;
        padding: .6rem 1.25rem;
        border-bottom: 1px solid var(--bs-border-color-translucent);
        gap: .75rem;
    }
    .receipt-info-row:last-child { border-bottom: none; }
    .receipt-info-row dt {
        font-size: .75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .03em;
        color: var(--bs-secondary);
        width: 72px;
        flex-shrink: 0;
    }
    .receipt-info-row dd { margin: 0; font-size: .875rem; }
</style>
}

@section Scripts {
    <script type="module">
        import { toast } from "/modules/modals.js";

        const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        const noteId = '@Model.Id';

        // ── Duyệt phiếu ────────────────────────────────────────────────────────
        document.querySelector('.btn-approve')?.addEventListener('click', async () => {
            if (!confirm('Xác nhận duyệt phiếu kiểm kê? Tồn kho sẽ được điều chỉnh theo số liệu thực tế.')) return;
            const fd = new FormData();
            fd.append('id', noteId);
            fd.append('__RequestVerificationToken', antiForgeryToken);
            try {
                const res = await fetch('@Url.Action("Approve")', { method: 'POST', body: fd }).then(r => r.json());
                if (res.success) location.reload();
                else toast('Lỗi', res.message || 'Duyệt phiếu thất bại.', 'danger');
            } catch { toast('Lỗi', 'Lỗi kết nối. Vui lòng thử lại.', 'danger'); }
        });
    </script>
}
