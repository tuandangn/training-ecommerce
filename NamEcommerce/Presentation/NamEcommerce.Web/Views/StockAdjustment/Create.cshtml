@model NamEcommerce.Web.Models.StockAdjustment.CreateStockAdjustmentNoteModel
@{
    ViewData[ViewConstants.PageTitle] = "Tạo phiếu kiểm kê tồn kho";
}
@section TitleSection {
    <h1 class="topbar-page-title">
        Thêm mới
        <span class="text-muted">Phiếu kiểm kê tồn kho</span>
    </h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="List" asp-controller="StockAdjustment" class="text-decoration-none">Kiểm kê tồn kho</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
            </ol>
        </nav>
    </div>
}
<div>
    <div asp-validation-summary="ModelOnly" class="alert alert-warning alert-global alert-dismissible"></div>
    <form method="post" id="createStockAdjustmentForm" asp-antiforgery="true">
        <div class="row g-3">
            <!-- Cột trái: danh sách hàng hóa kiểm kê -->
            <div class="col-lg-8 order-1 order-lg-0">
                <div class="content-card mb-3">
                    <div class="content-card-header">
                        <h5>Danh sách hàng hóa kiểm kê</h5>
                        <button type="button" class="btn btn-sm bg-light text-primary" id="btnAddItem">
                            <i class="bi bi-plus-lg me-1"></i> Thêm hàng hóa
                        </button>
                    </div>
                    <div class="content-card-body-flush">
                        <div class="table-responsive">
                            <table class="table data-table mb-0" id="adjustmentItemsTable">
                                <thead>
                                    <tr>
                                        <th class="ps-3">Hàng hóa</th>
                                        <th class="text-end" style="width:140px">SL hệ thống</th>
                                        <th class="text-end" style="width:140px">SL thực tế</th>
                                        <th class="text-end" style="width:110px">Chênh lệch</th>
                                        <th style="width:40px"></th>
                                    </tr>
                                </thead>
                                <tbody id="itemsTableBody">
                                    @for (var i = 0; i < Model.Items.Count; i++)
                                    {
                                        var item = Model.Items[i];
                                        <tr id="item-row-@i">
                                            <td class="ps-3">
                                                <div class="fw-medium">@item.ProductName</div>
                                                <input type="hidden" name="Items[@i].ProductId" value="@item.ProductId" />
                                                <input type="hidden" name="Items[@i].ProductName" value="@item.ProductName" />
                                            </td>
                                            <td class="text-end">
                                                <input name="Items[@i].SystemQuantity" value="@item.SystemQuantity"
                                                       class="form-control form-control-sm text-end item-system-qty"
                                                       data-decimal="quantity" data-decimals="@item.QuantityDecimalPlaces" readonly />
                                            </td>
                                            <td class="text-end">
                                                <input name="Items[@i].PhysicalQuantity" value="@item.PhysicalQuantity"
                                                       class="form-control form-control-sm text-end item-physical-qty"
                                                       data-decimal="quantity" data-decimals="@item.QuantityDecimalPlaces" min="0" placeholder="0" />
                                            </td>
                                            <td class="text-end item-delta text-muted small">
                                                @{ var delta = item.PhysicalQuantity - item.SystemQuantity; }
                                                <span class="@(delta > 0 ? "text-success" : delta < 0 ? "text-danger" : "text-muted")">
                                                    @(delta >= 0 ? "+" : "")@delta.DisplayQuantity()
                                                </span>
                                            </td>
                                            <td class="pe-3">
                                                <button type="button" class="btn-table-action danger border-0 bg-transparent shadow-none btn-remove-item">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div id="noItemsMessage" class="py-4 text-center text-muted"
                             style="@(Model.Items.Count == 0 ? "display:block" : "display:none")">
                            Chưa có hàng hóa nào được thêm vào phiếu kiểm kê.
                        </div>
                    </div>
                    <div class="content-card-footer py-2 d-flex align-items-center justify-content-between">
                        <a asp-action="List" class="btn btn-link text-decoration-none">
                            <span class="text-muted small">Trở về</span>
                        </a>
                        <button type="submit" class="btn btn-primary d-lg-none">Tạo phiếu</button>
                    </div>
                </div>
            </div>

            <!-- Cột phải: thông tin phiếu -->
            <div class="col-lg-4">
                <div class="content-card">
                    <div class="content-card-header">
                        <h5>Thông tin phiếu kiểm kê</h5>
                    </div>
                    <div class="content-card-body">
                        <!-- Kho hàng -->
                        <div class="mb-3">
                            <label asp-for="WarehouseId" class="form-label small fw-bold text-muted text-uppercase d-block">
                                Kho hàng <span class="text-danger">*</span>
                            </label>
                            <select asp-for="WarehouseId" class="form-select" id="warehouseSelect">
                                <option value="">(Chọn kho hàng)</option>
                                @foreach (var warehouse in Model.AvailableWarehouses)
                                {
                                    <option value="@warehouse.Id" selected="@(Model.WarehouseId == warehouse.Id)">
                                        @warehouse.Name
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="WarehouseId" class="small text-danger"></span>
                        </div>

                        <!-- Ghi chú -->
                        <div class="mb-3">
                            <label asp-for="Note" class="form-label small fw-bold text-muted text-uppercase d-block">
                                Ghi chú
                            </label>
                            <textarea asp-for="Note" class="form-control" rows="3"
                                      placeholder="Lý do kiểm kê, ghi chú..."></textarea>
                        </div>
                    </div>
                    <div class="content-card-footer d-none d-lg-block">
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Tạo phiếu kiểm kê</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Modal: Thêm hàng hóa -->
<div class="modal fade" id="addItemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Thêm hàng hóa kiểm kê</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3">
                <div class="mb-3">
                    <label class="form-label small fw-medium text-muted">Tên hàng hóa</label>
                    <input type="text" id="modalProductName" class="form-control"
                           placeholder="Nhập tên hàng hóa..." />
                </div>
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label small fw-medium text-muted">SL hệ thống</label>
                        <input type="number" id="modalSystemQty" class="form-control text-end"
                               value="0" min="0" step="0.001" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-medium text-muted">SL thực tế</label>
                        <input type="number" id="modalPhysicalQty" class="form-control text-end"
                               value="0" min="0" step="0.001" />
                    </div>
                </div>
                <div id="addItemError" class="alert alert-danger d-none mt-3 py-2 mb-0"></div>
            </div>
            <div class="modal-footer border-0 pt-0 pb-3">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                <button type="button" id="btnConfirmAddItem" class="btn btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>Thêm hàng
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module">
        let rowIndex = @Model.Items.Count;
        const tbody = document.getElementById('itemsTableBody');
        const noMsg = document.getElementById('noItemsMessage');
        const addItemModal = new bootstrap.Modal(document.getElementById('addItemModal'));

        function updateEmptyState() {
            noMsg.style.display = tbody.rows.length === 0 ? 'block' : 'none';
        }

        function formatDelta(delta) {
            const sign = delta > 0 ? '+' : '';
            const cls = delta > 0 ? 'text-success' : delta < 0 ? 'text-danger' : 'text-muted';
            return `<span class="${cls}">${sign}${delta.toFixed(3).replace(/\.?0+$/, '') || '0'}</span>`;
        }

        function addItemRow(productName, systemQty, physicalQty) {
            const i = rowIndex++;
            const delta = physicalQty - systemQty;
            const tr = document.createElement('tr');
            tr.id = `item-row-${i}`;
            tr.innerHTML = `
                <td class="ps-3">
                    <div class="fw-medium">${productName}</div>
                    <input type="hidden" name="Items[${i}].ProductId" value="${crypto.randomUUID()}" />
                    <input type="hidden" name="Items[${i}].ProductName" value="${productName}" />
                </td>
                <td class="text-end">
                    <input name="Items[${i}].SystemQuantity" value="${systemQty}"
                           class="form-control form-control-sm text-end item-system-qty"
                           data-decimal="quantity" readonly />
                </td>
                <td class="text-end">
                    <input name="Items[${i}].PhysicalQuantity" value="${physicalQty}"
                           class="form-control form-control-sm text-end item-physical-qty"
                           data-decimal="quantity" min="0" placeholder="0" />
                </td>
                <td class="text-end item-delta text-muted small">${formatDelta(delta)}</td>
                <td class="pe-3">
                    <button type="button" class="btn-table-action danger border-0 bg-transparent shadow-none btn-remove-item">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>`;
            tbody.appendChild(tr);
            updateEmptyState();

            // Update delta on physical qty change
            tr.querySelector('.item-physical-qty').addEventListener('input', function () {
                const sys = parseFloat(tr.querySelector('.item-system-qty').value) || 0;
                const phys = parseFloat(this.value) || 0;
                tr.querySelector('.item-delta').innerHTML = formatDelta(phys - sys);
            });
        }

        // Xóa item
        tbody.addEventListener('click', e => {
            const btn = e.target.closest('.btn-remove-item');
            if (btn) {
                btn.closest('tr').remove();
                updateEmptyState();
            }
        });

        // Delta live update cho items render từ server
        tbody.querySelectorAll('tr').forEach(tr => {
            const physInput = tr.querySelector('.item-physical-qty');
            if (physInput) {
                physInput.addEventListener('input', function () {
                    const sys = parseFloat(tr.querySelector('.item-system-qty').value) || 0;
                    const phys = parseFloat(this.value) || 0;
                    tr.querySelector('.item-delta').innerHTML = formatDelta(phys - sys);
                });
            }
        });

        // Mở modal thêm hàng
        document.getElementById('btnAddItem').addEventListener('click', () => {
            document.getElementById('modalProductName').value = '';
            document.getElementById('modalSystemQty').value = '0';
            document.getElementById('modalPhysicalQty').value = '0';
            document.getElementById('addItemError').classList.add('d-none');
            addItemModal.show();
        });

        // Xác nhận thêm hàng từ modal
        document.getElementById('btnConfirmAddItem').addEventListener('click', () => {
            const name = document.getElementById('modalProductName').value.trim();
            const sysQty = parseFloat(document.getElementById('modalSystemQty').value) || 0;
            const physQty = parseFloat(document.getElementById('modalPhysicalQty').value) || 0;
            const errEl = document.getElementById('addItemError');

            if (!name) {
                errEl.textContent = 'Vui lòng nhập tên hàng hóa.';
                errEl.classList.remove('d-none');
                return;
            }

            addItemRow(name, sysQty, physQty);
            addItemModal.hide();
        });
    </script>
}
