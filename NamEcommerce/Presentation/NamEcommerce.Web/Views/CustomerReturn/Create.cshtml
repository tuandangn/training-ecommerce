@model CreateCustomerReturnModel
@{
    ViewData[ViewConstants.PageTitle] = "Tạo phiếu trả hàng";
}
@section TitleSection {
    <h1 class="topbar-page-title">
        Thêm mới
        <span class="text-muted">Phiếu trả hàng</span>
    </h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="List" asp-controller="CustomerReturn" class="text-decoration-none">Khách trả hàng</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
            </ol>
        </nav>
    </div>
}

<div>
    <div asp-validation-summary="ModelOnly" class="alert alert-warning alert-global alert-dismissible"></div>
    <form method="post" id="createCustomerReturnForm" asp-antiforgery="true">
        <input type="hidden" asp-for="DeliveryNoteId" id="hiddenDeliveryNoteId" />
        <div class="row g-3">
            <div class="col-lg-8 order-1 order-lg-0">
                <div class="content-card mb-3">
                    <div class="content-card-header">
                        <h5>Danh sách hàng trả</h5>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnLoadFromNote" style="display:none!important">
                                <i class="bi bi-arrow-repeat me-1"></i>Tải lại
                            </button>
                            <button type="button" class="btn btn-sm bg-light text-primary" id="btnAddFreeItem">
                                <i class="bi bi-plus-lg me-1"></i>Thêm hàng trả
                            </button>
                        </div>
                    </div>
                    <div class="content-card-body-flush">
                        <div class="table-responsive">
                            <table class="table data-table mb-0" id="returnItemsTable">
                                <thead>
                                    <tr>
                                        <th class="ps-3" style="min-width:260px">Hàng hóa</th>
                                        <th class="text-end" style="width:120px">Đang giữ</th>
                                        <th class="text-end" style="width:120px">Trả lại</th>
                                        <th class="text-end" style="width:130px">Đơn giá</th>
                                        <th class="text-end" style="width:130px">Thành tiền</th>
                                        <th style="width:36px"></th>
                                    </tr>
                                </thead>
                                <tbody id="itemsTableBody">
                                    @for (var i = 0; i < Model.Items.Count; i++)
                                    {
                                        var item = Model.Items[i];
                                        <tr style="cursor:pointer">
                                            <td class="ps-3">
                                                <div class="fw-medium">@item.ProductDisplayName</div>
                                                <input type="hidden" name="Items[@i].ProductId" value="@item.ProductId" />
                                                <input type="hidden" name="Items[@i].DeliveryNoteItemId" value="@item.DeliveryNoteItemId" />
                                                <input type="hidden" name="Items[@i].OriginalUnitPrice" value="@item.OriginalUnitPrice" class="item-orig-price" />
                                                <input type="hidden" name="Items[@i].QuantityDecimalPlaces" value="@item.QuantityDecimalPlaces" />
                                            </td>
                                            <td class="text-end text-muted small">—</td>
                                            <td class="text-end">
                                                <input name="Items[@i].RequestedQuantity" value="@item.RequestedQuantity.DisplayQuantity()"
                                                       class="form-control form-control-sm text-end item-req-qty"
                                                       data-decimal="quantity" data-decimals="@item.QuantityDecimalPlaces" min="0.001" placeholder="0" />
                                            </td>
                                            <td class="text-end">
                                                <input name="Items[@i].ReturnUnitPrice" value="@item.ReturnUnitPrice.DisplayCurrency()"
                                                       class="form-control form-control-sm text-end item-return-price"
                                                       data-decimal="currency" min="0" placeholder="0" />
                                            </td>
                                            <td class="text-end item-subtotal text-muted small">
                                                @((item.RequestedQuantity * item.ReturnUnitPrice).DisplayCurrency())
                                            </td>
                                            <td class="pe-2">
                                                <button type="button" class="btn-table-action danger border-0 bg-transparent shadow-none btn-remove-item">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div id="noItemsMessage" class="py-4 text-center text-muted" style="@(Model.Items.Count == 0 ? "display:block" : "display:none")">
                            Chưa có hàng hóa nào được chọn.
                        </div>
                    </div>
                    <div class="content-card-footer py-2">
                        <div class="d-flex justify-content-end align-items-center gap-3">
                            <span class="text-muted small">Tổng giá trị:</span>
                            <span id="totalReturnValue" class="fw-semibold text-primary">0 ₫</span>
                        </div>
                        <div class="d-flex justify-content-end align-items-center gap-3 mt-1">
                            <span class="text-muted small">Chi phí phát sinh:</span>
                            <span id="additionalCostDisplay" class="text-danger small fw-medium">0 ₫</span>
                        </div>
                        <div class="d-flex justify-content-end align-items-center gap-3 mt-1 border-top pt-2">
                            <span class="text-muted small fw-bold">Tổng hoàn khách:</span>
                            <span id="netRefundAmount" class="fw-bold text-success fs-6">0 ₫</span>
                        </div>
                    </div>
                    <div class="content-card-footer py-2 d-flex align-items-center justify-content-between border-top">
                        <a asp-action="List" class="btn btn-link text-decoration-none">
                            <span class="text-muted small">Trở về</span>
                        </a>
                        <button type="submit" class="btn btn-primary">Tạo phiếu</button>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="content-card">
                    <div class="content-card-header">
                        <h5>Thông tin phiếu trả</h5>
                    </div>
                    <div class="content-card-body">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase d-block">
                                Khách hàng <span class="text-danger">*</span>
                            </label>
                            <div id="customerPicker" data-id="@Model.CustomerId" data-name="@Model.CustomerDisplayName" 
                                data-phone="@Model.CustomerDisplayPhone" data-address="@Model.CustomerDisplayAddress"></div>
                            <input type="text" class="visually-hidden" asp-for="CustomerId" id="hiddenCustomerId" />
                            <div class="form-text fw-medium text-warning d-none" id="customerNoItemsWarning">Khách hàng này không có hàng hóa nào có thể trả.</div>
                            <span asp-validation-for="CustomerId" class="small text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase d-block">
                                Phiếu giao hàng
                            </label>
                            <select id="deliveryNoteSelect" class="form-select" disabled>
                                <option value="">(Không chọn)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="AdditionalCost" class="form-label small fw-bold text-muted text-uppercase d-block"></label>
                            <input asp-for="AdditionalCost" id="additionalCostInput"
                                   class="form-control" data-decimal="currency" min="0" placeholder="0"
                                   value="@Model.AdditionalCost.DisplayCurrency()" />
                        </div>
                        <div class="form-check form-switch mb-3 p-3 bg-light rounded border">
                            <input class="form-check-input ms-0" type="checkbox" asp-for="CompensateInNextDelivery" role="switch" id="compensateInNextDeliverySwitch">
                            <label class="form-check-label ms-2 fw-medium" asp-for="CompensateInNextDelivery" for="compensateInNextDeliverySwitch">
                                Bù số lượng trả lại vào lần giao sau
                            </label>
                        </div>
                        <div class="mb-0">
                            <label asp-for="Note" class="form-label small fw-bold text-muted text-uppercase d-block"></label>
                            <textarea asp-for="Note" class="form-control" rows="3" placeholder="Lý do trả hàng..."></textarea>
                        </div>
                    </div>
                    <div class="content-card-footer d-none d-lg-block">
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Tạo phiếu</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@await Html.PartialAsync("_ItemEditOffcanvas")
<partial name="_ItemEditModal" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module">
        import CustomerPicker from '/modules/CustomerPicker.js';
        import { toast } from '/modules/modals.js';
        import ItemEditor from '/modules/ItemEditor.js';

        const customerPickerEl = document.getElementById('customerPicker');
        const hiddenCustomerId = document.getElementById('hiddenCustomerId');
        const hiddenDeliveryNoteId = document.getElementById('hiddenDeliveryNoteId');
        const deliveryNoteSelect = document.getElementById('deliveryNoteSelect');

        const customerPicker = new CustomerPicker(customerPickerEl);

        let pendingDeliveryNoteId = hiddenDeliveryNoteId.value || null;

        const initialCustomerId = hiddenCustomerId.value;
        const initialCustomerName = customerPickerEl.dataset.name;
        if (initialCustomerId && initialCustomerName) {
            customerPicker.selectCustomer(customerPickerEl.dataset);
        }

        customerPickerEl.addEventListener('select', async (e) => {
            hiddenCustomerId.value = e.detail.customer.id;
            hiddenDeliveryNoteId.value = '';
            await loadDeliveryNotes(e.detail.customer.id);
            document.getElementById('customerNoItemsWarning').classList.add('d-none');
        });

        customerPickerEl.addEventListener('remove', () => {
            hiddenCustomerId.value = '';
            hiddenDeliveryNoteId.value = '';
            resetDeliveryNoteSelect();
            clearItems();
            document.getElementById('customerNoItemsWarning').classList.add('d-none');
        });

        async function loadDeliveryNotes(customerId) {
            deliveryNoteSelect.disabled = true;
            deliveryNoteSelect.innerHTML = '<option value="">Đang tải...</option>';

            try {
                const res = await fetch(`/CustomerReturn/GetDeliveryNotes?customerId=${customerId}`);
                const notes = await res.json();

                deliveryNoteSelect.innerHTML = '<option value="">(Không chọn)</option>';
                notes.forEach(n => {
                    const opt = document.createElement('option');
                    opt.value = n.id;
                    const date = new Date(n.deliveredOn).toLocaleDateString('vi-VN');
                    opt.textContent = `${n.code} — ${date}`;
                    deliveryNoteSelect.appendChild(opt);
                });
                deliveryNoteSelect.disabled = false;

                const noteToSelect = pendingDeliveryNoteId || hiddenDeliveryNoteId.value;
                pendingDeliveryNoteId = null;

                const selectedOption = deliveryNoteSelect.querySelector(`option[value="${noteToSelect}"]`);
                if (noteToSelect && selectedOption) {
                    deliveryNoteSelect.value = noteToSelect;
                    hiddenDeliveryNoteId.value = noteToSelect;
                    updateLoadBtn(true);
                    await loadItemsFromNote(noteToSelect);
                }
            } catch {
                deliveryNoteSelect.innerHTML = '<option value="">Lỗi tải dữ liệu</option>';
            }
        }

        function resetDeliveryNoteSelect() {
            deliveryNoteSelect.innerHTML = '<option value="">(Chọn khách hàng trước)</option>';
            deliveryNoteSelect.disabled = true;
        }

        deliveryNoteSelect.addEventListener('change', async () => {
            const noteId = deliveryNoteSelect.value;
            hiddenDeliveryNoteId.value = noteId;

            if (!noteId) {
                updateLoadBtn(false);
                clearItems();
                return;
            }

            updateLoadBtn(true);
            await loadItemsFromNote(noteId);
        });

        function updateLoadBtn(show) {
            const btn = document.getElementById('btnLoadFromNote');
            btn.style.setProperty('display', show ? 'inline-flex' : 'none', 'important');
        }

        // ── Load items từ phiếu giao / hàng đã giao ─────────────────────────────
        async function loadItemsFromNote(noteId) {
            try {
                const res = await fetch(`/CustomerReturn/GetDeliveryNoteItems?deliveryNoteId=${noteId}`);
                const items = await res.json();
                clearItems();
                items
                    .filter(item => (item.availableQty ?? (item.originalQty - item.alreadyReturnedQty)) > 0)
                    .forEach(item => addItemRowFromNote(item));
                updateFooter();
            } catch {
                alert('Không thể tải danh sách hàng từ phiếu giao.');
            }
        }

        async function loadItemsByCustomer(customerId) {
            try {
                const res = await fetch(`/CustomerReturn/GetReturnableItems?customerId=${customerId}`);
                const items = await res.json();
                clearItems();
                if(!Array.isArray(items) || items.length == 0){
                    toast('Không thể trả hàng', 'Không tìm thấy hàng đã giao nào để trả cho khách hàng này.', 'warning');
                    updateFooter();
                    document.getElementById('customerNoItemsWarning').classList.remove('d-none');
                    return;
                }
                items.filter(item => (item.availableQty ?? (item.originalQty - item.alreadyReturnedQty)) > 0)
                    .forEach(item => addItemRowFromNote(item));
                updateFooter();
            } catch {
                alert('Không thể tải danh sách hàng đã giao của khách hàng.');
            }
        }

        document.getElementById('btnLoadFromNote').addEventListener('click', async () => {
            const noteId = deliveryNoteSelect.value;
            if (noteId) await loadItemsFromNote(noteId);
        });

        // ── Item table ────────────────────────────────────────────────────────────
        let rowIndex = @Model.Items.Count;
        const tbody = document.getElementById('itemsTableBody');
        const noMsg = document.getElementById('noItemsMessage');

        function clearItems() {
            tbody.innerHTML = '';
            rowIndex = 0;
            updateEmptyState();
        }

        function updateEmptyState() {
            noMsg.style.display = tbody.rows.length === 0 ? 'block' : 'none';
        }

        function fmtCurrency(val, symbol) {
            if(symbol)
                return DecimalFields.formatCurrencyWithSymbol(val);
            return DecimalFields.formatCurrency(val);
        }

        function fmtQty(val) {
            return DecimalFields.formatQuantity(val);
        }

        /** Thêm row từ AJAX hàng có thể trả (có AvailableQty, UnitPrice làm gợi ý) */
        function addItemRowFromNote(item) {
            const i = rowIndex++;
            const origPrice = item.unitPrice || 0;
            const available = item.availableQty ?? (item.originalQty - item.alreadyReturnedQty);
            const tr = document.createElement('tr');
            tr.style.cursor = 'pointer';
            tr.innerHTML = `
                <td class="ps-3">
                    <div class="fw-medium">${item.productName}</div>
                    <div class="text-muted small">Đã giao ${fmtQty(item.originalQty)} ${item.unit || ''} · đã giữ/trả ${fmtQty(item.alreadyReturnedQty)}</div>
                    <input type="hidden" name="Items[${i}].ProductId" value="${item.productId}" />
                    <input type="hidden" name="Items[${i}].DeliveryNoteItemId" value="${item.sourceItemId ?? ''}" />
                    <input type="hidden" name="Items[${i}].OriginalUnitPrice" value="${origPrice}" class="item-orig-price" />
                </td>
                <td class="text-end text-muted small fw-medium ${available > 0 ? 'text-success' : 'text-danger'}">${fmtQty(available)}</td>
                <td class="text-end align-middle">
                    <span class="fw-medium item-req-qty-display">${fmtQty(available)}</span>
                    <input type="hidden" name="Items[${i}].RequestedQuantity" value="${available}"
                           class="item-req-qty" data-decimals="${item.quantityDecimalPlaces ?? 0}" />
                </td>
                <td class="text-end align-middle">
                    <span class="text-muted item-return-price-display">${fmtCurrency(origPrice, true)}</span>
                    <input type="hidden" name="Items[${i}].ReturnUnitPrice" value="${origPrice}"
                           class="item-return-price" />
                </td>
                <td class="text-end item-subtotal text-muted small align-middle">
                    ${fmtCurrency(origPrice * available, true)}
                </td>
                <td class="pe-2">
                    <button type="button" class="btn-table-action danger border-0 bg-transparent shadow-none btn-remove-item">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>`;
            tbody.appendChild(tr);
            updateEmptyState();
        }

        document.getElementById('btnAddFreeItem').addEventListener('click', async () => {
            const noteId = deliveryNoteSelect.value || hiddenDeliveryNoteId.value;
            const customerId = hiddenCustomerId.value;
            if (!customerId) {
                toast('Thông báo', 'Vui lòng chọn khách hàng.', 'info');
                return;
            }

            if (!noteId) {
                await loadItemsByCustomer(customerId);
                return;
            }

            await loadItemsFromNote(noteId);
        });

        // Xóa item
        tbody.addEventListener('click', e => {
            const btn = e.target.closest('.btn-remove-item');
            if (btn) {
                btn.closest('tr').remove();
                updateEmptyState();
                updateFooter();
            }
        });

        const itemEditor = new ItemEditor(
            document.getElementById('itemEditOffcanvas'),
            document.getElementById('itemEditModal'),
            { priceLabel: 'Đơn giá hoàn' }
        );

        tbody.addEventListener('click', e => {
            if (e.target.closest('.btn-remove-item')) return;
            const row = e.target.closest('tr');
            if (!row) return;

            const name = row.querySelector('.fw-medium')?.textContent?.trim() ?? '';
            const qtyInput = row.querySelector('.item-req-qty');
            const priceInput = row.querySelector('.item-return-price');
            const decimals = parseInt(qtyInput?.dataset.decimals ?? '0', 10);

            itemEditor.open({
                name,
                quantity: DecimalFields.getValue(qtyInput),
                unitPrice: priceInput ? DecimalFields.getValue(priceInput) : 0,
                quantityDecimalPlaces: decimals,
                priceLabel: 'Đơn giá hoàn'
            }, {
                onApply: (qty, price) => {
                    const qtyFormatted = DecimalFields.formatQuantity(qty, decimals);
                    qtyInput.value = qtyFormatted;
                    const qtyDisplay = row.querySelector('.item-req-qty-display');
                    if (qtyDisplay) qtyDisplay.textContent = qtyFormatted;
                    if (priceInput) {
                        priceInput.value = price;
                        const priceDisplay = row.querySelector('.item-return-price-display');
                        if (priceDisplay) priceDisplay.textContent = fmtCurrency(price, true);
                    }
                    const sub = row.querySelector('.item-subtotal');
                    if (sub) sub.textContent = fmtCurrency(qty * price, true);
                    updateFooter();
                },
                onDelete: () => {
                    row.remove();
                    updateEmptyState();
                    updateFooter();
                }
            });
        });

        function renumberRows() {
            Array.from(tbody.querySelectorAll('tr')).forEach((row, index) => {
                row.querySelectorAll('[name^="Items["]').forEach(input => {
                    input.name = input.name.replace(/Items\[\d+\]/, `Items[${index}]`);
                });
            });
            rowIndex = tbody.rows.length;
        }

        document.getElementById('createCustomerReturnForm').addEventListener('submit', function(e) {
            renumberRows();

            if (tbody.rows.length === 0) {
                e.preventDefault();
                alert('Vui lòng thêm ít nhất một hàng đã giao.');
                return;
            }

            if (window.jQuery && typeof $(this).valid === 'function' && !$(this).valid()) {
                e.preventDefault();
                return;
            }
        });

        // Recalculate khi thay đổi giá / số lượng
        tbody.addEventListener('input', e => {
            if (e.target.matches('.item-req-qty, .item-return-price')) {
                const row = e.target.closest('tr');
                const qty = parseQuantity(row.querySelector('.item-req-qty')?.value);
                const price = parseDecimal(row.querySelector('.item-return-price')?.value);
                const sub = row.querySelector('.item-subtotal');
                if (sub) sub.textContent = fmtCurrency(qty * price, true);
                updateFooter();
            }
        });

        // ── Footer tính toán ─────────────────────────────────────────────────────
        const additionalCostInput = document.getElementById('additionalCostInput');

        function parseDecimal(str) {
            if (!str) return 0;
            return parseFloat(DecimalFields.stripFormatting(str));
        }
        function parseQuantity(str) {
            if (!str) return 0;
            return parseFloat(DecimalFields.stripFormatting(str, 2));
        }

        function updateFooter() {
            let total = 0;
            tbody.querySelectorAll('tr').forEach(row => {
                const qty = parseQuantity(row.querySelector('.item-req-qty')?.value);
                const price = parseDecimal(row.querySelector('.item-return-price')?.value);
                total += qty * price;
            });

            const addCost = parseDecimal(additionalCostInput.value);
            const net = Math.max(0, total - addCost);

            document.getElementById('totalReturnValue').textContent = fmtCurrency(total, true);
            document.getElementById('additionalCostDisplay').textContent = fmtCurrency(addCost, true);
            document.getElementById('netRefundAmount').textContent = fmtCurrency(net, true);
        }

        additionalCostInput.addEventListener('input', updateFooter);

        // Khởi tạo footer
        updateFooter();

        // Nếu server có customerId sẵn (validation fail re-render)
        if (initialCustomerId) {
            loadDeliveryNotes(initialCustomerId);
        }
    </script>
}
