@using NamEcommerce.Domain.Shared.Enums.Returns
@model CustomerReturnListModel
@{
    ViewData[ViewConstants.PageTitle] = "Khách trả hàng";
}
@section TitleSection {
    <h1 class="topbar-page-title">Khách trả hàng</h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="List" asp-controller="Order" class="text-decoration-none">Đơn bán</a></li>
                <li class="breadcrumb-item active" aria-current="page">Khách trả hàng</li>
            </ol>
        </nav>
    </div>
}
<div class="content-card" data-responsive-list data-list-key="customer-return-list">
    <div class="action-toolbar">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Tạo phiếu trả
        </a>
        <partial name="_ResponsiveListToolbar" />
    </div>
    <div class="content-card-body-flush">
        <div class="responsive-list-panel" data-list-view-panel="list">
            <div class="table-responsive">
                <table class="table data-table">
                    <thead>
                        <tr>
                            <th class="ps-4" style="width:130px">Mã phiếu</th>
                            <th>Khách hàng</th>
                            <th>Nguồn giao</th>
                            <th>Kho nhận</th>
                            <th class="text-end">Giá trị trả</th>
                            <th style="width:130px">Trạng thái</th>
                            @* <th class="text-center" style="width:110px">Ngày trả</th> *@
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Data.Pagination.TotalCount > 0)
                        {
                            @foreach (var item in Model.Data)
                            {
                                <tr class="align-middle">
                                    <td class="ps-4">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="fw-medium d-block text-nowrap text-decoration-none">
                                            @item.Code
                                        </a>
                                        <span class="text-muted small">@item.ReturnDate.ToString(ViewConstants.DefaultDateTimeFormat)</span>
                                    </td>
                                    <td>@item.CustomerName</td>
                                    <td>
                                        <a asp-controller="DeliveryNote" asp-action="Details" asp-route-id="@item.DeliveryNoteId"
                                           class="text-decoration-none fw-medium text-dark">
                                            @item.DeliveryNoteCode
                                        </a>
                                    </td>
                                    <td class="fw-medium text-dark">@item.WarehouseName</td>
                                    <td class="text-end fw-bold text-primary text-nowrap">@item.TotalAmount.DisplayCurrencyWithSymbol()</td>
                                    <td>
                                        @{
                                            var (badgeClass, badgeText) = (CustomerReturnStatus)item.Status switch
                                            {
                                                CustomerReturnStatus.Draft => ("bg-secondary", "Bản nháp"),
                                                CustomerReturnStatus.Inspecting => ("bg-warning text-dark", "Đang kiểm tra"),
                                                CustomerReturnStatus.Confirmed => ("bg-success", "Đã xác nhận"),
                                                CustomerReturnStatus.Cancelled => ("bg-danger", "Đã huỷ"),
                                                _ => ("bg-secondary", "—")
                                            };
                                        }
                                        <span class="badge @badgeClass">@badgeText</span>
                                    </td>
                                    @* <td class="text-center text-muted small">@item.ReturnDate.ToString(ViewConstants.DefaultDateFormat)</td> *@
                                    <td class="text-end pe-3">
                                        <a class="btn btn-sm btn-light text-primary"
                                           asp-action="Details" asp-route-id="@item.Id">Xem</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="empty-state">
                                        <span class="text-muted">Không có phiếu trả hàng nào</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="responsive-list-panel responsive-list-grid" data-list-view-panel="grid" hidden>
            @if (Model.Data.Pagination.TotalCount > 0)
            {
                @foreach (var item in Model.Data)
                {
                    var (badgeClass, badgeText) = (CustomerReturnStatus)item.Status switch
                    {
                        CustomerReturnStatus.Draft => ("bg-secondary", "Bản nháp"),
                        CustomerReturnStatus.Inspecting => ("bg-warning text-dark", "Đang kiểm tra"),
                        CustomerReturnStatus.Confirmed => ("bg-success", "Đã xác nhận"),
                        CustomerReturnStatus.Cancelled => ("bg-danger", "Đã huỷ"),
                        _ => ("bg-secondary", "—")
                    };

                    <article class="list-card">
                        <div class="list-card-header">
                            <div class="list-card-title-group">
                                <a asp-action="Details" asp-route-id="@item.Id" class="list-card-title">@item.Code</a>
                                <div class="list-card-meta">@item.ReturnDate.ToString(ViewConstants.DefaultDateFormat)</div>
                            </div>
                            <span class="badge @badgeClass">@badgeText</span>
                        </div>
                        <div class="list-card-fields">
                            <div class="list-card-field">
                                <span class="list-card-label">Khách hàng</span>
                                <span class="list-card-value">@item.CustomerName</span>
                            </div>
                            <div class="list-card-field">
                                <span class="list-card-label">Nguồn giao</span>
                                <a asp-controller="DeliveryNote" asp-action="Details" asp-route-id="@item.DeliveryNoteId"
                                   class="list-card-value text-decoration-none">
                                    @item.DeliveryNoteCode
                                </a>
                            </div>
                            <div class="list-card-field">
                                <span class="list-card-label">Kho nhận</span>
                                <span class="list-card-value">@item.WarehouseName</span>
                            </div>
                            <div class="list-card-field">
                                <span class="list-card-label">Giá trị trả</span>
                                <span class="list-card-value">@item.TotalAmount.DisplayCurrency()</span>
                            </div>
                        </div>
                        <div class="list-card-actions">
                            <a class="btn btn-sm btn-light text-primary"
                               asp-action="Details" asp-route-id="@item.Id">Xem</a>
                        </div>
                    </article>
                }
            }
            else
            {
                <div class="empty-state">
                    <span class="text-muted">Không có phiếu trả hàng nào</span>
                </div>
            }
        </div>
        @if (Model.Data.Pagination.TotalCount > 0)
        {
            <partial name="_Pager" model="Model.Data.Pagination" />
        }
    </div>
</div>
