@model PendingDirectShipDeliveryListModel
@{
    ViewData["Title"] = "Hàng giao thẳng";
}

@section TitleSection {
    <h1 class="topbar-page-title"> Hàng giao thẳng</h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page"> Hàng giao thẳng</li>
            </ol>
        </nav>
    </div>
}
<div class="content-card">
    <div class="action-toolbar">
        <form method="get" asp-action="Pending" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label small">Tìm kiếm</label>
                <input type="text" name="Keywords" value="@Model.Filter.Keywords" class="form-control"
                       placeholder="Mã phiếu, tên khách, địa chỉ..." />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small">Từ ngày</label>
                <input type="date" name="FromDate" class="form-control" placeholder="Từ ngày"
                       value="@Model.Filter.FromDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small">Đến ngày</label>
                <input type="date" name="ToDate" class="form-control" placeholder="Đến ngày"
                       value="@Model.Filter.ToDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-search me-1"></i>Lọc
                </button>
                @if (Context.Request.QueryString.HasValue)
                {
                    <a asp-action="Pending" class="btn btn-outline-secondary">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
    <div class="content-card-body-flush">
        @if (!Model.Items.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-check2-circle ui-icon-hero-muted"></i>
                <p class="mt-2">Không có phiếu nào đang chờ xác nhận.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table data-table">
                    <thead>
                        <tr>
                            <th class="ps-4">Mã phiếu</th>
                            <th>Đơn hàng</th>
                            <th><i class="bi bi-person me-1"></i>Khách hàng</th>
                            <th><i class="bi bi-geo-alt me-1"></i>Địa chỉ</th>
                            <th>Hàng hóa</th>
                            <th><i class="bi bi-calendar me-1"></i>Ngày tạo</th>
                            <th class="text-end pe-4 ui-w-180">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr data-id="@item.Id" data-code="@item.Code">
                                <td class="ps-4 fw-semibold">
                                    <span class="badge bg-success-subtle text-success me-1">
                                        <i class="bi bi-truck-fast"></i>
                                    </span>
                                    @item.Code
                                </td>
                                <td>
                                    @if (item.OrderCode != null)
                                    {
                                        <a asp-controller="Order" asp-action="Details" asp-route-id="@item.OrderId"
                                           class="text-decoration-none">@item.OrderCode</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-medium">@item.CustomerName</div>
                                    @if (!string.IsNullOrWhiteSpace(item.CustomerPhone))
                                    {
                                        <small class="text-muted">@item.CustomerPhone</small>
                                    }
                                </td>
                                <td>
                                    <span class="text-truncate d-inline-block ui-max-w-200" title="@item.ShippingAddress">
                                        @item.ShippingAddress
                                    </span>
                                </td>
                                <td>
                                    @foreach (var product in item.Items)
                                    {
                                        <div class="small">
                                            <span class="fw-medium">@product.ProductName</span>
                                            <span class="text-muted ms-1">× @product.Quantity.ToString("N0")</span>
                                        </div>
                                    }
                                </td>
                                <td class="text-muted small">
                                    @item.CreatedOn.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="text-end pe-4">
                                    <button type="button" class="btn btn-sm btn-success btn-confirm-delivery" data-testid="directship-confirm-open"
                                            data-id="@item.Id" data-code="@item.Code">
                                        <i class="bi bi-check2 me-1"></i>Đã giao
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger btn-reject-delivery"
                                            data-id="@item.Id" data-code="@item.Code" data-warehouse="@item.WarehouseId">
                                        <i class="bi bi-person-fill-x me-1"></i>Từ chối
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="px-4 pb-3">
                <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    Tổng <strong>@Model.Items.Count</strong> phiếu đang chờ xác nhận.
                </small>
            </div>
        }
    </div>
</div>

<partial name="_DeliveryNote.ConfirmDelivered" />
<partial name="_DeliveryNote.ConfirmReject" model="Model.ReturnWarehouseOptions" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module">
        import DeliverNoteController from '/modules/DeliveryNoteController.js';

        (function () {
            const deliveryNoteController = new DeliverNoteController({ hidePageLoadOnRequestEnd: false });

            document.querySelectorAll('.btn-confirm-delivery').forEach(btn => {
                btn.addEventListener('click', () => {
                    const id = btn.dataset.id;
                    if (!id) return;
                    deliveryNoteController.beginDeliveredWorkflow('markDeliveredModal').setId(id);
                });
            });

            document.querySelectorAll('.btn-reject-delivery').forEach(btn => {
                btn.addEventListener('click', () => {
                    const {id, code, warehouse } = btn.dataset;
                    deliveryNoteController.beginRejectWorkflow('rejectDeliveryNoteModal').setData(id, code, warehouse);
                });
            });
        })();
    </script>
}
