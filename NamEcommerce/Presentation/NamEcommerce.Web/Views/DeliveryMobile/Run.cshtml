@model DeliveryMobileRunModel
@using System.Text.Json
@using NamEcommerce.Domain.Shared.Enums.DeliveryNotes
@inject ICachedValuesService CachedValuesService
@{
    Layout = "_DeliveryMobileLayout";
    ViewData["Title"] = Model.Run.Code;
    var status = (DeliveryRunStatus)Model.Run.Status;
    var statusClass = Model.Run.IsDeliveryCompleted
        ? "mobile-status-success"
        : status == DeliveryRunStatus.ReadyForHandover && Model.Run.DeliveredItemCount == 0
            ? "mobile-status-ready"
            : "mobile-status-active";
    var statusIcon = Model.Run.IsDeliveryCompleted
        ? "bi-check-circle"
        : status == DeliveryRunStatus.ReadyForHandover && Model.Run.DeliveredItemCount == 0
            ? "bi-box-seam"
            : "bi-truck";
    var pendingCashAmount = Model.Run.Items
        .Where(item => item.DeliveryNoteStatus != (int)DeliveryNoteStatus.Delivered &&
                       item.DeliveryNoteStatus != (int)DeliveryNoteStatus.Cancelled)
        .Sum(item => item.AmountToCollect);
    var deliveredCount = Model.Run.DeliveredItemCount;
    var progressPercent = Model.Run.Items.Count == 0
        ? 0
        : (int)Math.Round((double)deliveredCount * 100 / Model.Run.Items.Count);
    var cachePayload = JsonSerializer.Serialize(Model.Run, new JsonSerializerOptions(JsonSerializerDefaults.Web));
}

<div class="mobile-topbar">
    <div>
        <h1 class="mobile-title">@Model.Run.Code</h1>
        <p class="mobile-subtitle">@deliveredCount/@Model.Run.Items.Count phiếu đã giao</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary mobile-icon-button" aria-label="Quay lại">
        <i class="bi bi-arrow-left"></i>
    </a>
</div>

<div class="mobile-card mb-3">
    <div class="d-flex justify-content-between align-items-center gap-3">
        <span class="mobile-status @statusClass">
            <i class="bi @statusIcon"></i>
            @Model.Run.StatusName
        </span>
        <strong class="mobile-cash-total">@pendingCashAmount.DisplayCurrencyWithSymbol()</strong>
    </div>

    <div class="mobile-stat-grid">
        <div class="mobile-stat">
            <div class="mobile-stat-label">Tiến độ</div>
            <div class="mobile-stat-value">@deliveredCount/@Model.Run.Items.Count</div>
        </div>
        <div class="mobile-stat">
            <div class="mobile-stat-label">Cần thu</div>
            <div class="mobile-stat-value">@pendingCashAmount.DisplayCurrencyWithSymbol()</div>
        </div>
    </div>
    <div class="mobile-progress" role="progressbar" aria-label="Tiến độ giao hàng" aria-valuenow="@progressPercent" aria-valuemin="0" aria-valuemax="100">
        <div class="mobile-progress-value" data-progress-width="@progressPercent"></div>
    </div>
</div>

<div class="mobile-section-label">Danh sách giao</div>

@foreach (var item in Model.Run.Items)
{
    var noteStatus = item.DeliveryNoteStatus.HasValue ? (DeliveryNoteStatus)item.DeliveryNoteStatus.Value : (DeliveryNoteStatus?)null;
    var isDelivered = noteStatus == DeliveryNoteStatus.Delivered;
    var isPendingConfirmation = noteStatus == DeliveryNoteStatus.PendingConfirmation;
    var receiverName = string.IsNullOrWhiteSpace(item.ReceiverName) ? item.CustomerName : item.ReceiverName;
    var shippingPhoneNumber = string.IsNullOrWhiteSpace(item.ShippingPhoneNumber) ? item.CustomerPhone : item.ShippingPhoneNumber;

    <article class="mobile-card mobile-route-card @(isDelivered ? "is-delivered" : null)">
        <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
            <div>
                <div class="fw-bold">@item.CustomerName</div>
                <div class="mobile-meta">@item.DeliveryNoteCode @(!string.IsNullOrWhiteSpace(item.OrderCode) ? $"· {item.OrderCode}" : "")</div>
            </div>
            @if (item.AmountToCollect > 0)
            {
                <span class="mobile-status mobile-status-muted">COD @item.AmountToCollect.DisplayCurrencyWithSymbol()</span>
            }
        </div>

        <div class="mobile-info-grid">
            <div class="mobile-info-cell">
                <span>Người nhận</span>
                <strong>@receiverName</strong>
            </div>
            @if (!string.IsNullOrWhiteSpace(shippingPhoneNumber))
            {
                <a href="tel:@shippingPhoneNumber" class="mobile-info-cell mobile-phone-link">
                    <span>Số điện thoại</span>
                    <strong>@shippingPhoneNumber</strong>
                </a>
            }
        </div>

        <div class="mobile-address">
            <i class="bi bi-geo-alt text-primary"></i>
            <span>@item.ShippingAddress</span>
        </div>

        @if (!isDelivered && item.AmountToCollectOverriddenAt.HasValue)
        {
            <div class="mobile-alert-warning mt-2">
                <i class="bi bi-exclamation-triangle-fill"></i>
                Admin đã cập nhật tiền cần thu: <strong>@item.AmountToCollect.DisplayCurrencyWithSymbol()</strong>
            </div>
        }

        @if (isDelivered)
        {
            <div class="mobile-goods-box">
                <div class="mobile-goods-head">
                    <span>Hàng đã giao</span>
                </div>
                @if (item.ProductLines.Any())
                {
                    <ul class="mobile-goods-list">
                        @foreach (var product in item.ProductLines)
                        {
                            <li>
                                <span>@product.ProductName</span>
                                <strong>@product.TotalQuantity.DisplayQuantity(product.QuantityDecimalPlaces) <span class="text-muted fw-normal">@product.UnitMeasurement</span></strong>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="mobile-meta">Chưa có thông tin hàng hóa</div>
                }
            </div>
            <div class="mobile-status mobile-status-success mt-3">
                <i class="bi bi-check-circle"></i>
                Đã giao
                @if (item.AmountToCollect > 0)
                {
                    if (item.CashCollectedAmount.HasValue)
                    {
                        <span>· @(item.CashCollectedAmount.Value > 0 ? $"Đã thu {item.CashCollectedAmount.Value.DisplayCurrencyWithSymbol()}" : "Chưa thu tiền")</span>
                    }
                    else
                    {
                        <span>· Chưa khai báo tiền thu</span>
                    }
                }
            </div>
            @if (item.DeliveryProofPictureId.HasValue)
            {
                <a href="/Picture/@item.DeliveryProofPictureId.Value" target="_blank" class="mobile-proof-image">
                    <img src="/Picture/@item.DeliveryProofPictureId.Value" alt="Ảnh bằng chứng giao hàng" />
                    <span>Ảnh bằng chứng</span>
                </a>
            }
        }
        else if (isPendingConfirmation)
        {
            <div class="mobile-status mobile-status-active mt-2">
                <i class="bi bi-hourglass-split"></i>
                Chờ đối soát
                @if (item.CashCollectedAmount.HasValue)
                {
                    <span>· Thu @item.CashCollectedAmount.Value.DisplayCurrencyWithSymbol()</span>
                }
            </div>
            @if (item.DeliveryProofPictureId.HasValue)
            {
                <a href="/Picture/@item.DeliveryProofPictureId.Value" target="_blank" class="mobile-proof-image">
                    <img src="/Picture/@item.DeliveryProofPictureId.Value" alt="Ảnh bằng chứng" />
                    <span>Ảnh bằng chứng</span>
                </a>
            }
        }
        else if (item.SettlementApproval == (int) DeliverySettlementApprovalStatus.PendingApproval)
        {
            <div class="mobile-status mobile-status-active mt-2">
                <i class="bi bi-hourglass-split"></i> Chờ admin duyệt số tiền thu
            </div>
            <div class="mobile-goods-box mt-3">
                <div class="mobile-goods-head">
                    <span>Hàng hóa chờ duyệt</span>
                    <strong>@((item.ProposedAmountToCollect ?? item.AmountToCollect).DisplayCurrencyWithSymbol())</strong>
                </div>
                @if (item.SettlementProductLines.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Hàng hóa</th>
                                    <th class="text-end">SL giao</th>
                                    <th class="text-end">Khách nhận</th>
                                    <th class="text-end">Trả về</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in item.SettlementProductLines)
                                {
                                    <tr>
                                        <td>@line.ProductName</td>
                                        <td class="text-end">@line.Quantity.DisplayQuantity(line.QuantityDecimalPlaces) @line.UnitMeasurement</td>
                                        <td class="text-end">@line.AcceptedQuantity.DisplayQuantity(line.QuantityDecimalPlaces)</td>
                                        <td class="text-end @(line.RejectedQuantity > 0 ? "text-danger fw-bold" : "text-muted")">@line.RejectedQuantity.DisplayQuantity(line.QuantityDecimalPlaces)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="mobile-meta">Chưa có thông tin hàng hóa</div>
                }
            </div>
            <a asp-action="Run" asp-route-id="@Model.Run.Id" class="btn btn-outline-secondary mobile-action-button w-100 mt-3">
                <i class="bi bi-arrow-clockwise me-1"></i>Làm mới để kiểm tra duyệt
            </a>
        }
        else if (item.SettlementApproval == (int)DeliverySettlementApprovalStatus.Approved)
        {
            <div class="mobile-status mobile-status-success mt-2" data-note-id="@item.DeliveryNoteId" style="font-size:0.9rem">
                <i class="bi bi-check-circle"></i> Đã duyệt - thu đúng @((item.ApprovedAmountToCollect ?? 0m).DisplayCurrencyWithSymbol())
            </div>
            @if (!string.IsNullOrWhiteSpace(item.SettlementAdminNote))
            {
                <div class="mobile-meta mt-2">Ghi chú admin: @item.SettlementAdminNote</div>
            }
            <button type="button" class="btn btn-success mobile-action-button w-100 mt-3 btn-confirm-approved"
                    data-run-id="@Model.Run.Id" data-note-id="@item.DeliveryNoteId">
                <i class="bi bi-check-circle me-1"></i>Đã thu @((item.ApprovedAmountToCollect ?? 0m).DisplayCurrencyWithSymbol()) · Xác nhận đã giao
            </button>
        }
        else if (noteStatus == DeliveryNoteStatus.Cancelled || item.SettlementApproval == (int)DeliverySettlementApprovalStatus.Rejected)
        {
            <div class="mobile-status mobile-status-muted mt-2">
                <i class="bi bi-x-circle"></i> Bị từ chối - mang hàng về kho
            </div>
            @if (!string.IsNullOrWhiteSpace(item.SettlementAdminNote))
            {
                <div class="mobile-meta mt-2">Lý do: @item.SettlementAdminNote</div>
            }
        }
        else
        {
            <form asp-action="CompleteDeliveryNote" method="post" enctype="multipart/form-data" class="delivery-complete-form mobile-proof-form" data-note-id="@item.DeliveryNoteId" data-settlement="1" data-run-id="@Model.Run.Id" data-amount-to-collect="@item.AmountToCollect.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)">
                <input type="hidden" name="deliveryRunId" value="@Model.Run.Id" />
                <input type="hidden" name="deliveryNoteId" value="@item.DeliveryNoteId" />
                <input type="hidden" name="idempotencyKey" />
                <input type="hidden" name="latitude" />
                <input type="hidden" name="longitude" />
                <input type="hidden" name="locationAddress" />
                <input type="hidden" name="acceptanceItemsJson" />
                <div class="mb-2">
                    <label class="form-label" for="receiverName_@(item.DeliveryNoteId)">Người nhận</label>
                    <input type="text" id="receiverName_@(item.DeliveryNoteId)" name="receiverName" class="form-control" autocomplete="name" value="@(item.CustomerId == CachedValuesService.DefaultCustomerId ? "" : receiverName)" placeholder="Nhập tên người nhận" />
                </div>
                <div class="mobile-goods-box mt-0 mb-2">
                    <div class="mobile-goods-head">
                        <span>Hàng giao</span>
                    </div>
                    @if (item.ProductLines.Any())
                    {
                        <div class="mobile-goods-list">
                            @foreach (var product in item.ProductLines)
                            {
                                var productUnitPrice = item.ProductItems.FirstOrDefault(productItem => productItem.ProductId == product.ProductId)?.UnitPrice ?? 0m;
                                var returnInputName = $"return_{item.DeliveryNoteId:N}_{product.ProductId:N}";
                                <div class="delivery-return-line py-2"
                                     data-product-id="@product.ProductId"
                                     data-quantity="@product.TotalQuantity.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                     data-unit-price="@productUnitPrice.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)"
                                     data-decimals="@product.QuantityDecimalPlaces">
                                    <div class="d-flex justify-content-between gap-2">
                                        <span>@product.ProductName</span>
                                        <strong>@product.TotalQuantity.DisplayQuantity(product.QuantityDecimalPlaces) <span class="text-muted fw-normal">@product.UnitMeasurement</span></strong>
                                    </div>
                                    <div class="row g-2 mt-1">
                                        <div class="col-6">
                                            <label class="form-label mobile-meta mb-1" for="@returnInputName">Trả về</label>
                                            <input class="form-control form-control-sm returned-quantity-input text-end"
                                                   inputmode="decimal"
                                                   data-decimal="quantity" data-decimals="@product.QuantityDecimalPlaces"
                                                   data-val="true" data-val-required="Vui lòng nhập số lượng trả về"
                                                   data-val-range="Số lượng trả về lớn hơn hoặc bằng 0 và nhỏ hơn hoặc bằng @product.TotalQuantity.DisplayQuantity(product.QuantityDecimalPlaces)"
                                                   data-val-range-min="0"
                                                   data-val-range-max="@product.TotalQuantity.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" name="@returnInputName"
                                                   id="@returnInputName" placeholder="Nhập số lượng trả về" />
                                            <span class="small text-danger field-validation-valid"
                                                  data-valmsg-for="@returnInputName" data-valmsg-replace="true"></span>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label mobile-meta mb-1">Khách nhận</label>
                                            <div class="form-control form-control-sm bg-light accepted-quantity-text text-end">@product.TotalQuantity.DisplayQuantity(product.QuantityDecimalPlaces)</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="mb-2 d-none reject-reason">
                            <label class="form-label" for="rejectReason@(item.DeliveryNoteId)">Lý do trả hàng</label>
                            <input name="rejectReason" class="form-control" disabled id="rejectReason@(item.DeliveryNoteId)" placeholder="Nhập lý do trả hàng" 
                                data-val="true" data-val-required="Vui lòng nhập lý do trả hàng"/>
                        </div>
                    }
                    else
                    {
                        <div class="mobile-meta">Chưa có thông tin hàng hóa</div>
                    }
                </div>
                @if (item.AmountToCollect > 0)
                {
                    <div class="mb-2">
                        <label class="form-label" for="amount_@(item.DeliveryNoteId)">Thu tiền khách</label>
                        <div class="input-group">
                            <input name="cashCollectedAmount" class="form-control mobile-money-input"
                                   data-decimal="currency" data-val="true" data-val-required="Vui lòng nhập đơn giá"
                                   data-val-range="Đơn giá phải lớn hơn 0" data-val-range-min="0.001"
                                   data-val-number="Đơn giá phải là số" value="@item.AmountToCollect.DisplayCurrency()"
                                   id="amount_@(item.DeliveryNoteId)" placeholder="Nhập số tiền thu của khách" />
                            <span class="input-group-text fw-bold">đ</span>
                        </div>
                        <span class="small text-danger field-validation-valid" data-valmsg-for="cashCollectedAmount" data-valmsg-replace="true"></span>
                    </div>
                }
                else
                {
                    <input type="hidden" name="cashCollectedAmount" value="0" />
                }
                <div class="mb-2">
                    <label class="form-label" for="proof_@(item.DeliveryNoteId)">Ảnh bằng chứng</label>
                    <input type="file" id="proof_@(item.DeliveryNoteId)" name="proofFile" class="form-control" accept="image/*" capture="environment" required placeholder="Nhập hình ảnh hàng hóa lúc giao" />
                    <div class="mobile-proof-preview" hidden>
                        <img alt="Ảnh bằng chứng đã chọn" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="note_@(item.DeliveryNoteId)">Ghi chú</label>
                    <textarea name="note" class="form-control" rows="2" id="note_@(item.DeliveryNoteId)" placeholder="Nhập ghi chú"></textarea>
                </div>
                <div class="mobile-meta mb-2 d-none settlement-hint">
                    Đề xuất thu: <strong class="settlement-proposed">-</strong> · Cần admin duyệt trước khi thu.
                </div>
                <button type="submit" class="btn btn-success mobile-action-button w-100 btn-complete-full">
                    <i class="bi bi-check-circle me-1"></i>Đã giao
                </button>
                <button type="button" class="btn btn-warning mobile-action-button w-100 btn-request-settlement d-none">
                    <i class="bi bi-send-check me-1"></i>Gửi admin duyệt số tiền thu
                </button>
                <div class="delivery-complete-status mobile-meta mt-2"></div>
            </form>
        }
    </article>
}

<div class="mobile-sticky-actions" hidden>
    <div class="mobile-sync-strip">
        <div>
            <div id="delivery-pending-count" class="mobile-meta"></div>
            <div id="delivery-sync-status" class="mobile-meta"></div>
        </div>
        <a asp-action="Run" asp-route-id="@Model.Run.Id" class="btn btn-outline-secondary btn-sm">Làm mới</a>
    </div>
</div>

<script type="application/json" id="delivery-run-payload">@Html.Raw(cachePayload)</script>

@section Scripts {
    <script type="module">
        import { installDeliveryRunCache, installDeliveryCompletionForms, installDeliveryManualSync } from '/modules/DeliveryMobileCache.js';
        import { installSettlementForms } from '/modules/DeliverySettlement.js';

        document.querySelectorAll('[data-progress-width]').forEach(function (el) {
        const width = el.dataset.progressWidth;
        if (!width)
        return;
        el.style.width = width.endsWith('%') ? width : `${width}%`;
        });

        installDeliveryRunCache({
        runId: '@Model.Run.Id',
        cacheUrl: '@Url.Action("Cache", "DeliveryMobile")'
        });
        installDeliveryCompletionForms();
        installDeliveryManualSync();
        installSettlementForms();

        document.querySelectorAll('.returned-quantity-input').forEach(el => {
        el.addEventListener('input', e => {
        el.form.querySelector('[name="rejectReason"]').disabled = el.value == '0' || !el.value;
        el.form.querySelector('.reject-reason')?.classList.toggle('d-none', el.value == '0' || !el.value);
        });
        });
    </script>
}
