@model DeliveryMobileIndexModel
@using System.Text.Json
@using NamEcommerce.Domain.Shared.Enums.DeliveryNotes
@{
    Layout = "_DeliveryMobileLayout";
    ViewData["Title"] = "Giao hàng";
    var cachePayload = JsonSerializer.Serialize(Model.Runs, new JsonSerializerOptions(JsonSerializerDefaults.Web));
}

<div class="mobile-topbar">
    <div>
        <h1 class="mobile-title">Giao hàng</h1>
        <p class="mobile-subtitle">@Model.CurrentUserFullName</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" asp-route-showCompleted="@(!Model.ShowCompleted)" class="btn btn-outline-secondary mobile-icon-button" aria-label="@(Model.ShowCompleted ? "Ẩn chuyến đã giao" : "Xem chuyến đã giao chờ đóng")">
            <i class="bi @(Model.ShowCompleted ? "bi-eye-slash" : "bi-clock-history")"></i>
        </a>
        <a asp-controller="User" asp-action="Logout" class="btn btn-outline-secondary mobile-icon-button" aria-label="Đăng xuất">
            <i class="bi bi-box-arrow-right"></i>
        </a>
    </div>
</div>

@if (Model.Runs.Any())
{
    foreach (var run in Model.Runs)
    {
        var status = (DeliveryRunStatus)run.Status;
        var statusClass = run.IsDeliveryCompleted
            ? "mobile-status-success"
            : status == DeliveryRunStatus.ReadyForHandover && run.DeliveredItemCount == 0
                ? "mobile-status-ready"
                : "mobile-status-active";
        var statusIcon = run.IsDeliveryCompleted
            ? "bi-check-circle"
            : status == DeliveryRunStatus.ReadyForHandover && run.DeliveredItemCount == 0
                ? "bi-box-seam"
                : "bi-truck";

        <article class="mobile-card">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                    <div class="fw-bold fs-5">@run.Code</div>
                    <div class="mobile-meta mt-1">@run.DeliveredItemCount/@run.ItemCount phiếu đã giao</div>
                </div>
                <span class="mobile-status @statusClass">
                    <i class="bi @statusIcon"></i>
                    @run.StatusName
                </span>
            </div>

            <div class="mobile-stat-grid">
                <div class="mobile-stat">
                    <div class="mobile-stat-label">Phiếu giao</div>
                    <div class="mobile-stat-value">@run.ItemCount</div>
                </div>
                <div class="mobile-stat">
                    <div class="mobile-stat-label">Cần thu</div>
                    <div class="mobile-stat-value">@run.AmountToCollect.DisplayCurrencyWithSymbol()</div>
                </div>
            </div>

            <div class="mobile-stop-list">
                @foreach (var stop in run.Items.Take(2))
                {
                    var receiverName = string.IsNullOrWhiteSpace(stop.ReceiverName) ? stop.CustomerName : stop.ReceiverName;
                    var shippingPhoneNumber = string.IsNullOrWhiteSpace(stop.ShippingPhoneNumber) ? stop.CustomerPhone : stop.ShippingPhoneNumber;
                    var productParts = stop.ProductItems
                        .Take(2)
                        .Select(product => product.ProductName)
                        .ToList();
                    var productSummary = productParts.Count == 0 ? "Chưa có hàng hóa" : string.Join(", ", productParts);
                    var remainingProductCount = stop.ProductItems.Count - productParts.Count;
                    var totalQuantity = stop.ProductItems.Sum(product => product.Quantity);
                    if (remainingProductCount > 0)
                    {
                        productSummary = $"{productSummary} +{remainingProductCount} mặt hàng";
                    }

                    <div class="mobile-stop">
                        <div class="mobile-stop-header">
                            <strong>@receiverName</strong>
                            @if (!string.IsNullOrWhiteSpace(shippingPhoneNumber))
                            {
                                <a href="tel:@shippingPhoneNumber" class="mobile-phone-link">@shippingPhoneNumber</a>
                            }
                        </div>
                        <div class="mobile-stop-address">@stop.ShippingAddress</div>
                        <div class="mobile-stop-goods">
                            <span>@productSummary</span>
                            @if (totalQuantity > 0)
                            {
                                <strong>@totalQuantity.DisplayQuantity()</strong>
                            }
                        </div>
                    </div>
                }
                @if (run.Items.Count > 2)
                {
                    <div class="mobile-meta mt-2">Còn @(run.Items.Count - 2) điểm giao khác</div>
                }
            </div>

            @if (run.HandedOverOnUtc.HasValue)
            {
                <div class="mobile-meta mt-3">
                    <i class="bi bi-clock-history me-1"></i>Bàn giao @run.HandedOverOnUtc.Value.ToLocalTime().ToString("dd/MM HH:mm")
                </div>
            }

            <a asp-action="Run" asp-route-id="@run.Id" class="btn btn-primary mobile-action-button w-100 mt-3">
                <i class="bi bi-arrow-right-circle me-1"></i>Mở chuyến
            </a>
        </article>
    }
}
else
{
    <div class="mobile-card mobile-empty">
        <div class="mobile-empty-icon"><i class="bi bi-truck"></i></div>
        <h2 class="h5 fw-bold mb-2">@(Model.ShowCompleted ? "Chưa có chuyến đã giao chờ đóng" : "Chưa có chuyến cần giao")</h2>
        <p class="mobile-meta mb-0">@(Model.ShowCompleted ? "Chỉ các chuyến đã giao xong nhưng quản kho chưa đóng mới hiện ở đây." : "Chuyến mới sẽ hiện ở đây sau khi quản kho tạo và gán cho bạn.")</p>
    </div>
}

<script type="application/json" id="delivery-index-payload">@Html.Raw(cachePayload)</script>

@section Scripts {
    <script type="module">
        import { installDeliveryIndexCache } from '/modules/DeliveryMobileCache.js';

        installDeliveryIndexCache();
    </script>
}
