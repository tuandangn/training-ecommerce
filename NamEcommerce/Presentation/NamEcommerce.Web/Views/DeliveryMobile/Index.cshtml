@model DeliveryMobileIndexModel
@using NamEcommerce.Domain.Shared.Enums.DeliveryNotes
@{
    Layout = "_DeliveryMobileLayout";
    ViewData["Title"] = "Giao hàng";
}

<div class="mobile-topbar">
    <div>
        <h1 class="mobile-title">Giao hàng</h1>
        <p class="mobile-subtitle">@Model.CurrentUserFullName</p>
    </div>
    <a asp-controller="User" asp-action="Logout" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-box-arrow-right"></i>
    </a>
</div>

@if (Model.Runs.Any())
{
    foreach (var run in Model.Runs)
    {
        var status = (DeliveryRunStatus)run.Status;
        var statusClass = status == DeliveryRunStatus.ReadyForHandover
            ? "bg-info text-white"
            : "bg-warning text-dark";
        var offlineReady = run.DriverCachedOnUtc.HasValue || run.PaperManifestIssued;

        <article class="mobile-card">
            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                <div>
                    <div class="fw-bold fs-5">@run.Code</div>
                    <div class="mobile-meta">@run.ItemCount phiếu giao</div>
                </div>
                <span class="mobile-status @statusClass">@run.StatusName</span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="mobile-meta">Tiền cần thu</span>
                <strong>@run.AmountToCollect.DisplayCurrencyWithSymbol()</strong>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="mobile-meta">Offline</span>
                @if (offlineReady)
                {
                    <span class="text-success fw-bold"><i class="bi bi-check2-circle me-1"></i>Sẵn sàng</span>
                }
                else
                {
                    <span class="text-muted fw-bold"><i class="bi bi-cloud-arrow-down me-1"></i>Chưa cache</span>
                }
            </div>

            <a asp-action="Run" asp-route-id="@run.Id" class="btn btn-primary w-100">
                <i class="bi bi-arrow-right-circle me-1"></i>Mở chuyến
            </a>
        </article>
    }
}
else
{
    <div class="mobile-card text-center py-5">
        <div class="display-6 text-muted mb-2"><i class="bi bi-truck"></i></div>
        <h2 class="h5 fw-bold">Chưa có chuyến cần giao</h2>
        <p class="mobile-meta mb-0">Chuyến mới sẽ hiện ở đây sau khi quản kho tạo và gán cho bạn.</p>
    </div>
}
