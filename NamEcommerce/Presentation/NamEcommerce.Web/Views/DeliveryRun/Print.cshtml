@model DeliveryRunDetailsModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bảng giao hàng - @Model.Code</title>
    <link rel="stylesheet" href="~/css/print/deliveryrun-print.css" asp-append-version="true" />
</head>
<body onload="window.print()">
    <div class="print-page">
        <div class="header">
            <div>
                <strong>CỬA HÀNG VLXD TUẤN KHÔI</strong><br />
                Địa chỉ: Số 123 Đường ABCD, Quận XYZ, TP.HCM<br />
                Điện thoại: 0909.123.456
            </div>
            <div class="text-right">
                <strong>Mã chuyến: @Model.Code</strong><br />
                Ngày @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>

        <div class="title">
            <h1>Phiếu giao hàng</h1>
        </div>

        <table class="summary">
            <tr>
                <td class="summary-label">Người giao:</td>
                <td>@Model.AssignedDeliveryFullName (@Model.AssignedDeliveryUsername)</td>
            </tr>
            <tr>
                <td class="summary-label">Tổng tiền cần thu:</td>
                <td><strong>@Model.Items.Sum(item => item.AmountToCollect).DisplayCurrencyWithSymbol()</strong></td>
            </tr>
            <tr>
                <td class="summary-label">Phiếu ngày:</td>
                <td>@(Model.PaperManifestIssuedOnUtc?.ToLocalTime().ToString(ViewConstants.DefaultDateTimeFormat) ?? DateTime.Now.ToString(ViewConstants.DefaultDateTimeFormat))</td>
            </tr>
        </table>

        <table class="item-table">
            <thead>
                <tr>
                    <th class="text-center ui-w-42">STT</th>
                    <th class="ui-w-110">Mã PXK</th>
                    <th>Khách hàng</th>
                    <th>Địa chỉ giao</th>
                    <th class="text-right ui-w-120">Tiền thu</th>
                    <th class="ui-w-130">Ghi chú giao</th>
                </tr>
            </thead>
            <tbody>
                @for (var index = 0; index < Model.Items.Count; index++)
                {
                    var item = Model.Items[index];
                    <tr>
                        <td class="text-center">@(index + 1)</td>
                        <td>
                            <strong>@item.DeliveryNoteCode</strong><br />
                            <span>@item.OrderCode</span>
                        </td>
                        <td>@item.CustomerName</td>
                        <td>@item.ShippingAddress</td>
                        <td class="text-right">@item.AmountToCollect.DisplayCurrencyWithSymbol()</td>
                        <td></td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="note-box">
            <strong>Ghi chú chuyến:</strong> @Model.Note
        </div>

        <div class="signatures">
            <div class="signature">
                <strong>Quản kho</strong>
                <div class="signature-space"></div>
                <div>Ký, ghi rõ họ tên</div>
            </div>
            <div class="signature">
                <strong>Người giao</strong>
                <div class="signature-space"></div>
                <div>Ký, ghi rõ họ tên</div>
            </div>
            <div class="signature">
                <strong>Thủ quỹ</strong>
                <div class="signature-space"></div>
                <div>Ký khi nhận tiền</div>
            </div>
        </div>
    </div>
</body>
</html>
