@model DeliveryRunDetailsModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bảng giao hàng - @Model.Code</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 13px;
            color: #000;
            margin: 0;
            background: #f0f0f0;
        }
        .print-page {
            width: 210mm;
            min-height: 297mm;
            padding: 18mm;
            margin: 10mm auto;
            background: #fff;
            border: 1px solid #ccc;
            box-shadow: 0 0 5px rgba(0, 0, 0, .12);
        }
        .header {
            display: flex;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 20px;
        }
        .title {
            text-align: center;
            margin: 18px 0;
        }
        .title h1 {
            margin: 0;
            font-size: 24px;
            text-transform: uppercase;
        }
        .summary {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 16px;
        }
        .summary td {
            padding: 4px 6px;
            vertical-align: top;
        }
        .summary-label {
            width: 150px;
            font-weight: bold;
        }
        .item-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 12px;
        }
        .item-table th,
        .item-table td {
            border: 1px solid #000;
            padding: 7px;
            vertical-align: top;
        }
        .item-table th {
            background: #f2f2f2;
            text-align: left;
        }
        .text-center { text-align: center; }
        .text-right { text-align: right; }
        .note-box {
            border: 1px solid #000;
            padding: 10px;
            margin-top: 16px;
            min-height: 36px;
        }
        .signatures {
            display: flex;
            justify-content: space-between;
            margin-top: 48px;
        }
        .signature {
            width: 31%;
            text-align: center;
        }
        .signature-space {
            height: 74px;
        }
        @@media print {
            body {
                background: #fff;
            }
            .print-page {
                margin: 0;
                border: none;
                box-shadow: none;
                width: auto;
                min-height: auto;
            }
        }
    </style>
</head>
<body onload="window.print()">
    <div class="print-page">
        <div class="header">
            <div>
                <strong>CỬA HÀNG VLXD TUẤN KHÔI</strong><br />
                Địa chỉ: Số 123 Đường ABCD, Quận XYZ, TP.HCM<br />
                Điện thoại: 0909.123.456
            </div>
            <div class="text-right">
                <strong>Mã chuyến: @Model.Code</strong><br />
                Ngày @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>

        <div class="title">
            <h1>Phiếu giao hàng</h1>
        </div>

        <table class="summary">
            <tr>
                <td class="summary-label">Người giao:</td>
                <td>@Model.AssignedDeliveryFullName (@Model.AssignedDeliveryUsername)</td>
            </tr>
            <tr>
                <td class="summary-label">Tổng tiền cần thu:</td>
                <td><strong>@Model.Items.Sum(item => item.AmountToCollect).DisplayCurrencyWithSymbol()</strong></td>
            </tr>
            <tr>
                <td class="summary-label">Phiếu ngày:</td>
                <td>@(Model.PaperManifestIssuedOnUtc?.ToLocalTime().ToString(ViewConstants.DefaultDateTimeFormat) ?? DateTime.Now.ToString(ViewConstants.DefaultDateTimeFormat))</td>
            </tr>
        </table>

        <table class="item-table">
            <thead>
                <tr>
                    <th class="text-center" style="width: 42px;">STT</th>
                    <th style="width: 110px;">Mã PXK</th>
                    <th>Khách hàng</th>
                    <th>Địa chỉ giao</th>
                    <th class="text-right" style="width: 120px;">Tiền thu</th>
                    <th style="width: 130px;">Ghi chú giao</th>
                </tr>
            </thead>
            <tbody>
                @for (var index = 0; index < Model.Items.Count; index++)
                {
                    var item = Model.Items[index];
                    <tr>
                        <td class="text-center">@(index + 1)</td>
                        <td>
                            <strong>@item.DeliveryNoteCode</strong><br />
                            <span>@item.OrderCode</span>
                        </td>
                        <td>@item.CustomerName</td>
                        <td>@item.ShippingAddress</td>
                        <td class="text-right">@item.AmountToCollect.DisplayCurrencyWithSymbol()</td>
                        <td></td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="note-box">
            <strong>Ghi chú chuyến:</strong> @Model.Note
        </div>

        <div class="signatures">
            <div class="signature">
                <strong>Quản kho</strong>
                <div class="signature-space"></div>
                <div>Ký, ghi rõ họ tên</div>
            </div>
            <div class="signature">
                <strong>Người giao</strong>
                <div class="signature-space"></div>
                <div>Ký, ghi rõ họ tên</div>
            </div>
            <div class="signature">
                <strong>Thủ quỹ</strong>
                <div class="signature-space"></div>
                <div>Ký khi nhận tiền</div>
            </div>
        </div>
    </div>
</body>
</html>
