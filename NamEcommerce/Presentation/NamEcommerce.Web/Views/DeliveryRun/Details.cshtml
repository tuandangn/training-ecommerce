@model DeliveryRunDetailsModel
@using System.Globalization
@using NamEcommerce.Domain.Shared.Enums.DeliveryNotes
@{
    ViewData["Title"] = "Chi tiết chuyến giao " + Model.Code;

    var status = (DeliveryRunStatus)Model.Status;
    var statusTuple = Model.IsDeliveryCompleted
        ? ("success", "bi-check-circle-fill")
        : Model.DeliveredItemCount > 0 || status == DeliveryRunStatus.HandedToDriver
            ? ("warning", "bi-truck")
            : (status switch
            {
                DeliveryRunStatus.ReadyForHandover => ("info", "bi-box-seam"),
                DeliveryRunStatus.HandedToDriver => ("warning", "bi-truck"),
                DeliveryRunStatus.Closed => ("success", "bi-check-circle-fill"),
                DeliveryRunStatus.Cancelled => ("danger", "bi-x-circle"),
                _ => ("secondary", "bi-question-circle")
            });

    var driverAccepted = Model.DriverCachedOn.HasValue;
    var offlineReady = driverAccepted || Model.PaperManifestIssued;

    var allWarehousesPicked = Model.PickingManifest.Count == 0 || Model.PickingManifest.All(g => g.Confirmed);

    var canHandOver = status == DeliveryRunStatus.ReadyForHandover
        && offlineReady && !Model.IsDeliveryCompleted;

    var deliveredItems = Model.Items
        .Where(item => item.DeliveryNoteStatus == (int)DeliveryNoteStatus.Delivered)
        .ToList();
    var missingCashReviewCount = deliveredItems.Count(item => item.AmountToCollect > 0 && !item.CashCollectedAmount.HasValue);
    var expectedCashAmount = deliveredItems.Sum(item => item.CashCollectedAmount ?? 0m);

    var deliveryProgressPercent = Model.Items.Count == 0 ? 0
        : (int)Math.Round((decimal)Model.DeliveredItemCount * 100 / Model.Items.Count);

    var canConfirmCashHandover = Model.CanConfirmDeliveryRunCashHandover
        && expectedCashAmount > 0
        && missingCashReviewCount == 0
        && (Model.IsDeliveryCompleted || status is not DeliveryRunStatus.ReadyForHandover and not DeliveryRunStatus.Cancelled)
        && !Model.CashHandoverConfirmedOn.HasValue;
}
@section TitleSection {
    <h1 class="topbar-page-title">
        Chuyến giao
        <span class="text-muted">@Model.Code</span>
    </h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="List" asp-controller="DeliveryRun" class="text-decoration-none">Chuyến giao</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Code</li>
            </ol>
        </nav>
    </div>
}
<div class="content-card">
    <div class="content-card-header mb-3">
        <div class="d-flex flex-wrap gap-2 justify-content-end w-100">
            @if (Model.CanManageDeliveryRun)
            {
                if (Model.PaperManifestIssued)
                {
                    <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-printer me-1"></i>In phiếu giấy
                    </a>
                }
                else if (Model.CanIssuePaperManifest)
                {
                    <form asp-action="IssuePaperManifest" method="post" target="_blank" id="issuePaperManifestForm">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-printer me-1"></i>In phiếu giấy
                        </button>
                    </form>
                }
                if (status == DeliveryRunStatus.ReadyForHandover && !Model.IsDeliveryCompleted)
                {
                    <form asp-action="HandOver" method="post" id="handOverForm">
                        <input type="hidden" name="id" value="@Model.Id" />
                        @if (!allWarehousesPicked)
                        {
                            <input type="hidden" name="setProductsPicked" value="true" />
                        }
                        <button type="submit" class="btn btn-sm btn-primary" disabled="@(!canHandOver)">
                            <i class="bi bi-truck me-1"></i>Bàn giao
                        </button>
                    </form>
                }
                if (Model.CanCloseIfDelivered && Model.IsDeliveryCompleted)
                {
                    <form asp-action="Close" method="post" id="closeForm">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-success btn-sm">
                            <i class="bi bi-check-circle me-1"></i>Đóng chuyến
                        </button>
                    </form>
                }
                if (Model.CanCancel)
                {
                    <form asp-action="Cancel" method="post" id="cancelForm">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-x-circle me-1"></i>Hủy chuyến
                        </button>
                    </form>
                }
            }
        </div>
    </div>
    @if (status == DeliveryRunStatus.ReadyForHandover && !offlineReady && !Model.IsDeliveryCompleted)
    {
        <div class="alert alert-warning d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle fs-5"></i>
            <div>Đang chờ người giao hàng nhận chuyến</div>
        </div>
    }
    <div class="content-card-body-flush px-3">
        <div class="row g-3">
            <div class="col-lg-4">
                <div class="border rounded p-3 h-100">
                    <h5 class="fw-bold mb-3"><i class="bi bi-person-check me-2 text-primary"></i>Người giao</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tên người giao</span>
                        <span class="fw-bold">@Model.AssignedDeliveryFullName</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tài khoản</span>
                        <span class="fw-bold text-muted">@Model.AssignedDeliveryUsername</span>
                    </div>
                    @if (Model.HandedOverOn.HasValue)
                    {
                        <hr />
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Đã bàn giao</span>
                            <span class="fw-bold text-muted">@Model.HandedOverOn.Value.ToString(ViewConstants.DefaultDateTimeFormat)</span>
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-4">
                <div class="border rounded p-3 h-100">
                    <h5 class="fw-bold mb-3"><i class="bi bi-cash-stack me-2 text-primary"></i>Tiền shipper giữ</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Đã khai báo</span>
                        <span class="fw-bold">@expectedCashAmount.DisplayCurrencyWithSymbol()</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Phiếu ghi nợ</span>
                        <span class="fw-bold @(missingCashReviewCount > 0 ? "text-warning" : "text-muted")">@missingCashReviewCount phiếu</span>
                    </div>
                    @if (Model.CashHandoverConfirmedOn.HasValue)
                    {
                        <hr />
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">
                                Thủ quỹ đã nhận
                                @if (!string.IsNullOrWhiteSpace(Model.CashHandoverConfirmedByFullName))
                                {
                                    <span class="small text-muted d-block fw-medium">@Model.CashHandoverConfirmedByFullName</span>
                                }
                            </span>
                            <span class="fw-bold text-muted">
                                @((Model.CashHandoverAmount ?? 0m).DisplayCurrencyWithSymbol())
                                <span class="small text-muted fw-normal d-block">@Model.CashHandoverConfirmedOn.Value.ToLocalTime().ToString(ViewConstants.DefaultDateTimeFormat)</span>
                            </span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.CashHandoverNote))
                        {
                            <div class="small mt-2">@Model.CashHandoverNote</div>
                        }
                    }
                    else if (canConfirmCashHandover)
                    {
                        <hr />
                        <form asp-action="ConfirmCashHandover" method="post" id="confirmCashHandoverForm">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <label class="form-label small fw-bold text-muted text-uppercase">Tiền thủ quỹ nhận</label>
                            <div class="d-flex align-items-start gap-2">
                                <div>
                                    <input name="amount" class="form-control text-end" data-decimal="currency" value="@expectedCashAmount.DisplayCurrency()" placeholder="Nhập số tiền nhận"
                                           data-val="true" data-val-required="Vui lòng nhập số tiền nhận" inputmode="numeric"
                                           data-val-range="Số tiền nhận phải lớn hơn 0" data-val-range-min="0.001"
                                           data-val-number="Số tiền nhận phải là số" />
                                    <span class="small text-danger field-validation-valid" data-valmsg-for="amount" data-valmsg-replace="true"></span>
                                </div>
                                <input name="note" class="form-control ui-w-100" placeholder="Ghi chú" />
                                <button type="submit" class="btn btn-primary btn-sm text-nowrap">
                                    <i class="bi bi-cash-coin me-1"></i>Xác nhận
                                </button>
                            </div>
                        </form>
                    }
                    else if (missingCashReviewCount > 0)
                    {
                        <hr />
                        <div class="alert alert-warning mb-0">
                            Cần khai báo tiền shipper đã thu cho @missingCashReviewCount phiếu đã giao trước khi thủ quỹ xác nhận nhận tiền.
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Note))
                    {
                        <hr />
                        <div class="small text-muted text-uppercase fw-bold">Ghi chú</div>
                        <div>@Model.Note</div>
                    }
                </div>
            </div>
            <div class="col-lg-4">
                <div class="border rounded p-3 h-100">
                    <h5 class="fw-bold mb-3"><i class="bi bi-info-circle me-2 text-primary"></i>Trạng thái</h5>
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                        <span class="status-badge @statusTuple.Item1">
                            <i class="bi @statusTuple.Item2 me-1"></i>@Model.DeliveryStatusInfo
                        </span>
                        <span class="small text-muted">@Model.DeliveredItemCount/@Model.Items.Count phiếu đã giao</span>
                    </div>
                    <div class="progress mb-3 ui-h-8">
                        <div class="progress-bar bg-success" role="progressbar" data-progress-width="@deliveryProgressPercent" aria-valuenow="@deliveryProgressPercent" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Người giao đã xem</span>
                        <span class="fw-bold @(Model.DriverCachedOn.HasValue ? "text-success" : "text-muted") text-end">
                            @if (Model.DriverCachedOn.HasValue)
                            {
                                <span class="text-muted fw-bold">@Model.DriverCachedOn.Value.ToLocalTime().ToString(ViewConstants.DefaultDateTimeFormat)</span>
                            }
                            else
                            {
                                @(Model.DriverCachedOn.HasValue ? "Có" : "Chưa")
                            }
                        </span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Phiếu giấy</span>
                        <span class="fw-bold @(Model.PaperManifestIssued ? "text-success" : "text-muted")">
                            @(Model.PaperManifestIssued ? "Đã in" : "Chưa in")
                        </span>
                    </div>
                    @if (Model.PaperManifestIssuedOnUtc.HasValue)
                    {
                        <div class="small text-muted">@Model.PaperManifestIssuedOnUtc.Value.ToLocalTime().ToString(ViewConstants.DefaultDateTimeFormat)</div>
                    }
                </div>
            </div>
        </div>
    </div>
    @if (Model.PickingManifest.Count > 0 && status == DeliveryRunStatus.ReadyForHandover)
    {
        var confirmedCount = Model.PickingManifest.Count(g => g.Confirmed);
        var totalCount = Model.PickingManifest.Count;
        <div class="content-card-header d-flex align-items-center justify-content-between">
            <h5 class="mb-0">Phiếu lấy hàng theo kho</h5>
            <span class="badge @(confirmedCount == totalCount ? "bg-success" : "bg-warning")">
                Đã lấy @confirmedCount/@totalCount kho
            </span>
        </div>
        <div class="content-card-body-flush px-3 pb-3">
            <div class="row g-3">
                @foreach (var group in Model.PickingManifest)
                {
                    <div class="col-md-6">
                        <div class="border rounded p-3 @(group.Confirmed ? "border-success" : "")">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="fw-bold mb-0">
                                        <i class="bi bi-building me-1"></i>@group.WarehouseName
                                    </h6>
                                    @if (group.Confirmed)
                                    {
                                        <div class="small text-success mt-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>
                                            Đã xác nhận@(string.IsNullOrWhiteSpace(group.ConfirmedByFullName) ? "" : $" bởi {group.ConfirmedByFullName}")
                                            @if (group.ConfirmedOnUtc.HasValue)
                                            {
                                                <span class="text-muted"> — @group.ConfirmedOnUtc.Value.ToLocalTime().ToString(ViewConstants.DefaultDateTimeFormat)</span>
                                            }
                                        </div>
                                    }
                                </div>
                                @if (Model.CanManageDeliveryRun && !group.Confirmed)
                                {
                                    <form asp-action="ConfirmWarehousePick" method="post" class="confirmWarehouseForm">
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <input type="hidden" name="warehouseId" value="@group.WarehouseId" />
                                        <button type="submit" class="btn btn-sm btn-outline-success" disabled="@(!offlineReady)">
                                            <i class="bi bi-check2 me-1"></i>Xác nhận đủ hàng
                                        </button>
                                    </form>
                                }
                            </div>
                            <table class="table table-sm mb-0">
                                <tbody>
                                    @for (var i = 0; i < group.Products.Count; i++)
                                    {
                                        var product = group.Products[i];
                                        <tr>
                                            <td class="ps-0 @(i == group.Products.Count - 1 ? "border-bottom-0" : "")">
                                                @product.ProductName
                                            </td>
                                            <td class="text-end text-nowrap fw-medium @(i == group.Products.Count - 1 ? "border-bottom-0" : "")">
                                                @product.TotalQuantity.DisplayQuantity(product.QuantityDecimalPlaces)
                                                <span class="text-muted">
                                                    @product.UnitMeasurement
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    <div class="content-card-header">
        <h5>Phiếu giao hàng</h5>
    </div>
    <div class="content-card-body-flush">
        <div class="table-responsive">
            <table class="table data-table align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">Mã PXK</th>
                        <th>Đơn hàng</th>
                        <th>Khách hàng</th>
                        <th>Địa chỉ giao</th>
                        <th class="text-end">Tiền COD</th>
                        <th class="text-end pe-3">Shipper thu</th>
                        @if ((Model.CanReconcileDeliveryRunItems && Model.Items.Any(item => item.DeliveryNoteStatus == (int)DeliveryNoteStatus.PendingConfirmation))
                            || Model.CanConfirmDeliveryRunCashHandover && Model.CanReviewCashCollected && Model.Items.Any(item => item.DeliveryNoteStatus == (int) DeliveryNoteStatus.Delivered))
                        {
                            <th class="text-end pe-3">Cập nhật</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var isDelivered = item.DeliveryNoteStatus == (int)DeliveryNoteStatus.Delivered;
                        <tr>
                            <td class="ps-4">
                                <a asp-controller="DeliveryNote" asp-action="Details" asp-route-id="@item.DeliveryNoteId" class="fw-bold text-decoration-none text-nowrap">
                                    @item.DeliveryNoteCode
                                </a>
                            </td>
                            <td class="text-nowrap">@item.OrderCode</td>
                            <td>
                                <div class="fw-medium">@item.CustomerName</div>
                                @if (!string.IsNullOrWhiteSpace(item.ShippingPhoneNumber))
                                {
                                    <a href="tel:@item.ShippingPhoneNumber" class="small text-muted text-decoration-none">@item.ShippingPhoneNumber</a>
                                }
                            </td>
                            <td>@item.ShippingAddress</td>
                            <td class="text-end fw-medium text-nowrap">@item.AmountToCollect.DisplayCurrencyWithSymbol()</td>
                            <td class="text-end fw-medium pe-3">
                                @if (!isDelivered && item.SettlementApproval == 1)
                                {
                                    <span class="status-badge warning small"><i class="bi bi-hourglass-split me-1"></i>Chờ duyệt số tiền thu</span>
                                }
                                else if (item.DeliveryNoteStatus == (int)DeliveryNoteStatus.PendingConfirmation)
                                {
                                    <span class="status-badge warning small"><i class="bi bi-hourglass-split me-1"></i>Chờ đối soát</span>
                                }
                                else if (!isDelivered)
                                {
                                    <span class="text-muted">Chưa giao</span>
                                }
                                else if (item.CashCollectedAmount.HasValue)
                                {
                                    @item.CashCollectedAmount.Value.DisplayCurrencyWithSymbol()
                                }
                                else if (item.AmountToCollect > 0)
                                {
                                    <span class="text-warning">Chưa khai báo</span>
                                }
                                else
                                {
                                    @(0m.DisplayCurrencyWithSymbol())
                                }
                            </td>
                            @if ((Model.CanReconcileDeliveryRunItems && Model.Items.Any(item => item.DeliveryNoteStatus == (int)DeliveryNoteStatus.PendingConfirmation))
                                || (Model.CanConfirmDeliveryRunCashHandover && Model.CanReviewCashCollected && isDelivered))
                            {
                                <td class="text-end pe-3">
                                    @if (Model.CanReconcileDeliveryRunItems && item.DeliveryNoteStatus == (int)DeliveryNoteStatus.PendingConfirmation)
                                    {
                                        <form asp-action="ReconcileDeliveryNote" method="post" class="reconcileForm @(item.AmountToCollect > 0 ? "hasAmountToCollect" : "")">
                                            <input type="hidden" name="id" value="@Model.Id" />
                                            <input type="hidden" name="deliveryNoteId" value="@item.DeliveryNoteId" />
                                            <div class="d-flex justify-content-end gap-1">
                                                @if (item.AmountToCollect > 0)
                                                {
                                                    <div>
                                                        <input name="cashCollectedAmount" class="form-control form-control-sm text-end ui-w-140"
                                                               placeholder="Nhập số tiền đã thu" inputmode="numeric"
                                                               value="@((item.CashCollectedAmount ?? item.AmountToCollect).DisplayCurrency())"
                                                               data-decimal="currency" data-val="true" data-val-required="Vui lòng nhập số tiền đã thu"
                                                               data-val-range="Số tiền thu phải lớn hơn 0" data-val-range-min="0.001" data-val-number="Số tiền thu phải là số" />
                                                        <span class="small text-danger field-validation-valid" data-valmsg-for="cashCollectedAmount" data-valmsg-replace="true"></span>
                                                    </div>
                                                    <button type="submit" class="btn btn-sm btn-primary text-nowrap">
                                                        <i class="bi bi-cash-coin me-1"></i>Xác nhận đã thu
                                                    </button>
                                                }
                                                else
                                                {
                                                    <input type="hidden" name="cashCollectedAmount" value="0" />
                                                    <button type="submit" class="btn btn-sm btn-success text-nowrap">
                                                        <i class="bi bi-check-circle me-1"></i>Xác nhận đã giao
                                                    </button>
                                                }
                                            </div>
                                            <span class="small text-danger field-validation-valid d-block text-start" data-valmsg-for="cashCollectedAmount" data-valmsg-replace="true"></span>
                                        </form>
                                    }
                                    else if (Model.CanConfirmDeliveryRunCashHandover && Model.CanReviewCashCollected && isDelivered)
                                    {
                                        <form asp-action="UpdateDeliveredNoteCashCollected" method="post" class="d-flex justify-content-end gap-1 updateAmounCashForm">
                                            <input type="hidden" name="id" value="@Model.Id" />
                                            <input type="hidden" name="deliveryNoteId" value="@item.DeliveryNoteId" />
                                            <div>
                                                <input name="cashCollectedAmount" class="form-control form-control-sm text-end ui-w-140"
                                                       value="" placeholder="Nhập số tiền đã thu" inputmode="numeric"
                                                       data-decimal="currency" data-val="true" data-val-required="Vui lòng nhập số tiền đã thu"
                                                       data-val-range="Số tiền thu phải lớn hơn 0 và nhỏ hơn @item.AmountToCollect.DisplayCurrency()"
                                                       data-val-range-min="0.001" data-val-range-max="@item.AmountToCollect.ToString(CultureInfo.InvariantCulture)"
                                                       data-val-number="Số tiền thu phải là số" />
                                                <span class="small text-danger field-validation-valid" data-valmsg-for="cashCollectedAmount" data-valmsg-replace="true"></span>
                                            </div>
                                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-save me-1"></i>Thay đổi
                                            </button>
                                        </form>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" defer>
        import { confirm } from '/modules/modals.js';

        const reconcileForms = document.querySelectorAll('.reconcileForm');
        if (reconcileForms) {
            Array.from(reconcileForms).forEach(form => {
                const submitBtn = form.querySelector('[type=submit]');
                if(!submitBtn) return;
                submitBtn.addEventListener('click', async (e) => {
                    e.preventDefault();

                    if (!$(form).valid()) 
                        return;

                    let confirmed;
                    if (form.classList.contains('hasAmountToCollect')) {
                        const amountToCollectEl = form.querySelector('[name=cashCollectedAmount]');
                        confirmed = await confirm('Đã thu tiền', `Xác nhận đã thu ${amountToCollectEl?.value}đ`);
                    } else {
                        confirmed = await confirm('Đã giao hàng', 'Xác nhận đã giao hàng cho khách');
                    }
                    if(!confirmed)
                        return;

                    showPageLoading();
                    form.submit();
                });
            });
        }


        const confirmWarehouseForms = document.querySelectorAll('.confirmWarehouseForm');
        if (confirmWarehouseForms) {
            Array.from(confirmWarehouseForms).forEach(form => {
                form.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const confirmed = await confirm('Đã lấy hàng', 'Xác nhận đã lấy đủ hàng ở kho này');
                    if(!confirmed)
                        return;

                    showPageLoading();
                    form.submit();
                });
            });
        }

        const updateAmounCashForms = document.querySelectorAll('.updateAmounCashForm');
        if (updateAmounCashForms) {
            Array.from(updateAmounCashForms).forEach(form => {
                const submitBtn = form.querySelector('[type=submit]');
                if(!submitBtn) return;
                submitBtn.addEventListener('click', async (e) => {
                    e.preventDefault();

                    if (!$(form).valid()) 
                        return;

                    const amountToCollectEl = form.querySelector('[name=cashCollectedAmount]');
                    const confirmed = await confirm('Thay đổi số tiền đã thu', `Xác nhận thay đổi số tiền đã thu thành ${amountToCollectEl?.value}đ`);
                    if(!confirmed)
                        return;

                    showPageLoading();
                    form.submit();
                });
            });
        }

        const confirmCashHandoverForm = document.getElementById('confirmCashHandoverForm');
        if (confirmCashHandoverForm) {
            const submitBtn = confirmCashHandoverForm.querySelector('[type=submit]');
            if(submitBtn){
                submitBtn.addEventListener('click', async (e) => {
                    e.preventDefault();

                    if (!$(confirmCashHandoverForm).valid())
                        return;

                    showPageLoading();
                    confirmCashHandoverForm.submit();
                });
            }
        }

        const closeForm = document.getElementById('closeForm');
        if (closeForm) {
            closeForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const confirmed = await confirm('Đóng chuyến giao', 'Xác nhận đóng chuyến giao này?');
                if (!confirmed) return;
                showPageLoading();
                closeForm.submit();
            });
        }


        const issuePaperManifestForm = document.getElementById('issuePaperManifestForm');
        if (issuePaperManifestForm) {
            issuePaperManifestForm.addEventListener('submit', async (e) => {
                showPageLoading();
                setTimeout(() => location.reload(), 700);
            });
        }

        const cancelForm = document.getElementById('cancelForm');
        if (cancelForm) {
            cancelForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const confirmed = await confirm('Hủy chuyến giao', 'Xác nhận hủy chuyến giao này?');
                if (!confirmed) return;
                showPageLoading();
                cancelForm.submit();
            });
        }

        const handOverForm = document.getElementById('handOverForm');
        if (handOverForm) {
            handOverForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                let confirmed;
                @if (allWarehousesPicked)
                    {
                        <text>
                                confirmed = true;
                        </text>
                }
                    else
                    {
                        <text>
                                confirmed = await confirm('Bàn giao cho người giao hàng', 'Xác nhận hàng hóa đã được lấy đầy đủ và tiến hành bàn giao cho người giao hàng?');
                        </text>
                }
                                                                        if (!confirmed) return;
                showPageLoading();
                handOverForm.submit();
            });
        }
    </script>
}