@using NamEcommerce.Web.Contracts.Models.Debts
@using NamEcommerce.Web.Models.VendorDebts
@model VendorLedgerListModel
@{
    ViewData[ViewConstants.PageTitle] = "Công nợ nhà cung cấp";
    var query = Model.Keywords;
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">Công nợ nhà cung cấp</h1>
        <p class="page-header-subtitle">Số dư công nợ theo từng NCC — nhấn vào tên để xem sao kê và ghi nhận thanh toán</p>
    </div>
</div>

<div class="content-card" data-responsive-list data-list-key="vendor-debt-list">
    <div class="action-toolbar">
        <partial name="_Search" model="@(new VendorDebtListSearchModel { Keywords = query })" />
        <partial name="_ResponsiveListToolbar" />
    </div>
    <div class="responsive-list-panel" data-list-view-panel="list">
        <div class="table-responsive">
            <table class="table data-table align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">Nhà cung cấp</th>
                        <th class="text-end">Số dư công nợ</th>
                        <th class="text-end">Giao dịch cuối</th>
                        <th style="width: 80px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Data?.Pagination.TotalCount > 0)
                    {
                        @foreach (var item in Model.Data)
                        {
                            var isDebt = item.Balance > 0;
                            var isCredit = item.Balance < 0;
                            <tr>
                                <td class="ps-4">
                                    <a asp-action="Details" asp-route-vendorId="@item.VendorId" class="fw-medium text-decoration-none">
                                        <i class="bi bi-building me-1"></i>
                                        @HighlighHelper.Highlight(item.VendorName, Model.Keywords)
                                    </a>
                                    @if (!string.IsNullOrEmpty(item.VendorPhone))
                                    {
                                        <div>
                                            <a href="tel:@item.VendorPhone" class="text-muted small text-decoration-none">
                                                <i class="bi bi-telephone me-1"></i> @HighlighHelper.Highlight(item.VendorPhone, Model.Keywords)
                                            </a>
                                        </div>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (isDebt)
                                    {
                                        <span class="fw-bold text-danger">@item.Balance.ToString(ViewConstants.CurrencyDisplayFormat)</span>
                                        <div class="small text-muted">Còn phải trả</div>
                                    }
                                    else if (isCredit)
                                    {
                                        <span class="fw-bold text-success">@(Math.Abs(item.Balance).ToString(ViewConstants.CurrencyDisplayFormat))</span>
                                        <div class="small text-muted">NCC dư — ta đã trả thừa</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-end text-muted small">
                                    @(item.LastEntryOnUtc.HasValue
                                        ? item.LastEntryOnUtc.Value.ToLocalTime().ToString(ViewConstants.DefaultDateFormat)
                                        : "—")
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="Details" asp-route-vendorId="@item.VendorId"
                                       class="btn-table-action" aria-label="Xem sao kê @item.VendorName">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">
                                <div class="empty-state py-5">
                                    <div class="empty-icon">
                                        <i class="bi @(!string.IsNullOrWhiteSpace(Model.Keywords) ? "bi-search" : "bi-building")"></i>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(Model.Keywords))
                                    {
                                        <h5>Không tìm thấy nhà cung cấp</h5>
                                        <p class="text-muted">Không có NCC nào khớp với từ khoá "<strong>@Model.Keywords</strong>".</p>
                                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-4 mt-2">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i> Xoá bộ lọc
                                        </a>
                                    }
                                    else
                                    {
                                        <h5>Chưa có công nợ NCC</h5>
                                        <p class="text-muted">Công nợ phát sinh khi hàng nhập kho được xác nhận.</p>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model.Data?.Pagination.TotalCount > 0)
    {
        <partial name="_Pager" model="Model.Data.Pagination" />
    }
</div>
