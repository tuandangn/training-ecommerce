@using NamEcommerce.Domain.Shared.Enums.Debts
@using NamEcommerce.Domain.Shared.Enums.Orders
@using NamEcommerce.Web.Contracts.Models.Debts
@using NamEcommerce.Web.Extensions
@model VendorLedgerDetailsModel
@{
    ViewData[ViewConstants.PageTitle] = $"Sao kê NCC: {Model.VendorName}";
    var isDebt = Model.Balance > 0;
    var isCredit = Model.Balance < 0;
}

<div class="page-header">
    <div class="d-flex align-items-center">
        <a asp-action="Index" class="btn btn-icon btn-light me-3 shadow-sm border" aria-label="Quay lại danh sách">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h1 class="page-header-title">@Model.VendorName</h1>
            <p class="page-header-subtitle mb-0">Sao kê công nợ</p>
        </div>
    </div>
    <div class="d-flex gap-2 align-items-center">
        @if (isCredit)
        {
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-6 fw-bold">
                <i class="bi bi-arrow-down-circle me-1"></i>
                Đã trả thừa @(Math.Abs(Model.Balance).ToString(ViewConstants.CurrencyDisplayFormat))
            </span>
        }
        <button type="button" class="btn btn-danger shadow-sm" data-bs-toggle="modal" data-bs-target="#paymentModal">
            <i class="bi bi-cash-coin me-1"></i> Chi tiền NCC
        </button>
    </div>
</div>

@* ── Summary cards ── *@
<div class="row g-3 mb-4">
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 text-center p-4 @(isDebt ? "border-danger border" : isCredit ? "border-success border" : "")">
            <div class="text-muted small text-uppercase fw-bold mb-1">Số dư công nợ</div>
            @if (isDebt)
            {
                <div class="fs-3 fw-bold text-danger">@Model.Balance.ToString(ViewConstants.CurrencyDisplayFormat)</div>
                <div class="small text-danger mt-1">Còn phải trả NCC</div>
            }
            else if (isCredit)
            {
                <div class="fs-3 fw-bold text-success">@(Math.Abs(Model.Balance).ToString(ViewConstants.CurrencyDisplayFormat))</div>
                <div class="small text-success mt-1">Đã trả thừa — NCC nợ lại ta</div>
            }
            else
            {
                <div class="fs-3 fw-bold text-muted">0</div>
                <div class="small text-muted mt-1">Đã thanh toán đủ</div>
            }
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 text-center p-4">
            <div class="text-muted small text-uppercase fw-bold mb-1">Giao dịch cuối</div>
            <div class="fs-5 fw-bold text-dark">
                @(Model.LastEntryOnUtc.HasValue ? Model.LastEntryOnUtc.Value.ToLocalTime().ToString(ViewConstants.DefaultDateFormat) : "—")
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 text-center p-4">
            <div class="text-muted small text-uppercase fw-bold mb-1">Tổng giao dịch</div>
            <div class="fs-5 fw-bold text-dark">@Model.TotalCount</div>
        </div>
    </div>
</div>

@* ── Ledger statement ── *@
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-header bg-white border-bottom py-3 px-4">
        <h6 class="mb-0 fw-bold text-uppercase small text-muted">Sao kê giao dịch</h6>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="bg-light bg-opacity-50">
                <tr>
                    <th class="ps-4 border-0 small text-uppercase text-muted fw-bold">Ngày</th>
                    <th class="border-0 small text-uppercase text-muted fw-bold">Loại</th>
                    <th class="border-0 small text-uppercase text-muted fw-bold">Chứng từ</th>
                    <th class="text-end border-0 small text-uppercase text-muted fw-bold">Phát sinh nợ</th>
                    <th class="text-end border-0 small text-uppercase text-muted fw-bold">Phát sinh có</th>
                    <th class="text-end border-0 small text-uppercase text-muted fw-bold pe-4">Số dư</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.Statement)
                {
                    var entryType = (VendorLedgerEntryType)entry.EntryType;
                    var refType = (VendorLedgerReferenceType)entry.ReferenceType;
                    var isCharge = entry.Amount > 0;
                    <tr>
                        <td class="ps-4 text-muted small text-nowrap">
                            @entry.OccurredAtUtc.ToLocalTime().ToString(ViewConstants.DefaultDateFormat)
                        </td>
                        <td>
                            @{
                                var (badgeClass, label) = entryType switch
                                {
                                    VendorLedgerEntryType.GoodsReceiptCharge => ("bg-danger-subtle text-danger", "Nhập hàng"),
                                    VendorLedgerEntryType.OpeningBalance => ("bg-secondary-subtle text-secondary", "Đầu kỳ"),
                                    VendorLedgerEntryType.Payment => ("bg-success-subtle text-success", "Chi tiền"),
                                    VendorLedgerEntryType.ReturnCredit => ("bg-info-subtle text-info", "Trả hàng NCC"),
                                    VendorLedgerEntryType.RefundReceipt => ("bg-warning-subtle text-warning", "Nhận hoàn tiền"),
                                    VendorLedgerEntryType.Correction => ("bg-secondary-subtle text-secondary", "Điều chỉnh"),
                                    _ => ("bg-light text-muted", entryType.ToString())
                                };
                            }
                            <span class="badge @badgeClass fw-normal">@label</span>
                        </td>
                        <td>
                            @if (entry.ReferenceId.HasValue && !string.IsNullOrEmpty(entry.ReferenceCode))
                            {
                                @if (refType == VendorLedgerReferenceType.GoodsReceipt)
                                {
                                    <a asp-controller="GoodsReceipt" asp-action="Details" asp-route-id="@entry.ReferenceId"
                                       class="text-decoration-none fw-medium">@entry.ReferenceCode</a>
                                }
                                else if (refType == VendorLedgerReferenceType.VendorReturn)
                                {
                                    <a asp-controller="VendorReturn" asp-action="Details" asp-route-id="@entry.ReferenceId"
                                       class="text-decoration-none fw-medium">@entry.ReferenceCode</a>
                                }
                                else if (refType == VendorLedgerReferenceType.VendorPayment)
                                {
                                    <a asp-action="Receipt" asp-route-paymentId="@entry.ReferenceId" target="_blank"
                                       class="text-decoration-none fw-medium">@entry.ReferenceCode</a>
                                }
                                else
                                {
                                    <span class="fw-medium">@entry.ReferenceCode</span>
                                }
                            }
                            @if (!string.IsNullOrEmpty(entry.Note))
                            {
                                <div class="text-muted small fst-italic">@entry.Note</div>
                            }
                        </td>
                        <td class="text-end">
                            @if (isCharge)
                            {
                                <span class="fw-bold text-danger">@entry.Amount.ToString(ViewConstants.CurrencyDisplayFormat)</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (!isCharge)
                            {
                                <span class="fw-bold text-success">@(Math.Abs(entry.Amount).ToString(ViewConstants.CurrencyDisplayFormat))</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-end pe-4 fw-bold @(entry.RunningBalance > 0 ? "text-danger" : entry.RunningBalance < 0 ? "text-success" : "text-muted")">
                            @entry.RunningBalance.ToString(ViewConstants.CurrencyDisplayFormat)
                        </td>
                    </tr>
                }
                @if (!Model.Statement.Any())
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state py-5">
                                <div class="empty-icon"><i class="bi bi-journal-text"></i></div>
                                <h5>Chưa có giao dịch nào</h5>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalCount > 50)
    {
        <div class="card-footer bg-light border-top py-3 px-4 d-flex justify-content-center gap-2">
            @if (Model.PageIndex > 1)
            {
                <a asp-action="Details" asp-route-vendorId="@Model.VendorId" asp-route-pageIndex="@(Model.PageIndex - 1)"
                   class="btn btn-sm btn-outline-secondary rounded-3">
                    <i class="bi bi-chevron-left me-1"></i>Trước
                </a>
            }
            <span class="btn btn-sm btn-light border rounded-3 disabled">Trang @Model.PageIndex</span>
            @if (Model.TotalCount > Model.PageIndex * 50)
            {
                <a asp-action="Details" asp-route-vendorId="@Model.VendorId" asp-route-pageIndex="@(Model.PageIndex + 1)"
                   class="btn btn-sm btn-outline-secondary rounded-3">
                    Sau<i class="bi bi-chevron-right ms-1"></i>
                </a>
            }
        </div>
    }
</div>

@* ── Modal chi tiền NCC ── *@
<div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-danger text-white pt-4 px-4 pb-3">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-cash-coin me-2"></i>Chi tiền — @Model.VendorName
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form id="paymentForm">
                <input type="hidden" name="vendorId" value="@Model.VendorId" />
                <div class="modal-body p-4">
                    @if (isDebt)
                    {
                        <div class="alert alert-danger-subtle border border-danger-subtle rounded-3 small mb-4">
                            <i class="bi bi-info-circle me-2 text-danger"></i>
                            Số dư còn phải trả:
                            <strong class="text-danger">@Model.Balance.ToString(ViewConstants.CurrencyDisplayFormat)</strong>
                        </div>
                    }
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-2" for="paymentAmount">
                                Số tiền chi <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-lg bg-light rounded-3 border">
                                <input class="form-control bg-transparent border-0 fw-bold text-danger no-additional-element no-hint"
                                       type="number" step="1000" name="amount" id="paymentAmount"
                                       value="@(isDebt ? Model.Balance.DisplayCurrency() : "")"
                                       required min="1" />
                                <span class="input-group-text bg-transparent border-0 fw-bold text-danger">đ</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-2">Phương thức</label>
                            <div class="d-flex gap-2">
                                <input type="radio" class="btn-check" name="paymentMethod" id="methodCash" value="@((int)PaymentMethod.Cash)" checked>
                                <label class="btn btn-outline-secondary w-100 py-2 rounded-3" for="methodCash">
                                    <i class="bi bi-cash-stack me-1"></i>Tiền mặt
                                </label>
                                <input type="radio" class="btn-check" name="paymentMethod" id="methodBank" value="@((int)PaymentMethod.BankTransfer)">
                                <label class="btn btn-outline-secondary w-100 py-2 rounded-3" for="methodBank">
                                    <i class="bi bi-bank me-1"></i>Chuyển khoản
                                </label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-2" for="paymentPaidOn">Ngày chi</label>
                            <input id="paymentPaidOn" type="datetime-local" class="form-control rounded-3" name="paidOn"
                                   value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-2" for="paymentNote">Ghi chú</label>
                            <textarea id="paymentNote" class="form-control rounded-3" name="note" rows="2"
                                      placeholder="VD: Chuyển khoản cho NCC @Model.VendorName..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top-0 p-4">
                    <button type="button" class="btn btn-light px-4 rounded-3 border" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" id="btnSubmitPayment" class="btn btn-danger px-4 rounded-3 shadow-sm fw-bold">
                        <i class="bi bi-check2-circle me-1"></i>Xác nhận chi tiền
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module">
        import { toast } from "/modules/modals.js";

        (function () {
            const form = document.getElementById('paymentForm');
            const submitBtn = document.getElementById('btnSubmitPayment');

            $(form).on('submit', async function (e) {
                e.preventDefault();
                if (!form.checkValidity()) { form.reportValidity(); return; }

                submitBtn.disabled = true;
                const orig = submitBtn.innerHTML;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý...';

                try {
                    const res = await $.ajax({
                        url: '@Url.Action("RecordFlexiblePayment")',
                        type: 'POST',
                        data: $(form).serialize()
                    });
                    if (res.success) {
                        toast('Thành công', res.message, 'success');
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        toast('Lỗi', res.message, 'error');
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = orig;
                    }
                } catch {
                    toast('Lỗi', 'Có lỗi xảy ra trong quá trình xử lý.', 'error');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = orig;
                }
            });
        })();
    </script>
}
