@using NamEcommerce.Domain.Shared.Enums.Debts
@using NamEcommerce.Domain.Shared.Enums.Orders
@using NamEcommerce.Web.Contracts.Models.Debts
@using NamEcommerce.Web.Extensions
@model VendorDebtDetailsModel
@{
    ViewData[ViewConstants.PageTitle] = $"Công nợ NCC: {Model.VendorName}";

    var hasOutstanding = Model.TotalRemainingAmount > 0;
    var hasAdvance     = Model.AdvanceBalance > 0;
    var hasCreditNote  = Model.UnappliedCreditNoteBalance > 0;
    var paidPct = Model.TotalDebtAmount > 0
        ? (Model.TotalPaidAmount / Model.TotalDebtAmount * 100m)
        : 0m;
}

@section Styles {
    <style>
        /* ── Data-Dense Dashboard tokens (scoped) ─────────── */
        .vendor-debt-page {
            --slate-50:  #F8FAFC;
            --slate-100: #F1F5F9;
            --slate-200: #E6E8EA;
            --slate-400: #94A3B8;
            --slate-500: #64748B;
            --slate-600: #475569;
            --slate-700: #334155;
            --slate-900: #0F172A;
            --stock-green: #059669;
            --stock-green-soft: #ECFDF5;
            --destructive: #DC2626;
            --destructive-soft: #FEF2F2;
            --amber-700: #B45309;
            --amber-50:  #FFFBEB;
            --amber-200: #FDE68A;

            color: var(--slate-900);
        }

        /* ── Hero summary (denser) ────────────────────────── */
        .debt-hero {
            background: #fff;
            border: 1px solid var(--slate-200);
            border-radius: 12px;
            padding: 1.1rem 1.25rem;
            margin-bottom: 0.85rem;
        }
        .debt-hero .hero-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
        }
        .debt-hero .hero-label {
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--slate-500);
            margin-bottom: 0.2rem;
        }
        .debt-hero .hero-amount {
            font-size: 1.85rem;
            font-weight: 700;
            line-height: 1.1;
            font-variant-numeric: tabular-nums;
            letter-spacing: -0.01em;
        }
        .debt-hero .hero-amount.is-clear { color: var(--stock-green); }
        .debt-hero .hero-amount.is-due   { color: var(--destructive); }

        .debt-hero .hero-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }

        .debt-hero .hero-progress {
            margin-top: 0.75rem;
            display: flex; align-items: center; gap: 0.65rem;
        }
        .debt-hero .hero-progress .bar {
            flex: 1; height: 6px;
            background: var(--slate-100);
            border-radius: 999px;
            overflow: hidden;
        }
        .debt-hero .hero-progress .bar > span {
            display: block; height: 100%;
            background: var(--stock-green);
            border-radius: inherit;
            transition: width 240ms ease;
        }
        .debt-hero .hero-progress .pct-text {
            font-size: 0.78rem; color: var(--slate-500);
            font-variant-numeric: tabular-nums;
            white-space: nowrap;
        }

        .debt-hero .hero-chips {
            display: flex; flex-wrap: wrap; gap: 0.4rem;
            margin-top: 0.7rem;
        }
        .chip {
            display: inline-flex; align-items: center; gap: 0.35rem;
            padding: 0.25rem 0.6rem;
            background: var(--slate-50);
            border: 1px solid var(--slate-200);
            border-radius: 6px;
            font-size: 0.78rem;
            color: var(--slate-900);
            font-variant-numeric: tabular-nums;
            line-height: 1.5;
        }
        .chip .chip-label { color: var(--slate-500); font-weight: 500; }
        .chip .chip-value { font-weight: 600; }
        .chip.is-paid    .chip-value { color: var(--stock-green); }
        .chip.is-advance .chip-value { color: var(--amber-700); }

        /* ── Advance card ─────────────────────────────────── */
        .advance-card {
            background: var(--amber-50);
            border: 1px solid var(--amber-200);
            border-radius: 10px;
            padding: 0.75rem 1rem;
            margin-bottom: 0.85rem;
            display: flex; gap: 0.75rem; align-items: flex-start;
        }
        .advance-card .icon {
            width: 32px; height: 32px;
            border-radius: 8px;
            background: #fef3c7;
            color: var(--amber-700);
            display: inline-flex; align-items: center; justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }
        .advance-card .advance-list {
            margin-top: 0.4rem;
            display: flex; flex-direction: column;
        }
        .advance-card .advance-item {
            display: flex; align-items: center; justify-content: space-between;
            gap: 0.75rem;
            font-size: 0.8rem;
            padding: 0.3rem 0;
            border-top: 1px dashed var(--amber-200);
            font-variant-numeric: tabular-nums;
        }
        .advance-card .advance-item:first-child { border-top: 0; }

        /* ── Debt list (denser) ───────────────────────────── */
        .debt-list-section .section-title {
            display: flex; align-items: center; justify-content: space-between;
            padding: 0 0.25rem 0.45rem;
        }
        .debt-list-section .section-title h6 {
            font-size: 0.78rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--slate-500);
            margin: 0;
        }

        .debt-list-card {
            background: #fff;
            border: 1px solid var(--slate-200);
            border-radius: 10px;
            overflow: hidden;
        }

        .debt-item {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid var(--slate-100);
            font-variant-numeric: tabular-nums;
            transition: background-color 160ms ease;
        }
        .debt-item:hover  { background: var(--slate-50); }
        .debt-item:last-child { border-bottom: 0; }
        .debt-item.is-overdue { box-shadow: inset 3px 0 0 var(--destructive); }
        .debt-item.is-paid    { box-shadow: inset 3px 0 0 var(--stock-green); }

        .debt-item .debt-head {
            display: flex; align-items: center; justify-content: space-between;
            gap: 0.75rem; flex-wrap: wrap;
            margin-bottom: 0.4rem;
        }
        .debt-item .debt-code {
            font-family: var(--bs-font-monospace);
            font-weight: 700;
            color: var(--slate-900);
            font-size: 0.88rem;
        }
        .debt-item .debt-meta {
            display: flex; gap: 0.75rem; flex-wrap: wrap;
            font-size: 0.75rem;
            color: var(--slate-500);
            align-items: center;
        }
        .debt-item .debt-meta a {
            color: var(--slate-700);
            text-decoration: none;
            font-weight: 500;
            border-bottom: 1px dotted var(--slate-400);
        }
        .debt-item .debt-meta a:hover { color: var(--slate-900); border-bottom-color: var(--slate-700); }

        .debt-item .debt-amounts {
            display: flex; align-items: center; justify-content: space-between;
            gap: 1rem; flex-wrap: wrap;
        }
        .debt-item .amount-stack { display: flex; gap: 1.1rem; flex-wrap: wrap; }
        .debt-item .amount-stack > div { display: flex; gap: 0.3rem; align-items: baseline; }
        .debt-item .amount-stack .lbl { color: var(--slate-500); font-size: 0.75rem; }
        .debt-item .amount-stack .val { font-weight: 600; font-size: 0.88rem; color: var(--slate-900); }
        .debt-item .amount-stack .val.is-paid      { color: var(--stock-green); }
        .debt-item .amount-stack .val.is-remaining { color: var(--destructive); font-weight: 700; }
        .debt-item .amount-stack .val.is-clear     { color: var(--stock-green); font-weight: 700; }

        .debt-item .pay-btn { white-space: nowrap; }

        .payment-history {
            margin-top: 0.55rem;
            padding-left: 0.75rem;
            border-left: 2px solid var(--slate-100);
        }
        .payment-history .pmt-row {
            display: flex; align-items: center; justify-content: space-between;
            gap: 0.5rem;
            padding: 0.2rem 0;
            font-size: 0.78rem;
            color: var(--slate-500);
            font-variant-numeric: tabular-nums;
        }
        .payment-history .pmt-row .pmt-meta { display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
        .payment-history .pmt-row .pmt-amt  { color: var(--destructive); font-weight: 600; white-space: nowrap; }
        .payment-history .pmt-row a.print {
            color: var(--slate-500);
            padding: 0.15rem 0.4rem;
            border-radius: 6px;
            transition: background-color 160ms ease, color 160ms ease;
        }
        .payment-history .pmt-row a.print:hover { background: var(--slate-100); color: var(--slate-900); }

        /* Focus visibility */
        .vendor-debt-page .btn:focus-visible,
        .vendor-debt-page a:focus-visible {
            outline: 2px solid var(--slate-700);
            outline-offset: 2px;
        }

        /* Respect reduced-motion */
        @@media (prefers-reduced-motion: reduce) {
            .debt-item, .debt-hero .hero-progress .bar > span,
            .payment-history .pmt-row a.print { transition: none; }
        }

        @@media (max-width: 575.98px) {
            .debt-hero { padding: 0.9rem 1rem; }
            .debt-hero .hero-amount { font-size: 1.55rem; }
            .debt-hero .hero-actions { width: 100%; }
            .debt-hero .hero-actions .btn { flex: 1; }
        }
    </style>
}

<div class="vendor-debt-page">

<div class="page-header">
    <div class="d-flex align-items-center">
        <a asp-action="Index" class="btn btn-icon btn-light me-3 shadow-sm border" aria-label="Quay lại danh sách">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
        </a>
        <div>
            <h1 class="page-header-title">@Model.VendorName</h1>
            <p class="page-header-subtitle mb-0">
                @Model.Debts.Count phiếu công nợ
            </p>
        </div>
    </div>
</div>

@* ── Hero summary ─────────────────────────────────────── *@
<section class="debt-hero" aria-label="Tổng quan công nợ">
    <div class="hero-row">
        <div>
            <div class="hero-label">Còn phải trả</div>
            @if (hasOutstanding)
            {
                <div class="hero-amount is-due">
                    @Model.TotalRemainingAmount.ToString(ViewConstants.CurrencyDisplayFormat)
                </div>
            }
            else
            {
                <div class="hero-amount is-clear">
                    <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>Đã thanh toán hết
                </div>
            }
        </div>

        @if (hasOutstanding)
        {
            <div class="hero-actions">
                <button type="button" class="btn btn-danger fw-semibold px-3"
                        data-bs-toggle="modal" data-bs-target="#paymentModal">
                    <i class="bi bi-cash-coin me-1" aria-hidden="true"></i> Trả tiền NCC
                </button>
                <button type="button" class="btn btn-outline-secondary px-3"
                        data-bs-toggle="modal" data-bs-target="#advancePaymentModal">
                    <i class="bi bi-piggy-bank me-1" aria-hidden="true"></i> Ứng trước
                </button>
            </div>
        }
        else
        {
            <div class="hero-actions">
                <button type="button" class="btn btn-outline-secondary px-3"
                        data-bs-toggle="modal" data-bs-target="#advancePaymentModal">
                    <i class="bi bi-piggy-bank me-1" aria-hidden="true"></i> Ứng trước
                </button>
            </div>
        }
    </div>

    @if (Model.TotalDebtAmount > 0)
    {
        <div class="hero-progress" role="progressbar"
             aria-valuenow="@paidPct.ToString("N0")" aria-valuemin="0" aria-valuemax="100"
             aria-label="Tiến độ thanh toán">
            <div class="bar">
                <span style="width:@paidPct.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)%"></span>
            </div>
            <div class="pct-text">@paidPct.ToString("N0")% đã thanh toán</div>
        </div>
    }

    <div class="hero-chips">
        <span class="chip">
            <span class="chip-label">Tổng nợ:</span>
            <span class="chip-value">@Model.TotalDebtAmount.ToString(ViewConstants.CurrencyDisplayFormat)</span>
        </span>
        <span class="chip is-paid">
            <span class="chip-label">Đã trả:</span>
            <span class="chip-value">@Model.TotalPaidAmount.ToString(ViewConstants.CurrencyDisplayFormat)</span>
        </span>
        @if (hasAdvance)
        {
            <span class="chip is-advance">
                <i class="bi bi-piggy-bank" aria-hidden="true"></i>
                <span class="chip-label">Ứng trước:</span>
                <span class="chip-value">@Model.AdvanceBalance.ToString(ViewConstants.CurrencyDisplayFormat)</span>
            </span>
        }
        @if (hasCreditNote)
        {
            <span class="chip is-advance">
                <i class="bi bi-arrow-return-left" aria-hidden="true"></i>
                <span class="chip-label">Trả hàng chưa cấn:</span>
                <span class="chip-value">@Model.UnappliedCreditNoteBalance.ToString(ViewConstants.CurrencyDisplayFormat)</span>
            </span>
        }
    </div>
</section>

@* ── Advance card (gộp alert + danh sách phiếu ứng) ──── *@
@if (hasAdvance)
{
    <section class="advance-card" aria-label="Tiền ứng trước">
        <div class="icon"><i class="bi bi-piggy-bank" aria-hidden="true"></i></div>
        <div class="flex-grow-1">
            <div class="fw-semibold">
                Có @Model.AdvanceBalance.ToString(ViewConstants.CurrencyDisplayFormat) tiền ứng trước chưa áp dụng
            </div>
            <div class="text-muted small">Khi trả tiền mới, hệ thống sẽ tự khấu trừ số dư này trước.</div>

            @if (Model.AdvancePayments.Any())
            {
                <div class="advance-list">
                    @foreach (var adv in Model.AdvancePayments)
                    {
                        var method = (PaymentMethod)adv.PaymentMethod;
                        <div class="advance-item">
                            <div class="d-flex align-items-center gap-2 text-muted">
                                <i class="bi @(method == PaymentMethod.BankTransfer ? "bi-bank" : "bi-cash-stack")" aria-hidden="true"></i>
                                <span class="font-monospace">@adv.Code</span>
                                <span class="text-muted">·</span>
                                <span>@adv.PaidOn.ToString(ViewConstants.DefaultDateFormat)</span>
                                @if (!string.IsNullOrEmpty(adv.Note))
                                {
                                    <span class="text-muted fst-italic">— @adv.Note</span>
                                }
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-bold text-warning">@adv.Amount.ToString(ViewConstants.CurrencyDisplayFormat)</span>
                                <a asp-action="Receipt" asp-route-paymentId="@adv.Id" target="_blank"
                                   class="text-muted" title="In phiếu chi"
                                   aria-label="In phiếu ứng trước @adv.Code">
                                    <i class="bi bi-printer" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
}

@* ── Danh sách phiếu công nợ ──────────────────────────── *@
@if (Model.UnappliedCreditNotes.Any())
{
    <section class="advance-card" aria-label="Chứng từ điều chỉnh từ trả hàng chưa cấn trừ">
        <div class="icon"><i class="bi bi-arrow-return-left" aria-hidden="true"></i></div>
        <div class="flex-grow-1">
            <div class="fw-semibold">
                Có @Model.UnappliedCreditNoteBalance.ToString(ViewConstants.CurrencyDisplayFormat) từ trả hàng NCC chưa cấn trừ
            </div>
            <div class="advance-list">
                @foreach (var credit in Model.UnappliedCreditNotes)
                {
                    <div class="advance-item">
                        <div class="d-flex align-items-center gap-2 text-muted">
                            <a asp-controller="VendorReturn" asp-action="Details" asp-route-id="@credit.SourceReturnId"
                               class="text-decoration-none">@credit.SourceReturnCode</a>
                            <span class="text-muted">·</span>
                            <span class="font-monospace">@credit.Code</span>
                            <span class="text-muted">·</span>
                            <span>@credit.CreatedOn.ToString(ViewConstants.DefaultDateFormat)</span>
                        </div>
                        <div class="fw-bold text-warning">
                            @credit.RemainingAmount.ToString(ViewConstants.CurrencyDisplayFormat)
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<section class="debt-list-section">
    <div class="section-title">
        <h6>Phiếu công nợ</h6>
        <span class="text-muted small">@Model.Debts.Count phiếu</span>
    </div>

    <div class="debt-list-card">
        @if (!Model.Debts.Any())
        {
            <div class="empty-state py-5">
                <div class="empty-icon"><i class="bi bi-inbox" aria-hidden="true"></i></div>
                <h5>Không có phiếu công nợ nào</h5>
                <p class="text-muted">Phiếu công nợ sẽ phát sinh khi đơn nhập hàng được hoàn tất.</p>
            </div>
        }
        else
        {
            @foreach (var debt in Model.Debts)
            {
                var status = (DebtStatus)debt.Status;
                var isPaid = status == DebtStatus.FullyPaid;
                var isOverdue = debt.DueDate.HasValue && debt.DueDate.Value < DateTime.Now && !isPaid;
                var itemClass = isPaid ? "is-paid" : (isOverdue ? "is-overdue" : "");

                <article class="debt-item @itemClass">
                    <header class="debt-head">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="debt-code">@debt.Code</span>
                            <span class="badge rounded-pill @status.GetDisplayColor() fw-normal small">
                                @status.GetDisplayText()
                            </span>
                            @if (isOverdue)
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-normal small">
                                    <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>Quá hạn
                                </span>
                            }
                        </div>
                        <div class="debt-meta">
                            <span>
                                <i class="bi bi-cart3 me-1" aria-hidden="true"></i>
                                <a asp-controller="PurchaseOrder" asp-action="Details" asp-route-id="@debt.PurchaseOrderId">@debt.PurchaseOrderCode</a>
                            </span>
                            <span>
                                <i class="bi bi-calendar3 me-1" aria-hidden="true"></i>@debt.CreatedOn.ToString(ViewConstants.DefaultDateFormat)
                            </span>
                            @if (debt.DueDate.HasValue)
                            {
                                <span class="@(isOverdue ? "text-danger fw-semibold" : "")">
                                    <i class="bi bi-alarm me-1" aria-hidden="true"></i>Hạn @debt.DueDate.Value.ToString(ViewConstants.DefaultDateFormat)
                                </span>
                            }
                        </div>
                    </header>

                    <div class="debt-amounts">
                        <div class="amount-stack">
                            <div>
                                <span class="lbl">Tổng:</span>
                                <span class="val">@debt.TotalAmount.ToString(ViewConstants.CurrencyDisplayFormat)</span>
                            </div>
                            <div>
                                <span class="lbl">Đã trả:</span>
                                <span class="val is-paid">@debt.PaidAmount.ToString(ViewConstants.CurrencyDisplayFormat)</span>
                            </div>
                            <div>
                                <span class="lbl">Còn lại:</span>
                                <span class="val @(debt.RemainingAmount > 0 ? "is-remaining" : "is-clear")">
                                    @debt.RemainingAmount.ToString(ViewConstants.CurrencyDisplayFormat)
                                </span>
                            </div>
                        </div>
                        @if (!isPaid)
                        {
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger rounded-3 btn-pay-single pay-btn"
                                    data-debt-id="@debt.Id"
                                    data-remaining="@debt.RemainingAmount"
                                    data-code="@debt.Code"
                                    aria-label="Trả khoản nợ phiếu @debt.Code">
                                <i class="bi bi-cash-coin me-1" aria-hidden="true"></i>Trả khoản này
                            </button>
                        }
                    </div>

                    @if (debt.Payments.Any())
                    {
                        <div class="payment-history">
                            @foreach (var p in debt.Payments)
                            {
                                var method = (PaymentMethod)p.PaymentMethod;
                                <div class="pmt-row">
                                    <div class="pmt-meta">
                                        <i class="bi @(method == PaymentMethod.BankTransfer ? "bi-bank" : "bi-cash-stack")" aria-hidden="true"></i>
                                        <span class="font-monospace">@p.Code</span>
                                        <span>·</span>
                                        <span>@p.PaidOn.ToString(ViewConstants.DefaultDateTimeFormat)</span>
                                        @if (!string.IsNullOrEmpty(p.Note))
                                        {
                                            <span class="fst-italic">— @p.Note</span>
                                        }
                                    </div>
                                    <div class="d-flex align-items-center gap-1">
                                        <span class="pmt-amt">−@p.Amount.ToString(ViewConstants.CurrencyDisplayFormat)</span>
                                        <a asp-action="Receipt" asp-route-paymentId="@p.Id" target="_blank"
                                           class="print" title="In phiếu chi"
                                           aria-label="In phiếu chi @p.Code">
                                            <i class="bi bi-printer" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    @if (debt.CreditNoteAllocations.Any())
                    {
                        <div class="payment-history">
                            @foreach (var allocation in debt.CreditNoteAllocations)
                            {
                                var reversed = allocation.ReversedOn.HasValue;
                                <div class="pmt-row @(reversed ? "text-muted" : "")">
                                    <div class="pmt-meta">
                                        <i class="bi bi-arrow-return-left" aria-hidden="true"></i>
                                        <span>@(reversed ? "Đã đảo cấn trừ" : "Cấn trừ") từ trả hàng</span>
                                        <a asp-controller="VendorReturn" asp-action="Details" asp-route-id="@allocation.SourceReturnId"
                                           class="text-decoration-none">@allocation.SourceReturnCode</a>
                                        <span class="font-monospace">@allocation.CreditNoteCode</span>
                                    </div>
                                    <span class="pmt-amt">−@allocation.Amount.ToString(ViewConstants.CurrencyDisplayFormat)</span>
                                </div>
                            }
                        </div>
                    }
                </article>
            }
        }
    </div>
</section>

</div> @* /.vendor-debt-page *@

@* ── Modal: Trả tiền (thanh toán 1 phiếu / FIFO) ──────── *@
<div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-danger text-white pt-4 px-4 pb-3">
                <h5 class="modal-title fw-bold" id="paymentModalTitle">
                    <i class="bi bi-cash-coin me-2" aria-hidden="true"></i>Chi tiền — @Model.VendorName
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form id="paymentForm">
                <input type="hidden" name="vendorId" value="@Model.VendorId" />
                <input type="hidden" name="vendorDebtId" id="debtIdInput" value="" />
                <input type="hidden" name="paymentType" id="paymentTypeInput" value="@((int)PaymentType.VendorDebtPayment)" />

                <div class="modal-body p-4">
                    <div id="paymentInfo" class="alert alert-danger-subtle border border-danger-subtle rounded-3 small mb-4">
                        <i class="bi bi-info-circle me-2 text-danger" aria-hidden="true"></i>
                        Tổng còn phải trả:
                        <strong class="text-danger">@Model.TotalRemainingAmount.ToString(ViewConstants.CurrencyDisplayFormat)</strong>
                        @if (hasAdvance)
                        {
                            <span>
                                · Tiền ứng trước có sẵn:
                                <strong class="text-warning">@Model.AdvanceBalance.ToString(ViewConstants.CurrencyDisplayFormat)</strong>
                            </span>
                        }
                        <br />
                        <span class="text-muted">Tiền sẽ được phân bổ FIFO vào các phiếu nợ cũ nhất. Tiền dư lưu làm ứng trước.</span>
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-2" for="paymentAmount">
                                Số tiền chi <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-lg bg-light rounded-3 border">
                                <input class="form-control bg-transparent border-0 fw-bold text-danger no-additional-element no-hint"
                                       type="number" step="1000" name="amount" id="paymentAmount"
                                       value="@Model.TotalRemainingAmount.DisplayCurrency()" required min="1" />
                                <span class="input-group-text bg-transparent border-0 fw-bold text-danger">đ</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-2">Phương thức</label>
                            <div class="d-flex gap-2">
                                <input type="radio" class="btn-check" name="paymentMethod"
                                       id="methodCash" value="@((int)PaymentMethod.Cash)" checked>
                                <label class="btn btn-outline-secondary w-100 py-2 rounded-3" for="methodCash">
                                    <i class="bi bi-cash-stack me-1" aria-hidden="true"></i>Tiền mặt
                                </label>
                                <input type="radio" class="btn-check" name="paymentMethod"
                                       id="methodBank" value="@((int)PaymentMethod.BankTransfer)">
                                <label class="btn btn-outline-secondary w-100 py-2 rounded-3" for="methodBank">
                                    <i class="bi bi-bank me-1" aria-hidden="true"></i>Chuyển khoản
                                </label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-2" for="paymentPaidOn">Ngày chi</label>
                            <input id="paymentPaidOn" type="datetime-local" class="form-control rounded-3" name="paidOn"
                                   value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-2" for="paymentNote">Ghi chú</label>
                            <textarea id="paymentNote" class="form-control rounded-3" name="note" rows="2"
                                      placeholder="VD: Chuyển khoản cho NCC @Model.VendorName..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light border-top-0 p-4">
                    <button type="button" class="btn btn-light px-4 rounded-3 border" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" id="btnSubmitPayment" class="btn btn-danger px-4 rounded-3 shadow-sm fw-bold">
                        <i class="bi bi-check2-circle me-1" aria-hidden="true"></i>Xác nhận chi tiền
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── Modal: Ứng trước NCC ─────────────────────────────── *@
<div class="modal fade" id="advancePaymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-warning text-dark pt-4 px-4 pb-3">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-piggy-bank me-2" aria-hidden="true"></i>Ứng trước — @Model.VendorName
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form id="advanceForm">
                <input type="hidden" name="vendorId" value="@Model.VendorId" />

                <div class="modal-body p-4">
                    <div class="alert alert-warning border-0 rounded-3 small mb-4">
                        <i class="bi bi-info-circle me-2" aria-hidden="true"></i>
                        Tiền ứng trước sẽ được lưu và tự động áp dụng vào phiếu nợ tiếp theo của NCC này.
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-2" for="advanceAmount">
                                Số tiền ứng <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-lg bg-light rounded-3 border">
                                <input id="advanceAmount" class="form-control bg-transparent border-0 fw-bold text-warning no-additional-element no-hint"
                                       type="number" step="1000" name="amount" required min="1" />
                                <span class="input-group-text bg-transparent border-0 fw-bold text-warning">đ</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-2">Phương thức</label>
                            <div class="d-flex gap-2">
                                <input type="radio" class="btn-check" name="paymentMethod"
                                       id="advMethodCash" value="@((int)PaymentMethod.Cash)" checked>
                                <label class="btn btn-outline-secondary w-100 py-2 rounded-3" for="advMethodCash">
                                    <i class="bi bi-cash-stack me-1" aria-hidden="true"></i>Tiền mặt
                                </label>
                                <input type="radio" class="btn-check" name="paymentMethod"
                                       id="advMethodBank" value="@((int)PaymentMethod.BankTransfer)">
                                <label class="btn btn-outline-secondary w-100 py-2 rounded-3" for="advMethodBank">
                                    <i class="bi bi-bank me-1" aria-hidden="true"></i>Chuyển khoản
                                </label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-2" for="advancePaidOn">Ngày ứng</label>
                            <input id="advancePaidOn" type="datetime-local" class="form-control rounded-3" name="paidOn"
                                   value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase mb-2" for="advanceNote">Ghi chú</label>
                            <textarea id="advanceNote" class="form-control rounded-3" name="note" rows="2"
                                      placeholder="VD: Ứng trước cho đơn nhập tháng 5..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light border-top-0 p-4">
                    <button type="button" class="btn btn-light px-4 rounded-3 border" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" id="btnSubmitAdvance" class="btn btn-warning px-4 rounded-3 shadow-sm fw-bold text-dark">
                        <i class="bi bi-check2-circle me-1" aria-hidden="true"></i>Xác nhận ứng tiền
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module">
        import { toast } from "/modules/modals.js";

        (function () {
            // ── Thanh toán (trả nợ) ──────────────────────────────────────────
            const paymentForm = document.getElementById('paymentForm');
            const debtIdInput = document.getElementById('debtIdInput');
            const paymentTypeInput = document.getElementById('paymentTypeInput');
            const paymentAmount = document.getElementById('paymentAmount');
            const paymentModalTitle = document.getElementById('paymentModalTitle');
            const btnSubmitPayment = document.getElementById('btnSubmitPayment');
            const totalRemaining = @Model.TotalRemainingAmount.ToString("#0");

            // Trả khoản nợ cụ thể
            document.querySelectorAll('.btn-pay-single').forEach(btn => {
                btn.addEventListener('click', function () {
                    const debtId = this.dataset.debtId;
                    const remaining = parseFloat(this.dataset.remaining);
                    const code = this.dataset.code;

                    debtIdInput.value = debtId;
                    paymentAmount.value = remaining;
                    paymentModalTitle.innerHTML = `<i class="bi bi-cash-coin me-2"></i>Chi tiền — Phiếu ${code}`;

                    bootstrap.Modal.getOrCreateInstance(document.getElementById('paymentModal')).show();
                });
            });

            // Trả tổng FIFO (mở từ nút hero)
            document.querySelector('[data-bs-target="#paymentModal"]')?.addEventListener('click', function () {
                debtIdInput.value = '';
                paymentAmount.value = totalRemaining;
                paymentModalTitle.innerHTML = `<i class="bi bi-cash-coin me-2"></i>Chi tiền — @Html.Raw(Model.VendorName)`;
            });

            $(paymentForm).on('submit', async function (e) {
                e.preventDefault();
                if (!paymentForm.checkValidity()) { paymentForm.reportValidity(); return; }

                btnSubmitPayment.disabled = true;
                const orig = btnSubmitPayment.innerHTML;
                btnSubmitPayment.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý...';

                const hasDebtId = debtIdInput.value !== '';
                const url = hasDebtId
                    ? '@Url.Action("RecordPayment")'
                    : '@Url.Action("RecordFlexiblePayment")';

                try {
                    const res = await $.ajax({ url, type: 'POST', data: $(paymentForm).serialize() });
                    if (res.success) {
                        toast('Thành công', res.message, 'success');
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        toast('Lỗi', res.message, 'error');
                        btnSubmitPayment.disabled = false;
                        btnSubmitPayment.innerHTML = orig;
                    }
                } catch {
                    toast('Lỗi', 'Có lỗi xảy ra trong quá trình xử lý.', 'error');
                    btnSubmitPayment.disabled = false;
                    btnSubmitPayment.innerHTML = orig;
                }
            });

            // ── Ứng trước ────────────────────────────────────────────────────
            const advanceForm = document.getElementById('advanceForm');
            const btnSubmitAdvance = document.getElementById('btnSubmitAdvance');

            $(advanceForm).on('submit', async function (e) {
                e.preventDefault();
                if (!advanceForm.checkValidity()) { advanceForm.reportValidity(); return; }

                btnSubmitAdvance.disabled = true;
                const orig = btnSubmitAdvance.innerHTML;
                btnSubmitAdvance.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý...';

                try {
                    const res = await $.ajax({
                        url: '@Url.Action("RecordAdvance")',
                        type: 'POST',
                        data: $(advanceForm).serialize()
                    });
                    if (res.success) {
                        toast('Thành công', res.message, 'success');
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        toast('Lỗi', res.message, 'error');
                        btnSubmitAdvance.disabled = false;
                        btnSubmitAdvance.innerHTML = orig;
                    }
                } catch {
                    toast('Lỗi', 'Có lỗi xảy ra trong quá trình xử lý.', 'error');
                    btnSubmitAdvance.disabled = false;
                    btnSubmitAdvance.innerHTML = orig;
                }
            });
        })();
    </script>
}
