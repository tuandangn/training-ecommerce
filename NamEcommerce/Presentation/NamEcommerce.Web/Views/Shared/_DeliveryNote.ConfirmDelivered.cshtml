<div class="modal fade" id="markDeliveredModal" tabindex="-1" aria-labelledby="markDeliveredModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form id="markDeliveredForm" asp-action="MarkDelivered" asp-controller="DeliveryNote" method="post" enctype="multipart/form-data">
            <input type="hidden" id="deliveryNoteId" name="deliveryNoteId" value="" />
            <input type="hidden" id="acceptanceItemsJson" name="acceptanceItemsJson" />

            <div class="modal-content border-0 shadow rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="markDeliveredModalLabel">Xác nhận giao hàng thành công</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-4">
                    <div class="alert alert-info border-0 rounded-3 mb-4">
                        Nhập số lượng khách nhận thực tế cho từng mặt hàng. Nếu khách không nhận đủ, hệ thống sẽ tự tạo phiếu trả hàng để xử lý kiểm hàng.
                    </div>
                    <div class="mb-3">
                        <label for="receiverName" class="form-label small fw-bold text-muted text-uppercase mb-2">Tên người nhận</label>
                        <input type="text" class="form-control form-control-lg rounded-3 fs-6" id="receiverName"
                               name="receiverName" data-testid="delivery-receiver-name" placeholder="Nhập tên người nhận">
                    </div>
                    <div class="table-responsive mb-3">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Hàng hóa</th>
                                    <th class="text-end pe-3" style="width: 110px;">Số lượng giao</th>
                                    <th class="text-end pe-3" style="width: 150px;">Nhận thực tế</th>
                                    <th class="text-end pe-3" style="width: 110px;">Trả lại</th>
                                </tr>
                            </thead>
                            <tbody id="acceptanceTableBody"></tbody>
                        </table>
                    </div>
                    <div class="mb-3">
                        <label for="rejectReason" class="form-label small fw-bold text-muted text-uppercase mb-2">Lý do trả hàng</label>
                        <textarea class="form-control rounded-3 fs-6" id="rejectReason" rows="2"
                                  placeholder="Nhập lý do trả hàng"></textarea>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label for="agreedCustomerCharge" class="form-label small fw-bold text-muted text-uppercase mb-2">Chi phí phát sinh</label>
                            <input class="form-control form-control-lg rounded-3 fs-6" id="agreedCustomerCharge" name="agreedCustomerCharge"
                                   value="0" data-decimal="currency" placeholder="Nhập chi phí phát sinh"
                                   data-val="true" data-val-range="Chi phí phải lớn hơn 0" data-val-range-min="0"
                                   data-val-number="Chi phí phải là số" />
                            <span class="small text-danger field-validation-valid" data-valmsg-for="agreedCustomerCharge" data-valmsg-replace="true"></span>
                        </div>
                        <div class="col-md-8">
                            <label for="agreedCustomerChargeReason" class="form-label small fw-bold text-muted text-uppercase mb-2">Lý do</label>
                            <input type="text" class="form-control form-control-lg rounded-3 fs-6" id="agreedCustomerChargeReason" name="agreedCustomerChargeReason"
                                   placeholder="Nhập lý do phát sinh chi phí" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="deliveryProofPicture" class="form-label small mb-2">
                            <span class="fw-bold text-muted text-uppercase">Hình ảnh khi giao hàng</span> <span class="text-danger">*</span>
                            <span class="d-block text-muted fw-normal">Hình ảnh hiện trạng hàng hóa khi giao cho khách hàng</span>
                        </label>
                        <input class="form-control form-control-lg rounded-3 fs-6" type="file" id="deliveryProofPicture" 
                            name="pictureFile" data-testid="delivery-proof-file" accept="image/*"
                            data-val="true" data-val-required="Vui lòng tải lên hình ảnh khi giao hàng"/>
                        <span class="small text-danger field-validation-valid" data-valmsg-for="pictureFile" data-valmsg-replace="true"></span>
                    </div>
                    <div class="mt-3 text-center d-none" id="previewContainer">
                        <img id="imagePreview" src="#" alt="Preview" class="img-fluid rounded-4 shadow-sm" style="max-height: 250px; display: none; object-fit: cover; border: 1px solid var(--bs-border-color);" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 pb-4 px-4">
                    <button type="button" class="btn btn-light px-4 rounded-3" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-success px-4 rounded-3 shadow-sm px-5" id="btnSubmitDelivery" data-testid="delivery-mark-delivered">
                        <i class="bi bi-camera me-1"></i> Xác nhận
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
