<div class="modal fade" id="markDeliveredModal" tabindex="-1" aria-labelledby="markDeliveredModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form id="markDeliveredForm" asp-action="MarkDelivered" asp-controller="DeliveryNote" method="post">
            <input type="hidden" id="deliveryNoteId" name="deliveryNoteId" value="" />
            <input type="hidden" id="acceptanceItemsJson" name="acceptanceItemsJson" />

            <div class="modal-content ui-modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="markDeliveredModalLabel">Xác nhận giao hàng thành công</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-4">
                    <div class="alert alert-info border-0 rounded-3 mb-4">
                        Nhập số lượng khách trả về cho từng mặt hàng. Hệ thống sẽ tự tính số lượng khách nhận và tạo phiếu trả hàng nếu có hàng trả về.
                    </div>
                    <div class="table-responsive mb-3">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Hàng hóa</th>
                                    <th class="text-end pe-3 ui-w-150">SL giao</th>
                                    <th class="text-end pe-3 ui-w-150">SL trả về</th>
                                    <th class="text-end pe-3 ui-w-150">SL khách nhận</th>
                                </tr>
                            </thead>
                            <tbody id="acceptanceTableBody"></tbody>
                        </table>
                    </div>
                    <div class="mb-3">
                        <label for="receiverName" class="form-label small fw-bold text-muted text-uppercase mb-2">Tên người nhận</label>
                        <input type="text" class="form-control form-control-lg rounded-3 fs-6" id="receiverName" name="receiverName" data-testid="delivery-receiver-name" placeholder="Nhập tên người nhận">
                    </div>
                    <div class="mb-3">
                        <label for="cashCollectedAmount" class="form-label small fw-bold text-muted text-uppercase mb-2">Tiền khách trả</label>
                        <input class="form-control form-control-lg rounded-3 fs-6 text-end" id="cashCollectedAmount" name="cashCollectedAmount"
                               value="0" data-decimal="currency" placeholder="Nhập số tiền khách đã trả" />
                        <div class="small text-muted mt-2">
                            Số tiền này chỉ giảm công nợ sau khi thủ quỹ xác nhận nhận tiền.
                        </div>
                    </div>
                    <div class="mb-3 d-none">
                        <label for="rejectReason" class="form-label small fw-bold text-muted text-uppercase mb-2">Lý do trả hàng</label>
                        <textarea class="form-control rounded-3 fs-6" id="rejectReason" rows="2" placeholder="Nhập lý do trả hàng"></textarea>
                    </div>
                    <div class="form-check form-switch mb-3 p-3 bg-light rounded-3 border d-none" id="compensateInNextDeliveryContainer">
                        <input class="form-check-input ms-0" type="checkbox" id="compensateInNextDelivery" name="compensateInNextDelivery" value="true" role="switch" />
                        <label class="form-check-label ms-2 fw-medium" for="compensateInNextDelivery">
                            Bù số lượng trả lại vào lần giao sau
                        </label>
                        <div class="small text-muted mt-2">
                            Dùng khi khách vẫn muốn nhận bù phần hàng không nhận trong lần giao tiếp theo.
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-5">
                            <label for="agreedCustomerCharge" class="form-label small fw-bold text-muted text-uppercase mb-2">Chi phí phát sinh</label>
                            <input class="form-control form-control-lg rounded-3 fs-6" id="agreedCustomerCharge" name="agreedCustomerCharge"
                                   value="0" data-decimal="currency" placeholder="Nhập chi phí phát sinh"
                                   data-val="true" data-val-range="Chi phí phải lớn hơn 0" data-val-range-min="0"
                                   data-val-number="Chi phí phải là số" />
                            <span class="small text-danger field-validation-valid" data-valmsg-for="agreedCustomerCharge" data-valmsg-replace="true"></span>
                        </div>
                        <div class="col-md-7">
                            <label for="agreedCustomerChargeReason" class="form-label small fw-bold text-muted text-uppercase mb-2">Lý do</label>
                            <input type="text" class="form-control form-control-lg rounded-3 fs-6" id="agreedCustomerChargeReason" name="agreedCustomerChargeReason"
                                   placeholder="Nhập lý do phát sinh chi phí" />
                        </div>
                    </div>
                    <div class="mb-3">
                        @await Html.PartialAsync("_ImageUploader", new NamEcommerce.Web.Models.Common.ImageUploaderModel
                        {
                            FieldName = "pictureIds",
                            Label = "Hình ảnh khi giao hàng",
                            HintText = "Hình ảnh hiện trạng hàng hóa khi giao cho khách hàng",
                            MaxFiles = 3,
                            Required = true,
                            RequiredMessage = "Vui lòng tải lên ít nhất 1 hình ảnh khi giao hàng."
                        })
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 pb-4 px-4">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-3" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-success px-4 rounded-3 shadow-sm px-5" id="btnSubmitDelivery" data-testid="delivery-mark-delivered">
                        <i class="bi bi-check-lg me-1"></i> Xác nhận
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
