@model UserHeaderLinksModel
@inject IWebHelper WebHelper

@if (WebHelper.IsLoginPage() || WebHelper.IsRegisterPage())
{
    return;
}
<div class="topbar-actions">
    @if (Model.IsAuthenticated)
    {
        @if (Model.CanViewOrderFulfillmentSchedule)
        {
            <div class="fulfillment-schedule-center" data-fulfillment-schedule-center>
                <button class="fulfillment-schedule-btn" type="button" data-fulfillment-schedule-toggle title="Lịch xử lý đơn hàng" aria-label="Lịch xử lý đơn hàng" aria-expanded="false">
                    <i class="bi bi-calendar2-week"></i>
                </button>
                <div class="fulfillment-schedule-panel" data-fulfillment-schedule-panel hidden>
                    <div class="fulfillment-schedule-panel-loading">Đang tải lịch...</div>
                </div>
            </div>
        }
        <div class="system-notification-center" data-system-notification-center>
            <button class="notification-btn" type="button" data-system-notification-toggle aria-label="Thông báo" aria-expanded="false">
                <i class="bi bi-bell"></i>
                <span class="system-notification-badge" data-system-notification-count hidden>0</span>
            </button>
            <div class="system-notification-panel" data-system-notification-panel hidden>
                <div class="system-notification-panel-header">
                    <div>
                        <div class="system-notification-title">Thông báo</div>
                        <div class="system-notification-subtitle">Sự kiện cần theo dõi</div>
                    </div>
                    <a asp-controller="SystemNotification" asp-action="List" class="btn btn-sm btn-outline-secondary">Xem tất cả</a>
                </div>
                <div class="system-notification-list" data-system-notification-list>
                    <div class="system-notification-empty">Đang tải...</div>
                </div>
            </div>
        </div>
    }
    else
    {
        <a class="btn btn-outline-secondary text-decoration-none" asp-controller="User" asp-action="Login">Đăng nhập</a>
    }
</div>
