@model EmptyStateModel

<div class="ui-empty-state">
    <div class="ui-empty-state__icon">
        <i class="bi @Model.Icon" aria-hidden="true"></i>
    </div>
    <div>
        <h2 class="ui-empty-state__title">@Model.Title</h2>
        <p class="ui-empty-state__message">@Model.Message</p>
    </div>
    @if (Model.Action is not null)
    {
        <a class="btn btn-@Model.Action.Variant" href="@Model.Action.Url" title="@Model.Action.Title">
            @if (!string.IsNullOrWhiteSpace(Model.Action.Icon))
            {
                <i class="bi @Model.Action.Icon" aria-hidden="true"></i>
            }
            <span>@Model.Action.Text</span>
        </a>
    }
</div>
