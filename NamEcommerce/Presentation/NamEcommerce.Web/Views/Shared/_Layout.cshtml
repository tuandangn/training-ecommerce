@using NamEcommerce.Domain.Shared.Services.Users
@inject IWebHelper WebHelper
@inject ICurrentUserAccessor CurrentUserAccessor
@{
    var isAuthPage = WebHelper.IsLoginPage() || WebHelper.IsRegisterPage();
    var pageTitle = ViewData[ViewConstants.PageTitle] as string ?? Information.Name;
    var currentUser = await CurrentUserAccessor.GetCurrentUserAsync();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData[ViewConstants.PageTitle] - @Information.Name</title>
    <partial name="_Styles" />
    @await RenderSectionAsync(ViewConstants.StyleSection, required: false)
</head>
<body>
    <a class="skip-link" href="#mainContent">Bỏ qua menu</a>
    <div class="app-layout">
        <div class="sidebar-overlay" id="sidebarOverlay"></div>
        <aside class="sidebar" id="appSidebar" aria-label="Điều hướng chính">
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                <div class="sidebar-brand-icon">
                    <i class="bi bi-bag-heart-fill"></i>
                </div>
                <div>
                    <div class="sidebar-brand-text">@Information.Name</div>
                    <div class="sidebar-brand-sub">Quản lý bán hàng</div>
                    @if (currentUser is not null)
                    {
                        <div class="sidebar-user-info">
                            <span class="sidebar-user-name small">
                                <i class="bi bi-person"></i>
                                @currentUser.FullName
                            </span>
                        </div>
                    }
                </div>
            </a>
            <nav class="sidebar-nav" aria-label="Menu chính">
                @await Component.InvokeAsync("MenuNavigationComponent")
            </nav>

            @if (currentUser is not null)
            {
                <div class="d-grid p-3 pb-3">
                    <a asp-controller="User" asp-action="Logout" class="btn btn-outline-secondary btn-sm">
                        Đăng xuất
                    </a>
                </div>
            }
        </aside>
        <div class="main-area">
            <header class="topbar">
                <button class="topbar-toggle" id="sidebarToggle" type="button" aria-label="Mở/đóng menu" aria-controls="appSidebar" aria-expanded="false">
                    <i class="bi bi-list"></i>
                </button>
                <div class="topbar-title">
                    @if (IsSectionDefined(ViewConstants.TitleSection))
                    {
                        @await RenderSectionAsync(ViewConstants.TitleSection)
                    }
                    else
                    {
                        <h1 class="topbar-page-title">@pageTitle</h1>
                    }
                </div>
                @await Component.InvokeAsync("UserHeaderLinksComponent")
            </header>
            <div class="page-content">
                <main id="mainContent" role="main">
                    @RenderBody()
                </main>
            </div>

            <footer class="footer-main">
                <div class="container-fluid px-3 px-lg-4 text-center">
                    &copy; 2026 @Information.Name &mdash; Hệ thống quản lý bán hàng
                </div>
            </footer>
        </div>
    </div>
    <div id="loading-mask" class="loader-wrapper" style="display:none;">
        <div class="loader-content">
            <div class="spinner"></div>
            <p>Đang xử lý, vui lòng đợi trong giây lát...</p>
        </div>
    </div>
    <partial name="_ReusedModals" />
    <partial name="_GlobalOffcanvas" />
    <partial name="_Scripts" />
    <partial name="_Notifications" />
    @await RenderSectionAsync(ViewConstants.ScriptSection, required: false)
</body>
</html>
