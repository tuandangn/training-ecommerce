@using System.Text.Json
@inject WarehouseSettings WarehouseSettings

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/lightbox/js/lightbox.min.js" defer></script>
<script src="~/lib/sweet-alert-2/sweetalert2.js" defer></script>
<script src="~/lib/notyf/notyf.min.js"></script>
<script src="~/js/notification-center.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true" defer></script>
<script src="~/js/currency-hint.js" asp-append-version="true" defer></script>
<script src="~/js/decimal-field.js" asp-append-version="true" defer></script>
<script type="module">
    import { setWarehouseSettings } from '/modules/Settings.js';
    setWarehouseSettings(@Html.Raw(JsonSerializer.Serialize(WarehouseSettings)))
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/l10n/vn.js" defer></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var cfg = {
            locale: 'vn',
            dateFmt: 'd/m/Y',
            dtFmt: 'd/m/Y H:i'
        };

        flatpickr('input[type="date"]', {
            locale:     cfg.locale,
            dateFormat: 'Y-m-d',
            altInput:   true,
            altFormat:  cfg.dateFmt,
            allowInput: false,
            closeOnSelect: true,
            clickOpens: true,
            onReady: function(selectedDates, dateStr, instance) {
                const original = instance.input;
                original.type = "text";
                original.classList.add("visually-hidden");
            },
            onChange: function(selectedDates, dateStr, instance) {
                $(instance.input.form).data('validator')?.element(instance.input);
            }
        });

        flatpickr('input[type="datetime-local"]', {
            locale:      cfg.locale,
            dateFormat:  'Y-m-d\\TH:i:S',
            altInput:    true,
            altFormat:   cfg.dtFmt,
            enableTime:  true,
            time_24hr:   true,
            allowInput:  false,
            closeOnSelect: true,
            clickOpens: true,
            onReady: function(selectedDates, dateStr, instance) {
                const original = instance.input;
                original.type = "text";
                original.classList.add("visually-hidden");
            },
            onChange: function(selectedDates, dateStr, instance) {
                $(instance.input.form).data('validator')?.element(instance.input);
                if(selectedDates.length) instance.close();
            }
        });

        // Sidebar toggle (mobile)
        var toggle  = document.getElementById('sidebarToggle');
        var sidebar = document.getElementById('appSidebar');
        var overlay = document.getElementById('sidebarOverlay');

        if (toggle && sidebar) {
            toggle.addEventListener('click', function () {
                    sidebar.classList.toggle('open');
                    if (overlay) overlay.classList.toggle('active');
                    });
            if (overlay) {
                overlay.addEventListener('click', function () {
                    sidebar.classList.remove('open');
                    overlay.classList.remove('active');
                });
            }
        }
    });
</script>

