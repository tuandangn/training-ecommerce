@using System.Text.Json
@using NamEcommerce.Domain.Shared.Enums.Customers
@inject WarehouseSettings WarehouseSettings
@inject NamEcommerce.Web.Services.Common.ICachedValuesService CachedValueService

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/chartjs/chart.umd.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/lightbox/js/lightbox.min.js" defer></script>
<script src="~/lib/sweet-alert-2/sweetalert2.js" defer></script>
<script src="~/lib/notyf/notyf.min.js"></script>
<script src="~/js/notification-center.js" asp-append-version="true"></script>
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@10.0.7/dist/browser/signalr.min.js" defer></script>
<script src="~/js/system-notification-center.js" asp-append-version="true" defer></script>
<script src="~/js/fulfillment-schedule-center.js" asp-append-version="true" defer></script>
<script src="~/js/cowork-offcanvas.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true" defer></script>
<script src="~/js/responsive-list.js" asp-append-version="true" defer></script>
<script src="~/js/currency-hint.js" asp-append-version="true" defer></script>
<script src="~/js/decimal-field.js" asp-append-version="true" defer></script>
<script type="module">
    import { setWarehouseSettings, setCustomerSettings } from '/modules/Settings.js';
    import { setCustomerKinds } from '/modules/CustomerInfo.js'

    setWarehouseSettings(@Html.Raw(JsonSerializer.Serialize(WarehouseSettings)));
    setCustomerSettings({
        defaultCustomerId: '@CachedValueService.DefaultCustomerId'
    });
    setCustomerKinds({
        standard: @((int)CustomerKind.Standard),
        retailWalkIn: @((int)CustomerKind.RetailWalkIn)
    });
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/l10n/vn.js" defer></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var cfg = {
            locale: 'vn',
            dateFmt: 'd/m/Y',
            dtFmt: 'd/m/Y H:i'
        };

        window.initFlatPickrDate = function (element) {
            const minDate = getDateFromAttribute(element, 'data-min-date');
            const maxDate = getDateFromAttribute(element, 'data-max-date');
            if (minDate && maxDate && minDate > maxDate)
                throw new Error('Min date must less than max date');
            flatpickr(element, {
                locale: cfg.locale,
                dateFormat: 'Y-m-d\\TH:i:S',
                altInput: true,
                altFormat: cfg.dateFmt,
                allowInput: false,
                closeOnSelect: true,
                clickOpens: true,
                minDate,
                maxDate,
                onReady: function (selectedDates, dateStr, instance) {
                    const original = instance.input;
                    original.type = "text";
                    original.classList.add("visually-hidden");
                    instance._input?.classList.add('bg-white'); 
                    if (instance.altInput) {
                        instance.altInput.id = original.id + '_alt';
                    }
                },
                onChange: function (selectedDates, dateStr, instance) {
                    $(instance.input.form).data('validator')?.element(instance.input);
                    if (selectedDates.length) instance.close();
                }
            });
        }
        window.initFlatPickrDateTime = function (element) {
            const minDate = getDateFromAttribute(element, 'data-min-date');
            const maxDate = getDateFromAttribute(element, 'data-max-date');
            if (minDate && maxDate && minDate > maxDate)
                throw new Error('Min date must less than max date');
            flatpickr(element, {
                locale: cfg.locale,
                dateFormat: 'Y-m-d\\TH:i:S',
                altInput: true,
                altFormat: cfg.dtFmt,
                enableTime: true,
                time_24hr: true,
                allowInput: false,
                closeOnSelect: true,
                clickOpens: true,
                minDate,
                maxDate,
                onReady: function (selectedDates, dateStr, instance) {
                    const original = instance.input;
                    original.type = "text";
                    original.classList.add("visually-hidden");
                    instance._input?.classList.add('bg-white');
                    if (instance.altInput) {
                        instance.altInput.id = original.id + '_alt';
                    }
                },
                onChange: function (selectedDates, dateStr, instance) {
                    $(instance.input.form).data('validator')?.element(instance.input);
                }
            });
        }
        window.initFlatPickrControls = function (container) {
            container.querySelectorAll('input[type="date"]').forEach(function (el) {
                initFlatPickrDate(el);
            });
            container.querySelectorAll('input[type="datetime-local"]').forEach(function (el) {
                initFlatPickrDateTime(el);
            });
        };

        initFlatPickrControls(document);

        function getDateFromAttribute(element, attributeName){
            if(!element) 
                throw new Error('Element is required');
            if(!element.getAttribute)
                throw new Error('Element is invalid');

            const dateStr = element.getAttribute(attributeName);
            if(!dateStr) 
                return null;

            const date = new Date(dateStr);

            if(!date.getTime())
                return null;

            return date;
        }

        var toggle = document.getElementById('sidebarToggle');
        var sidebar = document.getElementById('appSidebar');
        var overlay = document.getElementById('sidebarOverlay');

        function setSidebarOpen(isOpen) {
            if (!sidebar) return;
            sidebar.classList.toggle('open', isOpen);
            document.body.classList.toggle('sidebar-open', isOpen);
            if (overlay) overlay.classList.toggle('active', isOpen);
            if (toggle) toggle.setAttribute('aria-expanded', String(isOpen));
        }

        if (toggle && sidebar) {
            toggle.addEventListener('click', function () {
                setSidebarOpen(!sidebar.classList.contains('open'));
            });
            if (overlay) {
                overlay.addEventListener('click', function () {
                    setSidebarOpen(false);
                });
            }
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && sidebar.classList.contains('open')) {
                    setSidebarOpen(false);
                    toggle.focus();
                }
            });
        }
    });
</script>

