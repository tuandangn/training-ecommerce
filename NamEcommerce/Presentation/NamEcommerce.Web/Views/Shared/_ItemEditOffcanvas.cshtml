<div class="offcanvas offcanvas-bottom" id="itemEditOffcanvas" tabindex="-1"
     style="height:auto; max-height:85vh; border-radius:16px 16px 0 0;">
    <div class="offcanvas-header border-bottom pb-3">
        <div class="d-flex align-items-center gap-2 overflow-hidden">
            <img data-oe-picture class="rounded object-fit-cover d-none" style="width:36px; height:36px;" alt="" />
            <span data-oe-name class="fw-semibold text-truncate"></span>
        </div>
        <button type="button" class="btn-close ms-2 flex-shrink-0" data-bs-dismiss="offcanvas" aria-label="Đóng"></button>
    </div>
    <div class="offcanvas-body py-3">
        <div class="mb-3">
            <label class="form-label small fw-bold text-muted text-uppercase">Số lượng</label>
            <div class="input-group">
                <button type="button" class="btn btn-outline-secondary px-3" data-oe-decrement>
                    <i class="bi bi-dash-lg"></i>
                </button>
                <input type="text" class="form-control text-center" data-oe-qty
                       inputmode="decimal" autocomplete="off" />
                <button type="button" class="btn btn-outline-secondary px-3" data-oe-increment>
                    <i class="bi bi-plus-lg"></i>
                </button>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label small fw-bold text-muted text-uppercase" data-oe-price-label>Đơn giá</label>
            <div class="input-group">
                <input type="text" class="form-control" data-oe-price
                       inputmode="decimal" autocomplete="off" />
                <span class="input-group-text">đ</span>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center px-1 text-muted small">
            <span>Thành tiền</span>
            <span data-oe-total class="fw-bold text-primary fs-6">0 đ</span>
        </div>
    </div>
    <div class="offcanvas-footer border-top p-3 d-flex justify-content-between align-items-center gap-2">
        <button type="button" class="btn btn-link link-danger text-decoration-none px-1" data-oe-delete>
            <i class="bi bi-trash me-1"></i>Xóa dòng
        </button>
        <button type="button" class="btn btn-primary px-4" data-oe-apply>
            <i class="bi bi-check-lg me-1"></i>Xác nhận
        </button>
    </div>
</div>
