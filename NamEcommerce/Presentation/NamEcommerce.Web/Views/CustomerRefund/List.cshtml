@model NamEcommerce.Web.Models.Debts.CustomerRefundListSearchModel
@using NamEcommerce.Domain.Shared.Enums.Debts
@{
    ViewData["Title"] = "Hoàn tiền khách hàng";
}
@section TitleSection {
    <h1 class="topbar-page-title">Hoàn tiền khách hàng</h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Hoàn tiền khách hàng</li>
            </ol>
        </nav>
    </div>
}
@functions {
    (string cssClass, string label) getStatusLabel(CustomerRefundStatus status) => status switch
    {
        CustomerRefundStatus.Pending => ("bg-warning text-dark", "Chờ hoàn tiền"),
        CustomerRefundStatus.Completed => ("bg-success", "Đã hoàn tiền"),
        CustomerRefundStatus.Cancelled => ("bg-secondary", "Đã huỷ"),
        _ => ("bg-light text-dark", "?")
    };
}

<div class="content-card" data-responsive-list data-list-key="customer-refund-list">
    <div class="action-toolbar">
        <partial name="_Search" />
        <partial name="_ResponsiveListToolbar" />
    </div>
    <ul class="nav nav-tabs">
        <li class="nav-item">
            <a asp-route-keywords="@(string.IsNullOrEmpty(Model.Keywords) ? "" : Model.Keywords)" asp-route-status=""
               class="nav-link @(Model.Status.HasValue ? "" : "active")">Tất cả</a>
        </li>
        @foreach (var status in Enum.GetValues<CustomerRefundStatus>())
        {
            <li class="nav-item">
                <a asp-route-Keywords="@(string.IsNullOrEmpty(Model.Keywords) ? "" : Model.Keywords)" asp-route-Status="@((int) status)"
                   class="nav-link @((int) status == Model.Status ? "active" : "")" aria-current="page">@getStatusLabel(status).label</a>
            </li>
        }
    </ul>
    <div class="content-card-body-flush">
        <div class="responsive-list-panel" data-list-view-panel="list">
            <div class="table-responsive">
                <table class="table data-table">
                    <thead class="table-light">
                        <tr>
                            <th>Mã phiếu</th>
                            <th>Khách hàng</th>
                            <th>Phiếu trả hàng</th>
                            <th class="text-end">Số tiền hoàn</th>
                            <th class="text-center">Trạng thái</th>
                            <th>Ngày tạo</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Data?.Items.Pagination.TotalCount > 0)
                        {
                            foreach (var item in Model.Data.Items)
                            {
                                var (badgeClass, label) = getStatusLabel((CustomerRefundStatus)item.Status);
                                <tr>
                                    <td><strong>@item.Code</strong></td>
                                    <td>@item.CustomerName</td>
                                    <td>
                                        <a asp-controller="CustomerReturn" asp-action="Details"
                                           asp-route-id="@item.CustomerReturnId">@item.CustomerReturnCode</a>
                                    </td>
                                    <td class="text-end text-danger fw-bold">@item.Amount.DisplayCurrencyWithSymbol()</td>
                                    <td class="text-center">
                                        <span class="badge @badgeClass">@label</span>
                                    </td>
                                    <td>@item.CreatedOnUtc.ToString(ViewConstants.DateTimeFormat)</td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-xs btn-outline-primary">Chi tiết</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">Không có phiếu hoàn tiền nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="responsive-list-panel responsive-list-grid" data-list-view-panel="grid" hidden>
            @if (Model.Data?.Items.Pagination.TotalCount > 0)
            {
                foreach (var item in Model.Data.Items)
                {
                    var (badgeClass, label) = getStatusLabel((CustomerRefundStatus)item.Status);
                    <article class="list-card">
                        <div class="list-card-header">
                            <div class="list-card-title-group">
                                <div class="list-card-title">@item.Code</div>
                                <div class="list-card-meta">@item.CreatedOnUtc.ToString(ViewConstants.DateTimeFormat)</div>
                            </div>
                            <span class="badge @badgeClass">@label</span>
                        </div>
                        <div class="list-card-fields">
                            <div class="list-card-field">
                                <span class="list-card-label">Khách hàng</span>
                                <span class="list-card-value">@item.CustomerName</span>
                            </div>
                            <div class="list-card-field">
                                <span class="list-card-label">Phiếu trả hàng</span>
                                <a asp-controller="CustomerReturn" asp-action="Details"
                                   asp-route-id="@item.CustomerReturnId"
                                   class="list-card-value text-decoration-none">@item.CustomerReturnCode</a>
                            </div>
                            <div class="list-card-field">
                                <span class="list-card-label">Số tiền hoàn</span>
                                <span class="list-card-value text-danger">@item.Amount.DisplayCurrencyWithSymbol()</span>
                            </div>
                        </div>
                        <div class="list-card-actions">
                            <a asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary">Chi tiết</a>
                        </div>
                    </article>
                }
            }
            else
            {
                <div class="empty-state">
                    <span class="text-muted">Không có phiếu hoàn tiền nào.</span>
                </div>
            }
        </div>
        @if (Model.Data?.Items.Pagination.TotalCount > 0)
        {
            <partial name="_Pager" model="Model.Data?.Items.Pagination" />
        }
    </div>
</div>
@section Scripts {
    <script type="module">
        const txtKeywords = document.getElementById('@Html.IdFor(m => m.Keywords)');
        const form = txtKeywords.closest('form');
        const onSearchChanged = debounce(function () {
            form.submit();
            disableForm(form);
        }, 500);
        txtKeywords.addEventListener('input', onSearchChanged);

        if (txtKeywords.value) {
            focusEnd(txtKeywords);
        }
    </script>
}
