@model NamEcommerce.Web.Models.Debts.CustomerRefundDetailsViewModel
@using NamEcommerce.Domain.Shared.Enums.Debts
@using NamEcommerce.Domain.Shared.Enums.Orders

@{
    ViewData["Title"] = $"Phiếu hoàn tiền {Model.Code}";
}

<style>
    .refund-info-list { list-style: none; padding: 0; margin: 0; }
    .refund-info-row { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid #f0f0f0; font-size: 0.9rem; }
    .refund-info-row:last-child { border-bottom: none; }
    .refund-info-row .label { color: #6c757d; }
    .refund-info-row .value { font-weight: 500; text-align: right; }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">
        Phiếu hoàn tiền: <strong>@Model.Code</strong>
        <span class="badge @Model.StatusBadgeClass ms-2">@Model.StatusLabel</span>
    </h4>
    <a asp-action="List" class="btn btn-sm btn-outline-secondary">← Danh sách</a>
</div>

<div class="row g-3">
    <!-- Thông tin chính -->
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">Thông tin hoàn tiền</div>
            <div class="card-body">
                <ul class="refund-info-list">
                    <li class="refund-info-row">
                        <span class="label">Khách hàng</span>
                        <span class="value">@Model.CustomerName</span>
                    </li>
                    <li class="refund-info-row">
                        <span class="label">Phiếu trả hàng</span>
                        <span class="value">
                            <a asp-controller="CustomerReturn" asp-action="Details"
                               asp-route-id="@Model.CustomerReturnId">@Model.CustomerReturnCode</a>
                        </span>
                    </li>
                    <li class="refund-info-row">
                        <span class="label">Số tiền hoàn</span>
                        <span class="value text-danger fw-bold fs-5">@Model.Amount.ToString("N0") ₫</span>
                    </li>
                    <li class="refund-info-row">
                        <span class="label">Trạng thái</span>
                        <span class="value"><span class="badge @Model.StatusBadgeClass">@Model.StatusLabel</span></span>
                    </li>
                    @if (Model.PaymentMethod.HasValue)
                    {
                        var pmLabel = Model.PaymentMethod switch
                        {
                            PaymentMethod.Cash => "Tiền mặt",
                            PaymentMethod.BankTransfer => "Chuyển khoản",
                            PaymentMethod.COD => "COD",
                            _ => "Khác"
                        };
                        <li class="refund-info-row">
                            <span class="label">Hình thức hoàn</span>
                            <span class="value">@pmLabel</span>
                        </li>
                    }
                    @if (Model.RefundedOnUtc.HasValue)
                    {
                        <li class="refund-info-row">
                            <span class="label">Thời gian hoàn</span>
                            <span class="value">@Model.RefundedOnUtc.Value.ToString("dd/MM/yyyy HH:mm")</span>
                        </li>
                    }
                    @if (!string.IsNullOrEmpty(Model.Note))
                    {
                        <li class="refund-info-row">
                            <span class="label">Ghi chú</span>
                            <span class="value">@Model.Note</span>
                        </li>
                    }
                    <li class="refund-info-row">
                        <span class="label">Ngày tạo</span>
                        <span class="value">@Model.CreatedOnUtc.ToString("dd/MM/yyyy HH:mm")</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Actions -->
    @if (Model.Status == CustomerRefundStatus.Pending)
    {
        <div class="col-lg-4">
            <div class="card shadow-sm border-warning">
                <div class="card-header fw-semibold text-warning-emphasis bg-warning-subtle">
                    Xác nhận hoàn tiền
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Xác nhận đã hoàn <strong class="text-danger">@Model.Amount.ToString("N0") ₫</strong>
                        cho khách hàng <strong>@Model.CustomerName</strong>.
                    </p>
                    <div class="mb-3">
                        <label class="form-label small">Hình thức hoàn tiền</label>
                        <select id="completePaymentMethod" class="form-select form-select-sm">
                            <option value="0">Tiền mặt</option>
                            <option value="1">Chuyển khoản</option>
                            <option value="3">Khác</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Ghi chú</label>
                        <input id="completeNote" type="text" class="form-control form-control-sm"
                               placeholder="Tuỳ chọn..."/>
                    </div>
                    <button id="btnComplete" class="btn btn-success btn-sm w-100">
                        ✓ Đã hoàn tiền
                    </button>
                </div>
            </div>

            <div class="card shadow-sm border-danger mt-3">
                <div class="card-body">
                    <p class="text-muted small mb-2">Huỷ phiếu nếu không thực hiện hoàn tiền.</p>
                    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('Xác nhận huỷ phiếu hoàn tiền này?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100">Huỷ phiếu</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.Status == CustomerRefundStatus.Pending)
{
    <script>
        document.getElementById('btnComplete').addEventListener('click', async function () {
            const btn = this;
            const paymentMethod = parseInt(document.getElementById('completePaymentMethod').value);
            const note = document.getElementById('completeNote').value;

            btn.disabled = true;
            btn.textContent = 'Đang xử lý...';

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const res = await fetch('@Url.Action("Complete", "CustomerRefund", new { id = Model.Id })', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token ?? '' },
                    body: JSON.stringify({ paymentMethod, note })
                });
                const data = await res.json();
                if (data.success) {
                    location.reload();
                } else {
                    alert('Lỗi: ' + (data.message ?? 'Không thể hoàn tiền.'));
                    btn.disabled = false;
                    btn.textContent = '✓ Đã hoàn tiền';
                }
            } catch {
                alert('Có lỗi xảy ra. Vui lòng thử lại.');
                btn.disabled = false;
                btn.textContent = '✓ Đã hoàn tiền';
            }
        });
    </script>
    @Html.AntiForgeryToken()
}
