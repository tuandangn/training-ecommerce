@using NamEcommerce.Domain.Shared.Enums.Finance
@using NamEcommerce.Web.Models.Finances
@model CreateExpenseModel

@{
    ViewData[ViewConstants.PageTitle] = "Thêm mới Chi phí";
}

@section TitleSection {
    <h1 class="topbar-page-title">
        Thêm mới
        <span class="text-muted">Chi phí</span>
    </h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="List" asp-controller="Expense" class="text-decoration-none">Quản lý chi phí</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
            </ol>
        </nav>
    </div>
}
<div class="content-card">
    <form asp-action="Create" method="post" asp-antiforgery="true">
        <div class="content-card-header">
            <h5>Thông tin chi phí</h5>
        </div>
        <div class="content-card-body">
            <div class="row g-3">
                <div asp-validation-summary="ModelOnly" class="alert alert-warning alert-global alert-dismissible long-time-waiting"></div>
                <div class="col-md-6">
                    <label asp-for="Title" class="form-label">Tên khoản chi</label>
                    <input asp-for="Title" class="form-control" placeholder="Tên khoản chi" 
                        data-val-required="Tên khoản chi không được để trống" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="IncurredDate" class="form-label">Ngày phát sinh</label>
                    <input asp-for="IncurredDate" type="date" class="form-control" placeholder="Ngày phát sinh"
                           data-val-range-max="@DateTime.Today.ToString("s")" data-val-required="Vui lòng nhập Ngày phát sinh" />
                    <span asp-validation-for="IncurredDate" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="AmountWithoutTax" class="form-label">Số tiền</label>
                    <input asp-for="AmountWithoutTax" value="@Model.AmountWithoutTax.DisplayCurrency()" class="form-control text-end"
                           placeholder="Số tiền" inputmode="numeric" data-decimal="currency"
                           data-val-range="Số tiền phải lớn hơn 0" data-val-range-min="0.001"
                           data-val-number="Số tiền phải là số" data-val-required="Vui lòng nhập Số tiền" />
                    <span asp-validation-for="AmountWithoutTax" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ExpenseType" class="form-label">Loại phí</label>
                    <select asp-for="ExpenseType" class="form-select">
                        @foreach (var (value, text) in ExpenseType.GetOptions())
                        {
                            <option value="@value" selected="@(value == (int)Model.ExpenseType)" disabled="@(value == (int) ExpenseType.AssetDisposal)">@text</option>
                        }
                    </select>
                    <span asp-validation-for="ExpenseType" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label">Ghi chú</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Nhập ghi chú"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="content-card-footer d-flex align-items-center justify-content-between">
            <a asp-action="List" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i>
                Trở về
            </a>
            <div class="d-block">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-floppy"></i>
                    Thêm mới
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
