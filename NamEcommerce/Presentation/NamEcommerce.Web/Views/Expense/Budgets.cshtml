@using NamEcommerce.Web.Contracts.Models.Finance
@model ExpenseBudgetListModel
@{
    ViewData[ViewConstants.PageTitle] = "Ngân sách Chi phí";

    var monthNames = new[] { "", "Tháng 1", "Tháng 2", "Tháng 3", "Tháng 4", "Tháng 5", "Tháng 6", "Tháng 7", "Tháng 8", "Tháng 9", "Tháng 10", "Tháng 11", "Tháng 12" };

    string TypeLabel(int t) => t switch
    {
        1 => "Lương thưởng",
        2 => "Mặt bằng",
        3 => "Tiếp thị",
        4 => "Điện nước",
        5 => "Khác",
        _ => "Khác"
    };

    string TypeIcon(int t) => t switch
    {
        1 => "bi-people",
        2 => "bi-building",
        3 => "bi-megaphone",
        4 => "bi-lightning-charge",
        5 => "bi-three-dots",
        _ => "bi-three-dots"
    };

    var prevMonth = Model.Month == 1 ? new { year = Model.Year - 1, month = 12 } : new { year = Model.Year, month = Model.Month - 1 };
    var nextMonth = Model.Month == 12 ? new { year = Model.Year + 1, month = 1 } : new { year = Model.Year, month = Model.Month + 1 };
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">Ngân sách Chi phí</h1>
        <p class="page-header-subtitle">Thiết lập hạn mức ngân sách theo từng loại chi phí mỗi tháng</p>
    </div>
    <a asp-action="List" class="btn btn-outline-secondary">
        <i class="bi bi-list-ul me-1"></i>Danh sách Chi phí
    </a>
</div>

<div class="content-card mb-4">
    <div class="d-flex align-items-center gap-3 p-3">
        <a href="@Url.Action("Budgets", new { year = prevMonth.year, month = prevMonth.month })" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-chevron-left"></i>
        </a>
        <h5 class="mb-0 fw-bold">@monthNames[Model.Month] / @Model.Year</h5>
        <a href="@Url.Action("Budgets", new { year = nextMonth.year, month = nextMonth.month })" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-chevron-right"></i>
        </a>
        <a href="@Url.Action("Budgets")" class="btn btn-outline-secondary btn-sm text-muted ms-2">Tháng hiện tại</a>
    </div>
</div>

<div class="row g-3">
    @foreach (var item in Model.Items)
    {
        var pct = item.BudgetAmount > 0 ? Math.Min(100, (int)(item.ActualAmount * 100 / item.BudgetAmount)) : (item.ActualAmount > 0 ? 100 : 0);
        var isOver = item.BudgetAmount > 0 && item.ActualAmount > item.BudgetAmount;
        var remaining = item.BudgetAmount - item.ActualAmount;
        var barClass = isOver ? "bg-danger" : pct >= 80 ? "bg-warning" : "bg-success";

        <div class="col-12 col-md-6">
            <div class="content-card h-100">
                <div class="p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center bg-light ui-size-44 flex-shrink-0">
                            <i class="bi @TypeIcon(item.ExpenseType) fs-5 text-secondary"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold">@TypeLabel(item.ExpenseType)</h6>
                            <small class="text-muted">@item.Count giao dịch trong tháng</small>
                        </div>
                        @if (isOver)
                        {
                            <span class="badge bg-danger ms-auto">Vượt ngân sách</span>
                        }
                        else if (pct >= 80)
                        {
                            <span class="badge bg-warning text-dark ms-auto">Gần hết</span>
                        }
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-muted">Đã chi</span>
                            <span class="fw-semibold @(isOver ? "text-danger" : "")">@item.ActualAmount.DisplayCurrencyWithSymbol()</span>
                        </div>
                        <div class="progress ui-h-8">
                            <div class="progress-bar @barClass" data-progress-width="@pct"></div>
                        </div>
                        <div class="d-flex justify-content-between small mt-1">
                            <span class="text-muted">@pct% ngân sách</span>
                            @if (item.BudgetAmount > 0)
                            {
                                <span class="@(isOver ? "text-danger fw-semibold" : "text-muted")">
                                    @(isOver ? "Vượt " : "Còn ") @Math.Abs(remaining).DisplayCurrencyWithSymbol()
                                </span>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">Chưa đặt ngân sách</span>
                            }
                        </div>
                    </div>

                    <form asp-action="UpsertBudget" method="post" class="d-flex gap-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ExpenseType" value="@item.ExpenseType" />
                        <input type="hidden" name="Year" value="@Model.Year" />
                        <input type="hidden" name="Month" value="@Model.Month" />
                        <div class="flex-grow-1">
                            <label class="form-label text-muted small mb-1">Ngân sách tháng</label>
                            <div class="input-group">
                                <input type="number" name="Amount" class="form-control" min="0" step="1000"
                                       value="@((long)item.BudgetAmount)" placeholder="0" />
                                <span class="input-group-text text-muted small">đ</span>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary px-3">
                            <i class="bi bi-check-lg"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
