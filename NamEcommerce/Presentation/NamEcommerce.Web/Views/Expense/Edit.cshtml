@using NamEcommerce.Domain.Shared.Enums.Finance
@using NamEcommerce.Web.Models.Finances
@model EditExpenseModel
@{
    ViewData[ViewConstants.PageTitle] = "Chỉnh sửa Chi phí";
}

@section TitleSection {
    <h1 class="topbar-page-title">
        Chi phí
        <span class="text-muted">@Model.Title</span>
    </h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="List" asp-controller="Expense" class="text-decoration-none">Chi phí</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            </ol>
        </nav>
    </div>
}
<div class="content-card">
    <form asp-action="Edit" method="post" asp-antiforgery="true">
        <div class="content-card-header">
            <h5>Thông tin chi phí</h5>
        </div>
        <div class="content-card-body">
            <div class="row g-3">
                @if (Model.IsSystemGenerated)
                {
                    <div class="alert alert-warning d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-shield-lock-fill"></i>
                        <span>Khoản chi phí này được tạo tự động bởi hệ thống (từ nghiệp vụ hoàn hàng). Chỉ có thể chỉnh sửa ghi chú.</span>
                    </div>
                }
                <div asp-validation-summary="ModelOnly" class="alert alert-warning alert-global alert-dismissible long-time-waiting"></div>
                <input type="hidden" asp-for="Id" />
                <div class="col-md-6">
                    <label asp-for="Title" class="form-label">Khoản chi</label>
                    <input asp-for="Title" class="form-control" disabled="@(Model.IsSystemGenerated)" />
                    @if (Model.IsSystemGenerated)
                    {
                        <input type="hidden" asp-for="Title" />
                    }
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="IncurredDate" class="form-label">Ngày phát sinh</label>
                    <input asp-for="IncurredDate" type="date" class="form-control" data-val-range-max="@DateTime.Today.ToString("s")" disabled="@(Model.IsSystemGenerated)" />
                    @if (Model.IsSystemGenerated)
                    {
                        <input type="hidden" asp-for="IncurredDate" />
                    }
                    <span asp-validation-for="IncurredDate" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="AmountWithoutTax" class="form-label">
                        Số tiền
                    </label>
                    <input asp-for="AmountWithoutTax" data-decimal="currency" class="form-control" disabled="@(Model.IsSystemGenerated)" inputmode="numeric" />
                    @if (Model.IsSystemGenerated)
                    {
                        <input type="hidden" asp-for="AmountWithoutTax" />
                    }
                    <span asp-validation-for="AmountWithoutTax" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ExpenseType" class="form-label">Loại phí</label>
                    <select asp-for="ExpenseType" class="form-select" disabled="@(Model.IsSystemGenerated)">
                        @foreach (var (value, text) in ExpenseType.GetOptions())
                        {
                            <option value="@value" selected="@(value == (int)Model.ExpenseType)">@text</option>
                        }
                    </select>
                    @if (Model.IsSystemGenerated)
                    {
                        <input type="hidden" asp-for="ExpenseType" />
                    }
                    <span asp-validation-for="ExpenseType" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label">Ghi chú thêm</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="content-card-footer d-flex align-items-center justify-content-between">
            <a asp-action="List" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i>
                Trở về
            </a>
            <div class="d-block">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-floppy"></i>
                    Lưu lại
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
