@using System.Globalization
@model NamEcommerce.Web.Contracts.Models.Inventory.InventoryStockListModel
@{
    ViewData["Title"] = "Tồn kho";
    var query = Model.Keywords;
    var totalCount = Model.GroupByProduct ? Model.GroupedData.Pagination.TotalCount : Model.Data.Pagination.TotalCount;
    var listKey = Model.GroupByProduct ? "inventory-stock-product-list" : "inventory-stock-warehouse-list";
}

@functions {
    private static decimal AvailablePercent(decimal quantityOnHand, decimal quantityAvailable)
        => quantityOnHand > 0 ? Math.Clamp(quantityAvailable / quantityOnHand * 100, 0, 100) : 0;

    private static string PercentWidth(decimal value)
        => value.ToString("0.##", CultureInfo.InvariantCulture) + "%";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/inventory-stocklist.css" asp-append-version="true" />
}

@section TitleSection {
    <h1 class="topbar-page-title">Tồn kho</h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Tồn kho</li>
            </ol>
        </nav>
    </div>
}
<div class="content-card" data-responsive-list data-list-key="@listKey">
    <div class="action-toolbar align-items-start">
        <form method="get" asp-action="StockList" class="row g-3 flex-grow-1">
            <input type="hidden" name="groupByProduct" value="@Model.GroupByProduct.ToString().ToLowerInvariant()" />
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="Keywords" class="form-control border-start-0 ps-0"
                           placeholder="Tìm theo tên sản phẩm hoặc kho" value="@query" inputmode="search"/>
                </div>
                <div class="form-check mt-1 ms-1">
                    <input class="form-check-input" type="checkbox" value="true" name="includeDs" id="includeDs" checked="@Model.IncludeDirectTransit">
                    <label class="form-check-label" for="includeDs">
                        Hiển thị kho giao trực tiếp
                    </label>
                </div>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100 rounded-3">Tìm kiếm</button>
            </div>
        </form>
        <div class="d-flex align-items-center gap-2">
            <div class="btn-group" role="group" aria-label="Chọn cách gom tồn kho">
                <a asp-action="StockList"
                   asp-route-keywords="@query"
                   asp-route-includeDs="@Model.IncludeDirectTransit"
                   asp-route-groupByProduct="false"
                   class="btn @(Model.GroupByProduct ? "border" : "btn-outline-secondary")">
                    Theo kho
                </a>
                <a asp-action="StockList"
                   asp-route-keywords="@query"
                   asp-route-includeDs="@Model.IncludeDirectTransit"
                   asp-route-groupByProduct="true"
                   class="btn @(Model.GroupByProduct ? "btn-outline-secondary" : "border")">
                    Theo hàng hóa
                </a>
            </div>
            <a asp-action="CostingPolicy" class="btn btn-outline-secondary" title="Cài đặt giá vốn">
                <i class="bi bi-calculator me-1" aria-hidden="true"></i> Giá vốn
            </a>
            <partial name="_ResponsiveListToolbar" />
        </div>
    </div>
    @if (totalCount > 0)
    {
        <div class="content-card-body-flush">
            <div id="stock-list-view" class="responsive-list-panel overflow-hidden" data-list-view-panel="list">
                <div class="table-responsive">
                    @if (Model.GroupByProduct)
                    {
                        <table class="table table-hover align-middle mb-0 stock-table">
                            <thead>
                                <tr>
                                    <th class="ps-4 py-3 col-product">Sản phẩm</th>
                                    <th class="text-end py-3">Giá vốn</th>
                                    <th class="py-3">Trong kho</th>
                                    <th class="text-end py-3">Thực có</th>
                                    <th class="text-end py-3">Chờ giao</th>
                                    <th class="text-end py-3">Sẵn bán</th>
                                    <th class="py-3">Cập nhật</th>
                                    <th class="text-end pe-4 py-3">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.GroupedData)
                                {
                                    var stockHealth = item.QuantityAvailable < 5 ? "danger" : (item.QuantityAvailable < 20 ? "warning" : "success");
                                    var historyUrl = Url.Action("CostHistory", "Inventory", new { productId = item.ProductId });
                                    var inlineHistoryId = $"cost-inline-product-{item.ProductId:N}";
                                    var hasCostHistory = item.CostHistory.Any();
                                    <tr>
                                        <td class="ps-4 col-product">
                                            <div class="product-name fw-semibold text-dark" title="@item.ProductName">@item.ProductName</div>
                                            <div class="text-muted small">@item.Warehouses.Count kho</div>
                                        </td>
                                        <td class="text-end fw-bold text-info text-nowrap">@item.CurrentUnitCost.DisplayCurrencyWithSymbol()</td>
                                        <td>
                                            <div class="warehouse-breakdown">
                                                @foreach (var warehouse in item.Warehouses)
                                                {
                                                    <span class="warehouse-pill">
                                                        <i class="bi bi-geo-alt" aria-hidden="true"></i>
                                                        <span>@warehouse.WarehouseName:</span>
                                                        <strong>@warehouse.QuantityOnHand.DisplayQuantity()</strong>
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                        <td class="text-end fw-semibold">@item.QuantityOnHand.DisplayQuantity()</td>
                                        <td class="text-end fw-semibold text-warning">@item.QuantityReserved.DisplayQuantity()</td>
                                        <td class="text-end fw-bold text-@stockHealth">@item.QuantityAvailable.DisplayQuantity()</td>
                                        <td class="text-muted small text-nowrap">
                                            <i class="bi bi-clock me-1" aria-hidden="true"></i> @item.UpdatedOn.ToString(ViewConstants.DefaultDateTimeFormat)
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="btn-group history-action-group">
                                                @if (hasCostHistory)
                                                {
                                                    <button type="button"
                                                            class="btn btn-outline-dark btn-sm rounded-pill px-3 cost-history-toggle"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#@inlineHistoryId"
                                                            aria-expanded="false"
                                                            aria-controls="@inlineHistoryId"
                                                            title="Lịch sử giá vốn">
                                                        <i class="bi bi-clock-history me-1" aria-hidden="true"></i>
                                                        <span class="visually-hidden">Giá vốn</span>
                                                        <i class="bi bi-chevron-down ms-1" aria-hidden="true"></i>
                                                    </button>
                                                }
                                                <a class="btn btn-outline-primary btn-sm rounded-pill px-3"
                                                   asp-action="ReservationLedger"
                                                   asp-route-productId="@item.ProductId"
                                                   title="Lịch sử giữ hàng">
                                                    <i class="bi bi-list-check" aria-hidden="true"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                    @if (hasCostHistory)
                                    {
                                        <tr class="cost-inline-row">
                                            <td colspan="8" class="p-0 border-0">
                                                <div class="collapse" id="@inlineHistoryId">
                                                    <div class="px-4 pb-3 pt-1">
                                                        <div class="cost-inline-panel">
                                                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                                                <span class="cost-history-heading">3 biến động giá vốn gần nhất</span>
                                                                <button type="button" class="btn btn-outline-secondary btn-sm text-decoration-none btn-cost-history-panel"
                                                                        data-history-url="@historyUrl"
                                                                        data-history-title="Giá vốn - @item.ProductName">
                                                                    Xem đầy đủ
                                                                </button>
                                                            </div>
                                                            @await Html.PartialAsync("_InventoryCostHistoryMiniTable", item.CostHistory.Take(3).ToList())
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <table class="table table-hover align-middle mb-0 stock-table">
                            <thead>
                                <tr>
                                    <th class="ps-4 py-3 col-product">Sản phẩm</th>
                                    <th class="text-end py-3">Giá vốn</th>
                                    <th class="text-end py-3">Đặt hàng</th>
                                    <th class="py-3">Kho</th>
                                    <th class="text-end py-3">Thực có</th>
                                    <th class="text-end py-3">Chờ giao</th>
                                    <th class="text-end py-3">Sẵn bán</th>
                                    <th class="py-3 ui-min-w-200">Khả dụng</th>
                                    <th class="text-end pe-4 py-3">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Data)
                                {
                                    var stockHealth = item.QuantityAvailable < 5 ? "danger" : (item.QuantityAvailable < 20 ? "warning" : "success");
                                    var availablePercent = AvailablePercent(item.QuantityOnHand, item.QuantityAvailable);
                                    var isLow = item.QuantityAvailable < 5;
                                    var rowClass = isLow ? "is-low-stock" : "";
                                    var historyUrl = Url.Action("CostHistory", "Inventory", new { productId = item.ProductId, warehouseId = item.WarehouseId });
                                    var inlineHistoryId = $"cost-inline-stock-{item.Id:N}";
                                    var hasCostHistory = item.CostHistory.Any();
                                    <tr class="@rowClass">
                                        <td class="ps-4 col-product">
                                            <div class="product-name fw-semibold text-dark" title="@item.ProductName">@item.ProductName</div>
                                        </td>
                                        <td class="text-end fw-bold text-info text-nowrap">@item.CurrentUnitCost.DisplayCurrencyWithSymbol()</td>
                                        <td class="text-end">
                                            @if (item.TotalReservedByOrder > 0)
                                            {
                                                <a class="fw-semibold text-primary text-decoration-none"
                                                   asp-action="ReservationLedger"
                                                   asp-route-productId="@item.ProductId"
                                                   title="Xem lịch sử giữ hàng của @item.ProductName">
                                                    @item.TotalReservedByOrder.DisplayQuantity()
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">@item.TotalReservedByOrder.DisplayQuantity()</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-muted rounded-pill px-2 fw-normal">
                                                <i class="bi bi-geo-alt me-1"></i> @item.WarehouseName
                                            </span>
                                        </td>
                                        <td class="text-end fw-semibold">@item.QuantityOnHand.DisplayQuantity()</td>
                                        <td class="text-end fw-semibold text-warning">@item.QuantityReserved.DisplayQuantity()</td>
                                        <td class="text-end text-nowrap">
                                            @if (isLow)
                                            {
                                                <span class="badge bg-danger-subtle text-danger rounded-pill pe-1 fw-semibold" title="Sắp hết hàng">
                                                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                                                    <span class="visually-hidden">Sắp hết hàng</span>
                                                </span>
                                            }
                                            <span class="fw-bold text-@stockHealth">@item.QuantityAvailable.DisplayQuantity()</span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="progress rounded-pill flex-grow-1 ui-h-6" role="progressbar" aria-valuenow="@availablePercent.ToString("N0")" aria-valuemin="0" aria-valuemax="100">
                                                    <div class="progress-bar bg-@stockHealth" data-progress-width="@PercentWidth(availablePercent)"></div>
                                                </div>
                                                <span class="small fw-bold text-@stockHealth text-end ui-min-w-42">@availablePercent.ToString("N0")%</span>
                                            </div>
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="btn-group history-action-group">
                                                @if (hasCostHistory)
                                                {
                                                    <button type="button"
                                                            class="btn btn-outline-dark btn-sm rounded-pill px-3 cost-history-toggle"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#@inlineHistoryId"
                                                            aria-expanded="false"
                                                            aria-controls="@inlineHistoryId"
                                                            title="Lịch sử giá vốn">
                                                        <i class="bi bi-clock-history me-1" aria-hidden="true"></i>
                                                        <span class="visually-hidden">Giá vốn</span>
                                                        <i class="bi bi-chevron-down ms-1" aria-hidden="true"></i>
                                                    </button>
                                                }
                                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 btn-set-stock-levels"
                                                        data-id="@item.Id"
                                                        data-product-name="@item.ProductName"
                                                        data-warehouse-name="@item.WarehouseName"
                                                        data-reorder-level="@item.ReorderLevel"
                                                        data-max-stock-level="@item.MaxStockLevel"
                                                        title="Cấu hình mức tồn">
                                                    <i class="bi bi-sliders" aria-hidden="true"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    @if (hasCostHistory)
                                    {
                                        <tr class="cost-inline-row">
                                            <td colspan="9" class="p-0 border-0">
                                                <div class="collapse" id="@inlineHistoryId">
                                                    <div class="px-4 pb-3 pt-1">
                                                        <div class="cost-inline-panel">
                                                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                                                <span class="cost-history-heading">3 biến động giá vốn gần nhất</span>
                                                                <button type="button" class="btn btn-outline-secondary btn-sm text-decoration-none btn-cost-history-panel"
                                                                        data-history-url="@historyUrl"
                                                                        data-history-title="Giá vốn - @item.ProductName (@item.WarehouseName)">
                                                                    Xem đầy đủ
                                                                </button>
                                                            </div>
                                                            @await Html.PartialAsync("_InventoryCostHistoryMiniTable", item.CostHistory.Take(3).ToList())
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            <div id="stock-grid-view" class="responsive-list-panel row g-4" data-list-view-panel="grid" hidden>
                @if (Model.GroupByProduct)
                {
                    @foreach (var item in Model.GroupedData)
                    {
                        var stockHealth = item.QuantityAvailable < 5 ? "danger" : (item.QuantityAvailable < 20 ? "warning" : "success");
                        var historyUrl = Url.Action("CostHistory", "Inventory", new { productId = item.ProductId });
                        var hasCostHistory = item.CostHistory.Any();
                        <div class="col-md-6 col-xl-4">
                            <div class="card border-0 shadow-sm rounded-4 h-100">
                                <div class="card-body p-4">
                                    <div class="d-flex justify-content-between gap-3 mb-3">
                                        <div>
                                            <h5 class="fw-bold mb-1 text-dark line-clamp-2">@item.ProductName</h5>
                                            <div class="text-muted small">@item.Warehouses.Count kho đang có hàng</div>
                                        </div>
                                        <span class="badge bg-info-subtle text-info align-self-start rounded-pill">@item.CurrentUnitCost.DisplayCurrencyWithSymbol()</span>
                                    </div>

                                    <div class="row g-0 mb-3 bg-light rounded-4 p-3 border border-light">
                                        <div class="col-4 border-end border-white text-center">
                                            <div class="small text-muted mb-1">Thực có</div>
                                            <div class="fw-bold fs-5">@item.QuantityOnHand.DisplayQuantity()</div>
                                        </div>
                                        <div class="col-4 border-end border-white text-center">
                                            <div class="small text-muted mb-1">Chờ giao</div>
                                            <div class="fw-bold fs-5 text-warning">@item.QuantityReserved.DisplayQuantity()</div>
                                        </div>
                                        <div class="col-4 text-center">
                                            <div class="small text-muted mb-1">Sẵn bán</div>
                                            <div class="fw-bold fs-5 text-@stockHealth">@item.QuantityAvailable.DisplayQuantity()</div>
                                        </div>
                                    </div>

                                    <div class="warehouse-breakdown mb-3">
                                        @foreach (var warehouse in item.Warehouses)
                                        {
                                            <span class="warehouse-pill">
                                                <i class="bi bi-geo-alt" aria-hidden="true"></i>
                                                <span>@warehouse.WarehouseName:</span>
                                                <strong>@warehouse.QuantityOnHand.DisplayQuantity()</strong>
                                            </span>
                                        }
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="text-muted small">
                                            <i class="bi bi-clock me-1"></i> @item.UpdatedOn.ToString(ViewConstants.DefaultDateTimeFormat)
                                        </div>
                                        @if (hasCostHistory)
                                        {
                                            <button type="button"
                                                    class="btn btn-outline-dark btn-sm rounded-pill px-3 btn-cost-history-panel"
                                                    data-history-url="@historyUrl"
                                                    data-history-title="Giá vốn - @item.ProductName">
                                                <i class="bi bi-clock-history me-1" aria-hidden="true"></i> Giá vốn
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    @foreach (var item in Model.Data)
                    {
                        var stockHealth = item.QuantityAvailable < 5 ? "danger" : (item.QuantityAvailable < 20 ? "warning" : "success");
                        var availablePercent = AvailablePercent(item.QuantityOnHand, item.QuantityAvailable);
                        var historyUrl = Url.Action("CostHistory", "Inventory", new { productId = item.ProductId, warehouseId = item.WarehouseId });
                        var hasCostHistory = item.CostHistory.Any();

                        <div class="col-md-6 col-xl-4">
                            <div class="card border-0 shadow-sm rounded-4 h-100">
                                <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <span class="badge bg-light text-muted rounded-pill px-2">
                                            <i class="bi bi-geo-alt me-1"></i> @item.WarehouseName
                                        </span>
                                        @if (item.QuantityAvailable < 5)
                                        {
                                            <span class="badge bg-danger-subtle text-danger rounded-pill px-2">
                                                <i class="bi bi-exclamation-triangle me-1"></i> Sắp hết hàng
                                            </span>
                                        }
                                    </div>
                                    <h5 class="fw-bold mb-3 text-dark line-clamp-2 ui-min-h-3rem">@item.ProductName</h5>
                                </div>

                                <div class="card-body px-4 pt-0">
                                    <div class="row g-0 mb-4 bg-light rounded-4 p-3 border border-light">
                                        <div class="col-4 border-end border-white text-center">
                                            <div class="small text-muted mb-1">Thực có</div>
                                            <div class="fw-bold fs-5">@item.QuantityOnHand.DisplayQuantity()</div>
                                        </div>
                                        <div class="col-4 border-end border-white text-center">
                                            <div class="small text-muted mb-1">Chờ giao</div>
                                            <div class="fw-bold fs-5 text-warning">@item.QuantityReserved.DisplayQuantity()</div>
                                        </div>
                                        <div class="col-4 text-center">
                                            <div class="small text-muted mb-1">Sẵn bán</div>
                                            <div class="fw-bold fs-5 text-@stockHealth">@item.QuantityAvailable.DisplayQuantity()</div>
                                        </div>
                                    </div>

                                    <div class="mb-4">
                                        <div class="d-flex justify-content-between small mb-1">
                                            <span class="text-muted">Độ khả dụng</span>
                                            <span class="fw-bold text-@stockHealth">@availablePercent.ToString("N0")%</span>
                                        </div>
                                        <div class="progress rounded-pill ui-h-8">
                                            <div class="progress-bar bg-@stockHealth" role="progressbar" data-progress-width="@PercentWidth(availablePercent)"></div>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center pb-2 mt-2">
                                            <div>
                                                <span class="small text-muted">Giá vốn</span>
                                                <span class="fw-bold text-info">@item.CurrentUnitCost.DisplayCurrencyWithSymbol()</span>
                                            </div>
                                            <div>
                                                <span class="small text-muted">Đang đặt</span>
                                                @if (item.TotalReservedByOrder > 0)
                                                {
                                                    <a class="fw-semibold fs-5 text-primary text-decoration-none" title="Xem lịch sử giữ hàng của @item.ProductName"
                                                       asp-action="ReservationLedger" asp-route-productId="@item.ProductId">
                                                        @item.TotalReservedByOrder.DisplayQuantity()
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="fw-bold fs-5 text-muted">@item.TotalReservedByOrder.DisplayQuantity()</span>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                </div>

                                <div class="card-footer bg-white border-0 px-4 pb-4 pt-0">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="text-muted small">
                                            <i class="bi bi-clock me-1"></i> @item.UpdatedOn.ToString(ViewConstants.DefaultDateTimeFormat)
                                        </div>
                                        <div class="btn-group shadow-sm rounded-pill overflow-hidden">
                                            @if (hasCostHistory)
                                            {
                                                <button type="button"
                                                        class="btn btn-outline-dark btn-sm border-0 px-3 btn-cost-history-panel"
                                                        data-history-url="@historyUrl"
                                                        data-history-title="Giá vốn - @item.ProductName (@item.WarehouseName)"
                                                        title="Lịch sử giá vốn">
                                                    <i class="bi bi-clock-history"></i>
                                                </button>
                                            }
                                            <a class="btn btn-outline-primary btn-sm border-0 px-3" asp-action="ReservationLedger" asp-route-productId="@item.ProductId" title="Lịch sử giữ hàng">
                                                <i class="bi bi-list-check"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <partial name="_Pager" model="@(Model.GroupByProduct ? Model.GroupedData.Pagination : Model.Data.Pagination)" />
        </div>
    }
    else
    {
        var isFiltered = !string.IsNullOrWhiteSpace(query);
        <div class="text-center py-5">
            <div class="mb-3">
                <i class="bi @(isFiltered ? "bi-search" : "bi-box-seam") text-muted display-1 opacity-25" aria-hidden="true"></i>
            </div>
            @if (isFiltered)
            {
                <h4 class="text-muted">Không tìm thấy kết quả</h4>
                <p class="text-muted small">Không có sản phẩm nào khớp với từ khóa "<strong>@query</strong>".</p>
                <a asp-action="StockList" class="btn btn-outline-secondary btn-sm rounded-pill px-4 mt-2">
                    <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i> Xóa bộ lọc
                </a>
            }
            else
            {
                <h4 class="text-muted">Kho hàng đang trống</h4>
                <p class="text-muted small">Chưa có sản phẩm nào được nhập kho.</p>
            }
        </div>
    }
</div>

<div class="modal fade" id="setStockLevelsModal" tabindex="-1" aria-labelledby="setStockLevelsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content inventory-stock-modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold" id="setStockLevelsModalLabel">
                    <i class="bi bi-sliders me-2"></i>Cấu hình mức tồn
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form id="setStockLevelsForm">
                <div class="modal-body pt-0">
                    <input type="hidden" id="setStockLevels-id" name="Id" />
                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1">Sản phẩm</label>
                        <div id="setStockLevels-productName" class="fw-semibold"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1">Kho</label>
                        <div id="setStockLevels-warehouseName" class="fw-semibold"></div>
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label for="setStockLevels-reorderLevel" class="form-label">Mức cảnh báo</label>
                            <input type="number" step="0.01" min="0" class="form-control" id="setStockLevels-reorderLevel" name="ReorderLevel" required inputmode="numeric"/>
                            <div class="form-text">Hàng sẽ vào danh sách cảnh báo nếu tồn <= mức này.</div>
                        </div>
                        <div class="col-6">
                            <label for="setStockLevels-maxStockLevel" class="form-label">Mức tối đa</label>
                            <input type="number" step="0.01" min="0" class="form-control" id="setStockLevels-maxStockLevel" name="MaxStockLevel" required inputmode="numeric"/>
                            <div class="form-text">Để 0 nếu không giới hạn.</div>
                        </div>
                    </div>
                    <div id="setStockLevels-error" class="alert alert-danger mt-3 d-none small mb-0"></div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4" id="setStockLevels-submit">
                        <span class="spinner-border spinner-border-sm me-2 d-none" id="setStockLevels-spinner" role="status"></span>
                        Lưu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('.btn-cost-history-panel').forEach(btn => {
                btn.addEventListener('click', function () {
                    const url = this.dataset.historyUrl;
                    if (!url || typeof window.openCoworkOffcanvas !== 'function') return;

                    window.openCoworkOffcanvas({
                        title: this.dataset.historyTitle || 'Giá vốn',
                        url: url,
                        size: 'lg'
                    });
                });
            });
        })();

        (function () {
            const modalEl = document.getElementById('setStockLevelsModal');
            if (!modalEl) return;
            const modal = new bootstrap.Modal(modalEl);
            const form = document.getElementById('setStockLevelsForm');
            const idInput = document.getElementById('setStockLevels-id');
            const productNameEl = document.getElementById('setStockLevels-productName');
            const warehouseNameEl = document.getElementById('setStockLevels-warehouseName');
            const reorderInput = document.getElementById('setStockLevels-reorderLevel');
            const maxInput = document.getElementById('setStockLevels-maxStockLevel');
            const errorEl = document.getElementById('setStockLevels-error');
            const submitBtn = document.getElementById('setStockLevels-submit');
            const spinner = document.getElementById('setStockLevels-spinner');

            document.querySelectorAll('.btn-set-stock-levels').forEach(btn => {
                btn.addEventListener('click', function () {
                    idInput.value = this.dataset.id;
                    productNameEl.textContent = this.dataset.productName;
                    warehouseNameEl.textContent = this.dataset.warehouseName;
                    reorderInput.value = this.dataset.reorderLevel || '0';
                    maxInput.value = this.dataset.maxStockLevel || '0';
                    errorEl.classList.add('d-none');
                    errorEl.textContent = '';
                    modal.show();
                });
            });

            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                errorEl.classList.add('d-none');
                submitBtn.disabled = true;
                spinner.classList.remove('d-none');

                const formData = new FormData(form);
                try {
                    const response = await fetch('@Url.Action("SetStockLevels", "Inventory")', {
                        method: 'POST',
                        body: formData
                    });
                    const result = await response.json();
                    if (result.success) {
                        modal.hide();
                        window.location.reload();
                    } else {
                        errorEl.textContent = result.errorMessage || 'Có lỗi xảy ra.';
                        errorEl.classList.remove('d-none');
                    }
                } catch (err) {
                    errorEl.textContent = 'Lỗi kết nối tới máy chủ.';
                    errorEl.classList.remove('d-none');
                } finally {
                    submitBtn.disabled = false;
                    spinner.classList.add('d-none');
                }
            });
        })();
    </script>
}
