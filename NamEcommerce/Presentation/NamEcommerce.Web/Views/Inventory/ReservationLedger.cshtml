@model NamEcommerce.Web.Contracts.Models.Inventory.ProductReservationLedgerListModel
@{
    ViewData[ViewConstants.PageTitle] = "Lịch sử giữ hàng";
}

@functions
{
    private static string GetReasonText(int reason)
    {
        return (ProductReservationReason)reason switch
        {
            ProductReservationReason.OrderCreated => "Tạo đơn bán",
            ProductReservationReason.OrderItemAdded => "Thêm hàng vào đơn",
            ProductReservationReason.OrderItemIncreased => "Tăng số lượng đặt",
            ProductReservationReason.OrderItemDecreased => "Giảm số lượng đặt",
            ProductReservationReason.OrderItemRemoved => "Xóa hàng khỏi đơn",
            ProductReservationReason.OrderCancelled => "Hủy đơn bán",
            ProductReservationReason.OrderDeleted => "Xóa đơn bán",
            ProductReservationReason.OrderCompleted => "Hoàn tất đơn bán",
            ProductReservationReason.DeliveryNoteConfirmed => "Xác nhận phiếu xuất",
            ProductReservationReason.DeliveryNoteCancelled => "Hủy phiếu xuất",
            ProductReservationReason.DeliveryNoteCreated => "Tạo phiếu xuất",
            ProductReservationReason.MigrationBackfill => "Đồng bộ dữ liệu cũ",
            _ => "Khác"
        };
    }
}

<section class="content-title my-4 text-center">
    <h1>
        Lịch sử giữ hàng theo đơn bán
        <span class="text-muted d-block fs-3 ps-2">
            @Model.ProductName
        </span>
    </h1>
</section>

<section class="content-data p-4 mb-5 shadow">
    <div class="mb-3">
        <a asp-action="StockList" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Ngày phát sinh</th>
                    <th>Lý do</th>
                    <th>Đơn bán</th>
                    <th class="text-end">Số lượng</th>
                    <th class="text-end">Giá bán</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Data.Pagination.TotalCount > 0)
                {
                    @foreach (var item in Model.Data)
                    {
                        var isPositive = item.QuantityDelta > 0;
                        var colorClass = isPositive ? "text-primary" : "text-success";
                        var sign = isPositive ? "+" : "";

                        <tr>
                            <td>@item.CreatedOn.ToString(ViewConstants.DefaultDateTimeFormat)</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @GetReasonText(item.Reason)
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.OrderCode))
                                {
                                    <a asp-controller="Order" asp-action="Details" asp-route-id="@item.OrderId" class="fw-semibold text-decoration-none">
                                        @item.OrderCode
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">Không rõ</span>
                                }
                            </td>
                            <td class="text-end fw-bold @colorClass">@sign@item.QuantityDelta.DisplayQuantity()</td>
                            <td class="text-end text-nowrap">
                                @(item.UnitPrice.HasValue ? item.UnitPrice.Value.DisplayCurrencyWithSymbol() : "-")
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            Chưa có lịch sử giữ hàng cho sản phẩm này.
                        </td>
                    </tr>
                }
            </tbody>
            @if (Model.Data.Pagination.TotalCount > 0)
            {
                <tfoot>
                    <tr>
                        <td colspan="5" class="ps-0">
                            <partial name="_Pager" model="Model.Data.Pagination" />
                        </td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</section>
