@model ChangeUserPasswordModel
@{
    ViewData[ViewConstants.PageTitle] = "Đổi mật khẩu";
}

@section TitleSection {
    <h1 class="topbar-page-title">
        Đổi mật khẩu
        <span class="text-muted">@Model.Username</span>
    </h1>
    <div class="topbar-page-subtitle">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home" class="text-decoration-none">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-action="Users" asp-controller="UserManagement" class="text-decoration-none">Quản lý tài khoản</a></li>
                <li class="breadcrumb-item active" aria-current="page">Đổi mật khẩu</li>
            </ol>
        </nav>
    </div>
}

<div asp-validation-summary="ModelOnly" class="alert alert-warning alert-global alert-dismissible long-time-waiting"></div>
<div class="content-card">
    <form method="post" asp-antiforgery="true">
        <div class="content-card-body">
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Username" />
            <div class="row g-3">
                <div class="col-lg-5">
                    <label class="form-label">Tài khoản</label>
                    <div class="form-control bg-light">@Model.Username</div>
                </div>
                <div class="col-lg-5">
                    <label asp-for="NewPassword" class="form-label">Mật khẩu mới <span class="text-danger">*</span></label>
                    <input asp-for="NewPassword" type="password" class="form-control" placeholder="Nhập mật khẩu mới" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="content-card-footer d-flex align-items-center justify-content-between">
            <a asp-action="Users" class="btn btn-outline-secondary text-decoration-none btn-sm">
                <i class="bi bi-arrow-left"></i>
                Trở về
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-key me-1"></i>Lưu mật khẩu
            </button>
        </div>
    </form>
</div>
