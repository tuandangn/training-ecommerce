@using NamEcommerce.Web.Models.Users
@model LoginModel
@{
    Layout = "_Layout.Anonymous";
    ViewData[ViewConstants.PageTitle] = "Đăng nhập";
    string? returnUrl = Context.Request.Query["ReturnUrl"];
}
<div class="d-flex align-items-center justify-content-center ui-login-shell">
    <div class="w-100 ui-max-w-420">
        <!-- Logo / Brand -->
        <div class="text-center mb-4">
            <div class="mb-2 ui-login-brand-icon">
                <i class="bi bi-bag-heart-fill"></i>
            </div>
            <h1 class="fw-bold mb-0 ui-login-title">@Information.Name</h1>
            <p class="text-muted small mt-1">Đăng nhập để tiếp tục quản lý</p>
        </div>

        <!-- Login Card -->
        <div class="content-card">
            <div class="content-card-body ui-login-card">
                <div asp-validation-summary="ModelOnly" class="alert alert-warning alert-global"></div>
                <input type="hidden" name="ReturnUrl" value="@returnUrl" />

                <form class="row g-3" method="post" asp-antiforgery="true">
                    <div class="col-12">
                        <label asp-for="Username" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white ui-border-right-muted">
                                <i class="bi bi-person text-muted"></i>
                            </span>
                            <input asp-for="Username" class="form-control ui-border-left-0" data-testid="login-username" placeholder="Tên đăng nhập"
                                   autofocus />
                        </div>
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white ui-border-right-muted">
                                <i class="bi bi-lock text-muted"></i>
                            </span>
                            <input asp-for="Password" class="form-control ui-border-left-0" data-testid="login-password" placeholder="Mật khẩu"
                                   />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary w-100 py-2 ui-login-submit" data-testid="login-submit">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <p class="text-center text-muted small mt-3">
            &copy; 2026 @Information.Name
        </p>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
