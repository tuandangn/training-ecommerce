{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CustomerPortal": {
    "ForwardedHeaders": {
      "Enabled": false
    },
    "DataProtection": {
      "ApplicationName": "NamEcommerce.CustomerPortal",
      "KeysPath": ""
    },
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173",
      "http://127.0.0.1:5173",
      "https://127.0.0.1:5173"
    ],
    "Security": {
      "OtpExpiryMinutes": 5,
      "SessionExpiryHours": 8,
      "OtpCooldownSeconds": 60,
      "MaxOtpRequestsPerCustomerPerHour": 5,
      "MaxOtpRequestsPerIpPerHour": 20,
      "MaxPasswordFailuresPerCustomerPerHour": 5,
      "MaxPasswordFailuresPerIpPerHour": 20,
      "DeliveryAccessTokenExpiryDays": 30,
      "RevokeExistingDeliveryTokensOnCreate": false
    }
  },
  "ConnectionStrings": {
    "NamEcommerceEfDbContext": "Data Source=.\\SQLEXPRESS;Database=NamEcommerceDb;Integrated Security=True;Persist Security Info=False;Pooling=False;MultipleActiveResultSets=True;TrustServerCertificate=True;",
  }
}
