# ================================
# Stage 1: Build React (Vite)
# ================================
FROM node:20-alpine AS build
WORKDIR /app

COPY NamEcommerce/Presentation/Customer/NamEcommerce.Customer.Client/package*.json ./
RUN npm ci

COPY NamEcommerce/Presentation/Customer/NamEcommerce.Customer.Client/ .

# API URL sẽ được truyền vào lúc build
ARG VITE_API_URL=https://api.dangvy.com
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# ================================
# Stage 2: Serve bằng Nginx
# ================================
FROM nginx:alpine AS runtime

COPY --from=build /app/dist /usr/share/nginx/html

# Config nginx cho React Router (SPA)
RUN echo 'server { \
    listen 80; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80
